<http://data.open.ac.uk/climate-sense/claim/5390>
        rdf:type                 schema:Claim;
        schema:abstract          "“Although global warming has been described as the greatest threat facing mankind, the policies designed to address global warming actually pose a greater threat. The Kyoto Protocol and similar domestic schemes to ration carbon-based energy use would do little to slow carbon dioxide emissions, but would have enormous costs.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5390/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/competitive-enterprise-institute/>;

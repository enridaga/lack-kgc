        schema:url               "https://www.desmog.com/simon-lomax/" .

<http://data.open.ac.uk/climate-sense/claim/6823/source/35>
        rdf:type         schema:CreativeWork;
        schema:citation  "Ken Haapala. “<a href=\"http://web.archive.org/web/20141016161949/http://heartland.org/press-releases/2014/10/09/heartland-institute-climate-experts-comment-18-straight-years-no-global-wa\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Heartland Institute Climate Experts Comment on 18 Straight Years of No Global Warming</a>,” Heartland Institute, October 9, 2014. Archived October 16, 2014."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6823>
        rdf:type                 schema:Claim;
        schema:abstract          "“The EPA and the Obama administration have embarked on a program of eliminating electricity generation from even the most efficient and cleanest modern coal-fired power plants, without carbon capture and storage – a technology untested for general application. All this is based on a perceived threat to human health that cannot be shown to exist. It is past time to stop the madness of wasting great sums of money on EPA’s imaginary threat to human health.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6823/source/35>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ken-haapala/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/ken-haapala/" .

<http://data.open.ac.uk/climate-sense/claim/6822/source/31>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160531202058/https://cei.org/content/cei-runs-%E2%80%9Cabuse-power%E2%80%9D-ad-new-york-times\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">CEI Runs “Abuse of Power” Ad In New York Times</a>,” Competitive Enterprise Institute, May 18, 2016. Archived May 31, 2016."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6822>
        rdf:type                 schema:Claim;
        schema:abstract          "“Attempts to intimidate CEI and our allies and silence our policy research are unconstitutional,” said CEI president Kent Lassman. “The First Amendment protects us and everyone has a duty to respect it – even state attorneys general. CEI will continue to fight for all Americans to support the causes in which they believe.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6822/source/31>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ken-haapala/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/ken-haapala/" .


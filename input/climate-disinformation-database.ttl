        rdf:type                 schema:Claim;
        schema:abstract          "“What should states do?";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3453/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;

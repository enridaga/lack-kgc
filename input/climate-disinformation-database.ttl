        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20170225230421/https://thefederalist.com/2015/08/04/obama-wasnt-kidding-about-wanting-to-spike-your-electricity-bill/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Obama Wasn’t Kidding About Wanting To Spike Your Electricity Bill</a>,” <em>The Federalist</em>, August 4, 2015. Archived February 25, 2017. Archive.is URL: <a href=\"https://archive.is/8Xsde\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/8Xsde</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3450>
        rdf:type                 schema:Claim;
        schema:abstract          "“Congress should continue its efforts to restrict funding for the plan, passing legislation protecting ratepayers, and allowing governors to have the flexibility to reject the plan if it raises electricity rates.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3450/source/79>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;

<http://data.open.ac.uk/climate-sense/claim/5551>
        rdf:type                 schema:Claim;
        schema:abstract          "“In Australia in the 1880s and 1890s, the temperature was warmer than today. We know that for a fact because the Bureau of Meteorology’s measurements show that. But the Bureau of Meteorology only puts up graphs from 1910 onwards.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5551/source/43>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/malcolm-roberts/>;

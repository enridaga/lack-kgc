        rdf:type                 schema:Claim;
        schema:abstract          "8. Global cooling has presented serious problems for human society and the environment throughout history while global warming has generally been highly beneficial.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13031/source/>;

        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/989>
        rdf:type                 schema:Claim;
        schema:abstract          "If you’re going to reduce CO2 emissions from people in the United States, you have to go to the richest source first. And that is the power plants that we all are involved with. This is why this is so alarming to us, because we rely on them.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/989/source/>;

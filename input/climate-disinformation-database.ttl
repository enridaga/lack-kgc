        rdf:type         schema:CreativeWork;
        schema:citation  "<a name=\"s5\" id=\"s5\"></a>“<a href=\"http://web.archive.org/web/20151102231747/http://www.austriancenter.com/2013/09/27/climate-change-who-are-the-real-deniers/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Change – Who are the Real Deniers?</a>”<em> Austrian Economics Centre</em>, September 27, 2013. Archive URL: <a href=\"https://archive.ph/HUeZN\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/HUeZN</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4842>
        rdf:type                 schema:Claim;
        schema:abstract          "“The climate will never stop changing. No more than could Canute hold back the tide, not even ‘The One’ can stop nature from changing. We will never live in a static world, nor would we want to. While I am a strong believer in a clean environment, it is not about saving the planet – nature is bigger, more powerful and can be more destructive than anything man has devised.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4842/source/5>;

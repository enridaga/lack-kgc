<http://data.open.ac.uk/climate-sense/claim/9460>
        rdf:type                 schema:Claim;
        schema:abstract          "“A broader perspective on climate vulnerability suggests that industrial development under capitalism is not merely one factor among others influencing susceptibility to climate-related risks. Rather, it is the dominant factor, reducing climate vulnerability to a degree that makes all other factors irrelevant.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9460/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ayn-rand-institute/>;

<http://data.open.ac.uk/climate-sense/claim/3452>
        rdf:type                 schema:Claim;
        schema:abstract          "“Governors should continue to oppose the rule by refusing to submit a state plan. Three courageous governors have already said publicly that they will not submit a plan.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3452/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;

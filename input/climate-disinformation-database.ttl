<http://data.open.ac.uk/climate-sense/claim/12083/source/29>
        rdf:type         schema:CreativeWork;
        schema:citation  "Philip Cross. <a href=\"https://web.archive.org/web/20211019153352/https://macdonaldlaurier.ca/files/pdf/202110_Doubling_GDP_by_2050_Cross_PAPER_FWeb.pdf\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">“Doubling GDP by 2050: Why Canada need a firm target for economic growth” (PDF)</a>, <em>Macdonald Laurier Institute</em>, October 2021. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12083>
        rdf:type                 schema:Claim;
        schema:abstract          "“In the long-term, technological innovation is the only viable solution for lowering emissions while maintaining real income growth. However, our society apparently distrusts or discounts technology as the solution to climate change despite having the confidence to trust our lives to other technologies.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12083/source/29>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/macdonald-laurier-institute/>;

<http://data.open.ac.uk/climate-sense/claim/10724>
        rdf:type                 schema:Claim;
        schema:abstract          "The Foundation only accepts gifts which are completely philanthropic — ‘no strings attached.’ For example, someone creating a scholarship and making a fully tax-deductible gift can have no say in which students receive the awards. The same thing is true for gifts in kind, such as books for the library or donated artwork; donors give up their full rights of ownership and control over that property in order for it to qualify as a tax-deductible gift. ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10724/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/george-mason-university/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/george-mason-university/" .

<http://data.open.ac.uk/climate-sense/claim/10723/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10723>
        rdf:type                 schema:Claim;
        schema:abstract          "“All philanthropic gifts are processed through the George Mason University Foundation, which is the non-profit arm of the university proper. This allows for the university and the donor to both see the greatest benefit from gifts, including tax deductibility (with some exclusions). There are some exceptions, such as contributions that support sponsored research, which would be handled by a designated office on the university side.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10723/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/george-mason-university/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;

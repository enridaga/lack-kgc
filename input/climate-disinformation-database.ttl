<http://data.open.ac.uk/climate-sense/claim/13453>
        rdf:type                 schema:Claim;
        schema:abstract          "We require that all the work our agencies produce for clients complies with all relevant legal requirements, codes of practice and marketing standards. There are occasional complaints made about campaigns we have worked on, and some of these are upheld by marketing standards’ authorities. Our agencies take action where needed to prevent a recurrence.&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13453/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/grey-group/>;

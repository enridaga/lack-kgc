        rdf:type         schema:CreativeWork;
        schema:citation  "Tom Harris and Tim Ball. “TOM HARRIS and TIM BALL: Hypochondriac climate change concerns hurt us all,” <em>YourHoustonNews.com</em>, July 30, 2016. Archive.is URL: <a href=\"https://archive.is/eItjn\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/eItjn</a>"^^rdf:HTML .


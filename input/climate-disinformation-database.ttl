        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"http://web.archive.org/web/20090103105748/http://epw.senate.gov/public/index.cfm?FuseAction=Files.View&amp;FileStore_id=83947f5d-d84a-4a84-ad5d-6e2d71db52d9\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">“More Than 650 International Scientists Dissent Over Man-Made Global Warming Claims” (PDF)</a>, <em>U.S. Senate Committee on Environment &amp; Public Works</em>, Dec 11, 2008. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3738>
        rdf:type                 schema:Claim;
        schema:abstract          "“The IPCC has actually become a closed circuit; it doesn’t listen to others. It doesn’t have open minds… I am really amazed that the Nobel Peace Prize has been given on scientifically incorrect conclusions by people who are not geologists.”";

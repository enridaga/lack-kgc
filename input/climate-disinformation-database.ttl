<http://data.open.ac.uk/climate-sense/claim/232>
        rdf:type                 schema:Claim;
        schema:abstract          "“We conclude that where the effect at issue is climate change in the form of increased temperatures, a proposed action that will involve the emission of GHG [greenhouse gas] cannot pass the ‘may affect’ test and is not subject to consultation under ESA and its implementing regulations,” Bernhardt wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/232/source/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“We are acting now and we have been acting for decades… It’s not the case that we’re doing nothing about it. This is a new generation of activists – they probably don’t have much of an active memory of&nbsp;that.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4715/source/60>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/institute-economic-affairs/>;

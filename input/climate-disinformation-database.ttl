        rdf:type                 schema:Claim;
        schema:abstract          "“Even after all these years of propaganda and browbeating, Canadians are roughly evenly split on whether global warming is mostly anthropogenic, but so is the scientific community.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3552/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/canada-strong-and-free-network/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“Sceptics like us are challenged to disprove their hypothesis,” Cunningham said. “Scientists are best qualified to deal with the scientific questions but we all have to deal with the financial consequences of any actions taken on bad science.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7571/source/>;

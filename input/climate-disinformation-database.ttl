<http://data.open.ac.uk/climate-sense/claim/4440>
        rdf:type                 schema:Claim;
        schema:abstract          "“We do not need a $13 billion Department of Education. We need tax credits for anyone who sends a child to a private, voluntary school. This will give the poor and middle class a choice for the better education of their&nbsp;children.”";

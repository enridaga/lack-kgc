        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10404>
        rdf:type                 schema:Claim;
        schema:abstract          "“In Britain we will soon be making people buy inferior and more expensive boiler technology and driving many out of the new car market if they aren’t prepared to take a punt on electric vehicles.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10404/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-frost/>;

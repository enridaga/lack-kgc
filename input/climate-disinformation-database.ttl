        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://sites.libsyn.com/404672/episode-9-life-liberty-pending-at-the-supreme-court\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Episode 9: Life &amp; Liberty Pending at the Supreme Court</a>,” <em>Truth be Told with Mike &amp; Kelly Johnson</em>, May 11, 2022. Archived .mp4 on file at DeSmog."^^rdf:HTML .


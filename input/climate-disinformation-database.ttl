<http://data.open.ac.uk/climate-sense/claim/3874>
        rdf:type                 schema:Claim;
        schema:abstract          "“The president’s Paris pledge will increase electricity costs, ration energy and slow economic growth. Congress has repeatedly rejected the president’s extreme climate agenda. The president’s climate pledge is a bad deal for the American economy, the American people and would produce no substantive environmental benefits.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3874/source/27>;

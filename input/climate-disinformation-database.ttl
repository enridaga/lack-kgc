        rdf:type         schema:CreativeWork;
        schema:citation  "Rosalind S. Helderman. “<a href=\"https://www.washingtonpost.com/news/post-politics/wp/2018/01/04/mercer-issues-rare-public-rebuke-of-former-ally-bannon/?utm_term=.f50b3d9ba18c\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Mercer issues rare public rebuke of former ally Bannon</a>,” <em>The Washington Post</em>, January 4, 2018. <a href=\"http://web.archive.org/web/20180110013623/https://www.washingtonpost.com/news/post-politics/wp/2018/01/04/mercer-issues-rare-public-rebuke-of-former-ally-bannon/?utm_term=.8ad532b29833\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 10, 2018</a>. Archive.is URL: <a href=\"https://archive.is/Kj734\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/Kj734</a>"^^rdf:HTML .


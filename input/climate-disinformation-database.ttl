<http://data.open.ac.uk/climate-sense/claim/6883>
        rdf:type                 schema:Claim;
        schema:abstract          "“I am not a big proponent of the climate change data because I have seen data on the other side.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6883/source/69>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-johnson/>;

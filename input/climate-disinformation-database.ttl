<http://data.open.ac.uk/climate-sense/claim/3460>
        rdf:type                 schema:Claim;
        schema:abstract          "According to Domenech, “The Pope is being really ill-advised by folks that are really more global leftists concerned about ending capitalism more than helping the environment.”";

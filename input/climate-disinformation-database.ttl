<http://data.open.ac.uk/climate-sense/claim/8082/source/162>
        rdf:type         schema:CreativeWork;
        schema:citation  "Giles Parkinson. “<a href=\"http://reneweconomy.com.au/2015/67713\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">IEA says Lomborg claims on wind and solar energy are ‘rubbish’,</a>“&nbsp;<em>RenewEconomy</em>, December 2, 2015.&nbsp;Archive.is URL:&nbsp;<a href=\"https://archive.is/O7iCU\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/O7iCU</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8082>
        rdf:type                 schema:Claim;
        schema:abstract          "“The reality is that even after two decades of climate talks, we get a meagre 0.5% of our total global energy consumption from solar and wind energy, according to the leading authority, the International Energy Agency (";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8082/source/162>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;

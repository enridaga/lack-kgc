<http://data.open.ac.uk/climate-sense/claim/10406/source/22>
        rdf:type         schema:CreativeWork;
        schema:citation  "Reasoned. “<a href=\"https://twitter.com/ReasonedUK/status/1660361652263428096\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Bad – and expensive for the average Briton</a>,” Tweet by @ReasonedUK, May 21, 2023. Retrieved from Twitter.com. <a href=\"https://web.archive.org/web/20230602170514/https://twitter.com/ReasonedUK/status/1660361652263428096\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived June 2, 2023</a>. Archived .png on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10406>
        rdf:type                 schema:Claim;
        schema:abstract          "“We are replacing a lot of perfectly good ways of generating electricity with gas and nuclear ways of generating it with wind and solar.”";

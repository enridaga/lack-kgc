        rdf:type                 schema:Claim;
        schema:abstract          "“Dr Wei Peng, of Penn State university and lead author of the study, said she and her colleagues were ‘frustrated with Lomborg’s misinterpretation of our study’.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8112/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;

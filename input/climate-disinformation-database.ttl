<http://data.open.ac.uk/climate-sense/claim/10527>
        rdf:type                 schema:Claim;
        schema:abstract          "Lomborg: “Yeah.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10527/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-rogan/>;

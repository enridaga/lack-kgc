        rdf:type                 schema:Claim;
        schema:abstract          "“Many observers, including SecondStreet.org, noted that Canada was well-positioned to develop and export more natural gas and oil, helping the world to reduce its dependence on Russia,” SecondStreet.org suggested in the video description.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7504/source/>;

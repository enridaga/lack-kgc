<http://data.open.ac.uk/climate-sense/claim/12285/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "Joel Achenbach. “<a href=\"http://www.washingtonpost.com/wp-dyn/content/article/2006/05/23/AR2006052301305_5.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Tempest</a>,” <em>The Washington Post</em>, May 28, 2006. <a href=\"http://web.archive.org/web/20171024232526/http://www.washingtonpost.com/wp-dyn/content/article/2006/05/23/AR2006052301305_5.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived October 24, 2017</a>. Archive.is URL: <a href=\"https://archive.is/yYuMK\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/yYuMK</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12285>
        rdf:type                 schema:Claim;
        schema:abstract          "“I am of the opinion that this is one of the greatest hoaxes ever perpetrated on the American people.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12285/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/william-gray/>;

<http://data.open.ac.uk/climate-sense/claim/3087/source/70>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://wichitaliberty.org/capitalism/mike-pompeo-we-need-capitalism-not-cronyism/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Mike Pompeo: We need capitalism, not cronyism</a>,” <em>Voice for Liberty</em>, March 1, 2012. Archived March 14, 2018. Archive.is URL: <a href=\"https://archive.is/mSSvd\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/mSSvd</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3087>
        rdf:type                 schema:Claim;
        schema:abstract          "“One example of a tax earmark that should be eliminated is the Production Tax Credit (PTC) that goes to the wind industry,” Pompeo wrote. “The PTC has existed for the past 20 years, but it has not succeeded yet in making unsubsidized wind competitive. Politicians who pretend that a few more years of the PTC will make wind competitive could be right, but that is not a responsible bet to make with taxpayer dollars.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3087/source/70>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-pompeo/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/mike-pompeo/" .

<http://data.open.ac.uk/climate-sense/claim/3086/source/69>
        rdf:type         schema:CreativeWork;
        schema:citation  "Lee Fang. “<a href=\"https://theintercept.com/2016/11/23/mike-pompeo-religious-war/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">TRUMP CIA PICK MIKE POMPEO DEPICTED WAR ON TERROR AS ISLAMIC BATTLE AGAINST CHRISTIANITY</a>,” <em>The Intercept</em>, November 23, 2016. Archive.is URL: <a href=\"https://archive.is/6XkGJ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/6XkGJ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3086>
        rdf:type                 schema:Claim;
        schema:abstract          "”[…] [I]t is absolutely a minority within the Muslim faith, but these folks are serious, and they abhor Christians, and will continue to press against us until we make sure that we pray and stand and fight and make sure that we know that Jesus Christ as our savior is truly the only solution for our world.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3086/source/69>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-pompeo/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/mike-pompeo/" .

<http://data.open.ac.uk/climate-sense/claim/3085/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3085>
        rdf:type                 schema:Claim;
        schema:abstract          "“This threat to America is from people who deeply believe that Islam is the way and the light, and the only answer. And so as we think about what U.S. Policy needs to be… how we will begin to combat this, we need to recognize that these folks believe that it is religiously driven for them to wipe Christians from the face of the Earth.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3085/source/>;

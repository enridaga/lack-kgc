        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20181219210304/http://www.thegwpf.com/rebel-scientists-force-royal-society-to-accept-climate-scepticism/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">REBEL SCIENTISTS FORCE ROYAL SOCIETY TO ACCEPT CLIMATE SCEPTICISM,” <em>The Global Warming Policy Forum</em></a>, May 29, 2010."^^rdf:HTML .


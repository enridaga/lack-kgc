<http://data.open.ac.uk/climate-sense/claim/8639/source/238>
        rdf:type         schema:CreativeWork;
        schema:citation  "Ashley Braun. “T<a href=\"//www.desmog.com/2016/09/07/fight-clean-power-plan-fossil-fuel-companies-paid-private-meetings-republican-state-prosecutors\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">o Fight Clean Power Plan, Fossil Fuel Companies Paid for Private Meetings with Republican State Prosecutors</a>,” <em>DeSmog</em>, September 7, 2016."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8639>
        rdf:type                 schema:Claim;
        schema:abstract          "“That’s highly inappropriate for law enforcement officials in a majority of states to be holding private meetings with corporations that they are supposed to be holding to account,” Nick Surgey, CMD Research Director, told DeSmog";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8639/source/238>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Miranda Green. “<a href=\"http://web.archive.org/web/20190704190406/https://thehill.com/policy/energy-environment/398381-conservatives-come-out-against-carbon-tax-bill-from-gop-lawmaker\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Conservatives come out against carbon tax bill from GOP lawmaker</a>,” <em>The Hill</em>, July 23, 2018. Archived July 4, 2019. Archive.fo URL: <a href=\"https://archive.fo/zuGSc\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/zuGSc</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13487>
        rdf:type                 schema:Claim;
        schema:abstract          "“There is no appreciation to be gained by the real Democrats by pretending to be a Democrat,” Kerpen said of Curbelo. “There’s a Republican consensus against this bill. It’s a bad idea, and any Republican who is tempted to embrace it will see very little friends on both sides of the aisle.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13487/source/28>;

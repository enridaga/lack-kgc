<http://data.open.ac.uk/climate-sense/claim/12288/source/21>
        rdf:type         schema:CreativeWork;
        schema:citation  "William M. Gray. “<a href=\"http://web.archive.org/web/20171025172355/http://news.bbc.co.uk/2/hi/in_depth/sci_tech/2000/climate_change/1023334.stm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Viewpoint: Get off warming bandwagon</a>.” <em>BBC News</em>, November 16, 2000. Archived October 24, 2017. Archive.is URL: <a href=\"http://archive.is/4HDc0\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/4HDc0</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12288>
        rdf:type                 schema:Claim;
        schema:abstract          "“Human kind has little or nothing to do with the recent temperature changes. We are not that influential”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12288/source/21>;

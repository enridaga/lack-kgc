<http://data.open.ac.uk/climate-sense/claim/13444>
        rdf:type                 schema:Claim;
        schema:abstract          "“Coal-based generation in the United States […] has increased 146% since 1970. And all these emissions have dropped off. Clean coal works. We have to implement it.";

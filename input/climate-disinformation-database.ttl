        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .

<http://data.open.ac.uk/climate-sense/claim/11977/source/56>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20220820050754/https://www.youtube.com/watch?v=xHLalL5H9d8\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Richard Tice: We are at Everest base camp of the cost of net zero</a>”, Youtube video uploaded by user @GBNews, March 26, 2022. Archived August 20, 2022. Archived .mp4 on file at DeSmog.&nbsp;"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11977>
        rdf:type                 schema:Claim;
        schema:abstract          "“Our view is very simple. We all care about the environment, we all want to reduce emissions and have cleaner air, but there must be a discussion about the best way to do that. […] We ought to do our bit. Our concern is that Westminster’s net zero plans is the wrong bit at the wrong price and we are seeing the price as we speak.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11977/source/56>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .

<http://data.open.ac.uk/climate-sense/claim/11976/source/54>
        rdf:type         schema:CreativeWork;
        schema:citation  "Richard Tice. “<a href=\"https://web.archive.org/web/20221107175845/https://twitter.com/TalkTV/status/1552278345760514055?s=20&amp;t=JJSp1rSya0I1MJvCYDdndA\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Both Liz Truss and Rishi Sunak have indicated support for shale gas extraction “if local communities support it”. Ecotricity Founder, Dale Vince: “It’s fools gold. Fracking is a bad idea that nobody wants</a>”. Tweet by user @TalkTV. July 27, 2022. Archived November 7, 2022<strong>. </strong>Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11976>
        rdf:type                 schema:Claim;
        schema:abstract          "“We’ve got a huge opportunity here now to have a, literally, a trillion pounds worth of levelling up, by drilling down […] this is in our strategic national interest because we can reduce gas prices and there’s a massive win-win because we can also dramatically reduce the quantity of CO2 by using our own domestic gas as opposed to currently we’re importing almost 50% of the gas we use.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11976/source/54>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .


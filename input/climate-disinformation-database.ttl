        rdf:type                 schema:Claim;
        schema:abstract          "“Most of the predictions, you know, that hurricanes are going to get more intense, so we’re going to see more droughts and floods and so on. Almost all of the high-impact things don’t show any long-term trend. They’re all within natural variability.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10579/source/>;

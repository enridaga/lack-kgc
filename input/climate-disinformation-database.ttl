<http://data.open.ac.uk/climate-sense/claim/3467/source/52>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://fuelingfreedomproject.com/wp-content/uploads/2016/08/BML_03_Doug_Dominench_08_26_164.mp3?_=1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Listen to Doug Domenech’s Interview on the Bill Martinez Show</a>,” Fueling Freedom. Archived February 25, 2017. Archived .mp3 on file at DeSmog."^^rdf:HTML .


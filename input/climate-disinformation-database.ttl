<http://data.open.ac.uk/climate-sense/claim/882>
        rdf:type                 schema:Claim;
        schema:abstract          "b10";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/882/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/matt-ridley/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;

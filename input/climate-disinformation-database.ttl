        rdf:type                 schema:Claim;
        schema:abstract          "“Yes, CO2 has an effect, but it’s about a fifth or tenth of what the IPCC says it is. CO2 is not driving the climate; it caused less than 20 per cent of the global warming in the last few decades.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10036/source/19>;

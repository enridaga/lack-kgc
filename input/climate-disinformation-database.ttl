<http://data.open.ac.uk/climate-sense/claim/654>
        rdf:type                 schema:Claim;
        schema:abstract          "“Future economic damages from carbon dioxide emissions can only be estimated in conjunction with forecasts of climate change. But recent history shows those forecasts are in flux, with an increasing number of forecasts of less warming appearing in the scientific literature in the last four&nbsp;years.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/654/source/16>;

        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/benjamin-zycher/" .

<http://data.open.ac.uk/climate-sense/claim/12319/source/44>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180727205215/http://www.aei.org/publication/modern-environmentalism-and-the-david-vs-goliath-inversion/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Modern environmentalism and the David vs. Goliath inversion</a>,” <em>AEI</em>, Dec 20, 2017. Archived July 27, 2018. Archive.is URL: <a href=\"https://archive.fo/IqgTp\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/IqgTp</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12319>
        rdf:type                 schema:Claim;
        schema:abstract          "“As Mussolini might have put it: All within the climate crusade, nothing outside the climate crusade, nothing against the climate crusade. Thus has the climate industry evolved into a totalitarian ideology happy to crush the preferences of ordinary people,” Zycher ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12319/source/44>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/benjamin-zycher/>;

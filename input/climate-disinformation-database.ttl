        rdf:type         schema:CreativeWork;
        schema:citation  "Rob Galbraith. “<a href=\"https://web.archive.org/web/20190320153231/https://news.littlesis.org/2019/03/19/hedge-fund-backed-think-tank-manhattan-institute-publishes-blog-post-sympathizing-with-killer-the-day-after-christchurch-terror-attack/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Hedge fund-backed think tank Manhattan Institute publishes blog post sympathizing with killer the day after Christchurch attack</a>,” <em>LittleSis.org</em>, March 21, 2019. Archived March 20, 2019. Archive.is URL: <a href=\"http://archive.is/7Hs6X\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/7Hs6X</a>"^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s7\"></a> “<a href=\"http://web.archive.org/web/20151011034921/http://www.boston.com/bostonglobe/editorial_opinion/letters/articles/2008/08/08/solution_lies_in_the_free_market_system/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Solution lies in the free market system</a>,”&nbsp;<em>The Boston Globe</em>, August 8, 2008. Archived October 10, 2015. Archive URL: <a href=\"https://archive.ph/kJfbJ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/kJfbJ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7934>
        rdf:type                 schema:Claim;
        schema:abstract          "“The only way to slow global warming is to allow entrepreneurs to create more energy-efficient products and technologies. As the demand for these products grows, entrepreneurs will naturally react to market forces and direct their energies to producing more energy-efficient products at a cheaper cost. Government intervention is not the solution to this problem, the free market is.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7934/source/8>;

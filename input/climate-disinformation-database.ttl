<http://data.open.ac.uk/climate-sense/claim/12257/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "Kevin D. Williamson. “<a href=\"https://web.archive.org/web/20210518173824/https://www.nationalreview.com/2019/01/climate-change-fiscal-change-and-risk/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Climate Change, Fiscal Change, and Risk</a>,” <em>National Review</em>, January 30, 2019. Archived May 18, 2021. Archive URL:<a href=\"https://archive.ph/L46C3\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/L46C3</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12257>
        rdf:type                 schema:Claim;
        schema:abstract          "“Risk-mitigation is a useful way to think about climate change and climate-change policy. There is good reason to be skeptical of the alarmist view of climate change and the maximalist approach to climate-change policy; the case for assessing the risks associated with climate change at zero — and pricing them at $0.00 — is considerably more difficult to make.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12257/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kevin-d-williamson/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Bob Shoup. “<a href=\"http://web.archive.org/web/20191127195747/https://canadafreepress.com/article/lying-for-the-good-of-society\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Lying for the Good of Society</a>,” <em>Canada Free Press</em>, March 7, 2014. Archived November 27, 2019. Archive.fo URL: <a href=\"https://archive.ph/P5DIk\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/P5DIk</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9842>
        rdf:type                 schema:Claim;
        schema:abstract          "“When one looks at the data, we can see that it has, in fact, been manipulated. At least the temperature station records maintained by NASA’s Goddard Institute of Space Studies (GISS). Sometime between 2008 and 2012, temperature records in NASA’s GISS data base have been altered to show up to 2o more warming has actually occurred […]”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9842/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/robert-bob-c-shoup/>;

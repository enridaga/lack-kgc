<http://data.open.ac.uk/climate-sense/claim/1151/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://pielkeclimatesci.wordpress.com/2007/12/10/correction-to-a-december-10-2007-bbc-news-article/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Correction To A December 10, 2007 BBC News Article</a>,” C<em>limate Science: Roger Pielke Sr.</em>, December 10, 2007. <a href=\"http://web.archive.org/web/20160310120252/https://pielkeclimatesci.wordpress.com/2007/12/10/correction-to-a-december-10-2007-bbc-news-article/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 25, 2017</a>. Archive.is URL: <a href=\"https://archive.is/5dJFa\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/5dJFa</a>"^^rdf:HTML .


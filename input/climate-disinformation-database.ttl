        schema:citation  "“<a href=\"https://www.industrydocumentslibrary.ucsf.edu/tobacco/docs/#id=nrfm0045\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Draft Only the Epa and the Science of Environmental Tobacco Smoke</a>.” Retrieved from Truth Tobacco Industry Documents. Bates No. TI40481951."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8748>
        rdf:type                 schema:Claim;
        schema:abstract          "“Scientific standards were seriously violated [by the EPA] in order to produce a report to justify a political agenda, namely to ban smoking.”";

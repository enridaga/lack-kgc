        rdf:type                 schema:Claim;
        schema:abstract          "“[A] myth persists that is both unscientific and immoral to perpetuate: that the beneficial gas carbon dioxide ranks among hazardous pollutants. It does not.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6849/source/9>;

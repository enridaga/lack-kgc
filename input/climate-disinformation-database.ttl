        rdf:type                 schema:Claim;
        schema:abstract          "“The cited figure does appear in a supplementary section of the paper. But the authors of the study (which actually appeared in Nature Climate Change, not Nature) have told Temperature Check they have been asking Lomborg since early November to stop making that claim.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8114/source/>;

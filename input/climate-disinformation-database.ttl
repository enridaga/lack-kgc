<http://data.open.ac.uk/climate-sense/claim/11457>
        rdf:type                 schema:Claim;
        schema:abstract          "Making the documentary was an extraordinary experience and it really hit home to me the quasi-religious nature of this anthropogenic global warming cause. These people really have found&nbsp;religion.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11457/source/>;

<http://data.open.ac.uk/climate-sense/claim/2470>
        rdf:type                 schema:Claim;
        schema:abstract          "“Most scientists don’t believe computer models can predict future weather patterns or tell us whether global warming is a threat. Real peer-reviewed science shows the human impact on climate is probably too small to measure and not worth trying to prevent or undo,” the report claims.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2470/source/280>;

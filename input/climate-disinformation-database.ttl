<http://data.open.ac.uk/climate-sense/claim/2064>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate has always varied, often with large swings. […] These dramatic climatic ebbs and flows are naturally occurring events. A more appropriate response to potential climate change is the production and employment of resources toward meaningful adaptation strategies.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2064/source/9>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Richard Littlemore. “<a href=\"//www.desmog.com/uh-oh-the-nrsp-is-praising-harpers-climate-change-bill\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Uh oh … the NRSP is Praising Harper’s Climate Change Bill</a>,” <em>DeSmog</em>, October 19, 2006."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/955>
        rdf:type                 schema:Claim;
        schema:abstract          "“First, we are very pleased the Government makes no reference to the Kyoto Protocol or purchasing ‘carbon credits’ from foreign governments in their announcements today,’ said Dr. Timothy Ball, Chairman of NRSP. ‘Kyoto ratification was a serious mistake that Canada must remedy by withdrawing from the Protocol in February 2008, the earliest date possible.’";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/955/source/28>;

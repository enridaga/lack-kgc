<http://data.open.ac.uk/climate-sense/claim/75/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "Norman Rogers. “<a href=\"http://web.archive.org/web/20140721181008/http://www.americanthinker.com/2009/08/global_warming_blues.html\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Global Warming Blues</a>,” <em>American Thinker</em>, August 27, 2009. Archived July 21, 2014. Archive.fo URL:<a href=\"https://archive.fo/BlT33\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.fo/BlT33</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/75>
        rdf:type                 schema:Claim;
        schema:abstract          "Green electric power from windmills and solar energy is impracticable. Its expensive and due to the erratic nature of sunshine and wind, solar and wind power must be backed up by duplicate power plants or by energy storage systems that are as expensive as duplicate power plants. It sometimes seems that the advocates of solar power don’t realize that the sun does not shine at night. The much acclaimed Kyoto Treaty for the reduction of CO2 illogically does not give CO2 reduction credit for CO2-free nuclear power plants, something put in the treaty in response to green lobbying.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/75/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/norman-rogers/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/norman-rogers/" .

<http://data.open.ac.uk/climate-sense/claim/74/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/74>
        rdf:type                 schema:Claim;
        schema:abstract          "“Controlling our own carbon dioxide emissions accomplishes practically nothing if the Chinese and Indians don’t control theirs. They play along as long as it seems profitable. The Chinese and Indians are like the natives who happily attend church services as long as the missionaries are giving out free dinners.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/74/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/norman-rogers/>;
        schema:claimInterpreter  <http://desmog.com/>;

<http://data.open.ac.uk/climate-sense/claim/10523>
        rdf:type                 schema:Claim;
        schema:abstract          "Rogan: “Without us even doing shit.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10523/source/>;

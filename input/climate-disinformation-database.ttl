<http://data.open.ac.uk/climate-sense/claim/12817>
        rdf:type                 schema:Claim;
        schema:abstract          "“I continue to contend that ‘climate change’ is a meaningless phrase because the climate obviously changes. But how? To what effect? It’s like saying ‘baby change’ about an infant. How? Is he well and growing? Is he ill?";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12817/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/franklin-centre-government-and-public-integrity/>;

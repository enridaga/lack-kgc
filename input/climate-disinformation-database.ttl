<http://data.open.ac.uk/climate-sense/claim/3541>
        rdf:type                 schema:Claim;
        schema:abstract          "The absence of atmospheric warming proves that the warming of the earth’s surface observed in the last 100 years cannot be due to an increase in carbon dioxide in the atmosphere caused by human activities. The ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3541/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/martin-armstrong/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;

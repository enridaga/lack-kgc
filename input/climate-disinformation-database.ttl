<http://data.open.ac.uk/climate-sense/claim/3870>
        rdf:type                 schema:Claim;
        schema:abstract          "“Make no mistake, while President Obama may soon leave the Oval Office, the environmental extremists who fight against American energy are here to stay. They are determined to stop Americans from using reliable and affordable power. They would rather see America keep our natural resources, as they say, in the ground.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3870/source/23>;

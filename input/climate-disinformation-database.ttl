        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.cnn.com/2018/01/03/politics/trump-statement-steve-bannon/index.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Read Trump’s official statement about Steve Bannon</a>,” <em>CNN</em>, January 3, 2018. <a href=\"http://web.archive.org/web/20180110013336/http://www.cnn.com/2018/01/03/politics/trump-statement-steve-bannon/index.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 10, 2018</a>. Archive.is URL: <a href=\"https://archive.is/JSVb5\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/JSVb5</a>"^^rdf:HTML .


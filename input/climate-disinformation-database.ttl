        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5523>
        rdf:type                 schema:Claim;
        schema:abstract          "“I firmly believe myself, sometimes the best thing the government can do is. The best thing, well, since I’m a fed now, the best thing the federal government can do, believe me, is to get the heck out of the way.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5523/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vincent-devito/>;

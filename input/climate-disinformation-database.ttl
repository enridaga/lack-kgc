<http://data.open.ac.uk/climate-sense/claim/10449/source/21>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20230105221640/https://twitter.com/jordanbpeterson/status/1486840669264044035\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The climate models can predict the past</a>.” Tweet by user “@jordanbpeterson,” January 27, 2022. Archived January 5, 2023."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10449>
        rdf:type                 schema:Claim;
        schema:abstract          "“The climate models can predict the past. Just like models of the stock market. I defy these ‘modellers’ to predict one stock accurately for one year and to bet their own money on the outcome. And one stock is a lot less complex than ‘climate’ particularly out a century,” he wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10449/source/21>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jordan-peterson/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/jordan-peterson/" .

<http://data.open.ac.uk/climate-sense/claim/10448/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10448>
        rdf:type                 schema:Claim;
        schema:abstract          "“We were also going to avoid entirely any apocalyptic notions, refusing to accept in principle the notion that everything is such an emergency that all the power should be ceded to a centralized committee to save the planet.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10448/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jordan-peterson/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/jordan-peterson/" .

<http://data.open.ac.uk/climate-sense/claim/10447/source/>
        rdf:type         schema:CreativeWork;

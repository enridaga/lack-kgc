<http://data.open.ac.uk/climate-sense/claim/11245>
        rdf:type                 schema:Claim;
        schema:abstract          "“There are three main benefits of atmospheric CO2. Higher atmospheric CO2 increases plant productivity. It also enhances plant water use efficiency and helps plants withstand and better endure various environmental and resource limitations and stresses.” ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11245/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/craig-idso/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.channel4.com/news/exposed-undercover-secrets-of-donald-trump-data-firm-cambridge-analytica\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Exposed: Undercover secrets of Trump’s data firm</a>,” <em>Channel 4 News, </em>March 20, 2018. <a href=\"http://web.archive.org/web/20180414012429/https://www.channel4.com/news/exposed-undercover-secrets-of-donald-trump-data-firm-cambridge-analytica\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived April 13, 2018</a>. Archive.is URL:<a href=\"https://archive.li/AjlMj\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.li/AjlMj</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11788>
        rdf:type                 schema:Claim;
        schema:abstract          "“So, campaigns are normally subject to limits about how much money they can raise.&nbsp;Whereas outside groups can raise an unlimited amount. So the campaign will use their finite resources for things like persuasion and mobilisation and then they leave the ‘air war’ they call it, like the negative attack ads to other affiliated groups.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11788/source/27>;

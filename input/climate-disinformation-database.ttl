        rdf:type         schema:CreativeWork;
        schema:citation  "Steven F. Hayward. “<a href=\"http://web.archive.org/web/20100817162513/http://www.weeklystandard.com/articles/denial\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">In Denial: The meltdown of the climate campaign</a>,” <em>The Weekly Standard</em>, Mar 15, 2010, Vol. 15, No. 25. Archived August 17, 2010. Archived .pdf on file at DeSmog. Archive.is URL: <a href=\"https://archive.is/rcmNK\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/rcmNK</a>"^^rdf:HTML .


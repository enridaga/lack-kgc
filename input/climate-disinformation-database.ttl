        schema:citation  "“<a href=\"http://www.publications.parliament.uk/pa/ld200506/ldselect/ldeconaf/12/5012502.htm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Memorandum by Professor David Henderson, Westminster Business School</a>,” Select Committee on Economic Affairs. Accessed January, 2012 from <a href=\"http://www.parliament.uk\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">www.parliament.uk</a>."^^rdf:HTML .


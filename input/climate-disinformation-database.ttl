<http://data.open.ac.uk/climate-sense/claim/7933/source/7>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s6\"></a> Paul Bachman.&nbsp;<a href=\"https://web.archive.org/web/20210509051623/http://www.beaconhill.org/BHIStudies/ClimateChange/BackgrounderEnergy2008.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Phase II of Florida’s Plan for Energy and Climate Change: Avoiding the Mistakes Made by Others” (PDF)</a>, <em>The James Madison Institute</em>, Backgrounder Number 57 (September, 2008).&nbsp;Archived .pdf&nbsp;on file at&nbsp;DeSmog.&nbsp;"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7933>
        rdf:type                 schema:Claim;
        schema:abstract          "“The national debate on climate change has been marked by vehement disagreement between those who believe that global warming is a severe problem requiring urgent solutions and skeptics who argue that the scientific evidence on climate change remains inconclusive. Only the passage of time and the collection of additional data will settle the issue.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7933/source/7>;

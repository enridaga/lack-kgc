        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2998>
        rdf:type                 schema:Claim;
        schema:abstract          "“This includes undoing one of the worst deals America ever made ― Obama’s Nuclear Agreement with Iran that will eventually let them become a nuclear power and put billions of dollars back into a country that the world’s biggest state sponsor of terrorism.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2998/source/>;

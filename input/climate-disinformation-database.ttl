        rdf:type         schema:CreativeWork;
        schema:citation  "Alan Reynolds. “<a href=\"http://web.archive.org/web/20160412210647/http://dailycaller.com/2016/04/06/climate-change-cant-excuse-electric-car-subsidies/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Change Can’t Excuse Electric Car Subsidies</a>,”&nbsp;<em>The Daily Caller</em>, April 6, 2016. Archived April 12, 2016. Archive.is URL:<a href=\"https://archive.is/gxtJs\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">&nbsp;https://archive.is/gxtJs</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/663>
        rdf:type                 schema:Claim;
        schema:abstract          "“The real reason for all the scandalous regulations and subsidies designed to shove us into underpowered mini-cars has nothing to do with ‘saving the planet.’ &nbsp;It’s all about doling out lucrative gifts (emissions credits, grants and subsides) to politically-favored companies who try to sell us unwanted electric cars or biofuels while the government punishes taxpayers and companies that produce vehicles American consumers really want” — Alan Reynolds, Cato Institute senior fellow.";

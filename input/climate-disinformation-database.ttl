<http://data.open.ac.uk/climate-sense/claim/6395>
        rdf:type                 schema:Claim;
        schema:abstract          "Describing his book, Koonin has claimed: “The impact of human influences on the climate is too uncertain (and very likely too small) compared to the daunting amount of change required to actually achieve the goal of eliminating net global emissions by, say, 2075.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6395/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-koonin/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/steve-koonin/" .


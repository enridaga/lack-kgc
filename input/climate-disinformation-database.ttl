<http://data.open.ac.uk/climate-sense/claim/6786>
        rdf:type                 schema:Claim;
        schema:abstract          "“We might front you the money with low-interest loans, but shouldn’t we get it back when the profits start flowing so we don’t have to incur more debt,” he added.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6786/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-manchin/>;
        schema:claimInterpreter  <http://desmog.com/>;

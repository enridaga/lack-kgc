        rdf:type                 schema:Claim;
        schema:abstract          "“The Chancellor believes that it will cost a trillion pounds, which could otherwise be spent on welfare programmes, health and education; the ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3511/source/23>;

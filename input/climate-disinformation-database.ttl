<http://data.open.ac.uk/climate-sense/claim/13078>
        rdf:type                 schema:Claim;
        schema:abstract          "“Transitions begin and they end. I have been honored to have had the opportunity to serve the Trump Administration, but I have completed as much as I am able. Thus it is time for me to move on […] I wish each of you the best.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13078/source/95>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-schnare/>;

<http://data.open.ac.uk/climate-sense/claim/12679>
        rdf:type                 schema:Claim;
        schema:abstract          "“I vaguely remember responding to a survey as to whether or not the affordability of food for my family was important to me,” one participant said, “But that is far different than setting myself up as an authority on specific genetically engineered crops and authorizing my name for submission on form letters.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12679/source/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Alex Stevenson. “<a href=\"http://web.archive.org/web/20140331011658/https://www.politics.co.uk/comment-analysis/2012/08/30/feature-britain-s-elusive-aviation-strategy\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Feature: Britain’s elusive aviation strategy</a>,” <em>Politics.co.uk</em>, August 30, 2012. Archived March 31, 2014. Archive <span class=\"caps\">URL</span>:&nbsp;<a href=\"http://archive.fo/iRGTA\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/iRGTA</a>"^^rdf:HTML .


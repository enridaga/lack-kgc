<http://data.open.ac.uk/climate-sense/claim/12956>
        rdf:type                 schema:Claim;
        schema:abstract          "It should come as no surprise that Exxon’s scientists discussed the available scientific research at the time and sought to build upon it through their own studies. This free exchange of ideas is essential to productive scientific inquiry. If such deliberations are subject to legal scrutiny through the lens of later baseless allegations, what incentive do companies have to pursue further research?&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12956/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/free-speech-science-project/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/free-speech-science-project/" .


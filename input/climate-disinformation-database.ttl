<http://data.open.ac.uk/climate-sense/claim/6873/source/76>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20231020233033/https://www.arcforum.com/ideas/a-better-story/ARC-Conference-announcement\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The ARC Conference 2023 – SOLD OUT</a>,” <em>ARC</em>. Archived October 20, 2023. Archive URL: <a href=\"https://archive.ph/KpzYf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/KpzYf</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6873>
        rdf:type                 schema:Claim;
        schema:abstract          "“ARC represents a unique opportunity to bring together some of the most influential leaders in politics, business, media, and academia to re-evaluate humanity’s direction of travel and revitalize our vision of what it means to flourish. We are in the middle of an identity crisis, without a common narrative or moral framework, but we aim to draw on our moral, cultural, economic, and spiritual heritage to articulate a better future.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6873/source/76>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-johnson/>;
        schema:claimInterpreter  <http://desmog.com/>;

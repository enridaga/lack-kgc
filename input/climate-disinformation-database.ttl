        rdf:type         schema:CreativeWork;
        schema:citation  "Akshat Rathi and John Ainger. “<a href=\"https://www.bloomberg.com/news/articles/2023-05-23/us-eu-lawmakers-want-al-jaber-out-as-cop28-president?sref=Oz9Q3OZU&amp;leadSource=uverify%20wall\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">More Than 100 US, EU Politicians Want Oil CEO Removed as COP28 Head</a>,” <em>Bloomberg</em>, May 23, 2023. Archived May 25, 2023. Archive URL: <a href=\"https://archive.ph/SN8AO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/SN8AO</a>"^^rdf:HTML .


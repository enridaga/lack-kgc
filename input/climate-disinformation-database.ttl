        rdf:type         schema:CreativeWork;
        schema:citation  "Jim Lakely, Joseph Bast. “<a href=\"http://web.archive.org/web/20140817072036/http://heartland.org/press-releases/2014/03/26/international-gathering-scientists-skeptical-man-caused-global-warming-tak\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">International Gathering of Scientists Skeptical of Man-Caused Global Warming to Take Place in Las Vegas from July 7 to July 9</a>,” Heartland Institute, March 26, 2014. Archived August 17, 2014. Archive.is URL: <a href=\"https://archive.is/LFJvl\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/LFJvl</a>"^^rdf:HTML .


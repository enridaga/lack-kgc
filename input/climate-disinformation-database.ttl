        rdf:type                 schema:Claim;
        schema:abstract          "“Sad to say, despite Pope Francis’s best intentions, the policies he recommends to mitigate global warming would make it far more difficult to overcome poverty. And, ironically, by prolonging and even spreading poverty, those policies would put more of the natural environment at risk.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1578/source/>;

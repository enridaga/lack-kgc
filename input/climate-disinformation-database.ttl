        rdf:type                 schema:Claim;
        schema:abstract          "“When a politician says, concerning an issue involving science, that the debate is over, you may be sure the debate is rolling on and not going swimmingly for his side. Obama is, however, quite right that climate change is a fact. The climate is always changing.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4374/source/10>;

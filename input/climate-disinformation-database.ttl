<http://data.open.ac.uk/climate-sense/claim/12461/source/40>
        rdf:type         schema:CreativeWork;
        schema:citation  "Ross Clark. “<a href=\"https://web.archive.org/web/20221028033053/https://www.spectator.com.au/2022/06/the-truth-about-britains-record-breaking-heatwave/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The truth about Britain’s ‘record-breaking’ heatwave</a>’’, <em>Spectator Australia</em>, June 17, 2022. Archived October 28, 2022. Archive URL: <a href=\"https://archive.ph/rQHkw\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/rQHkw</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12461>
        rdf:type                 schema:Claim;
        schema:abstract          "“The reason we keep having ‘record-breaking heat is not so much because of climate change – although rising global temperatures are slightly increasing the chances of records being broken – but because there are so many records to break.”";

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20181107181835/https://news.sky.com/story/scientists-predict-mini-ice-age-could-hit-uk-by-2030-11186098\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Scientists predict ‘mini ice age’ could hit UK by 2030</a>,” <em>Sky News</em>, December 27, 2017. Archived November 7, 2018. Archive.fo URL: <a href=\"https://archive.fo/z08iU\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/z08iU</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4933>
        rdf:type                 schema:Claim;
        schema:abstract          "&nbsp;“I hope global warning will be overridden by this effect [lower solar magnetic activity], giving humankind and the Earth 30 years to sort out our pollution,” Zharkova said. “We have to be sorted by that time and prepare everything on Earth for the next big solar&nbsp;activity.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4933/source/12>;

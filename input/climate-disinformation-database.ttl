        rdf:type                 schema:Claim;
        schema:abstract          "Rogan: “Is there a point of diminishing returns? Like is there a point where there’s so much CO2 in the atmosphere that then it becomes detrimental?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10581/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-rogan/>;

<http://data.open.ac.uk/climate-sense/claim/8414>
        rdf:type                 schema:Claim;
        schema:abstract          "“I think green energy and the whole war on the agriculture [sic], the voters cannot support this anymore. We’re seeing what’s happening in Sri Lanka, we’re seeing what’s happening in the Netherlands, there’s protests in other countries growing. Canada is following the same line with fertilizer. This is a war against modern civilization, make no mistake about it.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8414/source/>;

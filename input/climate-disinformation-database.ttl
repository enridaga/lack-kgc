        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180321204214/http://www.onlineopinion.com.au/view.asp?article=7352\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">The Greens: illogical and treacherous</a>,”<em>Online Opinion</em>, Dec 5, 2008. Archived March 21, 2018. Archive.is URL: <a href=\"https://archive.is/6W4q8\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/6W4q8</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7693>
        rdf:type                 schema:Claim;
        schema:abstract          "“The 2020 summit exposed the hypocritical, illogical and treacherous nature of most people in the modern green movement. It has been hijacked by a quasi religious ideology which makes it ineffective at solving the big problems we face. The environment is suffering as a result.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7693/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ridd/>;

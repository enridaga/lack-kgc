        schema:citation  "“<a href=\"https://torontolife.com/city/qa-jeff-ballingall-founder-of-ontario-proud-on-his-right-wing-meme-machine/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Q&amp;A: Jeff Ballingall, founder of Ontario Proud, on his right-wing meme machine</a>,” <em>Toronto Life</em>, October 7, 2019. <a href=\"https://web.archive.org/web/20210215180111/https://torontolife.com/city/qa-jeff-ballingall-founder-of-ontario-proud-on-his-right-wing-meme-machine/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived June 29, 2022</a>. Archive URL: <a href=\"https://archive.ph/KTZ34\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/KTZ34</a>"^^rdf:HTML .


<http://data.open.ac.uk/climate-sense/claim/13088>
        rdf:type                 schema:Claim;
        schema:abstract          "“Today, maybe I’m a scientist, but I’m also a lawyer, and when I left the [Environmental Protection] Agency someone asked me and said ‘well, what are you going to do?’ and, I said, ‘I’m going to sue the agency,’ and they went, ‘oh no.’ And so, [since then] we have [sued]…”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13088/source/53>;

<http://data.open.ac.uk/climate-sense/claim/3152>
        rdf:type                 schema:Claim;
        schema:abstract          "“[T]he real-world effects of atmospheric CO2 enrichment are absolutely essential to enable us to adequately feed and sustain the human population of the planet that is expected to inhabit the earth a mere 35 years from now, while at the same time being able to enjoy better health and resultant longevity. Is not this the moral course we all should be pursuing?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3152/source/67>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/center-study-carbon-dioxide-and-global-change/>;

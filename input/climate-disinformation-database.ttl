        rdf:type                 schema:Claim;
        schema:abstract          "“Stopping the next ice age appears to be well within our technical capability and carries a huge benefit-to-cost ratio. An investment of millions would prevent the loss of trillions of dollars.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5473/source/17>;

<http://data.open.ac.uk/climate-sense/claim/12920>
        rdf:type                 schema:Claim;
        schema:abstract          "“Even attempting to implement the Green New Deal would be incredibly disruptive and unimaginably expensive—not to mention impossible,” some of the ads read.";

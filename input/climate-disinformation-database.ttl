<http://data.open.ac.uk/climate-sense/claim/12587>
        rdf:type                 schema:Claim;
        schema:abstract          "Expect a Green New Deal aiming to outlaw fossil-fuel usage to be a police state too, with self-interested actions towards cheaper, more reliable energies thwarting the central planners from Washington, D.C.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12587/source/14>;

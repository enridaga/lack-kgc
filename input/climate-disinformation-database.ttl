<http://data.open.ac.uk/climate-sense/claim/7751>
        rdf:type                 schema:Claim;
        schema:abstract          "“The warming period from ~1970 to ~2000 was sandwiched between the cooling periods of ~1940 to ~1970 and ~2000 to the present. The changes between these warming and cooling periods coincide with phase reversals of the Atlantic Multidecadal Oscillation (AMO) and, therefore, it seems that the present lack of warming is likely to continue for the next two decades.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7751/source/12>;

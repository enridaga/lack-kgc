        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=fqv83JrM58Q\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Who is Department of Energy Nominee Chris Wright? | Real Talk</a>,” YouTube video uploaded by user “PragerU,” April 19, 2023. Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7149>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate is changing, well it’s always changing because of natural forces, but human impacts today are definitely significant enough that they are additive. They are a meaningful force in and of themselves driving changes in the climate. So we should be concerned about it. We should be focused on it. We should be studying it.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7149/source/43>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/chris-wright/>;

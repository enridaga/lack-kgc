<http://data.open.ac.uk/climate-sense/claim/1249>
        rdf:type                 schema:Claim;
        schema:abstract          "“Extreme caution, even skepticism, is warranted in any statement about the climate given the decades of failed and overreaching forecasts and hyperbole from official and interested sources. Beyond individual prudent stewardship, no Catholic is obliged to support any environmental measure.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1249/source/36>;

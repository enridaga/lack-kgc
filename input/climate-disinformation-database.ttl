        rdf:type         schema:CreativeWork;
        schema:citation  "David Bernhardt. “<a href=\"http://web.archive.org/web/20181218034121/https://www.washingtonpost.com/opinions/at-interior-were-ready-to-bring-the-endangered-species-act-up-to-date/2018/08/09/2775cd8e-9a96-11e8-b55e-5002300ef004_story.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">At Interior, we’re ready to bring the Endangered Species Act up to date</a>,” <em>The Washington Post</em>, August 9, 2018. Archived December 18, 2018. Archive.fo: <a href=\"https://archive.fo/08ix2\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/08ix2</a>"^^rdf:HTML .


        rdf:type                 schema:Claim;
        schema:abstract          "“The real game, I believe, is actually a coup of sorts by large corporations working with like large businesses to drive an agenda that’s not in the best interests of the American people or the world, for the simple reason of profits and control,” he concluded. ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9832/source/>;

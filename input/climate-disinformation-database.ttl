        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://hansard.parliament.uk/commons/2009-11-05/debates/09110556000001/ClimateChange\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Change</a>,” House of Commons Hansard Vol. 498 (November 5, 2009). <a href=\"http://web.archive.org/web/20181229231002/https://hansard.parliament.uk/commons/2009-11-05/debates/09110556000001/ClimateChange\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived December 29, 2018</a>. Archive.fo URL: <a href=\"https://archive.fo/2Sxji\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/2Sxji</a>"^^rdf:HTML .


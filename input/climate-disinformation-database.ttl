<http://data.open.ac.uk/climate-sense/claim/8888>
        rdf:type                 schema:Claim;
        schema:abstract          "“What started off as a good idea, a protection of the habitat of a special bear, that idea has morphed and become a great trade barrier. Something is being protected here, and it’s not the bear.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8888/source/54>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vivian-m-krause/>;

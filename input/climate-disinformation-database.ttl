<http://data.open.ac.uk/climate-sense/claim/11809/source/28>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.rollcall.com/news/shutdown-trump-fossil-fuel-agenda\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Shutdown ties up Trump’s fossil fuel agenda</a>,” <em>Roll Call, </em>January 10, 2019. <a href=\"http://web.archive.org/web/20190115002609/http://www.rollcall.com/news/shutdown-trump-fossil-fuel-agenda\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 14, 2019</a>. Archive.fo URL: <a href=\"https://archive.fo/rmuyS\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/rmuyS</a>"^^rdf:HTML .


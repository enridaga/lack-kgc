<http://data.open.ac.uk/climate-sense/claim/1974/source/20>
        rdf:type         schema:CreativeWork;
        schema:citation  "Steven F. Hayward. “<a href=\"http://www.weeklystandard.com/articles/why-climate-skeptics-are-winning_631915.html?page=1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Why the Climate Skeptics Are Winning</a>,” <em>The Weekly Standard</em>, Mar 5, 2012, Vol. 17, No. 24. Archived .pdf on file at DeSmog. Archive.is URL: <a href=\"https://archive.is/IVBZx\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/IVBZx</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1974>
        rdf:type                 schema:Claim;
        schema:abstract          "“As with Three Mile Island, the hysteria of the media and the political class over the Deepwater spill is likely to lead to increased risk and adverse environmental tradeoffs.”";

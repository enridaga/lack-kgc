<http://data.open.ac.uk/climate-sense/claim/6194>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate is changing, always has and most likely always will until that thermonuclear engine in the sky, the sun, goes out,” England said by email.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6194/source/8>;

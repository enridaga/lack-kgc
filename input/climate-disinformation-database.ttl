        rdf:type                 schema:Claim;
        schema:abstract          "“Look, I don’t know. I’m in a lot of books from the 1990s from those coal advocacy days. Whatever people have said, they’ve said. I’m not going to go there. I don’t know the reference or the context.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9214/source/57>;

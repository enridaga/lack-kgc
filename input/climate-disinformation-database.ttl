<http://data.open.ac.uk/climate-sense/claim/2203/source/44>
        rdf:type         schema:CreativeWork;
        schema:citation  "Connie Hair. “<a href=\"http://humanevents.com/2010/07/13/obama-defies-court-with-second-moratorium/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Obama Defies Court with Second Moratorium</a>,”&nbsp;<em>Human Events</em>, July 13, 2010.&nbsp;<a href=\"http://web.archive.org/web/20161221021447/http://humanevents.com/2010/07/13/obama-defies-court-with-second-moratorium/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived December 21, 2016</a>. Archive.is&nbsp;URL:&nbsp;<a href=\"https://archive.is/wmdFR\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/wmdFR</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2203>
        rdf:type                 schema:Claim;

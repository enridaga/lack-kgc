<http://data.open.ac.uk/climate-sense/claim/11738/source/19>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20190524004413/https://www.politico.com/story/2015/12/koch-brothers-network-gop-david-charles-217124\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">How the Koch network rivals the GOP</a>,” <em>Politico</em>, December 30, 2015. Archived May 24, 2019. Archive.fo URL: <a href=\"https://archive.fo/CCoJp\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/CCoJp</a>"^^rdf:HTML .


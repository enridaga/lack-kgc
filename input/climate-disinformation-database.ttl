<http://data.open.ac.uk/climate-sense/claim/4979/source/32>
        rdf:type         schema:CreativeWork;
        schema:citation  "Julian Morris. “<a href=\"http://www.ocregister.com/articles/climate-713078-related-technologies.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate pact likely to do more harm than good</a>,” <em>The Orange County Register</em>, April 22, 2016. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4979>
        rdf:type                 schema:Claim;
        schema:abstract          "“[B]y slowing down the rate of innovation and economic growth across the world, it could seriously hinder adaptation. And those consequences could be dire, especially for the poor who currently suffer most from climate-related problems,” Morris writes.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4979/source/32>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/reason-foundation/>;

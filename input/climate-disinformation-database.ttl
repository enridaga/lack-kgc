        rdf:type                 schema:Claim;
        schema:abstract          "“Abundant, affordable, reliable energy, most of it now and in the foreseeable future provided by burning fossil fuels, which are the primary source of CO2 emissions, is indispensable to lifting and keeping people out of poverty.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3211/source/16>;

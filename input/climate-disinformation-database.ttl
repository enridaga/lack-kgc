        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4714>
        rdf:type                 schema:Claim;
        schema:abstract          "“I think it was best summarised by Bjorn Lomborg, the Danish statistician, who said something like, ‘yes, climate change is a problem, yes it is man-made, yes we should do something about it. But is it the end of the world?&nbsp;No.’”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4714/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/institute-economic-affairs/>;

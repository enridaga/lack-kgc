        rdf:type                 schema:Claim;
        schema:abstract          "There are other groups that are interested in the issue of global warming and the concerns about its costs. Koch Industries is working with other large corporations, including ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10766/source/8>;

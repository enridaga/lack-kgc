        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2642>
        rdf:type                 schema:Claim;
        schema:abstract          "[…] There has been virtually no warming over the past two decades. […] the warming is less than the IPCC is predicting, an they’re calling it the global warming ‘hiatus’. You can all Google it and see that, for them, it is something which is unexplainable.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2642/source/>;

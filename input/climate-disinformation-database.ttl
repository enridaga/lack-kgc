        rdf:type                 schema:Claim;
        schema:abstract          "“Binnion, who tried unsuccessfully to launch a fracking industry in Quebec, is reported to have raised money for Quebec Fier, a similar Quebec Facebook group that runs ads attacking federal and provincial Liberals. Binnion is on the board of the Manning Centre.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11588/source/>;

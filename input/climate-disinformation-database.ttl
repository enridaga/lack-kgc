        rdf:type                 schema:Claim;
        schema:abstract          "As a super PAC, [America Rising]&nbsp;will focus on digital campaigns and placing negative stories about Democrats in the news media. It does not plan to run television&nbsp;ads.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12681/source/>;

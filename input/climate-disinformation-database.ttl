<http://data.open.ac.uk/climate-sense/claim/10052/source/3>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s3\" name=\"s3\" href=\"https://www.amazon.com/Radicals-Capitalism-Freewheeling-American-Libertarian/dp/1586483501\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"><em>Radicals for Capitalism: A Freewheeling History of the Modern American Libertarian Movement</em></a>. Brian Doherty, February 12, 2007. P. 603."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10052>
        rdf:type                 schema:Claim;
        schema:abstract          "“I would never attempt to second-guess whatever he’s doing in the interest of making this a free country. He has a strategy that probably we are unaware of. He’s so smart and so successful that I’m just going to await the outcome.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10052/source/3>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-h-padden/>;

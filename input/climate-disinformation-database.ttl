<http://data.open.ac.uk/climate-sense/claim/8510>
        rdf:type                 schema:Claim;
        schema:abstract          "“We’ve just learned recently that there hasn’t been any for 15 years, even according to the people who are trying to whip up as big a frenzy as possible.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8510/source/23>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/philip-davies/>;

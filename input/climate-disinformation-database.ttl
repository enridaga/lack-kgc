        rdf:type         schema:CreativeWork;
        schema:citation  "Kevin Williamson. “<a href=\"https://web.archive.org/web/20210518173236/https://www.nationalreview.com/2019/12/climate-change-celebrity-activist-hypocrisy/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Do Celebrities Really Buy the Climate-Change Story?</a>” <em>National Review</em>, December 29, 2019. Archived May 18, 2021. Archive URL: <a href=\"https://archive.ph/izRfh\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/izRfh</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12248>
        rdf:type                 schema:Claim;
        schema:abstract          "“What they act like is people who want power. Because that is what they are.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12248/source/13>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kevin-d-williamson/>;

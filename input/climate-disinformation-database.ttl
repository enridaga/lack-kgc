        rdf:type         schema:CreativeWork;
        schema:citation  "Jennifer Marohasy. “<a href=\"https://web.archive.org/web/20181112174746/https://www.spectator.com.au/2017/07/price-of-electricity-is-rising-not-sure-about-temperatures/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Price of electricity is rising, not sure about temperatures</a>,” <em>The Spectator</em>, July 13, 2017. Archived November 12, 2018. Archive.is <span class=\"caps\">URL</span>:&nbsp;<a href=\"http://archive.is/lXPto\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/lXPto</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5459>
        rdf:type                 schema:Claim;
        schema:abstract          "“Because the masses believe that global atmospheric temperatures are rising unnaturally – the Hazelwood coal-fired power station was decommissioned, and the price of electricity is surging across Australia. The evidence, however, for a rise in global temperatures is actually not that compelling – unless you believe the output from computer models. … So, I have always thought, once this obsession with catastrophic global warming eventually comes to an end (as surely it must), we will be able to start over, with the real data.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5459/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jennifer-marohasy/>;

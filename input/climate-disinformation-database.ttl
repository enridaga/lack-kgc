<http://data.open.ac.uk/climate-sense/claim/3464/source/60>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20170226002742/http://fuelingfreedomproject.com/tppfs-doug-domenech-testifies-in-support-of-interstate-power-compact/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">TPPF’s Doug Domenech Testifies in Support of Interstate Power Compact</a>,” <em>Texas Public Policy Foundation</em>, January 26, 2016. Archived February 26, 2017. Archive.is URL: <a href=\"https://archive.is/E61ci\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/E61ci</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3464>
        rdf:type                 schema:Claim;
        schema:abstract          "“There are significant legal, technical, and policy deficiencies to the so-called Clean Power Plan and this legislation provides important safeguards for Missouri,” said Domenech. “Missouri will be significantly impacted by the CPP’s carbon emission rule since 83 percent of Missouri’s electricity is produced by low cost coal and the EPA is demanding the state reduce emissions by 37 percent. It is high time for states to coordinate a response to this EPA overreach and this is exactly what the Interstate Power Compact does.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3464/source/60>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/doug-domenech/" .

<http://data.open.ac.uk/climate-sense/claim/3463/source/62>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s29\" href=\"http://web.archive.org/web/20170226014653/http://www.texaspolicy.com/library/doclib/Clean-Power-Plan-Article-Reprint-DougDomenech.pdf\" name=\"s29\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“The EPA’s Clean Power Plan Will Hurt the Poor and Middle Class the Most” (PDF)</a>, <em>Green Watch</em>, March 23, 2016. Retrieved from Texas Public Policy Foundation."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3463>
        rdf:type                 schema:Claim;
        schema:abstract          "“The elite can afford higher energy costs. But people on fixed incomes, and lower- and middle-income families (including many African Americans and Latinos/Hispanics), and businesses that provide jobs to working class people—they need energy that’s affordable. For many of them, the choice is between the CPP […] and keeping the lights on,” Domenech concludes in the report.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3463/source/62>;

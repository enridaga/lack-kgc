        rdf:type                 schema:Claim;
        schema:abstract          "“Setting unrealistic climate goals risks making poor policy choices that lead to unwanted outcomes for both the economy and the environment,” Cross suggested.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12080/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/macdonald-laurier-institute/>;

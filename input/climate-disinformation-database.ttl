<http://data.open.ac.uk/climate-sense/claim/10684/source/28>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s17\" href=\"http://web.archive.org/web/20170825033136/http://www.lavoisier.com.au/articles/climate-policy/science-and-policy/Government-Submission-2020-emissions-reductions-ltr.pdf\" name=\"s17\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Submissions for Australia’s post -2020 emissions reduction target” (PDF)</a>, <em>The Climate Study Group</em>. Retrieved from Lavoisier.com.au."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10684>
        rdf:type                 schema:Claim;
        schema:abstract          "“In the context of the analysis in this submission of psychological research and new revelations of how bias can affect decision making, the Authors of this submission recommend the case for reduction of CO2 emissions is not well founded and certainly no Australian post-2020 emissions reduction target could be justified.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10684/source/28>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/lavoisier-group/>;

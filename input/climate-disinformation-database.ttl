<http://data.open.ac.uk/climate-sense/claim/13250/source/33>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20171228221908/https://mises.org/library/fairy-tale-austrian-movement\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">A Fairy Tale of the Austrian Movement</a>,” <em>MisesInstitute</em>, September 25, 2007. Archived December 28, 2017. Archive.is URL: <a href=\"https://archive.is/PeGdD\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/PeGdD</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13250>
        rdf:type                 schema:Claim;
        schema:abstract          "“If we’re going to give a lot of money, we’ll make darn sure they spend it in a way that goes along with our intent. And if they make a wrong turn and start doing things we don’t agree with we withdraw funding. We do exert that kind of control.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13250/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-koch/>;

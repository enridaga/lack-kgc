<http://data.open.ac.uk/climate-sense/claim/9461>
        rdf:type                 schema:Claim;
        schema:abstract          "“But the life-saving value of industrial capitalism is profoundly unappreciated in today’s culture. This is not merely because people have forgotten or ignored its history, but because its opponents have actively sought to bury and distort that history.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9461/source/11>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ayn-rand-institute/>;

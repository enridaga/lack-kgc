<http://data.open.ac.uk/climate-sense/claim/12427>
        rdf:type                 schema:Claim;
        schema:abstract          "“There is no evidence that climate change has caused an increase in disease. If the main causes of diseases such as diarrhoea and malaria are properly addressed, climate change will not increase their&nbsp;incidence.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12427/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/civil-society-coalition-climate-change/>;

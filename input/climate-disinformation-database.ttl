        schema:citation  "“<a href=\"https://web.archive.org/web/20200715154842/https:/www.tfa.net/the_journal_of_the_freedom_association\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The journal of the Freedom Association</a>,” <em>Freedom Association</em>. Archived July 15, 2020. Archive.fo URL: <a href=\"http://archive.fo/4nC52\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/4nC52</a>"^^rdf:HTML .


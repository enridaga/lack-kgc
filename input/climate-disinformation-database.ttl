        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10708>
        rdf:type                 schema:Claim;
        schema:abstract          "Svensmark: “I believe there’s no doubt that CO2 is a greenhouse gas. […] So there’s no doubt that CO2 is also affecting climate, but it looks as if that the climate sensitivity to CO2 is probably smaller because the sun is also part of what is going on. […] “";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10708/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/henrik-svensmark/>;

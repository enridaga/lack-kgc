<http://data.open.ac.uk/climate-sense/claim/4051/source/32>
        rdf:type         schema:CreativeWork;
        schema:citation  "“‘<a href=\"https://www.washingtonpost.com/news/acts-of-faith/wp/2017/06/07/this-is-what-happens-in-war-gop-congressman-defends-call-for-killing-radical-muslims/?utm_term=.d55a244ca7df\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">This is what happens in war’: GOP congressman defends call for killing radical Muslims</a>,” <em>The Washington Post, </em>June 7, 2017. <a href=\"http://web.archive.org/web/20181019174946/https://www.washingtonpost.com/news/acts-of-faith/wp/2017/06/07/this-is-what-happens-in-war-gop-congressman-defends-call-for-killing-radical-muslims/?utm_term=.d55a244ca7df\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived October 19, 2018</a>. Archive.fo URL: <a href=\"https://archive.fo/zyDlm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/zyDlm</a>"^^rdf:HTML .


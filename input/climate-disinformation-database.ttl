<http://data.open.ac.uk/climate-sense/claim/10264>
        rdf:type                 schema:Claim;
        schema:abstract          "Second, the “warming” from CO2 — and yes, CO2 is a ‘greenhouse gas’ — has been much less than predicted by the climate models Obama bases his policies on. For 20 years, the temperature has been virtually unchanged, in stark contrast to model predictions.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10264/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rodney-nichols/>;

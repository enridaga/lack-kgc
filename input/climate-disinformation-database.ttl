<http://data.open.ac.uk/climate-sense/claim/4671>
        rdf:type                 schema:Claim;
        schema:abstract          "So Paris does indeed mark a historic turning point. It is the moment when the political panic over climate change finally begins to collide with inescapable realities.”";

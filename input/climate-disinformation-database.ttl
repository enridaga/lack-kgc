        rdf:type                 schema:Claim;
        schema:abstract          "“Institute of Public Affairs economist Alan Moran said Australia would earn massive and steady income by offering to solve the problem of a permanent home for the world’s nuclear waste.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1013/source/25>;

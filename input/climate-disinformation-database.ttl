        rdf:type                 schema:Claim;
        schema:abstract          "“We’ll offer a large amount of money to the candidate, to finance his campaign in exchange for land for instance, we’ll have the whole thing recorded, we’ll blank out the face of our guy and we post it on the Internet,” Nix said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11789/source/31>;

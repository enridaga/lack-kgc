        rdf:type                 schema:Claim;
        schema:abstract          "“Misguided opposition to biotechnology, fossil fuels and increased atmospheric carbon dioxide could very well condemn millions of people to malnutrition and starvation, and numerous wildlife species to extinction.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5720/source/12>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/hudson-institute/>;

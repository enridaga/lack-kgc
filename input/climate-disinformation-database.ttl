        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4698>
        rdf:type                 schema:Claim;
        schema:abstract          "“Critics of the conventional view that science ‘proves’ that, given present policies, damaging global warming will occur as a consequence of human actions frequently warn that this view is leading towards adoption of a new secular religion, of a pronounced ascetic character. […] [S]upporters of the damaging climate change hypothesis fervently advocate stringent government measures to reduce greenhouse gas emissions which would have a serious impact on individual&nbsp;freedom.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4698/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/institute-economic-affairs/>;

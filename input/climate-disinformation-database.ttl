<http://data.open.ac.uk/climate-sense/claim/6966>
        rdf:type                 schema:Claim;
        schema:abstract          "“Although global warming alarmists believe carbon dioxide and other man-made greenhouse gases contribute to global warming, they’ve never documented that case with hard science. In fact, ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6966/source/11>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/60-plus-association/>;

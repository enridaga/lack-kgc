        rdf:type                 schema:Claim;
        schema:abstract          "“National conservatism is not the whole story. But it can be an important part of conservatism for post-Brexit Britain – helping us govern our nation in a tried and tested conservative way. The Conservative Party should embrace it, and draw strength from it, not push it aside.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10410/source/32>;

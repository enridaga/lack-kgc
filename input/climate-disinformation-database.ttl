<http://data.open.ac.uk/climate-sense/claim/11964>
        rdf:type                 schema:Claim;
        schema:abstract          "“We have to move away from arbitrary emission reduction targets. For too many years, we have been told an environmental collapse is imminent, but the predictions time and time again have been proven false.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11964/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/coalition-of-concerned-manufacturers-and-businesses-canada/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20190410172739/https://www.heartland.org/news-opinion/news/press-release-anthony-watts-joins-the-heartland-institute\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">PRESS RELEASE: ANTHONY WATTS JOINS THE HEARTLAND INSTITUTE,</a>” <em>The Heartland Institute</em>, April 5, 2019. Archived April 10, 2019. Archive.fo URL: <a href=\"https://archive.fo/KIoIz\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/ KIoIz</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2397>
        rdf:type                 schema:Claim;
        schema:abstract          "“Laughably, my critics have said for years that I have been ‘on the payroll’ of Heartland in some ‘nefarious capacity,’ even though I’ve never been on their payroll. I figure I might as well give these folks something factual to talk about now instead of just innuendo and smear campaigns,” Watts&nbsp;said.";

<http://data.open.ac.uk/climate-sense/claim/13131/source/34>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=EuluabwCikw\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Myron Ebell Discusses Trump’s Paris Climate Agreement Decision on CNN</a>,” YouTube video uploaded by user Competitive Enterprise Institute. Archived .mp4 on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13131>
        rdf:type                 schema:Claim;
        schema:abstract          "“We have a moral responsibility to prevent the energy poverty that is part of the Paris Climate Treaty. This agreement will cost the world over a trillion dollars a year and its effects on the climate are&nbsp;imperceptible.”";

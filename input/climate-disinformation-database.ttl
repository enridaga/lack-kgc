<http://data.open.ac.uk/climate-sense/claim/12437/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "Ross Clark. “<a href=\"https://www.spectator.co.uk/article/don-t-blame-all-weird-weather-on-climate-change\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Don’t blame all ‘weird’ weather on climate change</a>,”&nbsp;<em>Spectator</em>, December 3, 2019.&nbsp;<a href=\"http://archive.fo/JNlya\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived April 3, 2020</a>. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12437>
        rdf:type                 schema:Claim;
        schema:abstract          "b0";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12437/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ross-clark/>;
        schema:claimInterpreter  <http://desmog.com/>;

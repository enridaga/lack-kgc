<http://data.open.ac.uk/climate-sense/claim/10263>
        rdf:type                 schema:Claim;
        schema:abstract          "We support the cost-effective control of real pollutants associated with the use of fossil fuels — for example, fly ash, oxides of nitrogen and sulfur or smog-forming volatile hydrocarbons. But CO2 isn’t a pollutant, and there’s no reason to control it.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10263/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rodney-nichols/>;

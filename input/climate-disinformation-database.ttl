<http://data.open.ac.uk/climate-sense/claim/7700/source/17>
        rdf:type         schema:CreativeWork;
        schema:citation  "Peter Ridd. “<a href=\"https://web.archive.org/web/20160307073542/http://www.onlineopinion.com.au/view.asp?article=6134\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Great Great Barrier Reef Swindle</a>,” <em>The National Forum</em>, July 19, 2007. Archived March 7, 2016. Archive.is URL:<a href=\"https://archive.is/OmGJv\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.is/OmGJv</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7700>
        rdf:type                 schema:Claim;
        schema:abstract          "“Corals are particularly well adapted to temperature changes and in general, the warmer the better. It seems odd that coral scientists are worrying about global warming because this is one group of organisms that like it hot. Corals are most abundant in the tropics and you certainly do not find fewer corals closer to the equator. Quite the opposite, the further you get away from the heat, the worse the corals. A cooling climate is a far greater threat.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7700/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ridd/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/peter-ridd/" .

<http://data.open.ac.uk/climate-sense/claim/7699/source/17>
        rdf:type         schema:CreativeWork;
        schema:citation  "Peter Ridd. “<a href=\"https://web.archive.org/web/20160307073542/http://www.onlineopinion.com.au/view.asp?article=6134\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Great Great Barrier Reef Swindle</a>,” <em>The National Forum</em>, July 19, 2007. Archived March 7, 2016. Archive.is URL:<a href=\"https://archive.is/OmGJv\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.is/OmGJv</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7699>
        rdf:type                 schema:Claim;
        schema:abstract          "“In fact a more appropriate creature with which to compare corals would be cockroaches – at least for their ability to survive. ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7699/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ridd/>;

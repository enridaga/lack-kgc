        rdf:type                 schema:Claim;
        schema:abstract          "“[T’he evidence does not show that the increase in CO2 levels attributed to human activity is responsible for a measured rise in global temperature, or, for that matter, that a warmer climate, if it did occur, poses the threat of an environmental catastrophe.”";

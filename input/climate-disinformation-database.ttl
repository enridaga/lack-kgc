        rdf:type                 schema:Claim;
        schema:abstract          "“Tax lawyers say this arrangement may violate Internal Revenue Service rules that prohibit executives from profiting off the tax-exempt entities they run. IRS rules also require charities to have a public purpose,”&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2656/source/31>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/center-organizational-research-and-education-core/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.epw.senate.gov/public/index.cfm/2007/10/post-dcf7413b-802a-23ad-4e94-b596f085a13b\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Part 2: 2007: Global Warming Alarmism Reaches A Tipping Point</a>,” <em>U.S. Senate Committee on Environment &amp; Public Works</em>, October 26, 2007. <a href=\"https://archive.fo/tQX9i\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived September 23, 2020</a>. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3498>
        rdf:type                 schema:Claim;
        schema:abstract          "Giegengack said: ‘[Gore] claims that temperature increases solely because more CO2 in the atmosphere traps the sun’s heat. That’s just wrong … It’s a natural interplay.’ He continued, ‘It’s hard for us to say that CO2 drives temperature. It’s easier to say temperature drives CO2.’";

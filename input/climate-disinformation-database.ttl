<http://data.open.ac.uk/climate-sense/claim/9765/source/10>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20150630193916/http://www.nationalbcc.org/news/beyond-the-rhetoric/1623-environmental-racism-global-warming-and-climate-change\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Environmental Racism, Global Warming and Climate Change</a>,” National Black Chamber of Commerce. Archived June 30, 2015."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9765>
        rdf:type                 schema:Claim;
        schema:abstract          "“Certainly the climate changes as time goes on – sometimes for the better and sometimes for the worse. So far, there is no pattern that seems to be very detrimental to our earth. There is an ebb and flow and it takes time to see any significant detrimental trend. It is like Stevie Wonder wrote, ‘When you believe in things you don’t understand; you suffer. Superstition ain’t the way’.” – ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9765/source/10>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/harry-c-alford/>;

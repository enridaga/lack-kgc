        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3240>
        rdf:type                 schema:Claim;
        schema:abstract          "“In the short run, when you look at this winter and the energy costs that we face, no. But in the longer run it’s water under the bridge, we’re going towards net zero.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3240/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-baker/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/steve-baker/" .

<http://data.open.ac.uk/climate-sense/claim/3239/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3239>
        rdf:type                 schema:Claim;
        schema:abstract          "“I am deeply concerned about climate change and how we deal with it, about resource depletion, about population growth and about the problem of how to improve the lot of the world’s desperately poor, but I am most concerned about bad economics. […] What we need today more than urgent action on climate change is a paradigm shift in economic thinking. ”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3239/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-baker/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/steve-baker/" .

<http://data.open.ac.uk/climate-sense/claim/3238/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3238>
        rdf:type                 schema:Claim;
        schema:abstract          "“Interested as I am as a chartered aerospace engineer who used to work on thermodynamics, with an MSc in computer science, capable of understanding models – fascinated as I am, I am not having that conversation about the science. But I have to say, the science is sometimes propagandised.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3238/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-baker/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/steve-baker/" .

<http://data.open.ac.uk/climate-sense/claim/3237/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3237>
        rdf:type                 schema:Claim;
        schema:abstract          "“A lot of the science is absolutely settled. Carbon dioxide is a greenhouse gas. We’ve emitted plenty of it. That will have contributed to climate change. Lots of it is actually still contestable, but that’s not really the point.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3237/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-baker/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20151004001433/http://news.heartland.org/newspaper-article/2015/07/14/global-warming-policies-reflect-false-assumptions-panelists-say\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Global Warming Policies Reflect False Assumptions, Panelists Say</a>,”&nbsp;<em>The Heartlander</em>, July 14, 2015. Archived October 3, 2015. Archive URL: <a href=\"https://archive.ph/3pPfO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/3pPfO</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3151>
        rdf:type                 schema:Claim;
        schema:abstract          "“No attempt was made by [FIWG] to calculate or even acknowledge the existence of multiple, well-established ‘carbon’ benefits,” said Idso. “In order to be valid, a benefit-cost analysis must examine and include not only the costs but any benefits as well. Such negligence and prejudicial imbalance is stunning. It is inexcusable. It is scientifically fraudulent. And it is borderline criminal.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3151/source/65>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/center-study-carbon-dioxide-and-global-change/>;

<http://data.open.ac.uk/climate-sense/claim/153/source/44>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160526182537/http://www.robertbryce.com/articles/534-u-s-senate-testimony-killing-wildlife-in-the-name-of-climate-change\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">U.S. Senate Testimony: Killing Wildlife in the Name of Climate Change</a>,” RobertBryce.com, February 25, 2014. Archived May 26, 2016. Archive URL: <a href=\"https://archive.ph/D0yiY\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/D0yiY</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/153>
        rdf:type                 schema:Claim;
        schema:abstract          "The question at hand is obvious: why are policymakers implementing an energy policy that is a known killer of wildlife in exchange for what are infinitesimally small reductions in carbon dioxide emissions?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/153/source/44>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/robert-bryce/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/robert-bryce/" .

<http://data.open.ac.uk/climate-sense/claim/152/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/152>
        rdf:type                 schema:Claim;
        schema:abstract          "“Given the studies already done on wind energy’s deleterious impact on wildlife, combined with the ‘energy sprawl’&nbsp;that will come with the industry’s continuing expansion, it is virtually certain that as the wind sector adds more turbines, more federally protected wildlife – including more bald eagles, an animal that has been on the Great Seal of the United States since 1782 – will be killed.[xl] And thanks to the production tax credit, taxpayers will be subsidizing the&nbsp;slaughter.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/152/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/robert-bryce/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/robert-bryce/" .

<http://data.open.ac.uk/climate-sense/claim/151/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/151>
        rdf:type                 schema:Claim;
        schema:abstract          "“But if developing countries are going to prepare for possible changes in the climate, they will have to get richer so they can afford to deal with any calamities that may occur. And how will they get richer? The answer is obvious: by consuming more energy. And for countries throughout the developing world, the lowest-cost energy is still coal,” Bryce writes.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/151/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/robert-bryce/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/robert-bryce/" .

<http://data.open.ac.uk/climate-sense/claim/150/source/38>
        rdf:type         schema:CreativeWork;

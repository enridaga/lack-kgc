<http://data.open.ac.uk/climate-sense/claim/10631>
        rdf:type                 schema:Claim;
        schema:abstract          "“CFACT is committed to educating the public and exposing global warming for what it truly is — a massive redistribution scheme. This scheme is not designed to strengthen the U.S. economy, but to throttle it down.”";

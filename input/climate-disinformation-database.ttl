        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/craig-idso/" .

<http://data.open.ac.uk/climate-sense/claim/11269/source/31>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://alecclimatechangedenial.org/climate-denier-speakers-1/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Their Speakers</a>,” alecclimatechangedenial.org. <a href=\"http://web.archive.org/web/20160816032459/http://alecclimatechangedenial.org/climate-denier-speakers-1/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived August 16, 2016</a>. Archive.is URL: <a href=\"https://archive.is/9Diev\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/9Diev</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11269>
        rdf:type                 schema:Claim;
        schema:abstract          "“CO2 is not a pollutant. It is a benefit. It is the very elixer of life.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11269/source/31>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/craig-idso/>;
        schema:claimInterpreter  <http://desmog.com/>;

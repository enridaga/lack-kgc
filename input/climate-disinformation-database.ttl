<http://data.open.ac.uk/climate-sense/claim/4392>
        rdf:type                 schema:Claim;
        schema:abstract          "“We have been blessed in this country with very large gas reserves. Why on earth would you be importing gas which everybody accepts has to be part of the energy mix, no matter if you’re fully onto net zero or not. We have those reserves, for heavens sake let’s use them.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4392/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/craig-mackinlay/>;

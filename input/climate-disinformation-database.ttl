<http://data.open.ac.uk/climate-sense/claim/2063>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Earth’s climate has changed many times with many cooling phases and many warming phases. The Earth’s current modest warming trend (less than 1 degree C over 100 years), is well within historical norms.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2063/source/8>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/frontiers-freedom/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Arthur Rörsch. “Guest Editorial” (<a href=\"http://www.eike-klima-energie.eu/uploads/media/EE_21-4_paradigm_shift_output_limited_3_Mb.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">PDF</a>), <em>Energy &amp; Environment</em>, Vol. 21, No. 4 (2010)."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2098>
        rdf:type                 schema:Claim;
        schema:abstract          "“Doubts about the mainstream ‘CO2-paradigm’ arise because there is so little evidence from direct observations to support the framework that has been constructed from computer model studies/experiments. This alone should be a sufficient reason for the scientific world to consider alternative paradigms.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2098/source/2>;

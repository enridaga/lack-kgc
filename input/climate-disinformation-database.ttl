        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.canada.com/nationalpost/financialpost/story.html?id=3711460e-bd5a-475d-a6be-4db87559d605\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Open Kyoto to debate</a>,” <em>National Post</em>, April 11, 2006."^^rdf:HTML .


        rdf:type                 schema:Claim;
        schema:abstract          "“In late October Peng emailed Lomborg saying the modelling results for emissions cuts at 95% “was not well calibrated, and the cost number is likely to be off”.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8111/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;

<http://data.open.ac.uk/climate-sense/claim/183>
        rdf:type                 schema:Claim;
        schema:abstract          "“I am convinced by the scientific consensus on climate change, but I would still slam the door in the face of anyone who came to me with that offer. If an insurance salesman promises his policy is not-too-expensive but tells you nothing concrete about the benefits, walk away quickly.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/183/source/10>;

<http://data.open.ac.uk/climate-sense/claim/2331>
        rdf:type                 schema:Claim;
        schema:abstract          "“The speed of transition from a predominantly fossil-fuelled world to conversions of renewable flows is being grossly overestimated: all energy transitions are multigenerational affairs with their complex infrastructural and learning needs. Their progress cannot substantially be accelerated either by wishful thinking or by government ministers’&nbsp;fiats.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2331/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vaclav-smil/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/vaclav-smil/" .

<http://data.open.ac.uk/climate-sense/claim/2330/source/29>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"http://web.archive.org/web/20190321193110/http://vaclavsmil.com/wp-content/uploads/docs/smil-article-2008-long-range-energy-nature.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Long-range energy forecasts are no more than fairy tales” (PDF)</a>, Correspondence in <em>Nature</em>&nbsp;Vol. 453 (May 8, 2008. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2330>
        rdf:type                 schema:Claim;
        schema:abstract          "“I largely agree with the overall conclusion of Pielke et al. that the IPCC assessment is overly optimistic,” Smil wrote. “But I fear that the situation is even worse than the authors&nbsp;imply.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2330/source/29>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vaclav-smil/>;

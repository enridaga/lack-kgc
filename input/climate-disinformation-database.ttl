        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=3iLzA-ekye0\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">2017-08-01 – Reaching America – Derrick Hollie – EPA Testimony – Renewable Fuel Standard</a>,” YouTube video uploaded by user “Reaching Ameica,” August 8, 2017. Archived .mp4 on file at DeSmog."^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  "Michael Shellenberger. “<a href=\"https://web.archive.org/web/20200731235155/https://quillette.com/2020/07/29/why-democrats-are-trying-to-shut-me-up-about-climate-change-and-renewables/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">I Was Invited to Testify on Energy Policy. Then Democrats Didn’t Let Me Speak</a>,” <em>Quillette</em>, July 29, 2020. Archived July 31, 2020. Archive URL: <a href=\"https://archive.vn/1eMkU\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/1eMkU</a>"^^rdf:HTML .


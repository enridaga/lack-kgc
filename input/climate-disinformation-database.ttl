        rdf:type                 schema:Claim;
        schema:abstract          "“Better for whom?";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12255/source/14>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kevin-d-williamson/>;

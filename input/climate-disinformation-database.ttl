<http://data.open.ac.uk/climate-sense/claim/2134/source/106>
        rdf:type         schema:CreativeWork;
        schema:citation  "Rex W. Tillerson. “<a href=\"http://web.archive.org/web/20161215200813/http://corporate.exxonmobil.com/en/company/news-and-updates/speeches/the-path-forward-in-todays-energy-environment\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Path Forward in Today’s Energy Environment</a>,” ExxonMobil, October 19, 2016. Archived December 15, 2016. Archive.is URL: <a href=\"https://archive.is/NN1jy\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/NN1jy</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2134>
        rdf:type                 schema:Claim;
        schema:abstract          "“We have long supported a carbon tax as the best policy of those being considered. Replacing the hodge-podge of current, largely ineffective regulations with a revenue-neutral carbon tax would ensure a uniform and predictable cost of carbon across the economy. It would allow market forces to drive solutions.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2134/source/106>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rex-tillerson/>;
        schema:claimInterpreter  <http://desmog.com/>;

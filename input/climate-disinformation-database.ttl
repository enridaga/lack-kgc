        rdf:type                 schema:Claim;
        schema:abstract          "“Koonin’s analysis totally fails to consider the significant risk of very serious impacts on marine life of ocean acidification from the rising ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6388/source/47>;

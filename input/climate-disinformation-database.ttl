        rdf:type                 schema:Claim;
        schema:abstract          "“[Y]ou don’t have to worry about the cuddly polar bear. They are going to be just fine. Because what this means is that global warming will not affect us for the next 2,000 years, and if it does, it won’t have been caused by us. I therefore declare the climate scare officially over.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4856/source/21>;

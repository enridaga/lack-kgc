<http://data.open.ac.uk/climate-sense/claim/11154>
        rdf:type                 schema:Claim;
        schema:abstract          "“‘Over the years and despite all the invectives poured upon him by climate alarmists, Dr. Singer has stood his ground for scientific integrity and adherence to the scientific method. For that, he is to be greatly commended,’&nbsp;said climatologist David R. Legates.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11154/source/>;

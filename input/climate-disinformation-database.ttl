<http://data.open.ac.uk/climate-sense/claim/8044>
        rdf:type                 schema:Claim;
        schema:abstract          "“Pursuing this 2C target is very costly and not guaranteed to be successful. Much better, then, to target a maximum of, say, 3C rise, which will cost about $40 trillion but avoid most&nbsp;damages.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8044/source/50>;

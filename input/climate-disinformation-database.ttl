        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10403>
        rdf:type                 schema:Claim;
        schema:abstract          "“We must welcome the Government’s seeming willingness to push gently against the net zero ideology, for example with the proposed Cumbrian coal mine, [and] the opening of new areas for exploration in the North Sea.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10403/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-frost/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/david-frost/" .

<http://data.open.ac.uk/climate-sense/claim/10402/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10402>
        rdf:type                 schema:Claim;
        schema:abstract          "“As a country, we’re [responsible for] about two per cent of global emissions. We could shut down the British economy tomorrow and it would make no difference to the nature of the problem […] It makes no sense in a world that’s got more dangerous.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10402/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-frost/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/david-frost/" .

<http://data.open.ac.uk/climate-sense/claim/10401/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "Saphora Smith. “<a href=\"https://www.independent.co.uk/climate-change/news/lord-frost-no-evidence-climate-emergency-b2141677.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">‘No evidence’ to support claim we’re in climate emergency, ex-minister Lord Frost claims</a>,” <em>The Independent</em>, August 9, 2022. <a href=\"https://web.archive.org/web/20220810073601/https://www.independent.co.uk/climate-change/news/lord-frost-no-evidence-climate-emergency-b2141677.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived August 10, 2022</a>. Archive URL: <a href=\"https://archive.ph/E6QgX\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/E6QgX</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10401>
        rdf:type                 schema:Claim;
        schema:abstract          "“Instead of focusing on technological solutions that enable us to master our environment and get more energy in a more carbon-efficient way – nuclear, CCS, fracking, one-day fusion – we have focused on managing demand so we can use medieval technology like wind power.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10401/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-frost/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/david-frost/" .

<http://data.open.ac.uk/climate-sense/claim/10400/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10400>
        rdf:type                 schema:Claim;
        schema:abstract          "“You will be forced to buy ineffective boilers and expensive electric cars. That’s why you’re made to pay for windmills, a technology that was cutting-edge just after the Norman Conquest.”&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10400/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-frost/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/david-frost/" .

<http://data.open.ac.uk/climate-sense/claim/10399/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10399>
        rdf:type                 schema:Claim;
        schema:abstract          "“By all means accept the scientific consensus: it doesn’t seem to me to depict ‘climate catastrophe’. But net zero 2050 isn’t science. It’s a political goal enshrining a particular view of the trade-offs facing us as a result of climate change.”&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10399/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-frost/>;

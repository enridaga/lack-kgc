<http://data.open.ac.uk/climate-sense/claim/6761/source/36>
        rdf:type         schema:CreativeWork;
        schema:citation  "(Press Release. “<a href=\"https://www.manchin.senate.gov/newsroom/press-releases/manchin-applauds-administrations-latest-recognition-of-the-role-appalachia-will-play-in-americas-energy-future-thanks-secretary-perry-for-moving-appalachian-storage-hub-forward_\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">MANCHIN APPLAUDS ADMINISTRATION’S LATEST RECOGNITION OF THE ROLE APPALACHIA WILL PLAY IN AMERICA’S ENERGY FUTURE, THANKS SECRETARY PERRY FOR MOVING APPALACHIAN STORAGE HUB FORWARD</a>,” <em>Manchin.Senate.Gov</em>, April 10, 2019. Archive URL: <a href=\"https://archive.ph/k92Br\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.ph/k92Br</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6761>
        rdf:type                 schema:Claim;
        schema:abstract          "“After talking with Secretary Perry this week and after today’s executive order, I am more confident than ever that the Administration is serious about being a partner in helping us develop the Appalachian Storage Hub. Since 2017, I have been working with the Administration and Secretary Perry to make sure they understood the positive economic impact and the potential energy security an Appalachian Storage Hub will bring to West Virginia and the country,” Manchin said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6761/source/36>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-manchin/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/joe-manchin/" .

<http://data.open.ac.uk/climate-sense/claim/6760/source/20>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=VsYAkK5q68c\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Ranking Member Manchin’s Opening Statement From Hearing On Electricity Sector In Changing Climate</a>,” YouTube video uploaded by user “Senate Energy Dems, Chairman Joe Manchin III,” March 5, 2019. Archived .mp4 on file at DeSmog."^^rdf:HTML .


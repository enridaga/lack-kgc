<http://data.open.ac.uk/climate-sense/claim/12905/source/46>
        rdf:type         schema:CreativeWork;
        schema:citation  "Richard Harris. “<a href=\"https://www.npr.org/templates/story/story.php?storyId=105834436\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Putting A Financial Spin On Global Warming</a>,” <em>NPR</em>, June 24, 2009. <a href=\"https://web.archive.org/web/20200701044740/https://www.npr.org/templates/story/story.php?storyId=105834436\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived June 30, 2020</a>. Archive URL: <a href=\"https://archive.vn/Ife1q\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/Ife1q</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12905>
        rdf:type                 schema:Claim;
        schema:abstract          "“We’re stuck in this kind of poor paradigm for dealing with climate change, this pollution paradigm, not because environmentalists are failures, but actually because they were so successful. The Clean Water Act, the Clean Air Act, the cap and trade on acid rain — these things worked really&nbsp;well.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12905/source/46>;

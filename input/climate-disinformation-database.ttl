<http://data.open.ac.uk/climate-sense/claim/7690>
        rdf:type                 schema:Claim;
        schema:abstract          "“There needs to be a properly funded group of scientists whose sole job is to find fault in the science with which we are basing expensive public policy decisions,” he said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7690/source/13>;

        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10405>
        rdf:type                 schema:Claim;
        schema:abstract          "“We should keep underlining that there is not just a problem, there is a solution. That is gas to nuclear, backed with investment in fundamental research, and taking advantage of technological advances […] we may therefore need to be more dismissive of current renewable technology as an unnecessary complication.”&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10405/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-frost/>;

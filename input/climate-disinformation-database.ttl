<http://data.open.ac.uk/climate-sense/claim/12465/source/52>
        rdf:type         schema:CreativeWork;
        schema:citation  "Ross Clark. “<a href=\"https://www.telegraph.co.uk/news/2020/12/09/ban-gas-boilers-would-yet-another-pointless-eco-catastrophe/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">A ban on gas boilers would be yet another pointless eco catastrophe</a>,” <em>The Telegraph</em>, December 9, 2020. <a href=\"http://web.archive.org/web/20201212223558/https://www.telegraph.co.uk/news/2020/12/09/ban-gas-boilers-would-yet-another-pointless-eco-catastrophe/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived December 14, 2020</a>. Archive <span class=\"caps\">URL</span>: <a href=\"https://archive.vn/SXHl1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/<span class=\"caps\">SXH</span>l1</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12465>
        rdf:type                 schema:Claim;
        schema:abstract          "“It is right to build new homes to high energy efficiency standards, but it is sadly all too easy to predict the result of a rushed scheme to retrofit all existing homes to make them zero carbon. Homeowners will be fleeced, left with damp, chilly homes. Worse, the costs are bound to fall disproportionately on the lowest- income homeowners.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12465/source/52>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ross-clark/>;

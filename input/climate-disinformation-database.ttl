        rdf:type         schema:CreativeWork;
        schema:citation  "(Press Release). “<a href=\"https://web.archive.org/web/20191001050509/https://empoweringamerica.org/2019/09/27/new-advocacy-group-offers-smart-approach-to-energy-consumption-and-environmental-conservation-the-empowerment-alliance-launches-to-secure-americas-energy-independence-through-natural-gas/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">New Advocacy Group Offers Smart Approach to Energy Consumption and Environmental Conservation; The Empowerment Alliance Launches to Secure America’s Energy Independence Through Natural Gas</a>,” <em>The Empowerment Alliance</em>, September 30, 2019. Archived October 1, 2019. Archive.fo URL: <a href=\"https://archive.fo/WMZou\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/WMZou</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4589>
        rdf:type                 schema:Claim;
        schema:abstract          "“The recent attack in Saudi Arabia shows that our enemies are getting more sophisticated and that America is still at risk from events overseas,” said Jim Nathanson, Executive Director for TEA. “But the Green New Deal and other ideas would make those attacks seem small by comparison, as they would weaken America and take us back to energy dependence. There is a better path.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4589/source/21>;

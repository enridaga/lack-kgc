<http://data.open.ac.uk/climate-sense/claim/13552>
        rdf:type                 schema:Claim;
        schema:abstract          "“The last global cooling cycle began around 1795, or about 220 years ago. If the time clock strikes on time as it has over and over again throughout history, the upcoming cooling cycle has already begun in the Arctic and Antarctic, as shown in my video, ‘Is Climate Change Dangerous?’”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13552/source/12>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-dilley/>;

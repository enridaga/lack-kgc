<http://data.open.ac.uk/climate-sense/claim/13440>
        rdf:type                 schema:Claim;
        schema:abstract          "“By denying these countries opportunities to get access to American energy such as coal or natural gas, we are condemning people to lives of perpetual poverty,” Clemente said. “We’re not only condemning people today, we’re condemning their children.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13440/source/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20220107185417/https://cornwallalliance.org/anopenlettertopopefrancisonclimatechange/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">An Open Letter to Pope Francis on Climate Change</a>,” <em>Cornwall Alliance For The Stewardship of Creation</em>. April 27, 2015.&nbsp;Archived with March 30, 2022. Archive URL: <a href=\"https://archive.ph/gdNdc\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/gdNdc</a>"^^rdf:HTML .


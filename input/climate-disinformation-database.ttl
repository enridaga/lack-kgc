        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11975>
        rdf:type                 schema:Claim;
        schema:abstract          "“All of those who say to you that renewables are cheaper and we need more renewables, they are either deeply misinformed, or misleading you. It is simply not true.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11975/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .


        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1068>
        rdf:type                 schema:Claim;
        schema:abstract          "“We don’t take that position because they invest. It’s the other way around. And any environmental group that is honest and has any familiarity with us knows that to be the case.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1068/source/>;

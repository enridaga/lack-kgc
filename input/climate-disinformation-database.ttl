        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20170201045352/https://www.heartland.org/news-opinion/news/press-release-heartland-institute-experts-comment-on-keystone-xl-dakota-access-pipeline-executive-orders\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">PRESS RELEASE: HEARTLAND INSTITUTE EXPERTS COMMENT ON KEYSTONE XL, DAKOTA ACCESS PIPELINE EXECUTIVE ORDERS</a>,”<em> The Heartland Institute</em>, January 24, 2017. Archived February 1, 2017. Archive.is URL: <a href=\"https://archive.is/iuwrZ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/iuwrZ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6815>
        rdf:type                 schema:Claim;
        schema:abstract          "“Stopping the Dakota Access pipeline after 98% of the pipeline was laid down was an example of how the greens infected political decisions in Washington. The pipeline was to be drilled almost 100 feet below the riverbed of the Missouri, not placed on it. But, that made little difference to those stopped it.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6815/source/10>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ken-haapala/>;

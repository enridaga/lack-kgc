        rdf:type                 schema:Claim;
        schema:abstract          "”[…] the climate problem that the COP seeks to solve is not real. It is an image that does not conform with the real world or the climate that we actually experience.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5383/source/20>;

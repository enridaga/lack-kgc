        schema:citation  "“<a href=\"http://web.archive.org/web/20191213015426/https://dailycaller.com/2016/09/02/the-suspicious-backers-of-the-latest-climate-change-hyperbole/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Suspicious Backers Of The Latest Climate Change Hyperbole</a>,” <em>The Daily Caller</em>, September 2, 2016. Archived December 12, 2019. Archive.ph URL: <a href=\"https://archive.ph/RCtau\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/RCtau</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13051>
        rdf:type                 schema:Claim;
        schema:abstract          "“The next time green extremists exploit a tragedy by conjuring up a scientifically dubious link between climate change and a severe weather event, consider their motives. All too often leading environmental groups are promoting junk science that undercuts American interests in exchange for a payday linked to nefarious front groups and despicable dictators.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13051/source/9>;

<http://data.open.ac.uk/climate-sense/claim/942/source/11>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20171010212531/https://www.heartland.org/news-opinion/news/press-release-heartland-institute-experts-react-to-epa-scrapping-the-clean-power-plan\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">PRESS RELEASE: HEARTLAND INSTITUTE EXPERTS REACT TO EPA SCRAPPING THE CLEAN POWER PLAN</a>,” <em>The Heartland Institute</em>, October 9, 2017. Archived October 10, 2017. Archive.is URL: <a href=\"https://archive.is/B9m3e\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/B9m3e</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/942>
        rdf:type                 schema:Claim;
        schema:abstract          "“Increasing CO2 poses no direct hazard to human health, either. Concentrations in submarines can reach up to 25 times the normal atmospheric levels without causing harmful effects on the crew. Yet the CPP misleads readers by referring to CO2 as ‘carbon pollution,’ a huge deception. […]”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/942/source/11>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tom-harris/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/tom-harris/" .

<http://data.open.ac.uk/climate-sense/claim/941/source/12>
        rdf:type         schema:CreativeWork;
        schema:citation  "Tom Harris. “<a href=\"http://www.thespectrum.com/story/opinion/2016/09/24/judges-must-understand-climate-rules-irrational/91031444/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Judges must understand: Climate rules are irrational</a>,” <em>The Spectrum</em>, September 24, 2016. Archived .pdf on file at Desmog. Archive.is URL: <a href=\"https://archive.is/YZV2J\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/YZV2J</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/941>
        rdf:type                 schema:Claim;
        schema:abstract          "“[S]urface temperature, averaged over the land and ocean, increased only about 1.5 degrees between 1880 to 2012 despite a reputed 36 percent rise in atmospheric CO² content. And it is well known that the impact of CO² rise diminishes as the concentration increases. Given also that there has been no general increase in extreme weather or the rate of sea level rise, the primary rationale for actions to restrict CO2 emissions boils down to the possibility of dangerous climate change in the future.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/941/source/12>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tom-harris/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/tom-harris/" .

<http://data.open.ac.uk/climate-sense/claim/940/source/13>
        rdf:type         schema:CreativeWork;
        schema:citation  "Tom Harris. “<a href=\"http://web.archive.org/web/20160915012819/http://pagosadailypost.com/2016/08/22/opinion-gop-should-follow-trumps-lead-on-climate-change/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">OPINION: GOP Should Follow Trump’s Lead on Climate Change</a>,” <em>Pagosa Daily Post</em>, August 22, 2016. Archived September 15, 2016. Archive.is URL: <a href=\"https://archive.is/FhyHI\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/FhyHI</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/940>
        rdf:type                 schema:Claim;
        schema:abstract          "“GOP candidates must follow [Donald] Trump’s lead, making use of reports such as those of the NIPCC, to clearly explain to the public that climate change is a natural phenomenon on which human influence is likely very small. Plans to cripple the coal industry, our most important source of cheap electricity, because of improbable climate concerns, is irrational and dangerous. It is immoral to destroy millions of jobs and harm America’s poor, minority, and working class families with soaring energy prices because of a questionable theory about future climate.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/940/source/13>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tom-harris/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/tom-harris/" .

<http://data.open.ac.uk/climate-sense/claim/939/source/14>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.commondreams.org/news/2016/05/17/massachusetts-court-sides-teenagers-historic-climate-victory\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Massachusetts Court Sides with Teenagers in ‘Historic’ Climate Victory</a>,”<em>CommonDreams</em>, May 17, 2016. <a href=\"http://web.archive.org/web/20160623173748/http://www.commondreams.org/news/2016/05/17/massachusetts-court-sides-teenagers-historic-climate-victory\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Archived June 23, 2016</a>. Archive.is URL: <a href=\"https://archive.is/FVJ8q\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/FVJ8q</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/939>
        rdf:type                 schema:Claim;
        schema:abstract          "“Most adults consider security, potable water, education, etc., much more important than climate change. And when you consider about 5 million Africans die every year because they do not have fresh, drinkable water, you realize the kids are being totally propagandized.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/939/source/14>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tom-harris/>;

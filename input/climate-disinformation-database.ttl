        rdf:type         schema:CreativeWork;
        schema:citation  "Todd Wynn. “<a href=\"http://web.archive.org/web/20180622210950/https://www.masterresource.org/renewable-portfolio-standardrenewable-electricity-standard/alec-repeal-state-energy-mandates/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">ALEC to States: Repeal Renewable Energy Mandates (‘Electricity Freedom Act’ model bill adopted)</a>,” <em>MasterResource</em>, November 1, 2012. Archived June 22, 2018. Archive.is URL: <a href=\"https://archive.li/QWmm6\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.li/QWmm6</a>"^^rdf:HTML .


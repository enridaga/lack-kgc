        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.documentcloud.org/documents/4081441-Committee-for-a-Constructive-Tomorrow-CFACT.html\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Committee for a Constructive Tomorrow CFACT Weather Channel Mailer 2017-09-28</a>,” DocumentCloud."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7667>
        rdf:type                 schema:Claim;
        schema:abstract          "It is an agenda that claims to be about ‘climate’ and ‘science’ … but consistently favors an ideology of socialism and collectivism over capitalism. An agenda demanding a massive transfer of wealth from ‘rich nations’ to ‘poor nations.’";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7667/source/23>;

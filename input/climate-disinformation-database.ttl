<http://data.open.ac.uk/climate-sense/claim/9972/source/10>
        rdf:type         schema:CreativeWork;
        schema:citation  "Patrick Michaels. “<a href=\"http://web.archive.org/web/20151114193857/http://www.johnlocke.org/research/show/policy%20reports/248\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">High Tide for Hype on the OBX: Apocalyptic predictions miss the mark on North Carolina sea levels</a>,” John Locke Foundation, September 26, 2012. Archived November 14, 2015. Archive.is URL: <a href=\"https://archive.is/tSkCH\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/tSkCH</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9972>
        rdf:type                 schema:Claim;
        schema:abstract          "“While global warming is real, and human activities are one cause, it now appears that the most publicized forecasts systematically overestimate the rate of temperature rise.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9972/source/10>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-locke-foundation/>;

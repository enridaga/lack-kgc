<http://data.open.ac.uk/climate-sense/claim/3298/source/31>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.worldclimatereport.com/index.php/2008/11/19/why-the-epa-should-find-against-endangerment/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Why the EPA should find against ‘Endangerment’</a>,” <em>World Climate Report</em>, November 19, 2008.<a href=\"http://web.archive.org/web/20170729230726/http://www.worldclimatereport.com/index.php/2008/11/19/why-the-epa-should-find-against-endangerment/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> Archived July 29, 2017</a>. Archive.is URL: <a href=\"https://archive.is/YjoBI\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/YjoBI</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3298>
        rdf:type                 schema:Claim;
        schema:abstract          "“As America moves forward, we develop technologies that help us better respond and adapt to the prevailing climate and better protect ourselves from climate extremes. Thus, climate has become, and will undoubtedly continue to become, less and less of an ‘endangerment’ to our general health and welfare. It would be foolish of the EPA to ignore history in reaching its ultimate conclusion.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3298/source/31>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/world-climate-report/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/world-climate-report/" .

<http://data.open.ac.uk/climate-sense/claim/3297/source/29>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.worldclimatereport.com/index.php/2008/12/02/will-the-un-chill-out-on-climate-change/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Will the U.N. Chill Out on Climate Change?</a>” <em>World Climate Report</em>, December 2008.<a href=\"http://web.archive.org/web/20170729230151/http://www.worldclimatereport.com/index.php/2008/12/02/will-the-un-chill-out-on-climate-change/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> Archived July 29, 2017</a>. Archive.is URL: <a href=\"https://archive.is/zAfpq\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/zAfpq</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3297>
        rdf:type                 schema:Claim;
        schema:abstract          "“The lack of recent and future warming almost certainly means that the ultimate warming of this century is going to be quite modest. Instead, they should keep in mind that expensive policies to fight a modest climate change will only worsen the unprecedented cold snap affecting the global economy,” WCR concludes.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3297/source/29>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/world-climate-report/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/world-climate-report/" .

<http://data.open.ac.uk/climate-sense/claim/3296/source/27>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.worldclimatereport.com/index.php/2008/12/02/will-the-un-chill-out-on-climate-change/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Will the U.N. Chill Out on Climate Change?</a>” <em>World Climate Report</em>, December 2008.<a href=\"http://web.archive.org/web/20170729230151/http://www.worldclimatereport.com/index.php/2008/12/02/will-the-un-chill-out-on-climate-change/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> Archived July 29, 2017</a>. Archive.is URL: <a href=\"https://archive.is/zAfpq\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/zAfpq</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3296>
        rdf:type                 schema:Claim;
        schema:abstract          "“The fact is that the world cannot afford any expensive climate policies now. Economic conditions are so bad that carbon dioxide emissions—the byproduct of our commerce—are likely going down because of the financial cold spell, not the climatic one. Indeed, a permanent economic ice-age would likely result from any mandated large cuts in emissions. If you’re liking your 401(k) today, you’ll love ‘Beyond Kyoto.’”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3296/source/27>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/world-climate-report/>;
        schema:claimInterpreter  <http://desmog.com/>;

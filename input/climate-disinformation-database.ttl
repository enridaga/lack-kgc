<http://data.open.ac.uk/climate-sense/claim/4453/source/20>
        rdf:type         schema:CreativeWork;
        schema:citation  "John H. Sununu. “<a href=\"http://web.archive.org/web/20090313053335/http://www.heartland.org/full/24851/The_Politics_of_Global_Warming.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Politics of Global Warming</a>,” <em>The Heartland Institute</em>, March 13, 2009. Archived March 13, 2009. Archive URL: <a href=\"https://archive.fo/AGwFm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/AGwFm</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4453>
        rdf:type                 schema:Claim;
        schema:abstract          "“But waiting for ‘eventually’ to prove the alarmists wrong is not the wisest course of action. Unfullfillable ambitions to stifle growth will devastate a world trying to deal with the complexities of economics, stability, and the environment. Quality of life depends on access to energy. Noble intentions about ‘C02-free’ sources of energy are not sufficient, if their agenda of eliminating coal as a source, and turning their back on nuclear, are allowed to be part of our near-term policies.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4453/source/20>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-h-sununu/>;

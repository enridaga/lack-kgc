<http://data.open.ac.uk/climate-sense/claim/10057/source/19>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20211001225651/https://www.business-standard.com/article/opinion/deepak-lal-spiking-the-road-to-copenhagen-109082500022_1.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Deepak Lal: Spiking the road to Copenhagen</a>,” <em>Business Standard</em>, August 25, 2009. Archived October 1, 2021. Archive URL: <a href=\"https://archive.ph/xBkXw\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/xBkXw</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10057>
        rdf:type                 schema:Claim;
        schema:abstract          "“This new and growing scientific evidence that human CO2 emissions have little to do with climate change makes the current Western political obsession to curb carbon emissions at a vast economic cost extremely foolish. For India it would mean not only reversing the current trends in poverty alleviation, but a vast increase in the numbers of the poor who would otherwise be pulled out of poverty. India should have nothing to do with Copenhagen. If this means there is no climate change treaty, it might also save the West from its current path to committing economic hara-kiri.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10057/source/19>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/deepak-lal-1940-2020/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/deepak-lal-1940-2020/" .

<http://data.open.ac.uk/climate-sense/claim/10056/source/18>
        rdf:type         schema:CreativeWork;
        schema:citation  "Deepak Lal. “<a href=\"https://web.archive.org/web/20211001210417/https://www.business-standard.com/article/opinion/deepak-lal-man-made-global-warming-110013000029_1.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Man-made global warming: The climate-change ‘science’ continues to unravel</a>,” Business Standard, January 20, 2013. Archived June 23, 2023. Archive URL: https://archive.is/wip/MK2zL"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10056>
        rdf:type                 schema:Claim;
        schema:abstract          "“These [emails] show that Professor Phillip Jones, the director of the CRU — the source of the most important of the four sets of temperature data on which the IPCC relies — along with a tight network of colleagues had for years discussed various tactics to avoid releasing their data to outsiders under freedom of information laws…to conceal the background data on which their findings and temperature records are based.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10056/source/18>;

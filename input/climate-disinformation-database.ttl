        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7717>
        rdf:type                 schema:Claim;
        schema:abstract          "“Thanks to lots of people including Anthony Watts, Jennifer Marohasy, Jo Nova, Benny Peiser (GWPF), Willie Soon for spreading the word. Also a huge thanks to the IPA for helping with the organisation,” Ridd said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7717/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ridd/>;

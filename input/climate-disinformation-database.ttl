        rdf:type                 schema:Claim;
        schema:abstract          "”[…] The Earth has been recovering from the Little Ice Age for a couple of centuries and recovering from a real ice age for thousands of years; it is simply impossible to know whether any observed current warming is a continuation of this natural trend or represents some new man-made phenomenon.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2941/source/26>;

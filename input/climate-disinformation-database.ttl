        rdf:type                 schema:Claim;
        schema:abstract          "“Today, the peer reviewed process of funding and validation of scientific research in climatology is equally controlled by the modern equivalent of the Collegium Romanum (the Vatican’s Institute of Research), the Inter-government Panel of Climate Change (IPCC).";

<http://data.open.ac.uk/climate-sense/claim/11001/source/277>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20161118025828/http://www.heritage.org/research/commentary/2016/6/next-president-shouldnt-be-a-mad-scientist\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Next President Shouldn’t Be a Mad Scientist</a>,” <em>Heritage Foundation</em>, June 28, 2016. Archived November 18, 2016. Archive.is&nbsp;URL:&nbsp;<a href=\"https://archive.is/GmizM\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/GmizM</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11001>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Obama White House has used the Office of Science and Technology principally to support its pet political causes — like advocacy for global climate change research that matches the president’s views on the topic and can be puffed to justify expanding federal regulations in virtually every aspect of American life,” Carafano wrote at the Heritage&nbsp;Foundation.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11001/source/277>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/donald-trump/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/donald-trump/" .

<http://data.open.ac.uk/climate-sense/claim/11000/source/304>
        rdf:type         schema:CreativeWork;
        schema:citation  "Kai Ryssdal. “<a href=\"https://www.marketplace.org/2016/08/17/world/david-malpass-advising-donald-trump\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">David Malpass on advising Donald Trump</a>,”&nbsp;<em>Marketplace</em>, August 17, 2016.&nbsp;<a href=\"http://web.archive.org/web/20161118181340/http://www.marketplace.org/2016/08/17/world/david-malpass-advising-donald-trump\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived November 18, 2016</a>. Archive.is&nbsp;URL:&nbsp;<a href=\"https://archive.is/qfxLp\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/qfxLp</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11000>
        rdf:type                 schema:Claim;
        schema:abstract          "“Yes, of course, and that’s why I’m working on the campaign…. I worked in both the Reagan and Bush administrations. They were effective, they tried to be effective. But overwhelms you when you’re there is the number of decisions the federal government is making. [It’s] this giant entity that’s constantly affecting people’s lives. And I think they haven’t been making good decisions in the current administration and we need a better one.&nbsp;“";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11000/source/304>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/donald-trump/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/donald-trump/" .

<http://data.open.ac.uk/climate-sense/claim/10999/source/364>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.cleveland.com/open/index.ssf/2016/11/ken_blackwell_former_ohio_trea.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Ken Blackwell, former Ohio treasurer, secretary of state, takes key role in Donald Trump transition team</a>,”&nbsp;<em>Cleveland.com</em>, &nbsp;November 10, 2016.&nbsp;Archive.is&nbsp;URL:&nbsp;<a href=\"https://archive.is/lzRQf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/lzRQf</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10999>
        rdf:type                 schema:Claim;
        schema:abstract          "&nbsp;“Donald Trump is an existential threat to conservatism. He is arguably one of the most divisive figures in modern political history and his candidacy represents not only a threat to the Republican Party, Donald Trump is dragging the nation into the political gutter. It’s time for conservative voters to open their eyes and understand the nation deserves better than this political huckster.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10999/source/364>;

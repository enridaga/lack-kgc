        rdf:type         schema:CreativeWork;
        schema:citation  "Luke Mullins. “<a href=\"https://www.washingtonian.com/2012/05/30/the-battle-for-cato/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Battle for the Cato Institute</a>,” <em>Washingtonian</em>, May 30, 2012. <a href=\"http://web.archive.org/web/20190522222457/https://www.washingtonian.com/2012/05/30/the-battle-for-cato/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 22, 2019</a>. Archive.fo URL: <a href=\"https://archive.fo/XemXC\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/XemXC</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5092>
        rdf:type                 schema:Claim;
        schema:abstract          "“I just want to say something about these Koch people,” Crane said. “Kevin Gentry sitting over there has never once—never once!—invited me to one of the Koch donor events that he organizes for Charles! Nor has he invited anyone from Cato!”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5092/source/11>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kevin-gentry/>;

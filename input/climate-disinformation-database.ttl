<http://data.open.ac.uk/climate-sense/claim/5624>
        rdf:type                 schema:Claim;
        schema:abstract          "However, a DeSmog analysis of the same records shows that this figure is misleading and inaccurate. The $185,000 figure represents the total cost of six primary and general elections between 2013 and 2016, which included much more than just the anti-fracking initiatives.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5624/source/48>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://parlinfo.aph.gov.au/parlInfo/search/display/display.w3p;query=Id%3A%22committees%2Fcommsen%2F11980%2F0004%22\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">SELECT COMMITTEE ON CLIMATE POLICY – 15/04/2009 – Emissions trading and reducing carbon pollution</a>,” Parliament of Australia, April 15, 2009."^^rdf:HTML .


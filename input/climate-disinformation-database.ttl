<http://data.open.ac.uk/climate-sense/claim/10524>
        rdf:type                 schema:Claim;
        schema:abstract          "Lomborg: “It is. So look, if you look around and if you look back in time, absolutely there’s been huge changes. As you pointed out, you know, sea levels from, from an ice age to today has gone up what, 400ft. So, yeah.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10524/source/>;

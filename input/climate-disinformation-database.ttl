<http://data.open.ac.uk/climate-sense/claim/11093/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11093>
        rdf:type                 schema:Claim;
        schema:abstract          "“No current energy and synthetic feedstock source or combination of sources are presently technically superior and greener alternatives to crude oil,” they concluded.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11093/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/montreal-economic-institute/>;

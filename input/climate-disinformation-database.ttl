        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11974>
        rdf:type                 schema:Claim;
        schema:abstract          "“We’ve allowed our domestic gas production in the last decade to drop by 43 percent even though we’re sitting on huge energy owned by us all […] Brilliant, thanks for that you clueless civil servants, you useless politicians.”&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11974/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .

<http://data.open.ac.uk/climate-sense/claim/11973/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11973>
        rdf:type                 schema:Claim;
        schema:abstract          "“Of course we should be drill baby drill”, he said. “It’s our energy treasure. And the fact that we should deny ourselves that wealth, that jobs, is utter insanity”.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11973/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .

<http://data.open.ac.uk/climate-sense/claim/11972/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11972>
        rdf:type                 schema:Claim;
        schema:abstract          "“This is really important folks because this is data. Essentially, the IPCC, they always talk about, we are 1 degree higher than the pre-industrialisation period than 150 years ago, but what you said is, that was the lowest point in the last 10,000 years, so in a sense, that’s why we shouldn’t be panicking and it’s been much warmer in the 2 or 3 previous periods.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11972/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .

<http://data.open.ac.uk/climate-sense/claim/11971/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11971>
        rdf:type                 schema:Claim;
        schema:abstract          "“What I’m not convinced about is that we are facing a climate catastrophe […] no one has presented any science to me that shows that if we get to net zero, if we get there, that that’s gonna make any difference to climate change which is affected by things that are much much bigger than CO2”.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11971/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .

<http://data.open.ac.uk/climate-sense/claim/11970/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11970>
        rdf:type                 schema:Claim;
        schema:abstract          "“I’ve always said that climate change has existed since the year dot and it will continue to exist. I’m a fan of reducing emissions because I want cleaner, quieter cities, I live in them.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11970/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;

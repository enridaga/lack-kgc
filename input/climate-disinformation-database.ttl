        rdf:type         schema:CreativeWork;
        schema:citation  "Claes Johnson. <a href=\"http://www.nada.kth.se/~cgjoh/atmothermo.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Climate Thermodynamics” (PDF)</a>, retrieved from Claes Johnson’s personal website at <a href=\"http://www.nada.kth.se/~cgjoh/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">www.nada.kth.se</a>, September 27, 2012."^^rdf:HTML .


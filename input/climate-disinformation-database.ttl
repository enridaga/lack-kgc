<http://data.open.ac.uk/climate-sense/claim/858/source/74>
        rdf:type         schema:CreativeWork;
        schema:citation  "Matt Ridley. “<a href=\"https://web.archive.org/web/20190831150054/https://www.spectator.co.uk/2019/08/the-most-dangerous-thing-about-the-amazon-fires-is-the-apocalyptic-rhetoric/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The most dangerous thing about the Amazon fires is the apocalyptic rhetoric</a>,” <em>The Spectator</em>, August 31, 2019. Archived August 31, 2019. Archive.fo <span class=\"caps\">URL</span>: <a href=\"http://archive.fo/NNqMo\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/<span class=\"caps\">NN</span>qMo</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/858>
        rdf:type                 schema:Claim;
        schema:abstract          "“It is probably true that President Jair Bolsonaro’s rhetoric has encouraged those who want to resume logging and clearing forest and contributed to this year’s uptick in fires in the country. But was it really necessary to claim global catastrophe to make this point, and was it counterproductive?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/858/source/74>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/matt-ridley/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/matt-ridley/" .

<http://data.open.ac.uk/climate-sense/claim/857/source/72>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://twitter.com/talkRADIO/status/1181478044839665665?ref_src=twsrc%5Etfw%7Ctwcamp%5Etweetembed%7Ctwterm%5E1181478044839665665&amp;ref_url=https%3A%2F%2Fwww.breitbart.com%2Feurope%2F2019%2F10%2F11%2Fsavaged-by-an-extinction-rebellion-tofu-muncher%2F\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Author Lord Matt Ridley: “A whole generation has been talked into this extreme apocalyptic rhetoric that is just not supported by the facts.” @JuliaHB1|@mattwridley |#ExtinctionRebellion</a>,” Tweet by @talkRADIO, October 8, 2019. Retrieved from Twitter.com. Archived .png on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/857>
        rdf:type                 schema:Claim;
        schema:abstract          "“I saw that the Extinction Rebellion protesters had put out a call for people to bring them food. Now how’s that food going to be brought to them? Presumably with fossil fuels. It’s not likely to arrive on bicycles, so there’s a degree of extraordinary hypocrisy going on here.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/857/source/72>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/matt-ridley/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/matt-ridley/" .

<http://data.open.ac.uk/climate-sense/claim/856/source/65>
        rdf:type         schema:CreativeWork;
        schema:citation  "Matt Ridley, <a href=\"https://globalvisionuk.com/the-governments-energy-policy-could-cripple-global-britain/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">‘The Government’s energy policy could cripple global Britain’,</a> <em>Global Vision</em>, March 8, 2020. <a href=\"https://web.archive.org/web/20200418135032/https://globalvisionuk.com/the-governments-energy-policy-could-cripple-global-britain/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived October 5, 2020</a>. Archive <span class=\"caps\">URL</span>: <a href=\"https://archive.vn/q5PC4\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/q5PC4</a>"^^rdf:HTML .


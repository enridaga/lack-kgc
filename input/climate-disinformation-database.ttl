<http://data.open.ac.uk/climate-sense/claim/1817>
        rdf:type                 schema:Claim;
        schema:abstract          "“This is no time for political games. Climate change is not an immediate threat to humanity. Climate-related deaths have declined 98.9% in the last century, and humanity is growing more and more resilient thanks to the availability of affordable, reliable energy. On behalf of all Americans, we urge you to oppose any stimulus proposals that carve out special treatment for or bail out any energy companies and focus instead on stopping COVID-19.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1817/source/28>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/independence-institute/>;

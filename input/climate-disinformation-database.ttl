<http://data.open.ac.uk/climate-sense/claim/10035>
        rdf:type                 schema:Claim;
        schema:abstract          "“The model architecture was wrong. Carbon dioxide causes only minor warming. The climate is largely driven by factors outside our control.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10035/source/18>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-evans/>;

<http://data.open.ac.uk/climate-sense/claim/2733/source/2>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20150721193903/http://www.copenhagenconsensus.com/how-much-have-global-problems-cost-world/outcome\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Outcome</a>,” Score Card For Humanity (Copenhagenconsensus.com). Archived July 21, 2015."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2733>
        rdf:type                 schema:Claim;
        schema:abstract          "“Global warming is surprising, because the impact now is positive. The increased level of CO₂ has boosted agriculture because it works as a fertilizer. At the same time, the number of people dying from heat waves are more that outweighed by fewer people dying from fewer cold waves. In all, global warming benefits have increased from 1900 to almost 1.5% of GDP by now, but by 2025, they will peak and begin a rapid decline, leading to a net negative towards the end of the century.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2733/source/2>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/copenhagen-consensus-center/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/copenhagen-consensus-center/" .

<http://data.open.ac.uk/climate-sense/claim/2732/source/33>
        rdf:type         schema:CreativeWork;
        schema:citation  "Valerie Strauss. “<a href=\"https://www.washingtonpost.com/news/answer-sheet/wp/2017/02/07/shes-a-billionaire-who-said-schools-need-guns-to-fight-bears-heres-what-you-may-not-know-about-betsy-devos/?utm_term=.ba2d29b65a62\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">She’s a billionaire who said schools need guns to fight bears. Here’s what you may not know about Betsy DeVos</a>,” <em>The Washington Post</em>, February 7, 2017.<a href=\"http://web.archive.org/web/20170515221455/https://www.washingtonpost.com/news/answer-sheet/wp/2017/02/07/shes-a-billionaire-who-said-schools-need-guns-to-fight-bears-heres-what-you-may-not-know-about-betsy-devos/?utm_term=.ec7ebf721a89\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> Archived May 15, 2017</a>. Archive.is URL: <a href=\"https://archive.is/306qZ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/306qZ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2732>
        rdf:type                 schema:Claim;
        schema:abstract          "“My family is the biggest contributor of soft money to the Republican National Committee. I have decided to stop taking offense at the suggestion that we are buying influence. Now I simply concede the point. They are right. We do expect something in return. We expect to foster a conservative governing philosophy consisting of limited government and respect for traditional American virtues. We expect a return on our investment.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2732/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/betsy-devos/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/betsy-devos/" .

<http://data.open.ac.uk/climate-sense/claim/2731/source/31>
        rdf:type         schema:CreativeWork;
        schema:citation  "Benjamin Wermund. “<a href=\"http://www.politico.com/story/2016/12/betsy-devos-education-trump-religion-232150\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Trump’s education pick says reform can ‘advance God’s Kingdom’</a>,” <em>Politico</em>, December 2, 2016. <a href=\"http://web.archive.org/web/20170515203244/http://www.politico.com/story/2016/12/betsy-devos-education-trump-religion-232150\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 15, 2017</a>. Archive.is URL: <a href=\"https://archive.is/tQ8FS\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/tQ8FS</a>"^^rdf:HTML .


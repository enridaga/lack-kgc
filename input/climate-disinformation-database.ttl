        rdf:type                 schema:Claim;
        schema:abstract          "“The climate of this planet has been changing since God put the planet here. It will always change, and the warming in the last 10 years is not much difference than the warming we saw in the 1930s and other decades. And, lets not forget we are at the end of the ice age in which ice covered most of North America and Northern Europe.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7854/source/5>;

        rdf:type                 schema:Claim;
        schema:abstract          "b85";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8356/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alex-epstein/>;

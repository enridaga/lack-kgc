        rdf:type         schema:CreativeWork;
        schema:citation  "Graham Readfearn. “<a href=\"https://www.theguardian.com/environment/2021/dec/02/climate-cost-study-authors-accuse-bjrn-lomborg-of-misinterpreting-results\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate cost study authors accuse Bjørn Lomborg of misinterpreting results</a>,” <em>The Guardian</em>, December 2, 2021. <a href=\"https://web.archive.org/web/20211217223617/https://www.theguardian.com/environment/2021/dec/02/climate-cost-study-authors-accuse-bjrn-lomborg-of-misinterpreting-results\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived December 17, 2021</a>. Archive URL: <a href=\"https://archive.ph/k7VNR\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/k7VNR</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8108>
        rdf:type                 schema:Claim;
        schema:abstract          "“Lomborg wrote in the Australian that a study’“in the renowned journal’ Nature, ‘shows that reducing emissions 95% by 2050 – almost Biden’s promise of net zero – would cost 11.9% of gross domestic product, or more than $US11,000 ($15,300) for each American citizen every year’,” Graham Readfearn reported.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8108/source/85>;

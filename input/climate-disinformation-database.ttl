<http://data.open.ac.uk/climate-sense/claim/937/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "Wendy Wright. “<a href=\"http://web.archive.org/web/20150511043545/http://www.christiandaily.com/article/vatican.conference.criticized.for.backing.abortion.and.population.control.politics/50181.htm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Vatican Conference Criticized for Backing Abortion and Population Control Politics</a>,”<em> Christian Daily</em>. May 8, 2015. Archived May 11, 2015. Archive.is URL: <a href=\"https://archive.is/F60XV\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/F60XV</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/937>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate will continue to change no matter what we do. So let’s help the world’s poor to the degree we can afford by providing them with reliable, inexpensive electricity and stop pretending we have a crystal ball to future climate states.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/937/source/16>;

        rdf:type                 schema:Claim;
        schema:abstract          "1. Land use in general";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1328/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/stewart-muir/>;

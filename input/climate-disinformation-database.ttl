<http://data.open.ac.uk/climate-sense/claim/10683/source/24>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s16\" href=\"//www.desmog.com/wp-content/uploads/files/APS%20letter%20to%20The%20Australian.pdf\" target=\"_blank\" rel=\"noopener external noreferrer\" name=\"s16\" data-wpel-link=\"external\">“The pot calling the kettle black” (PDF)</a>, Australian Psychological Society, July 2015. Archived at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10683>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Australian Psychological Society was disturbed to see psychology being misused to mislead the public on such an important topic as climate change, and for this to be published in a reputable newspaper.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10683/source/24>;

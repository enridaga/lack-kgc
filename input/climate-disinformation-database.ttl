        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.theatlantic.com/science/archive/2019/03/climate-change-which-democrats-oppose-green-new-deal/585802/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">The 3 Democrats Who Voted Against the Green New Deal,</a>” <em>The Atlantic</em>, March 26, 2019. Archive URL: <a href=\"https://archive.ph/BBMce\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/BBMce</a>"^^rdf:HTML .


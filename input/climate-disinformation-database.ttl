        schema:url               "https://www.desmog.com/tom-harris/" .

<http://data.open.ac.uk/climate-sense/claim/913/source/103>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s42\" href=\"//www.desmog.com/wp-content/uploads/files/icsc-plan-12-06-11c.pdf\" target=\"_blank\" rel=\"noopener external noreferrer\" name=\"s42\" data-wpel-link=\"external\">“Winning Hearts and Minds to Climate and Energy Reality: ICSC’s Strategic Plan” (PDF)</a>, International Climate Science Coalition, June 12, 2011. PDF Archived at Demsmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/913>
        rdf:type                 schema:Claim;
        schema:abstract          "For rational public policy to triumph in spite of the powerful obstacles we face will require that the vast majority of the public and opinion leaders from across the political spectrum come to regard man-made global warming fears as unfounded ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/913/source/103>;

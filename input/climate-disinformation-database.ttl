        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3309>
        rdf:type                 schema:Claim;
        schema:abstract          "People worried about putting food on the table, clothes on the back, and a roof over the head can’t afford to care or do much about air, water, and solid waste pollution. Gathering enough twigs and branches to cook tonight’s measly meal and heat a miserable hut take precedence over any concerns about deforestation, soil erosion, and biodiversity loss.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3309/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/calvin-beisner/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/calvin-beisner/" .


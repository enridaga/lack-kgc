<http://data.open.ac.uk/climate-sense/claim/8311>
        rdf:type                 schema:Claim;
        schema:abstract          "“As long as your life is being made possible by the people of the fossil fuels industry, I think you should be grateful,” Epstein said, “and I think it is a crime, a moral crime, that you are damning anyone by association.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8311/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alex-epstein/>;

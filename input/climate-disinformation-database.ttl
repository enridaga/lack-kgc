<http://data.open.ac.uk/climate-sense/claim/11869>
        rdf:type                 schema:Claim;
        schema:abstract          "Temperatures and carbon dioxide levels do not show a strong correlation. In fact, over very long time spans – periods of hundreds of millions of years – they are often completely out of sync with each&nbsp;other.&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11869/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/patrick-moore/>;

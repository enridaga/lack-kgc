        schema:abstract          "“We should take Russia’s invasion of Ukraine as a wake-up call. Standing up for Western civilization this time requires cheap, abundant, and reliable energy supplies produced at home or in allied nations.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12911/source/>;

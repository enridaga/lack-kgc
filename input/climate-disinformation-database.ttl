<http://data.open.ac.uk/climate-sense/claim/1884>
        rdf:type                 schema:Claim;
        schema:abstract          "(1) That the official policy consensus, as widely interpreted today by governments and international agencies, mirrors prevailing scientific opinion and goes no further than it would warrant.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1884/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-henderson/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;

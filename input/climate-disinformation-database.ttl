        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2890>
        rdf:type                 schema:Claim;
        schema:abstract          "I have not had the opportunity to bring up a matter at recent P.R.C. meetings, and I thought I should let you know of an initiative being taken by Bryan Simpson which will be of interest to us.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2890/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rupert-murdoch/>;

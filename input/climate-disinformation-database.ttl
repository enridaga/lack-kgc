<http://data.open.ac.uk/climate-sense/claim/6850/source/10>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://online.wsj.com/article/SB10001424127887323528404578452483656067190.html?dsk=y\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">In Defense of Carbon Dioxide</a>,” <em>The Wall Street Journal</em>, May 8, 2013. Archived .pdf on file at DeSmog. Archive.is URL: <a href=\"https://archive.is/Bfw13\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/Bfw13</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6850>
        rdf:type                 schema:Claim;
        schema:abstract          "“We know that carbon dioxide has been a much larger fraction of the earth’s atmosphere than it is today, and the geological record shows that life flourished on land and in the oceans during those times. The incredible list of supposed horrors that increasing carbon dioxide will bring the world is pure belief disguised as science.”";

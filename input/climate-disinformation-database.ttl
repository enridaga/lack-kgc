<http://data.open.ac.uk/climate-sense/claim/8237/source/66>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=ByeDW5rliPY\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Africa needs ENERGY – the Paris Agreement is immoral – Alex Epstein</a>,” YouTube video uploaded by user “Contours,” October 22, 2023. Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8237>
        rdf:type                 schema:Claim;
        schema:abstract          "“Green is an anti-human idea, because the idea of green is that you should minimize or eliminate your impact. But that’s not compatible with energy, because what we use energy for is to impact our environment. That’s what you do with energy, is you do work on nature, you impact nature. So what the real hostility is, they don’t like abundant, plentiful energy.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8237/source/66>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alex-epstein/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/alex-epstein/" .

<http://data.open.ac.uk/climate-sense/claim/8236/source/64>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=ByeDW5rliPY\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Africa needs ENERGY – the Paris Agreement is immoral – Alex Epstein</a>,” YouTube video uploaded by user “Contours,” October 22, 2023. Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8236>
        rdf:type                 schema:Claim;
        schema:abstract          "“The idea of net zero by 2050 is 100% incompatible with African development and prosperity,” he said later in the program. He added, “I think it would be an amazing service to Africa and to humanity if you had three or four African governments say, you know what, we’re withdrawing from this Paris climate agreement.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8236/source/64>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alex-epstein/>;
        schema:claimInterpreter  <http://desmog.com/>;

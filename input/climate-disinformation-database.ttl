<http://data.open.ac.uk/climate-sense/claim/4261/source/15>
        rdf:type         schema:CreativeWork;
        schema:citation  "Professor Tad Murty. “<a href=\"http://web.archive.org/web/20191029213447/http://www.iberica2000.org/documents/eolica/GLOBAL_WARMING/Professor_Tad_Murty.txt\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">We now know what we don’t know about climate change</a>,” <em>The Ottawa Citizen</em>, December 12, 2005. Archived October 29, 2019, from iberica2000.org. Archive URL: <a href=\"https://archive.ph/qObQo\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/qObQo</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4261>
        rdf:type                 schema:Claim;
        schema:abstract          "But the price of this understanding is that we now know that we do not know why the Earth is warming. We do not know if humans have anything to do with it, and they may well not. The scientific assumption behind the Kyoto protocol, namely that humans are known to be significantly interfering with an otherwise unchanging climate, is simply false. A new era of climate science lies before us.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4261/source/15>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tad-murty/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/tad-murty/" .


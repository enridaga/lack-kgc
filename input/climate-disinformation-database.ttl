<http://data.open.ac.uk/climate-sense/claim/10447>
        rdf:type                 schema:Claim;
        schema:abstract          "“ARC is a good acronym. It has echoes of the Ark, the Biblical arc, which is a container that allows people to withstand the trials and tribulations of life to navigate through the flood and to preserve,” he said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10447/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jordan-peterson/>;

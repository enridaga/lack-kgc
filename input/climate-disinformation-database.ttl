        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12943>
        rdf:type                 schema:Claim;
        schema:abstract          "“There’s a lot of skepticism about global warming. One: Climate change. Is it happening? And most people say ‘yes, this is happening’, but how is it happening? You saw perhaps a new study that just came out predicting global&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12943/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/acton-institute/>;

<http://data.open.ac.uk/climate-sense/claim/2623/source/10>
        rdf:type         schema:CreativeWork;
        schema:citation  "Nir Shaviv. “<a href=\"http://business.financialpost.com/fp-comment/carbon-week-the-sun-raises-the-seas\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Carbon Week: The sun raises the seas</a>,”<em> Financial Post,</em> June 16, 2015. <a href=\"http://web.archive.org/web/20161008025931/http://business.financialpost.com/fp-comment/carbon-week-the-sun-raises-the-seas\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived October 7, 2016</a>. Archive.is URL: <a href=\"https://archive.is/ww5qZ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/ww5qZ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2623>
        rdf:type                 schema:Claim;
        schema:abstract          "For instance, the increase in solar activity over the 20th century implies that more than half of the warming should be attributed to the sun, not to emissions from human activity.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2623/source/10>;

<http://data.open.ac.uk/climate-sense/claim/6278/source/20>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.eenews.net/stories/1060019099/print\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">POLITICS: Former state energy regulator vows to fight Clean Power Plan from inside Congress</a>,”<em> E&amp;E Publishing</em>, May 26, 2015. <a href=\"http://web.archive.org/web/20160525212815/http://www.eenews.net/stories/1060019099/print\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 25, 2016</a>. WebCite URL: <a href=\"http://www.webcitation.org/6hmGcVLkg\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://www.webcitation.org/6hmGcVLkg</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6278>
        rdf:type                 schema:Claim;
        schema:abstract          "“I don’t even participate in that ‘climate change is real, climate change isn’t real’ debate. It doesn’t matter to me whether it’s real or it isn’t real. We’re dealing with it in reality, and my concern is more on the solution to it than it is on the climate change issue itself. What I do reject is the notion that somehow the power sector in the United States of America is going to bear the burden and the responsibility for fixing the entire world.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6278/source/20>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kevin-cramer/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/kevin-cramer/" .

<http://data.open.ac.uk/climate-sense/claim/6277/source/19>
        rdf:type         schema:CreativeWork;
        schema:citation  "Sarah Emerson. “<a href=\"http://motherboard.vice.com/read/trumps-energy-adviser-is-dangerously-anti-environment-kevin-cramer\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Trump’s Energy Adviser Is Dangerously Anti-Environment</a>,” <em>Motherboard</em>, May 18, 2016. <a href=\"http://web.archive.org/web/20160525202554/http://motherboard.vice.com/read/trumps-energy-adviser-is-dangerously-anti-environment-kevin-cramer\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 25, 2016</a>. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6277>
        rdf:type                 schema:Claim;
        schema:abstract          "“There is that sense of the Senate that climate change is real and not a hoax. Now, we can throw that out as sort of meaningless.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6277/source/19>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kevin-cramer/>;
        schema:claimInterpreter  <http://desmog.com/>;

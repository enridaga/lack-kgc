        rdf:type                 schema:Claim;
        schema:abstract          "[…] We need to embrace a stewardship mentality. And, to whom much is given, much is required. And use those natural resources we’ve been blessed with to bless others, both domestically and internationally. And we’ve got to have that dialogue.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4615/source/31>;

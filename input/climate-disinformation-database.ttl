<http://data.open.ac.uk/climate-sense/claim/5388>
        rdf:type                 schema:Claim;
        schema:abstract          "“Coalitions led by CEI were instrumental in defeating ratification of the 1997 Kyoto Protocol, defeating enactment of the 2009 Waxman-Markey cap-and-trade bill, and convincing President Trump to withdraw from the 2015 Paris climate treaty.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5388/source/15>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/competitive-enterprise-institute/>;

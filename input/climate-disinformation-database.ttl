<http://data.open.ac.uk/climate-sense/claim/558/source/54>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20171013011119/http://www.thegwpf.com/benny-peiser-climate-realism-a-lukewarm-approach-to-global-warming/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">BENNY PEISER: CLIMATE REALISM – A LUKEWARM APPROACH TO GLOBAL WARMING</a>,” <em>Global Warming Policy Forum</em>, September 5, 2017. Archive.is URL: <a href=\"https://archive.is/MgQok\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/MgQok</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/558>
        rdf:type                 schema:Claim;
        schema:abstract          "“There are many scientific agreements and disagreements in climate science. While there is general agreement about the modern global warming trend (since 1850), scientific controversies increase as climate research moves further back in time, and predictions move further into the future. Climate realism acknowledges the significant difference between verifiable and replicable knowledge, and hypothetical knowledge based on indirect&nbsp;evidence.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/558/source/54>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/benny-peiser/>;
        schema:claimInterpreter  <http://desmog.com/>;

<http://data.open.ac.uk/climate-sense/claim/10632>
        rdf:type                 schema:Claim;
        schema:abstract          "“This agreement will not meaningfully alter the temperature of the Earth, even under the U.N.’s own computer models.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10632/source/9>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/craig-rucker/>;

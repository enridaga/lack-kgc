<http://data.open.ac.uk/climate-sense/claim/6670>
        rdf:type                 schema:Claim;
        schema:abstract          "“In a pragmatic, just, and well-managed energy transition, we must be laser focused on phasing out fossil fuel emissions while phasing up and scaling up viable, affordable, zero carbon alternatives. This is the approach we have been taking in the United Arab Emirates for more than 20 years, where we have embraced in practice the energy transition.” [50:31]";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6670/source/125>;

<http://data.open.ac.uk/climate-sense/claim/7409/source/35>
        rdf:type         schema:CreativeWork;
        schema:citation  "Brian Giesbrecht. “<a href=\"https://web.archive.org/web/20240710175435/https://c2cjournal.ca/2020/01/an-endless-cycle-of-despair/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">An Endless Cycle of Despair</a>,” <em>C2C Journal</em>, January 31, 2020. Archived July 10, 2024. Archive URL: <a href=\"https://archive.ph/42bde\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/42bde</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7409>
        rdf:type                 schema:Claim;
        schema:abstract          "“[B]laming colonialism or other past injustices is a triumph of the victim narrative that will put more Indigenous children at risk.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7409/source/35>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/manning-foundation-for-democratic-education/>;

<http://data.open.ac.uk/climate-sense/claim/8333>
        rdf:type                 schema:Claim;
        schema:abstract          "b73";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8333/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alex-epstein/>;

        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/copenhagen-consensus-center/" .

<http://data.open.ac.uk/climate-sense/claim/2740/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2740>
        rdf:type                 schema:Claim;
        schema:abstract          "“A foreign group’s creation of a US ‘shell’ charity to gather US funds and funnel them abroad is the most obvious of ‘foreign conduits’ in IRS parlance, #1 on its list of no-no’s. IRS revocation of 501(c)(3) status not only eliminates tax breaks for ordinary donors, but eliminates entirely crucial major gifts from private foundations like the Randolph Foundation, Ewing Marion Kauffman Foundation and the Paul E. Singer Foundation.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2740/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/copenhagen-consensus-center/>;

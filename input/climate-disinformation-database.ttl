<http://data.open.ac.uk/climate-sense/claim/9912>
        rdf:type                 schema:Claim;
        schema:abstract          "“Our industry is responsible for 62% of the greenhouse gas emissions reductions in the electricity sector, compared to just 38% for wind, solar and other non-carbon generation, according to the Energy Information&nbsp;Administration.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9912/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/western-energy-alliance/>;

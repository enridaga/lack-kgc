        rdf:type                 schema:Claim;
        schema:abstract          "“The plan they put out really is illegal, and it far exceeds the authority of the EPA’s ability in the Clean Air Act to even impose something like this,” Domenech adds.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3457/source/74>;

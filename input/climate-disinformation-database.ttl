<http://data.open.ac.uk/climate-sense/claim/10408>
        rdf:type                 schema:Claim;
        schema:abstract          "“Obviously CO";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10408/source/>;

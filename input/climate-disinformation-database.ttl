        rdf:type         schema:CreativeWork;
        schema:citation  "Gayathri Vaidyanathan. “<a href=\"http://www.eenews.net/stories/1060029290\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">ADVOCACY:Think tank that cast doubt on climate change science morphs into smaller one</a>,” <em>ClimateWire</em>, December 10, 2015. Accessed at E&amp;E Publishing. <a href=\"http://web.archive.org/web/20160226204558/http://www.eenews.net/stories/1060029290\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Archived February 26, 2016</a>. WebCite URL: <a href=\"http://www.webcitation.org/6faqJBtXR\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">http://www.webcitation.org/6faqJBtXR</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5592>
        rdf:type                 schema:Claim;
        schema:abstract          "“We kept the hardest part of the problem – the climate problem,” he said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5592/source/11>;

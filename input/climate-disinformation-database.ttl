        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12935>
        rdf:type                 schema:Claim;
        schema:abstract          "“We’ve seen 31,000 scientists just came out who are skeptical of global warming. And they’re worried that the policies people are proposing are actually going to harm the planet and they’re going to make people poorer. We also see some of the effects these regulations can have on the developing countries where serious poverty is a real problem.”&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12935/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/acton-institute/>;

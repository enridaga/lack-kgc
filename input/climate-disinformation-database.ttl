        rdf:type         schema:CreativeWork;
        schema:citation  "Steven Goddard. “<a href=\"http://web.archive.org/web/20160906043500/http://www.theregister.co.uk/2008/08/15/goddard_arctic_ice_mystery/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Arctic ice refuses to melt as ordered</a>,”&nbsp;<em>The Register</em>, August 15, 2008. Archived September 6, 2016. Archive.is URL:&nbsp;<a href=\"https://archive.is/ewavl\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/ewavl</a>"^^rdf:HTML .


<http://data.open.ac.uk/climate-sense/claim/8049/source/53>
        rdf:type         schema:CreativeWork;
        schema:citation  "Bjorn Lomborg.&nbsp;”<a href=\"http://www.nytimes.com/2013/12/04/opinion/the-poor-need-cheap-fossil-fuels.html\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">The Poor Need Cheap Fossil Fuels</a>,”&nbsp;<em>The New York Times The Opinion Pages</em>, December 3, 2013.&nbsp;Archive .is URL:&nbsp;<a href=\"https://archive.is/WjSOP\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/WjSOP</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8049>
        rdf:type                 schema:Claim;
        schema:abstract          "“There’s no question that burning fossil fuels is leading to a warmer climate and that addressing this problem is important. But doing so is a question of timing and priority. For many parts of the world, fossil fuels are still vital and will be for the next few decades, because they are the only means to lift people out of the smoke and darkness of energy poverty.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8049/source/53>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;

<http://data.open.ac.uk/climate-sense/claim/3469>
        rdf:type                 schema:Claim;
        schema:abstract          "“The essence of the way environmental people think, when you really boil it down, is that the way we can protect our kids is not to have them in the first place,” Domenech told Martinez.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3469/source/44>;

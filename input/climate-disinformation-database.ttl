<http://data.open.ac.uk/climate-sense/claim/6192/source/5>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20111119180124/www.associatedcontent.com/article/298630/no_one_really_knows_on_global_warming.html?cat=15\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">No One Really Knows on Global Warming, Oklahoma Weather Forecaster Says</a>.” <em>Associated Content</em>, July 1, 2007."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6192>
        rdf:type                 schema:Claim;
        schema:abstract          "“Here in Oklahoma we’re a little warmer than we were 30 years ago. Recently we ended a two year drought and it has been replaced with significant, long duration rains. Is all of this a result of global warming? Maybe it is and maybe it isn’t. You see, no one really knows. If they say they do, I suggest that person is confused at best or has an agenda at the worst.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6192/source/5>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/gary-england/>;

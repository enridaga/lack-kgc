<http://data.open.ac.uk/climate-sense/claim/11493>
        rdf:type                 schema:Claim;
        schema:abstract          "“Even if that were true, isn’t the relevant question, how much worse? Not to mention that ‘worse’ is not exactly a scientific term.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11493/source/>;

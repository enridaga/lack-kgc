<http://data.open.ac.uk/climate-sense/claim/3808>
        rdf:type                 schema:Claim;
        schema:abstract          "“[T]he Earth’s climate is not changing in an unusual or anomalous fashion. The EPA relied on instrumental data that were adjusted to exaggerate the increase in global temperatures.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3808/source/>;

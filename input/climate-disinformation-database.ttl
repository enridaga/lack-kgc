        rdf:type                 schema:Claim;
        schema:abstract          "“Deleted from the text was: ‘The United States is taking a leading role by advancing an ever-expanding suite of measures at home and abroad.’ Also stricken were references to mitigation efforts and other mentions of leading on climate change.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2135/source/99>;

        rdf:type                 schema:Claim;
        schema:abstract          "“Environmental initiatives are often highly popular, and EPA, beset as it always is by interest groups whose métier is exaggeration and alarmism, may find it difficult to see past the lobbying fog: it may underestimate as well as overestimate popular support in a way that constituency-minded legislators would not.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6846/source/>;

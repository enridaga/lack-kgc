        rdf:type                 schema:Claim;
        schema:abstract          "b20";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9907/source/18>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/western-energy-alliance/>;

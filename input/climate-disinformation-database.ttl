<http://data.open.ac.uk/climate-sense/claim/12904/source/45>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.wsj.com/articles/SB10001424052748703915204575103200554489166\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Voices from the Conference</a>,” <em>Wall Street Journal</em>, March 8, 2010. Archive URL: <a href=\"https://archive.vn/oS30U\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/oS30U</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12904>
        rdf:type                 schema:Claim;
        schema:abstract          "“The real challenge is: How do you make low-carbon energy really cheap—as cheap as coal is? I think the reality is that we are not going to get beyond a fossil-fuel economy, and I don’t think we are going to impose big costs on the fossil-fuel economy either in the ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12904/source/45>;

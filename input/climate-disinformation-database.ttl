<http://data.open.ac.uk/climate-sense/claim/8043/source/49>
        rdf:type         schema:CreativeWork;
        schema:citation  "Bjorn Lomborg. “<a href=\"http://www.wsj.com/articles/an-overheated-climate-alarm-1459984226\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">An Overheated Climate Alarm</a>,” <em>The Wall Street Journal.</em> Archived .pdf on file at Desmog.&nbsp;Archive .is URL:&nbsp;Archive .is URL:&nbsp;<a href=\"https://archive.is/YoA3H\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/YoA3H</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8043>
        rdf:type                 schema:Claim;
        schema:abstract          "“In pushing too hard for the case that global warming is universally bad for everything, the administration’s report undermines the reasonable case for climate action. Focusing on only the bad side of the ledger destroys academic and political credibility.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8043/source/49>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/bjorn-lomborg/" .

<http://data.open.ac.uk/climate-sense/claim/8042/source/49>
        rdf:type         schema:CreativeWork;
        schema:citation  "Bjorn Lomborg. “<a href=\"http://www.wsj.com/articles/an-overheated-climate-alarm-1459984226\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">An Overheated Climate Alarm</a>,” <em>The Wall Street Journal.</em> Archived .pdf on file at Desmog.&nbsp;Archive .is URL:&nbsp;Archive .is URL:&nbsp;<a href=\"https://archive.is/YoA3H\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/YoA3H</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8042>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate change is a genuine problem that will eventually be a net detriment to society. Gradually rising temperatures across decades will increase the number of hot days and heat waves. If humans make no attempts whatsoever to adapt—a curious assumption that the report inexplicably relies on almost throughout—the total number of heat-related deaths will rise. But correspondingly, climate change will also reduce the number of cold days and cold spells. That will cut the total number of cold-related deaths.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8042/source/49>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/bjorn-lomborg/" .

<http://data.open.ac.uk/climate-sense/claim/8041/source/48>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.cbc.ca/radio/the180/the-positives-of-climate-change-the-ar-15-in-canada-and-elective-c-sections-are-a-feminist-issue-1.3638725/opinion-climate-change-is-bad-but-it-comes-with-benefits-too-1.3639568\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Opinion: Climate change is bad, but it comes with benefits too</a>,” <em>CBC Radio</em>, June 19, 2016. <a href=\"http://web.archive.org/web/20160905190750/http://www.cbc.ca/radio/the180/the-positives-of-climate-change-the-ar-15-in-canada-and-elective-c-sections-are-a-feminist-issue-1.3638725/opinion-climate-change-is-bad-but-it-comes-with-benefits-too-1.3639568\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived September 5, 2016</a>. Archive.is URL:&nbsp;<a href=\"https://archive.is/A5hpn\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/A5hpn</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8041>
        rdf:type                 schema:Claim;
        schema:abstract          "“[J]ust like every other issue, there’s both positives and negatives to global warming. Overall, and in the long run, the negatives will outweigh the positives, but there is a lot of positives to global warming right now.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8041/source/48>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;

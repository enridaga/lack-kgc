        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3064>
        rdf:type                 schema:Claim;
        schema:abstract          "“Through publications and testimony, this organization worked to introduce, defend, and promote the following basic concept: ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3064/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/council-competitive-economy/>;

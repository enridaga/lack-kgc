        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20171220023010/https://www.australianmining.com.au/news/gina-rinehart-urges-australians-to-fight-against-carbon-and-mining-taxes/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Gina Rinehart urges Australians to fight against carbon and mining taxes</a>,”&nbsp;<em>Australian Mining</em>, May 5, 2011. Archived December 20, 2017. Archive.is URL: <a href=\"https://archive.is/uVeNi\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/uVeNi</a>"^^rdf:HTML .


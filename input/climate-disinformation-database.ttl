<http://data.open.ac.uk/climate-sense/claim/5399/source/130>
        rdf:type         schema:CreativeWork;
        schema:citation  "Sarah Sloat. “<a href=\"https://www.inverse.com/article/11643-climate-change-denying-mit-prof-richard-lindzen-is-suddenly-popular-still-wrong\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Climate Change-Denying&nbsp;MIT&nbsp;Prof. Richard Lindzen Is Suddenly Popular, Still Wrong</a>,”<em>&nbsp;Inverse</em>, February 17, 2016. Archive URL: <a href=\"https://archive.ph/Qwpq3\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/Qwpq3</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5399>
        rdf:type                 schema:Claim;
        schema:abstract          "“It’s&nbsp;OK&nbsp;to be wrong, and [Richard Lindzen] is a smart person, but most people don’t really understand that one way of using your intelligence is to spin ever more clever ways of deceiving yourself. … He has made a career of being wrong in interesting ways about climate&nbsp;science.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5399/source/130>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/competitive-enterprise-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/competitive-enterprise-institute/" .

<http://data.open.ac.uk/climate-sense/claim/5398/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5398>
        rdf:type                 schema:Claim;
        schema:abstract          "“If that’s the case, though, it begs the question of why Glaxo and other pharmaceutical industry outfits that pledged their support to Obamacare have simultaneously backed a group that for years has been plotting the law’s destruction,” writes&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5398/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/competitive-enterprise-institute/>;

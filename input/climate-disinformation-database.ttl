        schema:citation  "“<a href=\"http://web.archive.org/web/20151012205921/http://www.freedomworks.org/content/freedomworks-supports-lifting-oil-export-ban-without-handouts\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">FreedomWorks Supports Lifting the Oil Export Ban without Handouts</a>,” FreedomWorks, October 8, 2015. Archived October 12, 2015. WebCite URL:&nbsp;<a href=\"http://www.webcitation.org/6cESn2tAW\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://www.webcitation.org/6cESn2tAW</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/699>
        rdf:type                 schema:Claim;
        schema:abstract          "“Please contact your representative and ask that they support lifting the ban on crude oil exports, while demanding that the cost savings not be passed on to special interest lobbies and Big Labor,” FreedomWorks CEO Adam Brandon wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/699/source/51>;

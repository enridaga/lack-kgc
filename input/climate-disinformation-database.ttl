        rdf:type         schema:CreativeWork;
        schema:citation  "Heartland Institute, “<a href=\"http://web.archive.org/web/20090318014550/http://www.heartland.org/events/NewYork09/PDFs/NY09Program.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">International Conference on Climate Change: Global Warming: Was It Ever Really a Crisis?</a>“&nbsp;<a href=\"http://web.archive.org/web/20090318014550/http://www.heartland.org/events/NewYork09/PDFs/NY09Program.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">(PDF)</a>, March 8-10, 2009, page 32. Archived March 18,&nbsp;2009."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11606>
        rdf:type                 schema:Claim;
        schema:abstract          "“[O]ur climate is driven by natural cycles, not by humans. We fear that one of those cycles – the Milankovitch Cycle – is leading us into the next ice age right now. We also fear that this nonsense about ‘global warming’ will leave us blindsided and unprepared.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11606/source/7>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/iceagenow/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/iceagenow/" .

<http://data.open.ac.uk/climate-sense/claim/11605/source/3>
        rdf:type         schema:CreativeWork;
        schema:citation  "George Monbiot. “<a href=\"https://web.archive.org/web/20151030223645/http://www.theguardian.com/environment/2005/may/10/environment.columnists\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Junk science</a>,”&nbsp;<em>The Guardian</em>, May 10, 2005. Archived October 30, 2015. Archive URL: <a href=\"https://archive.ph/7iNdL\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/7iNdL</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11605>
        rdf:type                 schema:Claim;
        schema:abstract          "“Is Felix a climatologist, a volcanologist or an oceanographer?” Monbiot asks. “Er, none of the above. His biography describes him as a ‘former architect’. His website is so bonkers that I thought at first it was a spoof. Sadly, he appears to believe what he&nbsp;says.”&nbsp;";

<http://data.open.ac.uk/climate-sense/claim/12537>
        rdf:type                 schema:Claim;
        schema:abstract          "“I am here today to testify that the climate of the 20th century is neither unusual nor the most extreme. Around 1,000 years ago, the temperature over many parts of the world was warm. A widespread cooling then set in for several centuries, followed by a recovery to 20th century warming.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12537/source/35>;

<http://data.open.ac.uk/climate-sense/claim/12966/source/38>
        rdf:type         schema:CreativeWork;
        schema:citation  "David B. Rivkin Jr. and Andrew M. Grossman. “<a href=\"https://www.wsj.com/articles/pulling-the-plug-on-obamas-power-plan-1455148680\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Pulling the Plug on Obama’s Power Plan</a>,” <em>The Wall Street Journal</em>, February 10, 2016. Archive URL: <a href=\"https://archive.ph/poE7v\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/poE7v</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12966>
        rdf:type                 schema:Claim;
        schema:abstract          "“It’s one thing for a rule to be unlawful—which happens, and rarely merits a stay—but another for it to be lawless. This one was lawless. That is why the court had to act: to reassert the rule of law over an executive who believes himself above it,” Rivkin and Grossman&nbsp;write.&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12966/source/38>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/free-speech-science-project/>;

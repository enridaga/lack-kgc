        rdf:type         schema:CreativeWork;
        schema:citation  "David Rose. “<a href=\"https://web.archive.org/web/20190104222036/https://www.dailymail.co.uk/news/article-6539067/Why-youve-told-polar-bears-WRONG-Inuits-different-story.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Why all you’ve been told about these polar bears could be WRONG</a>,” <em>The Daily Mail</em>. December 29, 2018. Archived January 4, 2019. Archive.is URL: <a href=\"http://archive.vn/Fqt0w\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.vn/Fqt0w</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2874>
        rdf:type                 schema:Claim;
        schema:abstract          "“Activists claim that polar bears are ‘the canary in the coalmine’ that proves how dangerous climate change is, not only to bears but humans. But what if they chose the wrong species? And if the scientists are wrong about the bears, will it be only the Inuit who become more skeptical?”";

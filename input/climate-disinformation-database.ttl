<http://data.open.ac.uk/climate-sense/claim/6195>
        rdf:type                 schema:Claim;
        schema:abstract          "“Increased CO2 actually increases crop production. When CO2 drops to less than 150 (parts per million) plants will commence failing. If the plants die, then the livestock die and then guess who is next?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6195/source/9>;

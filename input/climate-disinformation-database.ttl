<http://data.open.ac.uk/climate-sense/claim/9812>
        rdf:type                 schema:Claim;
        schema:abstract          "“Anything beyond a mild warming is predicated upon the idea of ever more fossil fuel use. If that’s not true because of what we’ve already done then anything beyond a mild warming is not true either,” Worstall&nbsp;concludes.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9812/source/12>;

<http://data.open.ac.uk/climate-sense/claim/12945>
        rdf:type                 schema:Claim;
        schema:abstract          "Now that’s very interesting also because Alexis de Tocqueville, the writer of";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12945/source/>;

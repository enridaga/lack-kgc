<http://data.open.ac.uk/climate-sense/claim/9775/source/19>
        rdf:type         schema:CreativeWork;
        schema:citation  "Nicholas Ballasy. “<a href=\"http://web.archive.org/web/20160816191142/http://dailycaller.com/2013/02/22/black-conservatives-gun-control-has-racist-roots-video/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Black conservatives: Gun control has ‘racist’ roots [VIDEO]</a>,”&nbsp;<em>The Daily Caller</em>, February 22, 2013. Archived August 16, 2016. Archive.is URL:&nbsp;<a href=\"https://archive.is/zbOtx\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/zbOtx</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9775>
        rdf:type                 schema:Claim;
        schema:abstract          "“The National Rifle Association was started, founded by religious leaders who wanted to protect free slaves from the Ku Klux Klan. They would raise money, buy arms, show the free slaves how to use those arms and protect their families. God bless you. Many of us probably wouldn’t be here today if it wasn’t for the NRA.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9775/source/19>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/harry-c-alford/>;

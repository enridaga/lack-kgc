        rdf:type                 schema:Claim;
        schema:abstract          "[00:56:51] I hope, like I said, I hope he’s right. I hope that this is the bazooka I needed to tear down the environmental Berlin Wall.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1173/source/>;

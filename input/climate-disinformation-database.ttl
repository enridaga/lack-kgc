        rdf:type                 schema:Claim;
        schema:abstract          "“On Climate Science, I state as a fundamental conclusion that";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1151/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-sr/>;

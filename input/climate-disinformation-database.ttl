        rdf:type         schema:CreativeWork;
        schema:citation  "Roger A. Pielke Sr. “<a href=\"http://web.archive.org/web/20110316112224/http://republicans.energycommerce.house.gov/Media/file/Hearings/Energy/030811/Pielke.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Testimony to the Subcommittee on Energy and Power entitled “Climate Science and EPA’s Greenhouse Gas Regulation” (PDF)</a>,<em> The Energy and Commerce Committee</em>, March 8, 2011. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1135>
        rdf:type                 schema:Claim;
        schema:abstract          "“1. Research has shown that a focus on just carbon dioxide and a few other greenhouse gases as the dominant human influence on climate is too narrow, and misses other important human influences.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1135/source/36>;

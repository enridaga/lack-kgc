        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/priti-patel/" .

<http://data.open.ac.uk/climate-sense/claim/6/source/23>
        rdf:type         schema:CreativeWork;
        schema:citation  "Priti Patel. “<a href=\"https://capx.co/countries-cannot-power-their-way-to-prosperity-on-renewables-alone/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Countries cannot power their way to prosperity on renewables alone</a>,” <em>CapX</em>, April 6, 2018. <a href=\"http://web.archive.org/web/20190822113930/https://capx.co/countries-cannot-power-their-way-to-prosperity-on-renewables-alone/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived August 22, 2019</a>. Archive.fo URL: <a href=\"http://archive.fo/wcVCT\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/wcVCT</a>"^^rdf:HTML .


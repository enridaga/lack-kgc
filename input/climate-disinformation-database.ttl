        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20191127025634/https://www.pipelinenews.ca/news/local-news/anti-pipeline-campaign-was-planned-intended-and-foreign-funded-vivian-krause-1.23866860\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Anti-pipeline campaign was planned, intended, and foreign-funded: Vivian Krause</a>,” <em>Pipeline News</em>, June 25, 2019. Archived November 27, 2019. Archive.fo URL: <a href=\"https://archive.ph/tDovV\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/tDovV</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8886>
        rdf:type                 schema:Claim;
        schema:abstract          "“Finally, we have Canadian politicians with the courage to take on the Rockefellers,” Krause said. “So I think we need to make sure we continue to support them, let them know they’re not alone in this fight. This is no small ordeal. It’s a huge, daunting challenge.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8886/source/52>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vivian-m-krause/>;

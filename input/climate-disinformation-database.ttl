<http://data.open.ac.uk/climate-sense/claim/10657/source/10>
        rdf:type         schema:CreativeWork;
        schema:citation  "Robert Bebber. “The Cult of Global Warming” <a href=\"http://www.jamesmadison.org/pdf/materials/631.pdf#page=40\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">(PDF)</a>, <em>James Madison Journal</em>, Winter/Spring 2008."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10657>
        rdf:type                 schema:Claim;
        schema:abstract          "“[S]tudies suggest that less than half of all published scientists endorse ‘Global Warming’ theory… . we do not yet understand what ‘Global Warming’ is, whether it is a natural occurrence or that human activity is having a direct impact. […] [T]he evidence also shows that the temperature was rising hundreds of years before carbon dioxide levels were rising. This contradicts the theory that rising CO2 levels cause an increase in the earth’s temperature.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10657/source/10>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/james-madison-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/james-madison-institute/" .

<http://data.open.ac.uk/climate-sense/claim/10656/source/9>
        rdf:type         schema:CreativeWork;
        schema:citation  "Robert J. Bebber. “<a href=\"http://web.archive.org/web/20160408190444/http://www.jamesmadison.org/pdf/materials/Journal_Summer2010_BEBBER.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">‘Climategate’ Provides Lessons for Policy Makers” (</a><a href=\"http://web.archive.org/web/20160408190444/http://www.jamesmadison.org/pdf/materials/Journal_Summer2010_BEBBER.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">PDF)</a>, The Journal of the James Madison Institute, Summer 2010."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10656>
        rdf:type                 schema:Claim;
        schema:abstract          "“Today, the scientists and the research associated with global warming have lost the credibility and authority with which they have argued their point. By arguing forcefully and loudly for more than 20 years that the data are “certain” and that the world’s scientific community is ‘unified’ in its belief that global warming is a man-made phenomena and will lead to a global environmental apocalypse, they have destroyed their position as an honest, dispassionate broker of knowledge. They have done a disservice to themselves and to science at large.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10656/source/9>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/james-madison-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/james-madison-institute/" .


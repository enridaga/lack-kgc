<http://data.open.ac.uk/climate-sense/claim/1936/source/50>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.documentcloud.org/documents/5453339-1996-GCC-Overview-and-Reports.html\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Global Climate Coalition: An Overview</a>,”&nbsp;<em>Global Climate Coalition</em>, November 11, 1996.&nbsp;<a href=\"http://web.archive.org/web/20190425101005/http://www.documentcloud.org/documents/5453339-1996-GCC-Overview-and-Reports.html\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Archived April 25, 2019</a>. Archive.fo&nbsp;URL:&nbsp;<a href=\"http://archive.fo/txH8X\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">http://archive.fo/txH8X</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1936>
        rdf:type                 schema:Claim;
        schema:abstract          "“The&nbsp;GCC&nbsp;believes that the preponderance of the evidence indicates that most, if not all, of the observed warming is part of a natural warming trend which began approximately 400 years ago. If there is an anthropogenic component to this observed warming, the&nbsp;GCC&nbsp;believes that it must be very small and must be superimposed on a much larger natural warming trend.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1936/source/50>;

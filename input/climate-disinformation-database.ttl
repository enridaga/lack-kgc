        schema:citation  "“<a href=\"https://www.washingtonexaminer.com/wasteful-subsidies-for-me-and-thee-not-for-that-fossil-guy-behind-the-tree/article/2630219\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Wasteful subsidies for me and thee, not for that fossil guy behind the tree</a>,” <em>Washington Examiner</em>, August 3, 2017."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12315>
        rdf:type                 schema:Claim;
        schema:abstract          "“And above all: There is the increase – yes, increase – in the emissions of conventional effluents caused by the up-and-down cycling of the conventional backup generation units needed to avoid blackouts caused by the unreliability of wind and solar power,” Zycher wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12315/source/35>;

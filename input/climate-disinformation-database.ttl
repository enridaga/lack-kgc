        rdf:type                 schema:Claim;
        schema:abstract          "“The pause in global warming​​—​​now going on 15 years​​—​​has become so obvious that many of the leading climate scientists are grudgingly admitting that global warming has stopped.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1970/source/15>;

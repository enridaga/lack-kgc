<http://data.open.ac.uk/climate-sense/claim/6258>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate is a word for regional weather variability. The earth has many climates, and life has lasted through severe global climate variability. Climate scientists readily agree that the earth has been warming for thousands of years following the peak of the last major glacial age. The warming has not been smooth and may or may not&nbsp;continue.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6258/source/30>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/american-institute-economic-research/>;

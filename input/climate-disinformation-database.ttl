        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s22\" name=\"s22\" href=\"https://web.archive.org/web/20201020194159/https://www.aier.org/wp-content/uploads/2013/11/EEB200805.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“The Global Warming Debate: Science, Economics, and Policy” (<span class=\"caps\">PDF</span>),</a>&nbsp;<em>Economic Education Bulletin</em>&nbsp;(Published by <span class=\"caps\">AIER</span>),&nbsp;Vol. <span class=\"caps\">XLVIII</span> No. 5 (May 2008). Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .


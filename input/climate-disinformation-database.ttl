        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/thomas-jefferson-institute-public-policy/" .

<http://data.open.ac.uk/climate-sense/claim/2055/source/28>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.newsplex.com/home/headlines/Study-Looks-at-Potential-for-Nuclear-Power-306797011.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Study Looks at Potential for Nuclear Power,</a>”<em> NewsPlex.com,</em> June 10, 2015. WebCite URL: <a href=\"http://www.webcitation.org/6boa9mUkW\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://www.webcitation.org/6boa9mUkW </a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2055>
        rdf:type                 schema:Claim;
        schema:abstract          "“With continuing controversy surrounding oil, natural gas and coal production, nuclear power is an energy supply that should be, and could be, safely developed to meet much of Virginia’s future electrical power needs,” Michael W. Thompson, chairman and president of the Thomas Jefferson Institute said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2055/source/28>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/thomas-jefferson-institute-public-policy/>;

<http://data.open.ac.uk/climate-sense/claim/2997>
        rdf:type                 schema:Claim;
        schema:abstract          "“Donald Trump has said the first step in defeating our enemies is to identify them properly and see the connections between them,” Giuliani said. “To defeat Islamic extremist terrorism we must put them on defense. If they are at war against us ― which they have declared ― we must commit ourselves to unconditional victory against them.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2997/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rudy-giuliani/>;

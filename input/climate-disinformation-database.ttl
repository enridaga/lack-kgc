        rdf:type                 schema:Claim;
        schema:abstract          "“Electric vehicles are good in the sense that they don’t themselves produce emissions, but they do rely on electricity being generated in order to power them. And i’m just not sure that there’s much joined up thinking going on in this area.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4712/source/61>;

<http://data.open.ac.uk/climate-sense/claim/8002>
        rdf:type                 schema:Claim;
        schema:abstract          "“Carbon dioxide emissions are not a pollutant, guys, it’s not a pollutant. […] It does not harm the atmosphere.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8002/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jim-lakely/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;

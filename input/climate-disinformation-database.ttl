        rdf:type                 schema:Claim;
        schema:abstract          "“Based on the paleoclimatic data I and others have collected, it’s obvious that climate is and always has been variable. In fact, the only constant about climate is change; it changes continually. We certainly have no chance of stopping this natural phenomenon.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2812/source/12>;

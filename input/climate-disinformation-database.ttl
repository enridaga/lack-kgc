<http://data.open.ac.uk/climate-sense/claim/2996/source/59>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.cnbc.com/2016/07/18/rudy-giuliani-what-i-did-for-new-york-city-donald-trump-will-do-for-america.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Rudy Giuliani: What I did for New York City, Donald Trump ‘will do for America’,</a>” <em>CNBC News</em>, July 18, 2016.<a href=\"http://web.archive.org/web/20161213234459/http://www.cnbc.com/2016/07/18/rudy-giuliani-what-i-did-for-new-york-city-donald-trump-will-do-for-america.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> Archived December 13, 2016</a>. Archive.is URL: <a href=\"https://archive.is/CPm2O\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/CPm2O</a>"^^rdf:HTML .


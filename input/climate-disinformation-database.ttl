        rdf:type                 schema:Claim;
        schema:abstract          "“Why [have] the Republicans not had a more full-throated saying, ‘No, we’re just going to shut this stuff down. We don’t care if the president vetoes it or not, but we’re not going to fund this continual madness?’";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7330/source/49>;

        rdf:type                 schema:Claim;
        schema:abstract          "“A sensible climate policy would emphasize building resilience into our capacity to adapt to climate changes–whether cooling or warming; whether wholly natural, wholly man-made, or somewhere in between.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1979/source/25>;

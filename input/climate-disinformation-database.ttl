        schema:citation  "“<a href=\"http://web.archive.org/web/20110728123741/http://naturalscience.com/ns/letters/ns_let07.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Re: Global warming: It’s happening</a>,” Letter to <em>NaturalSCIENCE</em>, January 29, 1998. Archived July 28, 2011. Archive.fo URL: <a href=\"https://archive.ph/cvhtm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/cvhtm</a>"^^rdf:HTML .


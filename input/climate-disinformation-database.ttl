<http://data.open.ac.uk/climate-sense/claim/3292>
        rdf:type                 schema:Claim;
        schema:abstract          "“Human-induced climate change is not leading to mass species extinctions, nor should it in the future.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3292/source/17>;

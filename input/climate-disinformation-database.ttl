<http://data.open.ac.uk/climate-sense/claim/4678>
        rdf:type                 schema:Claim;
        schema:abstract          "“Unfortunately the IPSO Complaints Committee decided that the article did not breach the Editors’ Code of Practice and that Mr Booker was allowed to make up his own definition of heatwave, ignore the results of experts, and present meteorological information in a selective and misleading way.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4678/source/19>;

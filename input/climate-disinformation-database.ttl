        rdf:type         schema:CreativeWork;
        schema:citation  "Doug Domenech. “<a href=\"http://web.archive.org/web/20170226033315/http://www.realclearenergy.org/articles/2016/05/17/dissent_must_be_silenced_109141.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Dissent Must Be Silenced</a>,” <em>RealClear Energy,</em> May 17, 2016. Archived February 25, 2017. Archive.is URL: <a href=\"https://archive.is/GAUON\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/GAUON</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3440>
        rdf:type                 schema:Claim;
        schema:abstract          "“On Earth Day, The Heritage Foundation published, ‘The State of Climate Science: No Justification for Extreme Policies.’ The report reviews much of what climate apologists insist is true including the myth that 97 percent of all climate scientists agree on global warming. That is a powerful rhetorical point and often quoted by the President, but it is also false and based on a faulty review of the abstracts of a limited number of papers,” Domenech wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3440/source/18>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/doug-domenech/" .

<http://data.open.ac.uk/climate-sense/claim/3439/source/>
        rdf:type         schema:CreativeWork;

        schema:citation  "“<a href=\"http://web.archive.org/web/20160726032407/https://pcc15.org\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Paris Climate Challenge</a>,” <em>PCC15.org.</em> Archived July 26, 2016. Archive.is URL:&nbsp;<a href=\"https://archive.is/OMEVI\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/OMEVI</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2091>
        rdf:type                 schema:Claim;
        schema:abstract          "“We call on governments, NGOs and universities to stop pursuing policy and dogma based ‘evidence’&nbsp;gathering.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2091/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/independent-committee-geoethics/>;

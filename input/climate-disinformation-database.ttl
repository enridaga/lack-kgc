<http://data.open.ac.uk/climate-sense/claim/9213/source/56>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=Vr9kanvxa6A\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Clean Coal Says ‘Emitting Carbon Dioxide = Doing God’s Work’</a>,” YouTube video uploaded by user greenkert, Feb 22, 2009. Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9213>
        rdf:type                 schema:Claim;
        schema:abstract          "“You’re doing God’s work. Every time you turn your car on, and you burn fossil fuels, and you put CO2 in the air, you’re doing the work of the lord. Absolutely. That’s the system, the ecological system we live in.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9213/source/56>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/fred-palmer/>;

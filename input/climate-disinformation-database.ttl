<http://data.open.ac.uk/climate-sense/claim/12429>
        rdf:type                 schema:Claim;
        schema:abstract          "“Instead of pushing emissions restrictions and failed ‘aid’ policies, governments should focus on reducing barriers to economic growth and adaptation – e.g. removing trade barriers and decentralising management of water and&nbsp;land.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12429/source/>;

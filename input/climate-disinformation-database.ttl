        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8686>
        rdf:type                 schema:Claim;
        schema:abstract          "We, the undersigned, having assessed the relevant scientific evidence, do not find convincing support for the hypothesis that human emissions of carbon dioxide are causing, or will in the foreseeable future cause, dangerous global warming.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8686/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/stewart-franks/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/stewart-franks/" .

<http://data.open.ac.uk/climate-sense/claim/8685/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "Alan Moran. “<a href=\"http://catallaxyfiles.com/2014/12/16/55806/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Change: the facts 2014</a>,” <em>Catallaxy Files</em> (blog), December 16, 2014."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8685>
        rdf:type                 schema:Claim;
        schema:abstract          "“Drawing heavily upon Karl Popper’s theories that scientific mate­rial should be subject to constant examination and should be falsifiable, Stewart Franks points to the many phenomena of climate change that the increase in greenhouse gases both failed to predict and fail to explain.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8685/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/stewart-franks/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/stewart-franks/" .

<http://data.open.ac.uk/climate-sense/claim/8684/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8684>
        rdf:type                 schema:Claim;
        schema:abstract          "“The climate models don’t work, so they need to find a reason why. So they’ll deny the problem until they can think of a narrative.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8684/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/stewart-franks/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/stewart-franks/" .

<http://data.open.ac.uk/climate-sense/claim/8683/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8683>
        rdf:type                 schema:Claim;
        schema:abstract          "“The point is, you can’t judge climate change by droughts. Can’t judge it by floods. Is it even warming? … No. Doesn’t look like it, does it. As put in that last 17 years, the numbers are a bit rubbery. Depends on your dataset.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8683/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/stewart-franks/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/stewart-franks/" .

<http://data.open.ac.uk/climate-sense/claim/8682/source/13>
        rdf:type         schema:CreativeWork;
        schema:citation  "Stewart Franks. “<a href=\"http://theconversation.edu.au/climate-and-floods-flannery-is-no-expert-but-neither-are-the-experts-5709\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate and floods: Flannery is no expert, but neither are the experts</a>,” <em>The Conversation</em>, March 6, 2012."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8682>
        rdf:type                 schema:Claim;
        schema:abstract          "“The mistake that Tim Flannery, as well as the numerous expert commentators made, was that they confused climate variability for climate change. The future impact of climate change is very uncertain, but when one ‘wants to believe’, then it is all too easy to get sucked in and to get it spectacularly wrong.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8682/source/13>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/stewart-franks/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/stewart-franks/" .


<http://data.open.ac.uk/climate-sense/claim/7665>
        rdf:type                 schema:Claim;
        schema:abstract          "“For example, as you know. President Trump has committed to pulling the United States out of the ill-conceived Paris climate accord. The White House has also scrubbed climate alarm propaganda from government websites. This is good news!";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7665/source/21>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-rothbard/>;

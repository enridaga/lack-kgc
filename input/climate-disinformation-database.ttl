        rdf:type                 schema:Claim;
        schema:abstract          "“I am just not for giving public companies who have shareholders, public dollars, free, when I know they’re going to be very profitable at the end whatever we do,” he said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6787/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-manchin/>;

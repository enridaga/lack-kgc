        rdf:type         schema:CreativeWork;
        schema:citation  "Peter Murphy. “<a href=\"https://web.archive.org/web/20211103144200/https://www.cfact.org/2021/11/03/cop-26-armageddon-awaits-at-the-un-climate-conference/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">COP 26: Armageddon awaits at the UN Climate Conference</a>,”&nbsp;<em>CFACT</em>, November 3, 2021. Archived November 3, 2021. Archive URL:<a href=\"https://archive.ph/tx2Qo\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/tx2Qo</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7593>
        rdf:type                 schema:Claim;
        schema:abstract          "“CFACT got to ask the only question permitted by NGOs. I stepped forward and asked them to comment about scientific findings which show that increased carbon emissions actually boost crop yields, which have led to record harvests for feeding the world. This would mean that CO2 isn’t just a ‘problem,’ but a benefit to helping feed the world. The panelists were having none of it — with one of them saying that any impact from CO2 has only a’negative’ effects, particularly on Africa, the region he represented.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7593/source/42>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/committee-constructive-tomorrow/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/committee-constructive-tomorrow/" .


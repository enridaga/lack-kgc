<http://data.open.ac.uk/climate-sense/claim/3459/source/72>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20170226011222/http://fuelingfreedomproject.com/doug-domenech-interviewed-on-coffee-and-markets/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Doug Domenech interviewed on Coffee and Markets</a>,” <em>Fueling Freedom</em>, August 10, 2015. Archived .mp3 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3459>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Heritage Foundation put out a great study that talks about how expensive it’s going to be. They estimate that everybody’s bill, including the poorest people in our society, are going to end up paying 12 to 17 percent more for their electricity. Heritage estimates a loss of 2.5 trillion in GDP across the country, and more than a million job losses. When you close these plants, especially coal plants, across the country, people are going to lose their jobs.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3459/source/72>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;
        schema:claimInterpreter  <http://desmog.com/>;

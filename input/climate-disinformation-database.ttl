        rdf:type         schema:CreativeWork;
        schema:citation  "David B. Rivkin Jr. and Andrew M. Grossman. “<a href=\"http://www.wsj.com/articles/punishing-climate-change-skeptics-1458772173\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Punishing Climate-Change Skeptics</a>,” <em>The Wall Street Journal</em>, March 23, 2016. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9802>
        rdf:type                 schema:Claim;
        schema:abstract          "“As the scientific case for a climate-change catastrophe wanes, proponents of big-ticket climate policies are increasingly focused on punishing dissent from an asserted “consensus” view that the only way to address global warming is to restructure society—how it harnesses and uses energy. That we might muddle through a couple degrees’ of global warming over decades or even centuries, without any major disruption, is the new heresy and must be suppressed.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9802/source/19>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Gordon J. Fulks, “<a href=\"https://www.oregonlive.com/opinion/2013/01/the_changing_climate_of_climat.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Changing Climate of Climate Change</a>,” <em>The Oregonian</em>, January 19, 2013. Archive.ph URL: <a href=\"https://archive.ph/70ONn\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/wip/70ONn</a>"^^rdf:HTML .


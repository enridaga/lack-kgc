<http://data.open.ac.uk/climate-sense/claim/607>
        rdf:type                 schema:Claim;
        schema:abstract          "He has written to my employers and publishers, accusing me of libel for writing this technical article. This is a false accusation of a serious offense, no longer just an academic disagreement. It has gone far beyond the bounds of acceptable debate.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/607/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tol/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;

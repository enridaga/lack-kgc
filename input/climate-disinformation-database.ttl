        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/rudy-giuliani/" .

<http://data.open.ac.uk/climate-sense/claim/2989/source/56>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=s_r66LQwrh4\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Rudy Giuliani’s Ideas for Dealing with Global Warming</a>,” YouTube video uploaded by user The Heat Is On, March 27, 2007. Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2989>
        rdf:type                 schema:Claim;
        schema:abstract          "“I don’t like taxes. I don’t know how to make that any clearer. I don’t like taxes. I generally think taxes are, given the level of taxation we have, and a lot of our states and in the country, inventing new ones is a very big mistake. Find other ways to do it.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2989/source/56>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rudy-giuliani/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/rudy-giuliani/" .

<http://data.open.ac.uk/climate-sense/claim/2988/source/55>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"//www.desmog.com/2016/12/10/rudy-giuliani-and-his-numerous-fossil-fuel-industry-connections-bows-out-potential-post-trump-admin\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Rudy Giuliani — And His Numerous Fossil Fuel Industry Connections — Out for Potential Post in Trump Admin</a>,” <em>DeSmog</em>, December 10, 2016."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2988>
        rdf:type                 schema:Claim;
        schema:abstract          "“It would be one thing if you had some minor role,” he says. “It’s another when one of the world’s largest lobbying groups renames itself after you.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2988/source/55>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rudy-giuliani/>;

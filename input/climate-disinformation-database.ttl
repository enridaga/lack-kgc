<http://data.open.ac.uk/climate-sense/claim/3080/source/59>
        rdf:type         schema:CreativeWork;
        schema:citation  "(Press Release). “<a href=\"http://web.archive.org/web/20160710175622/http://pompeo.house.gov/news/documentsingle.aspx?DocumentID=398717\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Pompeo on President Obama’s ‘Dangerously Wrong’ Priorities: ‘Radical Climate Change Agenda Is Not More Important than Fighting ISIS’</a>,” <em>US CongressmanMike Pompeo, </em>November 30, 2015. Archived July 10, 2016. Archive.is URL: <a href=\"https://archive.is/55yfL\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/55yfL</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3080>
        rdf:type                 schema:Claim;
        schema:abstract          "“The President has his priorities dangerously wrong. He is now headed to Paris to bow down to radical environmentalists, all the while refusing to stand up to radical Islamists. In this city that has suffered an enormous tragedy at the hands of jihadists, our President stands ready to handcuff the global economy instead of the barbarians that seek to kill Americans, our allies, and others all over the world.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3080/source/59>;

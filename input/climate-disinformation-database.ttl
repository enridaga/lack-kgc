<http://data.open.ac.uk/climate-sense/claim/8003>
        rdf:type                 schema:Claim;
        schema:abstract          "“Ultimately if they really are serious about this and really wanted to do it, our liberty and our freedom has to go.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8003/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jim-lakely/>;

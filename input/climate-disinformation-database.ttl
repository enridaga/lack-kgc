<http://data.open.ac.uk/climate-sense/claim/9469>
        rdf:type                 schema:Claim;
        schema:abstract          "“These [FoI] documents expose once again the double standards promoted by…the ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9469/source/28>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/global-warming-policy-foundation/>;

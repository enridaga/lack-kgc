<http://data.open.ac.uk/climate-sense/claim/2735>
        rdf:type                 schema:Claim;
        schema:abstract          "We work with more than a hundred of the world’s top economists and 7 Nobel Laureates. It is the work of these people that assure the public of the quality of the output of the Copenhagen Consensus.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2735/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/copenhagen-consensus-center/>;

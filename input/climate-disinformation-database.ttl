<http://data.open.ac.uk/climate-sense/claim/7802>
        rdf:type                 schema:Claim;
        schema:abstract          "“Here’s the dirty little secret about the new climate religion: it has *nothing* to do with the climate.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7802/source/61>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vivek-ramaswamy/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Brian Kahn. “<a href=\"http://www.climatecentral.org/news/state-dept-climate-change-web-page-21272\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The State Dept. Rewrote Its Climate Change Page</a>,” <em>Climate Central</em>, March 23, 2017. <a href=\"http://web.archive.org/web/20171025203845/http://www.climatecentral.org/news/state-dept-climate-change-web-page-21272\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived October 25, 2017</a>. Archive.is URL: <a href=\"https://archive.is/cOrZV\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/cOrZV</a>"^^rdf:HTML .


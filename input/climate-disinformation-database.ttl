        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://archive.fo/CzpvO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Determining the Regional Impacts of Climate Change</a>,” <em>University of Washington</em>. Archived October 25,&nbsp;2018."^^rdf:HTML .


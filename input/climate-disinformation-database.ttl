        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s16\" href=\"http://citeseerx.ist.psu.edu/viewdoc/download?doi=10.1.1.167.1483&amp;rep=rep1&amp;type=pdf\" name=\"s16\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“APPENDIX – SCIENCE AND TECHNOLOGY COMMITTEE SUBMISSION” (PDF)</a>, S. McIntyre, Feb. 10, 2010. From psu.edu."^^rdf:HTML .


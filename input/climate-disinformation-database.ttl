        rdf:type         schema:CreativeWork;
        schema:citation  "Roger Pielke. “<a href=\"https://web.archive.org/web/20200213152038/https:/www.forbes.com/sites/rogerpielke/2020/02/09/a-climate-blacklist-that-works-it-should-make-her-unhirable-in-academia\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">A Climate Blacklist That Works: ‘It Should Make Her Unhirable In Academia</a>,” <em>Forbes.com</em>, February 9, 2020. Archived February 9, 2020. Archive.is URL: <a href=\"http://archive.is/Avlad\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/Avlad</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1509>
        rdf:type                 schema:Claim;
        schema:abstract          "b15";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1509/source/45>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1508/source/25>
        rdf:type         schema:CreativeWork;
        schema:citation  "Roger A. Pielke Jr. and Daniel Sarewitz. “<a href=\"http://web.archive.org/web/20170128014643/http://sciencepolicy.colorado.edu/admin/publication_files/2000.17.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Anyone for global warming?</a>” <em>The Washington Times</em>, February 2, 2000. Retrieved from Centre for Science &amp; Policy Research at the University of Colorado. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1508>
        rdf:type                 schema:Claim;
        schema:abstract          "“Predictions of the future can be more dangerous than ignorance, if they induce us to behave in ways that reduce our resilience in the face of inevitable&nbsp;uncertainties and contingencies. When predictions are made about events decades or centuries hence, such as the level of the stock market or the conditions of a changing climate, it is simply impossible to verify their accuracy , no matter how impressive the supporting science may&nbsp;be.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1508/source/25>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1507/source/24>
        rdf:type         schema:CreativeWork;
        schema:citation  "Daniel Sarewitz and Roger Pielke JR. “<a href=\"http://web.archive.org/web/20170128015705/http://sciencepolicy.colorado.edu/admin/publication_files/resource-47-2001.17.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Changes; Society Has To Learn To Adapt</a>,” <em>The Albuquerque Journal</em>, August 5, 2001. Retrieved from Centre for Science &amp; Policy Research at the University of Colorado. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1507>
        rdf:type                 schema:Claim;
        schema:abstract          "“Of course, it is quite reasonable to believe, as many climate scientists do, that the record of past temperature increased, combined with knowledge of atmospheric chemistry and physics, foretells a warmer future. But what such scientists do not, and cannot, know is this: what will be the impact of such warming on humans and the environment,and how will those impacts change if we limit&nbsp;emissions?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1507/source/24>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1506/source/24>
        rdf:type         schema:CreativeWork;
        schema:citation  "Daniel Sarewitz and Roger Pielke JR. “<a href=\"http://web.archive.org/web/20170128015705/http://sciencepolicy.colorado.edu/admin/publication_files/resource-47-2001.17.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Changes; Society Has To Learn To Adapt</a>,” <em>The Albuquerque Journal</em>, August 5, 2001. Retrieved from Centre for Science &amp; Policy Research at the University of Colorado. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1506>
        rdf:type                 schema:Claim;
        schema:abstract          "According to the authors, “climate policy makers continue to focus on energy policy as the primary means to address future climate impacts. The approach is simply doomed to fail. Why has the idea of adaptation been so neglected in the political and scientific&nbsp;arenas?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1506/source/24>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1505/source/23>
        rdf:type         schema:CreativeWork;
        schema:citation  "Roger A. Pielke JR. “<a href=\"http://web.archive.org/web/20170128020200/http://sciencepolicy.colorado.edu/admin/publication_files/resource-268-2003.07.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">When Science Gets Political,</a>” <em>Newsday.com</em>, February 23, 2003. Retrieved from Centre for Science &amp; Policy Research at the University of Colorado. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1505>
        rdf:type                 schema:Claim;
        schema:abstract          "“Today we see a subset of scientists trying to use their science to affect political outcomes. The most obvious example is with the Kyoto protocol on global warming, where scientists are arrayed on both sides of the debate. What policy makers need from scientists is not support for or against the protocol, but practical alternatives to deal with climate change. The protocol is more a symbol than an proposal for a real&nbsp;solution.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1505/source/23>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1504/source/22>
        rdf:type         schema:CreativeWork;
        schema:citation  "Roger A. Pielke Jr. “<a href=\"http://web.archive.org/web/20170128024307/http://sciencepolicy.colorado.edu/admin/publication_files/2003.26.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Speakout: Pre-emptive politics ignore science” (PDF),</a> <em>Rocky Mountain News</em>, August 18, 2003. Retrieved from Centre for Science &amp; Policy Research at the University of Colorado. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1504>
        rdf:type                 schema:Claim;
        schema:abstract          "“We risk bad policy when all choices before us are bad ones. For instance, the Kyoto protocol on climate change has its supporters and opponents, but very few are willing to admit that debate over its implementation has considerably more symbolic value than practical effect. The debate over the war on Iraq may have been similarly misguided as better policy options may have been ignored. In both cases, a commitment to pre-emption enables the politicization of intelligence, which then serves as a constraint on options that may be more effective but, for certain ideologues, politically less&nbsp;desirable.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1504/source/22>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1503/source/22>
        rdf:type         schema:CreativeWork;
        schema:citation  "Roger A. Pielke Jr. “<a href=\"http://web.archive.org/web/20170128024307/http://sciencepolicy.colorado.edu/admin/publication_files/2003.26.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Speakout: Pre-emptive politics ignore science” (PDF),</a> <em>Rocky Mountain News</em>, August 18, 2003. Retrieved from Centre for Science &amp; Policy Research at the University of Colorado. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1503>
        rdf:type                 schema:Claim;
        schema:abstract          "Pre-emption hurts the policy process when it results in a dearth of&nbsp;choice.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1503/source/22>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1502/source/21>
        rdf:type         schema:CreativeWork;
        schema:citation  "Roger Pielke Jr. and D. Sarewitz, <a href=\"http://web.archive.org/web/20170128025659/http://sciencepolicy.colorado.edu/admin/publication_files/resource-1835-2005.37.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Managing the next disaster” (PDF)</a>,<em> Los Angeles Times</em>, September 23, 2005. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1502>
        rdf:type                 schema:Claim;
        schema:abstract          "“Efforts to slow global warming will have no discernible effect on hurricanes for the foreseeable future. Reducing greenhouse gas emissions and adequately preparing for future disasters are essentially separate problems.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1502/source/21>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1501/source/20>
        rdf:type         schema:CreativeWork;
        schema:citation  "Roger Pielke Jr. and Christopher Green. <a href=\"http://web.archive.org/web/20170128030320/http://sciencepolicy.colorado.edu/admin/publication_files/resource-2712-2008.21.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Obama plan a good start to climate policy” (PDF)&nbsp;</a><em>Rocky Mountain News</em>, November 22, 2008. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1501>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Obama plan for climate policy involves one very good idea – investment in new technologies and infrastructure – and one very bad one:&nbsp;cap-and-trade.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1501/source/20>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1500/source/20>
        rdf:type         schema:CreativeWork;
        schema:citation  "Roger Pielke Jr. and Christopher Green. <a href=\"http://web.archive.org/web/20170128030320/http://sciencepolicy.colorado.edu/admin/publication_files/resource-2712-2008.21.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Obama plan a good start to climate policy” (PDF)&nbsp;</a><em>Rocky Mountain News</em>, November 22, 2008. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1500>
        rdf:type                 schema:Claim;
        schema:abstract          "To understand why cap-and-trade is a bad idea, we need only to look to lessons from Europe’s&nbsp;experiences.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1500/source/20>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/roger-pielke-jr/" .

<http://data.open.ac.uk/climate-sense/claim/1499/source/19>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://foreignpolicy.com/2010/02/26/the-fp-guide-to-climate-skeptics/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The FP Guide to Climate Skeptics</a>,” <em>Foreign Policy</em>, February 26, 2010<a href=\"http://web.archive.org/web/20170127191637/http://foreignpolicy.com/2010/02/26/the-fp-guide-to-climate-skeptics/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">. Archived January 27, 2017</a>. Archive.is URL:&nbsp;<a href=\"https://archive.is/TKXQl\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/TKXQl</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1499>
        rdf:type                 schema:Claim;
        schema:abstract          "“We cannot make a causal link between increase in greenhouse gases and the costs of damage associated with hurricanes, floods, and extreme weather&nbsp;phenomena.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1499/source/19>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;

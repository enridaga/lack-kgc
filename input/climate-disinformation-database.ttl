        rdf:type                 schema:Claim;
        schema:abstract          "“EPA estimates that reducing power plants’ SO2 and NOx emissions by approximately 60% will deliver ‘particulate matter-related annual benefits’ that include 13,000-17,000 fewer premature fatalities every year. “";

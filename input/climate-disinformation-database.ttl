        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/vaclav-smil/" .

<http://data.open.ac.uk/climate-sense/claim/2329/source/28>
        rdf:type         schema:CreativeWork;
        schema:citation  "Pielke Sr, Roger &amp; Wigley, Tom &amp; Green, Christopher. “<a href=\"https://www.researchgate.net/publication/5466224_Dangerous_assumptions\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Dangerous assumptions</a>,”&nbsp;<em>Nature</em>. 452. 531-2 (2008).&nbsp;10.1038/452531a."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2329>
        rdf:type                 schema:Claim;
        schema:abstract          "“I largely agree with the overall conclusion of Pielke et al. that the IPCC assessment is overly optimistic,” Smil wrote. “But I fear that the situation is even worse than the authors&nbsp;imply.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2329/source/28>;

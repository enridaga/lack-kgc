        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://cascadepolicy.org/blog/2016/02/22/testimony-on-hb-4036-the-alluring-vision-of-a-coal-free-electricity-grid/\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Testimony Regarding HB 4036 Before the Senate Business and Transportation Committee</a>,” Cascade Policy Institute, February 22, 2016. WebCite URL: <a href=\"http://www.webcitation.org/6hJSYRU34\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">http://www.webcitation.org/6hJSYRU34</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4280>
        rdf:type                 schema:Claim;
        schema:abstract          "“However, as with the singing of the Sirens in Greek mythology, the coal-free vision is a fatal attraction, and Senators should strap themselves to the mast when listening to proponents,” Charles says.";

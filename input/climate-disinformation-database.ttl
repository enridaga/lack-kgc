        rdf:type                 schema:Claim;
        schema:abstract          "Koonin: “It conflates carbon pollution, and I hate that word because CO2, which is what they’re talking about, is essential for plant growth. The more CO2, the more plants grow, all right? So, in that sense, it’s not at all.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10580/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-rogan/>;

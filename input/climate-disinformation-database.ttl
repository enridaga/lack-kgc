        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/dennis-prager/" .

<http://data.open.ac.uk/climate-sense/claim/4510/source/47>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=V9A9sVV24gA\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Dennis Prager Thinks Gay Marriage Bigger Threat Than Bad Economy</a>,” YouTube video uploaded by user “heathr456,” April 12, 2009. Archived .mp4 on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4510>
        rdf:type                 schema:Claim;
        schema:abstract          "“I don’t think that the press covers always what’s most important. Because, honestly, whatever side you’re on, I can’t think frankly of a more important issue even including the economy, than the definition of marriage.”";

<http://data.open.ac.uk/climate-sense/claim/9231/source/95>
        rdf:type         schema:CreativeWork;
        schema:citation  "“Heartland Institute Experts React to Trump’s Appointment of Kathleen Hartnett White for CEQ,” <em>The Heartland Institute</em>. Archived newsletter .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9231>
        rdf:type                 schema:Claim;
        schema:abstract          "“The nomination of Kathleen Hartnett White as chair of the Council on Environmental Quality is great news for the American people. The CEQ role over the years has been significant in leading the way on environmental issues under the National Environmental Policy Act in its advisory capacity to the president and to all federal agencies.[JH1] Under the Obama administration, CEQ was used as a vehicle to eliminate the use of fossil fuels. Those days are over. The White nomination to this crucial post illustrates the seriousness of President Trump and his administration in moving the needle in favor of the American people and against radical environmentalism,” Palmer said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9231/source/95>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/fred-palmer/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/fred-palmer/" .


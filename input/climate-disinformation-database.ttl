        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"https://www.wpp.com/-/media/project/wpp/files/sustainability/2023/sustainability-report-2022/wpp-sustainability-report.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Sustainability Report 2022 (PDF)</a>,” <em>WPP, </em>March 23, 2023. <a href=\"http://web.archive.org/web/20230828162256/https://www.wpp.com/-/media/project/wpp/files/sustainability/2023/sustainability-report-2022/wpp-sustainability-report.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived August 8, 2023</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13451>
        rdf:type                 schema:Claim;
        schema:abstract          "We support urgent action to tackle the climate crisis and aim to reach net zero carbon emissions across our supply chain by 2030.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13451/source/6>;

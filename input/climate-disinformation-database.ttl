<http://data.open.ac.uk/climate-sense/claim/6825>
        rdf:type                 schema:Claim;
        schema:abstract          "Lomax: “Let me start with the bad news. So, the bad news is there’s a group of Democratic attorneys general at the state level who have basically decided they want to use their law enforcement powers to go after people who disagree with the Obama climate agenda and especially the Clean Power Plan.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6825/source/14>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/simon-lomax/>;

<http://data.open.ac.uk/climate-sense/claim/6427/source/30>
        rdf:type         schema:CreativeWork;
        schema:citation  "Katharine Murphy. “<a href=\"https://www.theguardian.com/australia-news/2018/jul/03/tony-abbott-urges-withdrawal-from-paris-agreement-despite-signing-australia-up-as-pm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Tony Abbott urges withdrawal from Paris agreement, despite signing Australia up as <span class=\"caps\">PM</span></a>,” <em>Guardian</em>, July 3, 2018. <a href=\"http://web.archive.org/web/20200113132751/https://www.theguardian.com/australia-news/2018/jul/03/tony-abbott-urges-withdrawal-from-paris-agreement-despite-signing-australia-up-as-pm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 13, 2020</a>. Archive.fo <span class=\"caps\">URL</span>:&nbsp;<a href=\"http://archive.md/wip/Lyo4j\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.md/wip/Lyo4j</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6427>
        rdf:type                 schema:Claim;
        schema:abstract          "“Storms are not more severe; droughts are not more prolonged; floods are not greater; and fires are not more intense than a century ago – despite hyperventilating reportage and over-the-top claims from Green&nbsp;politicians.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6427/source/30>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tony-abbott/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/tony-abbott/" .

<http://data.open.ac.uk/climate-sense/claim/6426/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6426>
        rdf:type                 schema:Claim;
        schema:abstract          "“The last thing we should do is drive our industries offshore and be putting pressure on household budgets and risk third world-style blackouts all in the name of climate change. We have got to be sensible and balanced and proportionate about these things and I don’t think other policymakers are right now.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6426/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tony-abbott/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/tony-abbott/" .

<http://data.open.ac.uk/climate-sense/claim/6425/source/29>
        rdf:type         schema:CreativeWork;
        schema:citation  "Graham Readfearn. “<a href=\"https://www.theguardian.com/australia-news/2020/jan/03/tony-abbott-former-australian-pm-tells-israeli-radio-the-world-is-in-the-grip-of-a-climate-cult\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Tony Abbott, former Australian <span class=\"caps\">PM</span>, tells Israeli radio the world is ‘in the grip of a climate cult’</a>,” <em>Guardian</em>, January 3, 2020.&nbsp;<a href=\"http://web.archive.org/web/20200110161545/https://www.theguardian.com/australia-news/2020/jan/03/tony-abbott-former-australian-pm-tells-israeli-radio-the-world-is-in-the-grip-of-a-climate-cult\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 10, 2019</a>. Archive.fo <span class=\"caps\">URL</span>:&nbsp;<a href=\"http://archive.md/kCV7S\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.md/kCV7S</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6425>
        rdf:type                 schema:Claim;
        schema:abstract          "“While we still seem to be in the grip of a climate cult, the climate cult is going to produce policy outcomes that will cause people to wake up to&nbsp;themselves.”";

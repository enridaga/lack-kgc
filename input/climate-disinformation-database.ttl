<http://data.open.ac.uk/climate-sense/claim/9061/source/83>
        rdf:type         schema:CreativeWork;
        schema:citation  "Chris White. “<a href=\"http://web.archive.org/web/20160523192207/http://dailycaller.com/2016/04/26/report-keep-it-in-the-ground-campaign-will-turn-economy-inside-out/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Report: ‘Keep It In The Ground’ Campaign Will Turn Economy Inside Out</a>,” <em>The Daily Caller,&nbsp;</em>April 26, 2016. Archived May 23, 2016. Archive URL: <a href=\"https://archive.ph/pqOsy\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/pqOsy</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9061>
        rdf:type                 schema:Claim;
        schema:abstract          "“Cutting off access to the very resources that power our economy will not only raise energy costs, but also the costs of everyday products that make modern life possible for American families,” states the&nbsp;report.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9061/source/83>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/institute-energy-research/>;

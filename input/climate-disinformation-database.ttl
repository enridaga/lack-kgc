<http://data.open.ac.uk/climate-sense/claim/13030>
        rdf:type                 schema:Claim;
        schema:abstract          "9. It is not possible to reliably predict how climate will change in the future, beyond the certainty that multi-decadal warming and cooling trends, and abrupt changes, will all continue, underscoring a need for effective adaptation.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13030/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/international-climate-science-coalition/>;

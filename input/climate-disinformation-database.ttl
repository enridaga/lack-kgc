<http://data.open.ac.uk/climate-sense/claim/3095/source/81>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.reuters.com/article/us-usa-trump-climate/greens-fear-climate-backslide-with-pompeo-as-top-u-s-diplomat-idUSKCN1GP2OE\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Greens fear climate backslide with Pompeo as top U.S. diplomat</a>,” <em>Reuters</em>, March 13, 2018. Archive.is URL: <a href=\"https://archive.is/I8Z0v\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/I8Z0v</a>"^^rdf:HTML .


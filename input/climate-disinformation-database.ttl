<http://data.open.ac.uk/climate-sense/claim/2580/source/33>
        rdf:type         schema:CreativeWork;
        schema:citation  "Robin Tysver. “<a href=\"https://www.omaha.com/news/politics/iowa-and-nebraska-lawmakers-stand-by-trump-on-paris-climate/article_12ab754f-3390-5176-9e34-f2c82aaf11e1.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Iowa and Nebraska lawmakers stand by Trump on Paris climate accord</a>,” <em>Omaha World-Herald</em>, June 3, 2017. <a href=\"http://web.archive.org/web/20190531131706/https://www.omaha.com/news/politics/iowa-and-nebraska-lawmakers-stand-by-trump-on-paris-climate/article_12ab754f-3390-5176-9e34-f2c82aaf11e1.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 31, 2019</a>. Archive.fo URL: <a href=\"http://archive.fo/ffrKT\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/ffrKT</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2580>
        rdf:type                 schema:Claim;
        schema:abstract          "“Keeping our air and water clean and protecting our environment for generations to come is something we all care about. The United States can continue to do this without overly burdensome, government-imposed regulations that increase costs on Americans and hurt our economy… Whether or not the U.S. is a member of this agreement does nothing to preclude our country from reducing our emissions on our own accord, and finding market-driven, innovative solutions for our energy needs.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2580/source/33>;

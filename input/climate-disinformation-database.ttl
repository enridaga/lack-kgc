<http://data.open.ac.uk/climate-sense/claim/1298>
        rdf:type                 schema:Claim;
        schema:abstract          "“Today’s students will soon be tomorrow’s voters and they will need to know the science, not the politics of this major issue to make educated choices. My program will give them that.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1298/source/>;

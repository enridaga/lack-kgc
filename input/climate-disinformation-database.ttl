<http://data.open.ac.uk/climate-sense/claim/10011>
        rdf:type                 schema:Claim;
        schema:abstract          "“1967: “Dire Famine by 1975.”&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10011/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-rowe/>;

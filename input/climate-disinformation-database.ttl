        schema:url               "https://www.desmog.com/center-organizational-research-and-education-core/" .

<http://data.open.ac.uk/climate-sense/claim/2657/source/30>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160514222645/http://www.foodandwaterwatch.org/news/rick-berman-strikes-again-environmental-policy-alliance\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Rick Berman Strikes Again With Environmental Policy Alliance</a>,”<em> Food &amp; Water Watch</em>, March 6, 2014.&nbsp;Archived May 14, 2016. Archive URL: <a href=\"https://archive.ph/SZbo3\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/SZbo3</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2657>
        rdf:type                 schema:Claim;
        schema:abstract          "“We’re honored to be called one of the ‘Big Green Radicals’ by notorious corporate lobbyist Rick Berman through his apparent latest astroturf operation, the Environmental Policy Alliance, a ‘project of the Center for Organizational Research Education.’ Ever heard of it? We hadn’t either. After doing a bit of digging, we found out that the Center for Organizational Research Education was recently known as the Center for Consumer Freedom led by the head of Berman &amp; Co. – Rick&nbsp;Berman.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2657/source/30>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/center-organizational-research-and-education-core/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/center-organizational-research-and-education-core/" .


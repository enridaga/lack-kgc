<http://data.open.ac.uk/climate-sense/claim/7668>
        rdf:type                 schema:Claim;
        schema:abstract          "“And it’s an agenda demanding a headlong rush into expensive and unreliable ‘renewable energy.’ An agenda of ‘carbon taxes’ and what amounts to “carbon indulgences” that punish the poor and middle class while enriching Green millionaires and billionaires.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7668/source/23>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-rothbard/>;

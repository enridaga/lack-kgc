        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11805>
        rdf:type                 schema:Claim;
        schema:abstract          "“Reducing power plants’ air pollution would result in ‘14,100 fewer premature deaths,’ among other ‘significant health benefits,’ ‘by dramatically reducing fine particle pollution caused by SO2 and NOx emissions.’";

        rdf:type         schema:CreativeWork;
        schema:citation  "Douglas Carswell. “<a href=\"https://www.theoldie.co.uk/blog/cheer-up-the-world-is-getting-better\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Cheer Up! The world is getting better</a>,” <em>TheOldie</em>, August 12, 2019. <a href=\"http://web.archive.org/web/20210105142337/https://www.theoldie.co.uk/blog/cheer-up-the-world-is-getting-better\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 5, 2021</a>. Archive.vn URL: <a href=\"https://archive.vn/6t4If\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/6t4If</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4254>
        rdf:type                 schema:Claim;
        schema:abstract          "“Today it’s climate change we’re told we need to worry about. But this pessimism is piffle. The world hasn’t been getting worse at all. For most people there’s never been a better time to be alive than right now.”";

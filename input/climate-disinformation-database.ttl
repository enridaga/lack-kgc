        rdf:type         schema:CreativeWork;
        schema:citation  "Keith Bays. “<a href=\"https://web.archive.org/web/20241216223453/https://www.gbnews.com/politics/net-zero-britons-higher-energy-oil-imports-labour-ed-miliband-keir-starmer\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Britons told to brace for higher energy bills as oil imports SOAR despite Labour’s ‘Net Zero madness’</a>,” <em>GN News</em>, December 6, 2024. Archived December 16, 2024. Archive URL: <a href=\"https://archive.ph/wip/SnzNA\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/SnzNA</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/884>
        rdf:type                 schema:Claim;
        schema:abstract          "“The UK is facing years of soaring energy bills as Britain becomes increasingly reliant on imported oil – despite a staggering 25 billion barrels remaining untapped in the North Sea.";

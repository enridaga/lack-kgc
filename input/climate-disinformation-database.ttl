<http://data.open.ac.uk/climate-sense/claim/2891/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2891>
        rdf:type                 schema:Claim;
        schema:abstract          "You may know that Bryan has had very good contacts with the News International media group, particularly with Rupert Murdoch and Bruce Matthews. After a recent discussion with myself, I understand from Bryan that Bruce Matthews has suggested a format for an evening function embracing tobacco companies operating in the U.K.; some senior advertising agencies that work in the tobacco field; and executives from News International. Apparently, they envisage an evening dinner meeting of, say, thirty people at which Bryan would be the guest speaker. It seems as if News International may suggest a date sometime in April.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2891/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rupert-murdoch/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/rupert-murdoch/" .


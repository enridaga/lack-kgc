        rdf:type         schema:CreativeWork;
        schema:citation  "John Charles. “<a href=\"http://cascadepolicy.org/blog/2016/01/13/electric-utilities-should-call-the-bluff-of-green-radicals/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Electric Utilities Should Call the Bluff of Green Radicals</a>,” Cascade Policy Institute, January 13, 2016. WebCite URL:<a href=\"http://www.webcitation.org/6hJYqhOyd\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> http://www.webcitation.org/6hJYqhOyd</a>"^^rdf:HTML .


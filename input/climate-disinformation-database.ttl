        schema:citation  "“<a href=\"http://web.archive.org/web/20170118204151/http://www.api.org/news-policy-and-issues/testimony-and-speeches/2016/01/12/jack-gerard-delivers-remarks-ahead-of-st\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">JACK GERARD HOLDS PRESS CONFERENCE AHEAD OF PRESIDENT OBAMA’S STATE OF THE UNION ADDRESS</a>,” <em>American Petroleum Institute</em>, January 12, 2015. Archived January 18, 2017. Archive.is URL: <a href=\"https://archive.is/k22fs\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/k22fs</a>"^^rdf:HTML .


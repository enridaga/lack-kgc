<http://data.open.ac.uk/climate-sense/claim/11047/source/17>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s7\" href=\"http://web.archive.org/web/20171226054400/http://www.edberry.com/SiteDocs/PDF4567/Climate%20Change%20Reconsidered%20-%20App%204%20Petition%20Project.pdf\" name=\"s7\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“The Petition Project” (PDF)</a>, retrieved from edberry.com."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11047>
        rdf:type                 schema:Claim;
        schema:abstract          "“There is no convincing scientific evidence that human release of carbon dioxide, methane, or other greenhouse gases is causing or will, in the foreseeable future, cause catastrophic heating of the Earth’s atmosphere and disruption of the Earth’s climate. Moreover, there is substantial scientific evidence that increases in atmospheric carbon dioxide produce many beneficial effects upon the natural plant and animal environments of the Earth.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11047/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/arthur-viterito/>;

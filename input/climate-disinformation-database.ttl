        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"https://www.newsmaxtv.com/Shows/The-Howie-Carr-Show/vid/1_wtqpjnvk\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Howie Carr Show</a>,&nbsp;<em>NewsMax</em>, September 22, 2020. Archived .mp4 and .mp3 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8423>
        rdf:type                 schema:Claim;
        schema:abstract          "“Donald Trump, I believe, has failed in his administration to push back on climate science and the whole narrative.&nbsp;He had an opportunity, those first four years he had a scientist on his staff, federal scientist named Will Happer to 200 peer reviewed studies. Considered the foremost expert, he went to do a climate commission bringing together two dozen dissenting scientists for the first time ever pushback in the U.N. Trump actually supported it.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8423/source/76>;

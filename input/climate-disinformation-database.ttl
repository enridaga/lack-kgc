        schema:citation  "“<a href=\"https://aberdeenbusinessnews.co.uk/pressure-mounts-on-keir-starmer-for-u-turn-on-north-sea-oil-and-gas/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Pressure mounts on Keir Starmer for U-turn on North Sea oil and gas</a>,” <em>Aberdeen Business News</em>, May 30, 2023. <a href=\"https://web.archive.org/web/20230628171832/https://aberdeenbusinessnews.co.uk/pressure-mounts-on-keir-starmer-for-u-turn-on-north-sea-oil-and-gas/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived June 28, 2023</a>. Archive URL: <a href=\"https://archive.ph/X9zMq \" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/X9zMq</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4388>
        rdf:type                 schema:Claim;
        schema:abstract          "“Labour’s plans to import more will simply enrich foreign treasuries and increase CO2 output, such is the flawed model of international LNG shipments.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4388/source/40>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/craig-mackinlay/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“They might ask whether the obsession with climate change in recent decades has taken attention away from the many other major problems facing the planet. And they might also look at ‘extreme weather events’ and whether they really are claiming more lives.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8035/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;

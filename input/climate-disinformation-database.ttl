<http://data.open.ac.uk/climate-sense/claim/1357/source/17>
        rdf:type         schema:CreativeWork;
        schema:citation  "Mark Steyn. “<a href=\"http://www.steynonline.com/6403/im-gonna-quash-that-mann-right-out-of-my-hair\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">I’m Gonna Quash That Mann Right Out Of My Hair</a>,” SteynOnline.Com. June 7, 2014. Archive.is URL: <a href=\"https://archive.is/rS1v6\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/rS1v6</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1357>
        rdf:type                 schema:Claim;
        schema:abstract          "“I want to get to court as soon as possible, and put Michael E Mann, PhD (Doctor of Phraudology) on the stand under oath. I haven’t wasted two years on this guy to be denied my moment in court. That’s one reason I’ve countersued Mann. He thinks the DC Superior Court is competent to litigate his fraudulent ‘hockey stick’. Fine, let’s get it to a jury – before the sclerotic DC ‘justice’ system’s procedural delays go on as long as the global-warming ‘pause’.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1357/source/17>;

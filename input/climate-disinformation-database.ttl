<http://data.open.ac.uk/climate-sense/claim/8238/source/67>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=ByeDW5rliPY\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Africa needs ENERGY – the Paris Agreement is immoral – Alex Epstein</a>,” YouTube video uploaded by user “Contours,” October 22, 2023. Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8238>
        rdf:type                 schema:Claim;
        schema:abstract          "“That’s why there’s hostility not just to fossil fuels, but nuclear and hydro. And I think the solar and wind fetish is just a ruse, because if they said we hate all energy, they wouldn’t get away with it.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8238/source/67>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alex-epstein/>;

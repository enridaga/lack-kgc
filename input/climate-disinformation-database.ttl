<http://data.open.ac.uk/climate-sense/claim/5094>
        rdf:type                 schema:Claim;
        schema:abstract          "“Gentry has contributed much to the bottom lines of state-focused think tanks. For nearly four years he has organized the Koch Foundation’s Development Exchange, a monthly Washington, D.C.-based luncheon featuring experts in fundraising and marketing. SPN members attend the Exchanges in-person or by telephone.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5094/source/29>;

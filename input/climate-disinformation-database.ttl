        rdf:type         schema:CreativeWork;
        schema:citation  "Matt Kasper. “<a href=\"http://web.archive.org/web/20170123222543/http://www.energyandpolicy.org/trump-nominated-oklahoma-attorney-general-scott-pruitt/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Donald Trump Has Nominated Oklahoma AG Pruitt, ALEC and Fossil Fuel Industry Ally, To Lead EPA</a>,” <em>Energy and Policy Institute</em>, December, 2016. Archived January 23, 2017. Archive.is URL: <a href=\"https://archive.is/wXz6z\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/wXz6z</a>"^^rdf:HTML .


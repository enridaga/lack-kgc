        rdf:type         schema:CreativeWork;
        schema:citation  "Cardinal George Pell. <a href=\"http://web.archive.org/web/20090528073951/http://www.sydney.catholic.org.au:80/people/archbishop/stc/2009/2009524_1018.shtml\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Global Warming Pauses</a>,” <em>Sunday Telegraph</em>, May 24, 2009. Archived May 28, 2009. Archive.is URL: <a href=\"https://archive.li/hQz8j\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.li/hQz8j</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/406>
        rdf:type                 schema:Claim;
        schema:abstract          "“The carbon dioxide in the atmosphere continues to rise, but the world’s temperature has not risen since 1998,” Pell ";

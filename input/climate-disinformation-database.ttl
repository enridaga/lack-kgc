        rdf:type                 schema:Claim;
        schema:abstract          "“The president sat on the Keystone pipeline throughout his entire eight years, even though his own State Department said it had no measurable impact on climate.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7380/source/26>;

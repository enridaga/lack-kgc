<http://data.open.ac.uk/climate-sense/claim/9859>
        rdf:type                 schema:Claim;
        schema:abstract          "“Natural gas, when combusted, releases roughly 50% fewer carbon emissions than coal. But that doesn’t tell the whole story. Natural gas vents and leaks release unburnt methane, a potent greenhouse gas, into the atmosphere, and anxieties about that phenomenon are growing,” ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9859/source/13>;

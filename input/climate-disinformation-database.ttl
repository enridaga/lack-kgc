        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.warwickhughes.com/blog/?p=40#more-40\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Royal Society and the ‘dead hand of consensus’</a>”, <em>Warwick Hughes</em>. April 23rd, 2006."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/231>
        rdf:type                 schema:Claim;
        schema:abstract          "“People don’t drive climate; it’s the Sun. Instead of manning the barricades in defence of an implausible hypothesis, humanity would be better served if the Society were to lead an open-minded search for improved understanding of our ever-varying climate.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/231/source/8>;

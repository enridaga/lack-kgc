        rdf:type         schema:CreativeWork;
        schema:citation  "Graham Lloyd. “<a href=\"http://www.theaustralian.com.au/higher-education/reef-whistleblower-censured-by-james-cook-university/news-story/c7aa0e0ac1c1dec1b065273d2e968f6d\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Reef whistleblower censured by James Cook University</a>,” <em>The Australian</em>, June 11, 2016. Archive.is URL: <a href=\"http://archive.is/schdj\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/schdj</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7713>
        rdf:type                 schema:Claim;
        schema:abstract          "“Is there a chance that many marine scientists are partially driven by ideology? Is there a chance that peer review among this group is self-selecting of the dominant idea? Is there a robust debate without intimidation?” Ridd asked.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7713/source/63>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ridd/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180727201846/https://www.aei.org/publication/bp-and-the-earth-day-prayers-of-the-rent-seeking-corporation/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">BP and the Earth Day prayers of the rent-seeking corporation</a>,” <em>AEI</em>, April 20, 2018. Archived July 27, 2018. Archive.is URL: <a href=\"https://archive.fo/VEI2P\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/VEI2P</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12316>
        rdf:type                 schema:Claim;
        schema:abstract          "“Earth Day is a classic religious holiday: The interpretation of destructive weather as the gods’ punishment of men for the sins of Man is ancient.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12316/source/38>;

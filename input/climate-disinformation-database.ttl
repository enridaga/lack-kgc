<http://data.open.ac.uk/climate-sense/claim/6428/source/30>
        rdf:type         schema:CreativeWork;
        schema:citation  "Katharine Murphy. “<a href=\"https://www.theguardian.com/australia-news/2018/jul/03/tony-abbott-urges-withdrawal-from-paris-agreement-despite-signing-australia-up-as-pm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Tony Abbott urges withdrawal from Paris agreement, despite signing Australia up as <span class=\"caps\">PM</span></a>,” <em>Guardian</em>, July 3, 2018. <a href=\"http://web.archive.org/web/20200113132751/https://www.theguardian.com/australia-news/2018/jul/03/tony-abbott-urges-withdrawal-from-paris-agreement-despite-signing-australia-up-as-pm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 13, 2020</a>. Archive.fo <span class=\"caps\">URL</span>:&nbsp;<a href=\"http://archive.md/wip/Lyo4j\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.md/wip/Lyo4j</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6428>
        rdf:type                 schema:Claim;
        schema:abstract          "“Sea levels have hardly risen and temperatures are still below those of the medieval warm period. Over time, temperature change seems to correlate rather more with sun spot activity than with carbon dioxide&nbsp;levels.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6428/source/30>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tony-abbott/>;

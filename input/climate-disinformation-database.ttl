<http://data.open.ac.uk/climate-sense/claim/3407/source/9>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20161227185632/https://www.onenewsnow.com/science-tech/2016/12/22/expert-arctic-heating-up-but-its-not-a-bad-thing\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Expert: Arctic heating up, but it’s not a bad thing …</a>” <em>One News Now</em>, December 22, 2016. Archived December 27, 2016. Archive.is URL:<a href=\"https://archive.is/Z9izo\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.is/Z9izo</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3407>
        rdf:type                 schema:Claim;
        schema:abstract          "“It’s expected that the Arctic is going to warm more than the rest of the world. Now, does that mean it’s all doom and gloom? There, I take exception to that. […] Some particular elements of the press like to focus on the losers – and pretend like the winners don’t exist at all. But in that same annual Arctic report card from NOAA, there is plenty of good to be found there.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3407/source/9>;

<http://data.open.ac.uk/climate-sense/claim/4438>
        rdf:type                 schema:Claim;
        schema:abstract          "”Every increase in the minimum wage has led to a direct, visible increase in teenage&nbsp;unemployment.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4438/source/17>;

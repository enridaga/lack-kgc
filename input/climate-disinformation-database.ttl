        rdf:type                 schema:Claim;
        schema:abstract          "“We cannot just sit back and hope for the best and hope that the merit of our project will sell itself. Nowadays [regulators] are being bombarded by general citizenry, by elected officials who have asked to insert themselves into the process, and this debate swirls around.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3505/source/42>;

        rdf:type                 schema:Claim;
        schema:abstract          "“We need a sustainable energy to ensure the future of the country,” Mr. Drevna told the&nbsp;audience.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9739/source/>;

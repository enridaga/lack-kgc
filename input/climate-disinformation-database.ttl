        rdf:type                 schema:Claim;
        schema:abstract          "In case anyone is unfamiliar with the simplicity of the man-caused global warming idea: overwhelming scientific conclusions say we are causing floods / droughts / blazing summers / intense winters, and don’t listen to any skeptic scientists – they’re corrupt.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10271/source/11>;

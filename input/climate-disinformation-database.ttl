        schema:citation  "Suzanne Goldenberg. “<a href=\"https://www.theguardian.com/environment/2015/jun/11/james-inhofe-republican-climate-denier-pope-francis\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Republicans’ leading climate denier tells the pope to butt out of climate debate</a>,” <em>The Guardian</em>, June 11, 2015. Archive.is URL: <a href=\"https://archive.is/r1vTW\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/r1vTW</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4858>
        rdf:type                 schema:Claim;
        schema:abstract          "“My message to the Pope would be, don’t take sides on the science. Don’t make the same mistake as seven out of 10 judges in the trial of Galileo, when they invited him to retract his views.”";

<http://data.open.ac.uk/climate-sense/claim/6842>
        rdf:type                 schema:Claim;
        schema:abstract          "“Many have convinced themselves that today’s threat of authoritarianism comes from not the left, but from the right. We take a different view. We regard ourselves as direct descendants and rightful heirs of the Glorious Revolution of the 1980s, led by Ronald Reagan and Saint John Paul the Great, and also by Margaret Thatcher. We think we are vindicating the victories of national independence in Central and Eastern Europe of 1989.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6842/source/21>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/christopher-demuth/>;

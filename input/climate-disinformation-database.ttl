        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20250204223803/https://cei.org/issues/energy-and-environment/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Energy and Environment</a>,” <em>CEI</em>. Archived February 4, 2025. Archive URL: <a href=\"https://archive.ph/SzReH\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/SzReH</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5387>
        rdf:type                 schema:Claim;
        schema:abstract          "“Conclusions of CEI’s research and analysis include: Abundant, affordable energy is a blessing underpinning the unprecedented improvements of the past two centuries in life expectancy, health, standards of living, food and nutrition, and industrial production. The climate catastrophe narrative is based on global climate models that inflate greenhouse gas emission scenarios and have been falsified by the past four decades of temperature data. The real costs of proposed solutions to the alleged crisis hugely exceed their hypothetical benefits.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5387/source/15>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/competitive-enterprise-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;

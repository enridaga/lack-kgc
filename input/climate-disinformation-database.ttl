<http://data.open.ac.uk/climate-sense/claim/3657/source/41>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s24\" href=\"http://informationrights.decisions.tribunals.gov.uk//DBFiles/Decision/i1014/20130517%20Decision%20EA20120156.pdf\" name=\"s24\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“STEPHEN MCINTYRE And THE INFORMATION COMMISSIONER And UNIVERSITY OF EAST ANGLIA” (PDF – Appeal No: EA/2012/0156)</a>, HM Courts &amp; Tribunals Service, May 17, 2013. Archived .pdf on file at Desmog."^^rdf:HTML .


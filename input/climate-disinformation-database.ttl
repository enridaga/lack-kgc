<http://data.open.ac.uk/climate-sense/claim/11104>
        rdf:type                 schema:Claim;
        schema:abstract          "“While I am not a scientist, and write primarily on economics, tax policy and budget issues, I have been fascinated over the years by Heartland’s work on climate change.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11104/source/12>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ferrara/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s33\" href=\"http://web.archive.org/web/20160804173707/http://clexit.net/wp-content/uploads/2016/07/clexit.pdf\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">“After Brexit, Clexit” (PDF)</a>, Clexit.net. Archived .pdf on file at Desmog."^^rdf:HTML .


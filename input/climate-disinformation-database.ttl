<http://data.open.ac.uk/climate-sense/claim/1236>
        rdf:type                 schema:Claim;
        schema:abstract          "“But the promotion of unhealthy sexual desires is not what Diversity is about. Diversity is about power. Diversity is therefore never strictly about the subjects in which Diversity is pushed. The subjects are always incidental. Who controls the subjects is paramount.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1236/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/william-briggs/>;

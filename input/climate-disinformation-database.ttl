<http://data.open.ac.uk/climate-sense/claim/12318/source/42>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180727214356/http://www.aei.org/publication/earth-day-and-the-celebration-of-suffering/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Earth Day and the celebration of suffering</a>,” <em>AEI</em>, April 21, 2015. Archived July 27, 2018. Archive.is URL: <a href=\"https://archive.fo/g6IjH\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/g6IjH</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12318>
        rdf:type                 schema:Claim;
        schema:abstract          "“Tens or hundreds of millions of the world’s poor have died from malaria as a direct result of the multination ban on the use of DDT, driven by vastly exaggerated fears of its harmful effects on various bird species. This indifference to the death toll among the least fortunate is strangely reminiscent of Joseph Stalin’s view of the difference between one death and millions; and it is no accident, as Pravda used to put it, that the modern Earth Day mindset reflects that of the original.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12318/source/42>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/benjamin-zycher/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/benjamin-zycher/" .

<http://data.open.ac.uk/climate-sense/claim/12317/source/40>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180727061909/http://www.aei.org/publication/earth-day-and-the-triumph-of-dogbert/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Earth Day and the triumph of Dogbert</a>,” <em>AEI</em>, April 22, 2016. Archive.is URL: <a href=\"https://archive.fo/hTlpp\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/hTlpp</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12317>
        rdf:type                 schema:Claim;
        schema:abstract          "“Tens or hundreds of millions of the world’s poor have died from malaria as a direct result of the multination ban on DDT use, driven by deeply disingenuous propaganda on its harmful effects on various bird species, vastly exaggerated on Earth Days past. This indifference to the death toll among the least fortunate is strangely reminiscent of Joseph Stalin’s view of the difference between one death and millions; and it is no accident, as Pravda used to put it, that the modern Earth Day mindset reflects that of the original.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12317/source/40>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/benjamin-zycher/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“I think the likelihood that [the EPA rules] will ever go into effect is pretty low,” Holmstead says. “There needs to be some sort of congressional action to decide how the United States is going to deal with climate change.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11811/source/29>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jeffrey-r-holmstead/>;

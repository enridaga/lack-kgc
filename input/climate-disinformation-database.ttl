<http://data.open.ac.uk/climate-sense/claim/9128>
        rdf:type                 schema:Claim;
        schema:abstract          "“Under the veneer of promoting environmental stewardship, ‘green’ pressure groups have dominated the European public policy debate on climate change, agriculture and forestry. In the name of nature for decades they exerted massive pressures on political actors and businesses. The effects of this dubious lobbying have spilled beyond the EU’s borders, now dictating development policies in emerging economies.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9128/source/7>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/wolfgang-muller/>;

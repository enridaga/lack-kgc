<http://data.open.ac.uk/climate-sense/claim/12816/source/28>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160508210238/http://www.npri.org/issues/publication/epa-is-determined-to-prove-obama-right-and-make-energy-prices-skyrocket\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">EPA is determined to prove Obama right and make energy prices ‘skyrocket’</a>,” <em>Nevada Policy Research Institute</em>, December 9, 2015. Archived May 8, 2016. Archive URL: <a href=\"https://archive.ph/o8hXL\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/o8hXL</a>"^^rdf:HTML .


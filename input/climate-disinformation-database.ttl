<http://data.open.ac.uk/climate-sense/claim/3461>
        rdf:type                 schema:Claim;
        schema:abstract          "“The administration’s big climate program is the Clean Power Plan and has been finalized by the EPA and published in the federal register about two months ago and what you saw was immediately 27 states filed suits in the courts,” Domenech said. “It’s going to boil down to the state level.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3461/source/67>;

<http://data.open.ac.uk/climate-sense/claim/11594>
        rdf:type                 schema:Claim;
        schema:abstract          "“Ontario Proud’s financial records have not yet been made public. Ballingall says 1,300 donors both big and small have contributed funds to what was once an out-of-pocket bootstrap organization. A PowerPoint presentation leaked to The Walrus this summer showed that Ontario Proud was seeking $700,000 in funding to ‘inform,’ ‘influence,’ and ‘mobilize’ voters ahead of the 2018 election — roughly the spending limit placed on third-party organizations in Ontario.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11594/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/canada-proud/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/canada-proud/" .

<http://data.open.ac.uk/climate-sense/claim/11593/source/24>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"https://www.ola.org/sites/default/files/node-files/hansard/document/pdf/2016/2016-06/committee-transcript-1-EN-06-JUN-2016_G056.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Official Report o fDebates (Handsard): Standing Committee on General Government, June 6, 2016” (PDF)</a>, <em>Legislative Assembly of Ontario</em>. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11593>
        rdf:type                 schema:Claim;
        schema:abstract          "“The problem with our current rules is that they provide third parties an almost unlimited ability to raise and spend funds, in contrast to parties and candidates, which are subject to limits.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11593/source/24>;

<http://data.open.ac.uk/climate-sense/claim/11690>
        rdf:type                 schema:Claim;
        schema:abstract          "“Few things annoy me more than to hear people talking about carbon dioxide being a pollutant. You’re made of carbon dioxide, I’m made of carbon dioxide, carbon dioxide is how living things grow”";

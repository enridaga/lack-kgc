<http://data.open.ac.uk/climate-sense/claim/1877/source/24>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.europarl.europa.eu/sides/getDoc.do?pubRef=-//EP//TEXT+CRE+20171003+ITEM-013+DOC+XML+V0//EN&amp;language=en&amp;query=INTERV&amp;detail=2-497-000\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">UN Climate Change Conference in Bonn, Germany (COP23) (debate)</a>,” <em>European Parliament</em>, October 3, 2017. <a href=\"http://web.archive.org/web/20181206103840/http:/www.europarl.europa.eu/sides/getDoc.do?pubRef=-//EP//TEXT+CRE+20171003+ITEM-013+DOC+XML+V0//EN&amp;language=en&amp;query=INTERV&amp;detail=2-497-000\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived December 6, 2018</a>. Archive.fo URL: <a href=\"http://archive.fo/0iQue\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/0iQue</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1877>
        rdf:type                 schema:Claim;
        schema:abstract          "“This ludicrous myth of man-made global warming is going to impact on agriculture. Farmers apparently are going to have to improve the world weather by emitting fewer greenhouse gases. There are two of them that we emit where we find ourselves in total contradiction to EU dogma.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1877/source/24>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-stuart-agnew/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;

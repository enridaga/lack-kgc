<http://data.open.ac.uk/climate-sense/claim/10195>
        rdf:type                 schema:Claim;
        schema:abstract          "“Addressing these and the other long-term issues we face will require that we do a better job of convincing others — Politicians and the public alike — of the merits of our case. To do that, we’ll need to draw on a third ‘C’ — cooperation.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10195/source/49>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=ZP3mSamRbYA\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Dr. Jordan Peterson gives up trying to reason with SJWs</a>,” YouTube video uploaded by user “1791L” October 20, 2016. Archived .mp4 on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10452>
        rdf:type                 schema:Claim;
        schema:abstract          "“I don’t believe using your pronouns will do you any good in the long run,” he said. “I believe it’s quite the&nbsp;contrary.”&nbsp;";

        schema:citation  "“<a href=\"http://web.archive.org/web/20190731053301/https://www.bdbcanegrowers.com.au/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">GREAT BARRIER REEF WORLD EXPERT DR PETER RIDD JOINS BUNDY FARMERS’ FIGHT</a>,” <em>bdbcanegrowers.com.au</em>, accessed July 31, 2019. Archived July 31, 2019. Archive.is URL: <a href=\"http://archive.is/pgBsV\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/pgBsV</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7727>
        rdf:type                 schema:Claim;
        schema:abstract          "“As I have been stating clearly for some time now, the scare stories about the Great Barrier Reef started in the 1960s when scientists first began work on the Reef. Since then, they have been crying wolf. […] The Reef is actually in great order. So are farmers really killing the Great Barrier Reef through run-off of pesticides and fertilisers, and mud in flood periods? No.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7727/source/27>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ridd/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/peter-ridd/" .


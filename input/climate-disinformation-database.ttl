        rdf:type         schema:CreativeWork;
        schema:citation  "Diana Furchtgott-Roth. “<a href=\"http://web.archive.org/web/20150905232552/http://www.theglobeandmail.com/globe-debate/quebec-tragedy-shows-that-pipelines-are-safest-way-to-transport-oil/article13054202/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Quebec tragedy reminds us pipelines are safest way to transport oil</a>,”&nbsp;<em>The Globe and Mail</em>, July 7, 2013. archived September 5, 2015.&nbsp;Archive.is URL:&nbsp;<a href=\"https://archive.is/2qOd9\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/2qOd9</a>"^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  "Michael Bastasch. “<a href=\"https://web.archive.org/web/20171129053454/http://dailycaller.com/2017/11/21/the-real-story-behind-the-heartland-institutes-role-in-the-trump-admin/\" rel=\"noreferrer noopener external\" target=\"_blank\" data-wpel-link=\"external\">The Real Story Behind The Heartland Institute’s Role In The Trump Admin</a>,” <em>The Daily Caller</em>. November 21, 2017. Archived November 28, 2017. Archive.is URL: <a href=\"https://archive.is/tCDXt\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/tCDXt</a>"^^rdf:HTML .


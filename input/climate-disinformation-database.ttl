        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3241>
        rdf:type                 schema:Claim;
        schema:abstract          "“Research promoted by the taxpayer-funded UK Research and Innovation Council said the nation may have to swap bangers and beef burgers for I’m a Celeb-style jungle substitutes made of gross insects by 2030.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3241/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-baker/>;

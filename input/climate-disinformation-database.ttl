<http://data.open.ac.uk/climate-sense/claim/6824/source/13>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20190815183125/https://denver.cbslocal.com/2017/01/23/du-students-faculty-walk-out-for-climate-justice/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">DU Students, Faculty Walk Out For ‘Climate Justice’</a>,” <em>CBS Denver</em>, January 23, 2017. Archived August 15, 2019. Archive.fo URL: <a href=\"https://archive.fo/04Yff\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/04Yff</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6824>
        rdf:type                 schema:Claim;
        schema:abstract          "“There are more than 11,000 students at DU and just a handful of them walked out of class today. That tells you the fossil-fuel divestment campaign, which is run by 350.org in New York, has almost no traction with DU students at all. We hope DU sees through the 350.org divestment campaign. It’s a costly political stunt that will hurt DU students and faculty without doing anything – on campus or off campus – to lower carbon emissions.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6824/source/13>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/simon-lomax/>;

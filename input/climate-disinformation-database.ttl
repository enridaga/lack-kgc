<http://data.open.ac.uk/climate-sense/claim/8749/source/109>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s49\" href=\"http://web.archive.org/web/20120422230910/http://ossfoundation.us/projects/environment/global-warming/myths/revelle-gore-singer-lindzen/cosmos-myth/Beran_affidavit.pdf\" name=\"s49\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Affidavit of Ms. Christa Beran” (PDF)</a>, Commonwealth of Massachusetts, Middlesex, ss. Superior Court Civil Action No. 93-2219."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8749>
        rdf:type                 schema:Claim;
        schema:abstract          "“I do not remember seeing any review by Roger of any text by Dr. Singer before a day in February 1991 when he came to Roger’s office. For quite some time Dr. Singer had been trying to get Roger to work on an article that Dr. Singer was writing for the Cosmos Club Journal. He seemed quite anxious to get Roger’s comments. […] After a series of unsuccessful attempts to get Roger to work on this document, Dr. Singer must have decided that the only way he was going to get this thing done was to come in person.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8749/source/109>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/s-fred-singer/>;

        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9250>
        rdf:type                 schema:Claim;
        schema:abstract          "Carlson: “You are a zoologist. You know a lot about polar bears. But you’ve been attacked by many in the climate establishment as a ‘denier’ as a subversive person whose voice shouldn’t be heard. This seems like a fairly straightforward question. They told us the polar bears were going extinct. You’re certain they’re not. Why is this controversial?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9250/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/susan-crockford/>;

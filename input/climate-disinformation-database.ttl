<http://data.open.ac.uk/climate-sense/claim/13290>
        rdf:type                 schema:Claim;
        schema:abstract          "“As for my past with UKIP and CAR26, I wear those roles with pride. I’ve always been upfront about my views: climate change happens, but the hysteria around human causation is, frankly, a bit of a stretch. CO2 is indeed vital for life, turning our planet into a blooming, green paradise rather than a barren wasteland.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13290/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/nigel-farage/>;

<http://data.open.ac.uk/climate-sense/claim/6762>
        rdf:type                 schema:Claim;
        schema:abstract          "“Earlier this year, at the request of the state, EPA issued clear guidance that ensures permits are reviewed using the best science available to protect residents from the significant and irreversible damage this practice can have on communities and their water sources.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6762/source/>;

<http://data.open.ac.uk/climate-sense/claim/3988>
        rdf:type                 schema:Claim;
        schema:abstract          "“Third, even if humans are undesirably affecting global climate, the best&nbsp;path forward may be adaptation to that climate change rather than harming the&nbsp;global economy through the expenditure of hundreds of billion dollars under&nbsp;the questionable rationale that greenhouse gas regulation can act as some sort of global thermostat.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3988/source/36>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-milloy/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.ustream.tv/recorded/63524134\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Panel 1: Climate Science with Willie Soon, Ph.D., David Legates, Ph.D., and Patrick Michaels, Ph.D.</a>,” UStream&nbsp;video. Archived video on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11150>
        rdf:type                 schema:Claim;
        schema:abstract          "Legates concluded&nbsp;at the Heartland Institute’s Tenth International Conference on Climate Change (ICCC10) that it is “difficult to continue to argue that the climate, of the US at least, is becoming more extreme.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11150/source/22>;

<http://data.open.ac.uk/climate-sense/claim/9811>
        rdf:type                 schema:Claim;
        schema:abstract          "I therefore agree with the CRS’s conclusion that any court weighing the claim that the President may adopt and implement quantitative emissions reductions, would most likely deem the executive’s action an unconstitutional usurpation of congressional power. This is why Paris is a farce.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9811/source/46>;

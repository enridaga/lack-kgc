        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s11\" href=\"http://web.archive.org/web/20160714213243/http://blog.heartland.org/wp-content/uploads/2016/07/2016-07-12-Coalition-Letter-Senate-Web-of-Denial-Resolution.pdf\" name=\"s11\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Coalition Letter to Senate Web of Denial Resolution (PDF)</a>. Retrieved from the Heartland Institute. Archived .pdf on file at DeSMogBlog."^^rdf:HTML .


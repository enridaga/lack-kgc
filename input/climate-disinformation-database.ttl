<http://data.open.ac.uk/climate-sense/claim/11613>
        rdf:type                 schema:Claim;
        schema:abstract          "“The media willfully ignores thousands of scientists who believe in global warming but do not believe its effects will be ‘catastrophic.’ The only global warming catastrophes are going to be bad public policies based on fear and panic rather than caution and science.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11613/source/12>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jay-h-lehr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/jay-h-lehr/" .

<http://data.open.ac.uk/climate-sense/claim/11612/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11612>
        rdf:type                 schema:Claim;
        schema:abstract          "“It’s arrogant to think [increases in 100-year storms]&nbsp;are manmade because nature is so overwhelming compared to what the impact that we&nbsp;have.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11612/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jay-h-lehr/>;

        rdf:type                 schema:Claim;
        schema:abstract          "Greens do not worry about ‘climate’ one little bit. But they are physically revolted by the idea of less govt regulation and lower taxes. It is not ‘climate chaos’ but human freedom that disgusts them.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3749/source/>;

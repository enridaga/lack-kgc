<http://data.open.ac.uk/climate-sense/claim/6789>
        rdf:type                 schema:Claim;
        schema:abstract          "“The role of fossil fuels in the global economy is growing, and the U.S. must lead the world in pursuing the solutions that will allow us to burn fossil fuels in a cleaner, more cost effective and more efficient manner.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6789/source/19>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-manchin/>;

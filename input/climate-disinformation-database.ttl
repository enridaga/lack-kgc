<http://data.open.ac.uk/climate-sense/claim/9127>
        rdf:type                 schema:Claim;
        schema:abstract          "“On top of the incredible obstacles already faced by disadvantaged peoples and free enterprise businesses across the developing world, efforts to raise living standards of millions living in poverty are now being undermined by radical scare tactics deployed by Green NGOs. Collectively, this ‘green’ smear machine funnels millions of dollars into dubious campaigns and lobbying efforts that ultimately lead to unnecessary human suffering and stifled economic growth.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9127/source/>;

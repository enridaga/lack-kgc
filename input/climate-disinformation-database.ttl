<http://data.open.ac.uk/climate-sense/claim/12807/source/22>
        rdf:type         schema:CreativeWork;
        schema:citation  "Duane D. Freese. “<a href=\"http://web.archive.org/web/20050318102139/http://www2.techcentralstation.com:80/1051/envirowrapper.jsp?PID=1051-450&amp;CID=1051-111401A\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Toothless Kyoto Dragon</a>,” <em>Tech Central Station</em>, November 14, 2001. Archived March 18, 2005. Archive.is URL: <a href=\"https://archive.is/EXNnF\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/EXNnF</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12807>
        rdf:type                 schema:Claim;
        schema:abstract          "“The problem with this settled science approach to global warming is that no one – other than extreme environmentalists – fully buys it. Scientists themselves disagree about the extent to which human emissions of CO2 have an effect on climate change, with some even arguing that any effect is beneficial.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12807/source/22>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tech-central-station/>;

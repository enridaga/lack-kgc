        schema:url               "https://www.desmog.com/rupert-darwall/" .

<http://data.open.ac.uk/climate-sense/claim/4245/source/25>
        rdf:type         schema:CreativeWork;
        schema:citation  "Rupert Darwall. “<a href=\"https://web.archive.org/web/20220412132811/https://www.realclearenergy.org/articles/2022/03/03/john_kerry_putins_useful_climate_idiot_819615.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">John Kerry: Putin’s Useful Climate Idiot</a>”, <em>Real Clear Energy</em>, March 3, 2022. Archived April 12, 2022. Archive URL: <a href=\"https://archive.ph/Qzzvu\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/Qzzvu</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4245>
        rdf:type                 schema:Claim;
        schema:abstract          "“Vladimir Putin’s invasion of Ukraine marks the end of the West’s Era of Illusions. It was an era in which Western elites obsessed about solving climate change because the climate crisis was far more dangerous than issues of war and peace and the stability of the international system. They even convinced themselves that climate change causes war, so climate change policy could double as national security policy.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4245/source/25>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rupert-darwall/>;

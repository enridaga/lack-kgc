<http://data.open.ac.uk/climate-sense/claim/3990>
        rdf:type                 schema:Claim;
        schema:abstract          "“Our opposition to global warming alarmism is based on three points. First, we don’t believe the available scientific data&nbsp;indicate that human activity is measurably changing global climate – history&nbsp;shows that natural climate change can be far more significant than any slight change in climate that may have occurred over the last 200 years.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3990/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-milloy/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/steve-milloy/" .


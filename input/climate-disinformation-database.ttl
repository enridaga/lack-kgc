<http://data.open.ac.uk/climate-sense/claim/4010>
        rdf:type                 schema:Claim;
        schema:abstract          "“Earth’s climate system is unfathomably complex. It is affected by innumerable interacting variables, atmospheric CO2 levels being just one. The more variables there are in any system or train of events, the lower the probability of all of them coming to pass. Your odds of correctly guessing the outcome of a flipped coin are 1 in 2, but your odds of guessing correctly twice in a row are only 1 in 4 — i.e., 1/2 x 1/2. Extending your winning streak to a third guess is even less probable: just 1 in 8.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4010/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jeff-jacoby/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/jeff-jacoby/" .


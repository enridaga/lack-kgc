        rdf:type                 schema:Claim;
        schema:abstract          "Lomborg: “I want to get people to understand that global warming is a problem, but it’s actually mostly a problem in the sense that the world is getting better and better. But because of global warming, it gets slightly slower much better.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10529/source/>;

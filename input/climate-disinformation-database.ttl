<http://data.open.ac.uk/climate-sense/claim/9709/source/50>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.abc.net.au/news/2012-10-18/alan-jones-ordered-to-do-journalism-training/4320534\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Alan Jones ordered to do journalism training</a>,”<em> ABC News, </em>October 22, 2012. <a href=\"http://web.archive.org/web/20171213045458/http://www.abc.net.au/news/2012-10-18/alan-jones-ordered-to-do-journalism-training/4320534\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived December 13, 2017</a>. Archive.is URL: <a href=\"https://archive.is/uW7vO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/uW7vO</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9709>
        rdf:type                 schema:Claim;
        schema:abstract          "“Remembering all this when the percentage of man-made carbon dioxide Australia produces is 1 per cent of .001 per cent of carbon dioxide in the air. Nature produces nearly all of the carbon dioxide in the air. Human beings produce 0.001 per cent of the carbon dioxide in the air and Australians produce 1 per cent of that. That’s 1 per cent of .001 is .00001 per cent of the air. 1/100000th.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9709/source/50>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alan-jones/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/alan-jones/" .

<http://data.open.ac.uk/climate-sense/claim/9708/source/44>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.2gb.com/podcast/alan-jones-lord-christopher-monckton/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Alan Jones – Lord Christopher Monckton</a>,” 2GB Radio, November 29, 2015. <a href=\"http://web.archive.org/web/20171213202214/http://www.2gb.com/podcast/alan-jones-lord-christopher-monckton/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived December 13, 2015</a>. Archive.is URL: <a href=\"https://archive.is/bdAnx\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/bdAnx</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9708>
        rdf:type                 schema:Claim;
        schema:abstract          "“We’re talking about carbon dioxide. Of all the air in the atmosphere, carbon dioxide is 0.04 of a percent and human beings produce only 3% of that. That’s 3% of 0.04 of a percent. And Australia produces 1% of the 3% of the 0.04 of a percent.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9708/source/44>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alan-jones/>;

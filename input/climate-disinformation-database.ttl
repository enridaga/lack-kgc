<http://data.open.ac.uk/climate-sense/claim/3714>
        rdf:type                 schema:Claim;
        schema:abstract          "“”Global warming is designed to scam America, more than any other country,” Levant said in a TheRebel.media video. “That’s not my opinion. That’s a fact.”";

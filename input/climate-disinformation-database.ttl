<http://data.open.ac.uk/climate-sense/claim/1363/source/5>
        rdf:type         schema:CreativeWork;
        schema:citation  "Paul Reiter. “<a href=\"http://www.eco-imperialism.com/content/article.php3?id=210\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Disinformation is dangerous – and often deadly</a>,” <em>International Herald Tribune</em>, January 11, 2007. Republished by Eco-Imperialism.com."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1363>
        rdf:type                 schema:Claim;
        schema:abstract          "“I am not a climatologist, nor an expert on sea level or polar ice. But I do know from talking to many scientists in many disciplines that this ‘consensus’ is a mirage. Every discipline has many critical, unanswered questions and many dangerous distortions.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1363/source/5>;

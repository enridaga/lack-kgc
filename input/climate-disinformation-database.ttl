<http://data.open.ac.uk/climate-sense/claim/9320/source/108>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.umces.edu/Cato-Report\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Statement on the Cato Institute ADDENDUM Report</a>,” University of Maryland Center for Environmental Science. <a href=\"http://web.archive.org/web/20161025200352/http://www.umces.edu/Cato-Report\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived October 25. 2016</a>. Archive.is URL: <a href=\"https://archive.is/oJVz9\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/oJVz9</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9320>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Cato report is in no way an addendum to our 2009 report. &nbsp;It is not an update, explanation, or supplement by the authors of the original report. &nbsp;Rather, it is a completely separate document lacking rigorous scientific analysis and review,” the original report authors write.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9320/source/108>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/patrick-michaels/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/patrick-michaels/" .

<http://data.open.ac.uk/climate-sense/claim/9319/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9319>
        rdf:type                 schema:Claim;
        schema:abstract          "“The authors of the Cato Institute report say that their report has more references than our report, but this is a meaningless distinction that does not reflect relative thoroughness. Our 2009 report was intentionally written to be accessible to a general audience and, consequently, cited only the most authoritative and comprehensive sources. &nbsp;The Cato Institute report includes numerous citations of marginal relevance and excludes or misrepresents key publications that, in fact, contradict its interpretations.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9319/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/patrick-michaels/>;

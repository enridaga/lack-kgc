        rdf:type         schema:CreativeWork;
        schema:citation  "G. Cornelis van Kooten. <a href=\"https://web.archive.org/web/20220118035739/http://web.uvic.ca/~repa/publications/REPA%20working%20papers/WorkingPaper2021-03.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Climate Change and Economics: Update” (PDF)</a>, December 2021. <em>Resource Economics &amp; Policy Analysis Research Group</em> (Department of Economics, University of Victoria). Archived .pdf on file at DeSmog."^^rdf:HTML .


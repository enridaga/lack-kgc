        schema:citation  "“<a href=\"http://online.wsj.com/article/SB10001424127887323981504578179291222227104.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Matt Ridley: Cooling Down the Fears of Climate Change</a>,”&nbsp;<em>The Wall Street Journal</em>, December 18, 2012.&nbsp;Archive.is <span class=\"caps\">URL</span>:&nbsp;<a href=\"https://archive.is/HK5po\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/<span class=\"caps\">HK5</span>po</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/852>
        rdf:type                 schema:Claim;
        schema:abstract          "“A cumulative change of less than 2°C by the end of this century will do no net harm. It will actually do net good […] rainfall will increase slightly, growing seasons will lengthen, Greenland’s ice cap will melt only very slowly, and so on,” Ridley ";

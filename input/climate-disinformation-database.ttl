        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/ken-haapala/" .

<http://data.open.ac.uk/climate-sense/claim/6819/source/13>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://vaseee.org/page7/files/facb0e170cb3edd9df9376604d0b42c4-0.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Ken’s EPA Testimony</a>,” <em>Northern Virginia Chapter of SEEE</em>, November 18, 2009."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6819>
        rdf:type                 schema:Claim;
        schema:abstract          "“Carbon dioxide is a necessary food for green plants, thus necessary for life on this planet as we generally recognize it. As discussed in the second report, thousands of experiments and observations show that virtually all food crops and green plants thrive better in an atmosphere enriched in carbon dioxide and better resist stress such as draught, or insect attacks. Contrary to EPA claims, Carbon dioxide enrichment, condemned by these regulations, is a benefit to agriculture, humanity, and the planet.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6819/source/13>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ken-haapala/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/ken-haapala/" .

<http://data.open.ac.uk/climate-sense/claim/6818/source/12>
        rdf:type         schema:CreativeWork;
        schema:citation  "Michael F. Haverluck. “<a href=\"https://web.archive.org/web/20150726185433/http://www.onenewsnow.com/culture/2014/10/15/is-worry-over-global-warming-cooling-down\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Is worry over ‘global warming’ cooling down?</a>” OneNewsNow.com, October 15, 2014. Archived July 26, 2015."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6818>
        rdf:type                 schema:Claim;
        schema:abstract          "“The EPA claimed that carbon dioxide emissions are pollutants that endangers human health, even though carbon dioxide is necessary for life on this planet,” Haapala reports. “Green plants need carbon dioxide for photosynthesis to create the food plants and animals need to survive.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6818/source/12>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ken-haapala/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"https://web.archive.org/web/20180214000740/https://wattsupwiththat.files.wordpress.com/2018/02/amnh18-feb4-petitionletter-1.pdf\" id=\"s39\" name=\"s39\" rel=\"nofollow noopener external noreferrer\" target=\"_blank\" data-wpel-link=\"external\">mnh18-feb4-petitionletter (PDF – Untitled)</a>. Retrieved from <em>Watts Up With That</em>."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2816>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Earth has supported abundant life many times in the geological past when there were much higher levels of carbon dioxide in the atmosphere. It is quite likely that future generations will benefit from the enrichment of Earth’s atmosphere with more carbon dioxide.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2816/source/18>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/r-timothy-patterson/>;

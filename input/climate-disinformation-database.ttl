        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20240630133601/https://agenda.americafirstpolicy.com/assets/uploads/Pillar_7-2_-_Make_America_Energy_Independent.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Pillar VII Make America Energy Independent: Lower The Price of Gas and Energy By Increasing Production of America’s Energy Supplies (PDF)</a>,” <em>America First Policy Institute</em>, December 7, 2022 (document creation date). Archived June 30, 2024. Archive URL: <a href=\"https://archive.ph/wip/K7p49\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/wip/K7p49</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12329>
        rdf:type                 schema:Claim;
        schema:abstract          "“The policies of climate activists only exacerbate the difficulties of providing affordable and reliable energy. The burdensome regulatory policies pushed by ‘build-nothing’ environmentalists mean additional costs for providers of the most affordable and reliable sources of power. These additional costs for providers expose Americans to a greater risk of rolling brownouts and blackouts.”";

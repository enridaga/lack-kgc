        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://blogs.news.com.au/heraldsun/andrewbolt/index.php/heraldsun/comments/how_government_cash_created_the_climategate_scandal/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">How government cash created the Climategate scandal</a>,” <em>Herald Sun</em>, March 22, 2010."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13522>
        rdf:type                 schema:Claim;
        schema:abstract          "“As editor of a journal which remained open to scientists who challenged the orthodoxy, I became the target of a number of CRU manoeuvres. The hacked emails revealed attempts to manipulate peer review to E&amp;E’s disadvantage, and showed that libel threats were considered against its editorial team […]”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13522/source/10>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/sonja-boehmer-christiansen/>;

<http://data.open.ac.uk/climate-sense/claim/13044/source/15>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"https://www.desmog.com/wp-content/uploads/files/Climate%20denier%20Paris%20withdrawal%20petition.pdf\" target=\"_blank\" rel=\"noreferrer noopener\" data-wpel-link=\"internal\">“PETITION” (PDF),</a>&nbsp;February 23, 2017. Richard Lindzen. PDF Archived at DeSmog."^^rdf:HTML .


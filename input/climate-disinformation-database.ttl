        rdf:type         schema:CreativeWork;
        schema:citation  "Marlo Lewis. “<a href=\"http://web.archive.org/web/20170103024011/http://www.globalwarming.org/2015/01/13/some-free-market-talking-points-on-the-keystone-xl-pipeline-amendments/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Some Free Market Talking Points on the Keystone XL Pipeline Amendments</a>,” Global Warming.org, January 13, 2015. Archived January 2, 2017. Archive.is URL: <a href=\"https://archive.is/PsoAW\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/PsoAW</a>"^^rdf:HTML .


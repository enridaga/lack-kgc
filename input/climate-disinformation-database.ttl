<http://data.open.ac.uk/climate-sense/claim/4275/source/5>
        rdf:type         schema:CreativeWork;
        schema:citation  "John A. Charles Jr. “Climate Change and the Oregon Economy: Still Searching for the Smoking Gun” (<a href=\"http://cascadepolicy.org/pdf/env/2005_13.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">PDF</a>), <em>Cascade Commentary</em>, No. 13 (December, 2005)."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4275>
        rdf:type                 schema:Claim;
        schema:abstract          "“Because 98 percent of Oregon is open space, largely covered with vegetation, it’s at least plausible that Oregon is actually a net sink for CO2 rather than a net source. If that turns out to be the case—and it’s currently being calculated by a multi-state task force known as Westcarb—there would be no policy basis for Gov. Kulongoski to impose additional regulations on Oregonians, such as the costly California automotive emissions standards he is advocating.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4275/source/5>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-charles/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/john-charles/" .

<http://data.open.ac.uk/climate-sense/claim/4274/source/4>
        rdf:type         schema:CreativeWork;
        schema:citation  "John A. Charles Jr. “Climate Change and the Oregon Economy: Still Searching for the Smoking Gun” (<a href=\"http://cascadepolicy.org/pdf/env/2005_13.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">PDF</a>), <em>Cascade Commentary</em>, No. 13 (December, 2005)."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4274>
        rdf:type                 schema:Claim;
        schema:abstract          "“Journalists have repeatedly shown a propensity for believing alarmist claims about global warming based primarily on computer modeling of the future. But the only thing that really matters for public policy is empirical data. If the evidence shows that Oregon is a net emitter of greenhouse gases and that reducing those gases would demonstrably make us better off, then policy makers should consider taking action. But that evidence does not yet exist.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4274/source/4>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-charles/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/john-charles/" .

<http://data.open.ac.uk/climate-sense/claim/4273/source/9>
        rdf:type         schema:CreativeWork;
        schema:citation  "Thomas Tanton. “<a href=\"http://www.windaction.org/opinions/651\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Whirlwind of Trouble</a>,” <em>Rocky Mountain News</em>, January 15, 2005. Republished by Industrial Wind Action Group.<a href=\"http://www.webcitation.org/65a1vGK9u\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> Archived February 19, 2012</a>, with WebCite."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4273>
        rdf:type                 schema:Claim;
        schema:abstract          "“Wind energy is environmentally harmful and costly to taxpayers. Furthermore, its expansion could adversely affect the nation’s electricity transmission system.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4273/source/9>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Alex Fitzsimmons. “<a href=\"http://web.archive.org/web/20161219185858/http://instituteforenergyresearch.org/analysis/obamas-final-carbon-rule-combines-fake-carrots-and-a-big-stick/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Obama’s Final Carbon Rule Combines Fake Carrots and a Big Stick</a>,” Institute for Energy Research, August 4, 2015. Archived December 19, 2016. Archive.is URL: <a href=\"https://archive.is/46KqW\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/46KqW</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5659>
        rdf:type                 schema:Claim;
        schema:abstract          "“The final [carbon] rule is even worse than the proposal: it is still an illegal assault on states, it raises electricity prices even more than originally thought, it poses an even larger threat to the electric grid, and it still does nothing to address climate change. Now more than ever, states should reject President Obama’s costly carbon agenda and refuse to submit state plans.”";

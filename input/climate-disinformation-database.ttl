        rdf:type                 schema:Claim;
        schema:abstract          "“Despite many efforts by EPA, state officials have not engaged in a meaningful discussion of sustainable mining practices that will create jobs while protecting the waters that Appalachian communities depend on for drinking, swimming and fishing.”";

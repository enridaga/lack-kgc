        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://cascadepolicy.org/blog/2016/02/22/testimony-on-hb-4036-the-alluring-vision-of-a-coal-free-electricity-grid/\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Testimony Regarding HB 4036 Before the Senate Business and Transportation Committee</a>,” Cascade Policy Institute, February 22, 2016. WebCite URL: <a href=\"http://www.webcitation.org/6hJSYRU34\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">http://www.webcitation.org/6hJSYRU34</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4281>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Siren Song of a coal-free grid is ultimately destructive. We suggest that the Senate Committee steer around it. If that means that the advocates move forward with their threatened ballot measures, so be it. Voters are quite capable of deciding for themselves if they want a power grid that works, or one that randomly fails,” Charles concludes.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4281/source/16>;

        rdf:type                 schema:Claim;
        schema:abstract          "“This is the price of Net Zero. Be under no illusion…”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11985/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;

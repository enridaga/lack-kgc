<http://data.open.ac.uk/climate-sense/claim/9973/source/11>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"http://www.johnlocke.org/acrobat/policyReports/globalwarmingguide.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“A North Carolina Citizen’s Guide to Global Warming” (PDF</a><a href=\"http://www.johnlocke.org/acrobat/policyReports/globalwarmingguide.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">)</a>, John Locke Foundation Policy Report, July, 2007. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9973>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Earth has indeed warmed during the last few decades and may warm further in the future. But the pattern of climate change is not consistent with the greenhouse effect being the main cause.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9973/source/11>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-locke-foundation/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“As municipalities, counties, and even countries declare a “climate emergency,” it is apparent that global warming is often being presented as an existential challenge requiring urgent and strong climate policies to avoid&nbsp;devastation.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8119/source/>;

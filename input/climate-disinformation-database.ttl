<http://data.open.ac.uk/climate-sense/claim/9036/source/57>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20190201163648/https://www.instituteforenergyresearch.org/the-grid/bad-policies-cause-prices-spike-northeast/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Bad Policies Cause Prices to Spike in the Northeast</a>,” <em>instituteforenergyresearch.org, </em>January 10, 2018. Archived February 1, 2019. Archive.is URL: <a href=\"http://archive.is/iAKl9\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/iAKl9</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9036>
        rdf:type                 schema:Claim;
        schema:abstract          "“Environmentalists have contributed to the problem by protesting pipeline projects.&nbsp;… Bad policy decisions regarding limiting pipeline capacity, banning hydraulic fracturing, and shuttering coal and nuclear power plants have caused natural gas and electricity prices to spike in the Northeast when the bomb cyclone hit.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9036/source/57>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/institute-energy-research/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;

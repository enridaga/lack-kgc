<http://data.open.ac.uk/climate-sense/claim/3264/source/35>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"http://web.archive.org/web/20120829075946/http://ipaa.org/issues/hot_topics/docs/Waxman-HedgingUnderFire.pdf?40097968927525418081359021016397\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">“Dear IPAA Members and Colleagues” (PDF)</a>, <em>IPAA, </em>May 29, 2009. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3264>
        rdf:type                 schema:Claim;
        schema:abstract          "“There are other issues in the global climate portion of the bill that need to be addressed, but the point of regulation has been an important issue of U.S. natural gas producers. IPAA had strongly opposed the earlier Senate bill because it required gas processors to acquire the GHG emissions rights for natural gas – an approach that would likely have caused the burden to shift to producers. The H.R. 2454 point of regulation does not create this risk.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3264/source/35>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/independent-petroleum-association-america-ipaa/>;

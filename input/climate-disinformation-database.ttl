<http://data.open.ac.uk/climate-sense/claim/2892>
        rdf:type                 schema:Claim;
        schema:abstract          "I believe we should very much encourage such a meeting with News International, as it would fit well with our present work on the Tobacco Alliance, and would fit particularly well with the response we had recently from the N.P.A. I expect to hear further from Bryan Simpson shortly on this matter.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2892/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rupert-murdoch/>;

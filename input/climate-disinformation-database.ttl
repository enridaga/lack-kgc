<http://data.open.ac.uk/climate-sense/claim/6490>
        rdf:type                 schema:Claim;
        schema:abstract          "As one gets older, one can get tired. But only when your heart gives out does your strength give in. For me, all this is an affair of the heart.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6490/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-bastardi/>;

<http://data.open.ac.uk/climate-sense/claim/8522/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "Charles McConnell. “<a href=\"https://web.archive.org/web/20181029211946/https://www.washingtonexaminer.com/how-one-trump-nominee-combined-environmental-quality-and-economic-development\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">How one Trump nominee combined environmental quality and economic development</a>,” <em>Washington Examiner</em>, November 27, 2017. Archived October 29, 2018. Archive.is URL: <a href=\"http://archive.is/Yw9Ss\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/Yw9Ss</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8522>
        rdf:type                 schema:Claim;
        schema:abstract          "“Kathleen has been nominated by President Trump to chair the White House Council on Environmental Quality, and she is being questioned and challenged – not for her record, and not for her qualifications, but because she has refused to define environmental quality and economic development as mutually exclusive.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8522/source/16>;

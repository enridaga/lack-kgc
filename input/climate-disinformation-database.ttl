<http://data.open.ac.uk/climate-sense/claim/12072>
        rdf:type                 schema:Claim;
        schema:abstract          "“It’s my opinion – based on the work I have done with my own nation, as the former president and CEO of the Canadian Council for Aboriginal Business, the executive director of the Indigenous Resource Network and as a board member of both Indigenous owned and public companies – that resource development, from forestry to mining to oil and gas to fishing, is often the best, and for many nations, the only, transformative economic opportunity that can allow us to be self-determining again.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12072/source/42>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/macdonald-laurier-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/macdonald-laurier-institute/" .


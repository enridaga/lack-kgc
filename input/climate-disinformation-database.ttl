<http://data.open.ac.uk/climate-sense/claim/10662>
        rdf:type                 schema:Claim;
        schema:abstract          "“Florida cannot afford to ignore the potential adverse impact of those errors because accurate assumptions and credible data are central to a fair evaluation of the costs and benefits of implementing recommendations for reducing greenhouse gases,” the BHI/JMI report reads.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10662/source/32>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/james-madison-institute/>;

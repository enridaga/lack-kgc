<http://data.open.ac.uk/climate-sense/claim/10446>
        rdf:type                 schema:Claim;
        schema:abstract          "“Concluding words. We at the Alliance for Responsible Citizenship, we at ARC do not believe that humanity is necessarily and inevitably teetering on the brink of apocalyptic disaster.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10446/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jordan-peterson/>;

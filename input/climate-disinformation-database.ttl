<http://data.open.ac.uk/climate-sense/claim/12245>
        rdf:type                 schema:Claim;
        schema:abstract          "“Despite some doom and gloom predictions, excluding waves washing onto shores by relatively rarely occurring tsunamis and storm-surges, low-lying areas on the face of our planet have NOT yet been submerged by rising oceans… so probably low-lying areas along shorelines of Canada and the USA will be SAFE into foreseeable and even distant futures.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12245/source/2>;

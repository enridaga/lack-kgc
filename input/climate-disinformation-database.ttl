        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11801>
        rdf:type                 schema:Claim;
        schema:abstract          "1320 N. Courthouse Road, Suite 500";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11801/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/seminar-network/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/seminar-network/" .

<http://data.open.ac.uk/climate-sense/claim/11800/source/17>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://deepclimate.org/2010/04/22/wegman-and-saids-social-network-sources-more-dubious-scholarship/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Wegman and Said on social networks: More dubious scholarship</a>,” <em>Deep Climate</em>, April 22, 2010. Archived June 16, 2020. Archive URL: <a href=\"https://archive.vn/ocqCB\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/ocqCB</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11800>
        rdf:type                 schema:Claim;
        schema:abstract          "“In both the original Wegman report and a subsequent follow-up paper by Yasmin Said, Wegman and two others, the background sections on social network research show clear and compelling instances of apparent plagiarism. The three main sources, used almost verbatim and without attribution, have now been identified. These include a Wikipedia article and a classic sociology text book by Wasserman and Faust. But the papers rely even more on the third source, a hands-on text book that explores social network concepts via the Pajek analysis software package – the same tool used by the Wegman team to analyze ‘hockey stick’ author Michael Mann’s co-author network.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11800/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/edward-wegman/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/edward-wegman/" .

<http://data.open.ac.uk/climate-sense/claim/11799/source/13>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"http://web.archive.org/web/20100614192241/http://republicans.energycommerce.house.gov/108/home/07142006_Wegman_fact_sheet.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Report Raises New Questions About Climate Change Assessments” (PDF)</a>. U.S. House Committee on Energy &amp; Commerce."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11799>
        rdf:type                 schema:Claim;
        schema:abstract          "“Overall, our committee believes that Dr. Mann’s assessments that the decade of the 1990s was the hottest decade of the millennium and that 1998 was the hottest year of the millennium cannot be supported by his analysis.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11799/source/13>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/edward-wegman/>;

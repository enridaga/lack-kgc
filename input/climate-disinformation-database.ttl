<http://data.open.ac.uk/climate-sense/claim/2361/source/126>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160308215645/https://www.heartland.org/events/eleventh-international-conference-climate-change-iccc-11\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Heartland Events: Eleventh International Conference on Climate Change ( ICCC-11)</a>,” <em>Heartland Institute</em>. Archived March 8, 2016. Archive URL: <a href=\"https://archive.ph/ZlwM7\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/ZlwM7</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2361>
        rdf:type                 schema:Claim;
        schema:abstract          "“We brought a needed discussion to COP-21 in Paris by putting science before ideology,” said Jim Lakely, director of communications at The Heartland Institute. “That conversation continues, in longer form, with another great program with world-renowned scientists and policy experts in Essen. We’re proud to co-host this conference with our friends at EIKE.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2361/source/126>;

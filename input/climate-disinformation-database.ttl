<http://data.open.ac.uk/climate-sense/claim/5300/source/53>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.reuters.com/article/uk-factcheck-seibt-fined-banned-social-m/fact-checkclimate-changeskepticnaomi-seibtwas-notfined-banned-from-social-media-for-her-views-idUSKBN2322PD\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Fact check: Climate change skeptic Naomi Seibt was not banned from social media for her views and she is appealing a regulator’s order to remove two videos</a>,” <em>Reuters</em>, May 28, 2020. <a href=\"https://web.archive.org/web/20200529212056/https://www.reuters.com/article/uk-factcheck-seibt-fined-banned-social-m/fact-checkclimate-changeskepticnaomi-seibtwas-notfined-banned-from-social-media-for-her-views-idUSKBN2322PD\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 29, 2020</a>. Archive URL: <a href=\"https://archive.vn/lHF4I\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/lHF4I</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5300>
        rdf:type                 schema:Claim;
        schema:abstract          "“Ms. Seibt was requested to delete two YouTube videos because they violate German law. The basis of our decision is the prohibition of third party influence on the editorial content in audiovisual media according to articles 7 para. 7 sentence 1 in connection with 58 para. 3 sentence 1 of the Interstate Broadcasting Treaty (Rundfunkstaatsvertrag-RStV).";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5300/source/53>;

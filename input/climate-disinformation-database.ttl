        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.theglobeandmail.com/politics/article-conservative-politicians-oil-executives-map-out-strategy-for-ousting/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Conservative politicians, oil executives map out strategy for ousting Liberals in growing collaboration</a>,” <em>The Globe and Mail</em>, April 25, 2019. Archive.fo URL: <a href=\"https://archive.fo/Ok5CB\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/Ok5CB</a>"^^rdf:HTML .


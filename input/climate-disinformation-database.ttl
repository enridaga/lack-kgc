        schema:citation  "“<a href=\"http://www.washingtontimes.com/news/2011/mar/29/redressing-global-climate-hysteria/?page=1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">BOOK REVIEW: Redressing global climate hysteria</a>,” <em>The Washington Times</em>, March 29, 2011."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6707>
        rdf:type                 schema:Claim;
        schema:abstract          "“…the man-made-climate-catastrophe scientists, with enormous financial support from big government and the aid of media and PR promoters, continue to hawk their limited view of the atmosphere.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6707/source/13>;

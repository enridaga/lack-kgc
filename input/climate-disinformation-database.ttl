        rdf:type                 schema:Claim;
        schema:abstract          "“If the Government wants to encourage investment in native oil and gas production – and it should – it needs to […] give the industry reassurances that it is not going to be regulated out of existence by net zero commitments”.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12462/source/>;

        rdf:type                 schema:Claim;
        schema:abstract          "&nbsp;“Global restrictions on greenhouse gases would undermine the capacity of people in poor countries to address the problems they face today as well as in the future by retarding economic growth and general economic&nbsp;development.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12428/source/>;

        schema:abstract          "Sherman: “Well, do you think the State of Alaska’s actions in the first seventy-two hours after the spill in regard to dispersant use were wrong?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10185/source/>;

<http://data.open.ac.uk/climate-sense/claim/7897/source/9>
        rdf:type         schema:CreativeWork;
        schema:citation  "Charles Battig. “<a href=\"http://wattsupwiththat.com/2014/07/10/climate-change-hysteria-and-the-madness-of-crowds/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Change Hysteria and the Madness of Crowds</a>,” <em>Watts Up With That</em>. July 10, 2015."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7897>
        rdf:type                 schema:Claim;
        schema:abstract          "“Countering this climate doomsday propaganda has been a number of scientists and independent organizations. Manipulation of the historical temperature record by our own government agencies has been documented. Such revisions serve to make the historical record conform to the political aims and views of our Federal government, that global warming is occurring and is linked to fossil fuel use. Proliferation of internet access has provided the new open public soap box, independent of traditional media, itself fully in the climate panic mode. Web sites maintained by Anthony Watts, Marc Morano, and Steve Milloy are just a few of many striving to get the unpoliticized science before the public.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7897/source/9>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/charles-battig/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;

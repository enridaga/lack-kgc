        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"//www.desmog.com/wp-content/uploads/files/Moghissi-special-report-climate-change-and-health-001.pdf\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Global Climate Change and Human Health” (PDF)</a>, <em>American Council on Science and Health, </em>October 1997."^^rdf:HTML .


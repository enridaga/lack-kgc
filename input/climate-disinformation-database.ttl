<http://data.open.ac.uk/climate-sense/claim/10653>
        rdf:type                 schema:Claim;
        schema:abstract          "“We do not believe that past and current climates are sufficiently well understood to enable projections of future climate changes to be accurately predicted.&nbsp; Our purpose is to exchange scientific ideas and to encourage proper political and social debate on this intriguing subject.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10653/source/7>;

<http://data.open.ac.uk/climate-sense/claim/9135>
        rdf:type                 schema:Claim;
        schema:abstract          "“I think we need to lean on legislature a little bit to get to the bottom of exactly what occurred. And I think the answer to that’s going to be that we need to look at how we allow renewable, that access, onto the grid and maybe not not allow that to happen.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9135/source/23>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jim-wright/>;

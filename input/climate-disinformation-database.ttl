<http://data.open.ac.uk/climate-sense/claim/12330>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Biden Administration seeks to replace fossil fuels with green energy. This would cause a significant number of jobs to be eliminated. To compensate, the Biden Administration would use taxpayer funds to create ‘green’ jobs for those who lost theirs due to the Biden Administration’s anti-traditional energy policies. Instead of attempting to end fossil fuels, the United States should have a policy that embraces all energy sources and rewards American energy innovation.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12330/source/34>;

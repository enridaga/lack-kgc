<http://data.open.ac.uk/climate-sense/claim/2205/source/41>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20010415121513/http://mikepence.com/warm.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Global Warming Disaster</a>,” Mikepence.com. Archived April 15, 2001. Archived .pdf on file at DeSmog. Archive.is&nbsp;URL:&nbsp;<a href=\"https://archive.is/VxXVy\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/VxXVy</a>"^^rdf:HTML .


<http://data.open.ac.uk/climate-sense/claim/7825>
        rdf:type                 schema:Claim;
        schema:abstract          "“Lawson agrees that there has been some global warming over the past hundred years and that increased man-made emissions of carbon dioxide are partly to blame. But he argues that natural causes are more important than commonly agreed and that the science of climate remains in its infancy.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7825/source/14>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/nigel-lawson/>;

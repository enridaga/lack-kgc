        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10466>
        rdf:type                 schema:Claim;
        schema:abstract          "“I like [Michael] Shellenberger. I think ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10466/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jordan-peterson/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;

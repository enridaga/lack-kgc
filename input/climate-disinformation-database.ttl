<http://data.open.ac.uk/climate-sense/claim/7108/source/12>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s25\"></a>“<a href=\"https://twitter.com/johnredwood/status/1479773224250523652?s=20\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">More gas is the answer to a gas crisis. We need it to heat our homes and fuel our factories. We also need it as back up for electricity generation when the wind does not blow or blows too much. Let’s have some more U.K. sourced gas as well as more windmills.</a>,” Tweet by @JohnRedwood, January 8, 2022. Retrieved from twitter.com. <a href=\"https://web.archive.org/web/20220110185131/https://twitter.com/johnredwood/status/1479773224250523652?s=20\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 10, 2022</a>. Archive URL: <a href=\"https://archive.ph/OtjRC\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/OtjRC</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7108>
        rdf:type                 schema:Claim;
        schema:abstract          "“More gas is the answer to a gas crisis. We need it to heat our homes and fuel our factories. We also need it as back up for electricity generation when the wind does not blow or blows too much. Let’s have some more U.K. sourced gas as well as more windmills.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7108/source/12>;

        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/pacific-research-institute/" .

<http://data.open.ac.uk/climate-sense/claim/11298/source/10>
        rdf:type         schema:CreativeWork;
        schema:citation  "Dana Joel Gattuso. “<a href=\"http://web.archive.org/web/20160324022822/https://www.pacificresearch.org/article/the-chilling-effects-of-the-kyoto-protocol/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Chilling Effects of the Kyoto Protocol</a>,” <em>Pacific Research Institute</em>, November 20, 1998. Archived March 24, 2016. Archive.is URL:&nbsp;<a href=\"https://archive.is/ZMwmG\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/ZMwmG</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11298>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Kyoto Protocol is wrong on all accounts. There is no conclusive scientific evidence that global warming exists or that, if it does, human activity is a contributing factor. But in the event warming is occurring and is stoppable, the Protocol will not even come close to achieving its stated goal. The world’s largest emitters will get a free ride, leaving the United States to bear the burden.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11298/source/10>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/pacific-research-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/pacific-research-institute/" .


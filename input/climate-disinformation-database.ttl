<http://data.open.ac.uk/climate-sense/claim/9850/source/12>
        rdf:type         schema:CreativeWork;
        schema:citation  "Coral Davenport. “<a href=\"https://www.nytimes.com/2018/11/25/climate/trump-climate-report.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Trump Administration’s Strategy on Climate: Try to Bury Its Own Scientific Report</a>,” <em>New York Times</em>, November 25, 2018. <a href=\"https://web.archive.org/web/20181125223832/https://www.nytimes.com/2018/11/25/climate/trump-climate-report.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived November 25, 2018</a>. Archive.is URL:&nbsp;<a href=\"http://archive.is/upESh\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/upESh</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9850>
        rdf:type                 schema:Claim;
        schema:abstract          "“We don’t care. In our view, this is made-up hysteria anyway. … Trying to stop the deep state from doing this in the first place, or trying to alter the document, and then creating a whole new narrative — it’s better to just have it come out and get it over with. … But do it on a day when nobody cares, and hope it gets swept away by the next day’s news.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9850/source/12>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/burn-more-coal/>;

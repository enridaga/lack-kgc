<http://data.open.ac.uk/climate-sense/claim/10410/source/32>
        rdf:type         schema:CreativeWork;
        schema:citation  "David Frost. “<a href=\"https://web.archive.org/web/20230519000949/https://www.telegraph.co.uk/news/2023/05/18/the-tories-should-embrace-national-conservatism/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Tories should embrace national conservatism</a>,” <em>The Telegraph</em>, May 18, 2023. Archived May 19, 2023. Archive URL: <a href=\"https://archive.ph/wvwHa\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/wvwHa</a>"^^rdf:HTML .


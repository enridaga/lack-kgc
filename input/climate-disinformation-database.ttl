<http://data.open.ac.uk/climate-sense/claim/12782>
        rdf:type                 schema:Claim;
        schema:abstract          "“In their quest to fulfill the Paris Accord and force an arbitrary shift to unreliable, costly energy sources, the Climate Mayors network has shown the United States what our future would be, had the president worked to stay in the&nbsp;agreement.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12782/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mandy-gunasekara/>;

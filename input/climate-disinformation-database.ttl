<http://data.open.ac.uk/climate-sense/claim/11968/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11968>
        rdf:type                 schema:Claim;
        schema:abstract          "“Net zero will make zero difference to climate change, as confirmed by the Intergovernmental Panel on Climate Change, that says if you get to net zero, it’ll make no difference to sea level rise for between 200 and 1,000 years. Actually, what we need to do with climate change – of course, we all care about the environment of the planet – we need to adapt to it. The idea that you can stop the power of the sun or volcanoes is simply ludicrous. Anyone who thinks you can, frankly, you’re misinformed.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11968/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .

<http://data.open.ac.uk/climate-sense/claim/11967/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11967>
        rdf:type                 schema:Claim;
        schema:abstract          "“The arrogant naivete of people who think you can stop the power of the sun, stop the power of volcanoes. There’s no evidence that man-made CO2 is going to change climate change. Given that it’s gone on for millions of years, it will go on for millions of years”.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11967/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/richard-tice/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/richard-tice/" .


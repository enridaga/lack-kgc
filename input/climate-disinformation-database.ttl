        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20051127055647/http://techcentralstation.com:80/083001L.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Skeptical Environmentalist Finds Hope for the Human Condition</a>,” T<em>ech Central Station</em>, August 30, 2001. Archived November 27, 2005. Archive.is URL: <a href=\"https://archive.is/KJB9V\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/KJB9V</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12808>
        rdf:type                 schema:Claim;
        schema:abstract          "“I try to say the Kyoto agreement, even if it was completed in full and the U.S. participated would do almost no good,” Lomborg said in the interview. “It would postpone warming for about six years longer than 2100. On the other hand, it will cost an amazing amount of money.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12808/source/23>;

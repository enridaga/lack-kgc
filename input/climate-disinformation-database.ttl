        rdf:type                 schema:Claim;
        schema:abstract          "“To to run a country on [solar and wind generation] technology is truly not here today, and if we had to do that, what we would be doing to the environment would be a lot worse than what we’re doing with fossil fuel today,” Wright said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9144/source/>;

<http://data.open.ac.uk/climate-sense/claim/10445>
        rdf:type                 schema:Claim;
        schema:abstract          "“To realize, yes, climate change is a real problem, but it’s not this catastrophic end of the world. There is nothing in the UN climate panel, the new report that came out from 2021–2022, these 1600 pages. No apocalypse in there.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10445/source/>;

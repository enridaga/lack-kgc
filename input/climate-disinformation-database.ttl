<http://data.open.ac.uk/climate-sense/claim/3869>
        rdf:type                 schema:Claim;
        schema:abstract          "“Even when fully implemented, the Paris Agreement would have no significant impact on the environment. An analysis by Bjorn Lomborg found that the collective efforts of the world would only reduce global temperatures by one sixth of a degree Celsius and could cost trillions of dollars.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3869/source/22>;

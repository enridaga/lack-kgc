        rdf:type                 schema:Claim;
        schema:abstract          "“CO2 is not harmful and is actually good for the planet…”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11756/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-bezdek/>;
        schema:claimInterpreter  <http://desmog.com/>;

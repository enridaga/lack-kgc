<http://data.open.ac.uk/climate-sense/claim/3739>
        rdf:type                 schema:Claim;
        schema:abstract          "Behind the arrant nonsense of climate alarmism is a vicious attack on the prosperity &amp; freedom of ordinary people. It is driven by a deranged contempt for material progress, a deep hatred of people, by self-interest, and a dark authoritarian urge to keep people under control.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3739/source/>;

<http://data.open.ac.uk/climate-sense/claim/7894>
        rdf:type                 schema:Claim;
        schema:abstract          "“Life has existed on our planet for billions of years, and the climate over that time has changed from ice ages to periods much warmer than today. There is little doubt that as our cities grow, heat waves will be more severe in the urban areas. If global warming does in fact add to the problem, we will adapt to the new world, just as humans have done for millions of years.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7894/source/8>;

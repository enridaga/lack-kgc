        rdf:type                 schema:Claim;
        schema:abstract          "“Tom Steyer is a billionaire based in California,” Institute for Liberty President Andrew Langer said. “He argues for greater regulation on his competitors and forces to get subsidies for his green energy boondoggles.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12678/source/>;

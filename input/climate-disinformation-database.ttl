<http://data.open.ac.uk/climate-sense/claim/7806>
        rdf:type                 schema:Claim;
        schema:abstract          "The climate religion has about as much to do with the climate as the Spanish Inquisition had to do with Christ. ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7806/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vivek-ramaswamy/>;

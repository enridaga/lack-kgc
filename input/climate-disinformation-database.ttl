<http://data.open.ac.uk/climate-sense/claim/9806>
        rdf:type                 schema:Claim;
        schema:abstract          "“Mann could be said to be the Jerry Sandusky of climate science, except for instead of molesting children, he has molested and tortured data in the service of politicized science that could have dire economic consequences for the nation and planet.”";

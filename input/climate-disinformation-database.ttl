        rdf:type                 schema:Claim;
        schema:abstract          "“The hypothesis of Anthropogenic Global Warming does not yet meet the basic scientific standards of proof needed to be accepted as a viable hypothesis, much less as accepted fact.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9841/source/15>;

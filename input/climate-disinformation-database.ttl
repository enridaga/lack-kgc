<http://data.open.ac.uk/climate-sense/claim/13286>
        rdf:type                 schema:Claim;
        schema:abstract          "“HSBC will stop funding future oil and gas exploration and development projects. They’re doing it because they want to help us meet our environmental targets. Oh aren’t they so virtuous and wonderful?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13286/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/nigel-farage/>;

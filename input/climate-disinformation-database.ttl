        rdf:type         schema:CreativeWork;
        schema:citation  "James Lankford. “<a href=\"https://votesmart.org/public-statement/873697/lankford-what-difference-will-new-climate-change-regulations-actually-make-for-our-climate#.XPEJT6R7k2x\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Lankford: What Difference Will New Climate Change Regulations Actually Make for Our Climate?</a>” <em>Vote Smart</em>, June 3, 2014. Archived May 31, 2019. Archive.fo URL: <a href=\"http://archive.fo/Or1aM\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/Or1aM</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11218>
        rdf:type                 schema:Claim;
        schema:abstract          "“When all is said and done, what will we actually gain in our effort to preserve our environment, if this change takes effect? Right now, the President says we need to be a world leader in climate change mitigation. But will these changes actually improve our climate, or will they just cost struggling American families more money?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11218/source/15>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/james-lankford/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/james-lankford/" .


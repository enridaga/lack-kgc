        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12907>
        rdf:type                 schema:Claim;
        schema:abstract          "“So is there a better way to do this? Well, we think that there is. It’s very simple: It’s that we need to make clean energy cheap&nbsp;worldwide.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12907/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/michael-shellenberger/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/michael-shellenberger/" .

<http://data.open.ac.uk/climate-sense/claim/12906/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12906>
        rdf:type                 schema:Claim;
        schema:abstract          "“When was the last time human beings modernized our energy sources by making older power sources more expensive? And, of course, by now you probably know that the answer is&nbsp;never.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12906/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/michael-shellenberger/>;

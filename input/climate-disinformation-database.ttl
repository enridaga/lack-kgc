        rdf:type         schema:CreativeWork;
        schema:citation  "David E. Wojick. “<a href=\"http://web.archive.org/web/20060228101708/www.heartland.org/Article.cfm?artId=17190\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Another False Alarm on Global Warming</a>,” <em>The Heartland Institute</em>, May 2, 2005. Archived February 28, 2006. Archive.is URL: <a href=\"http://archive.li/Fd3YO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.li/Fd3YO</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3820>
        rdf:type                 schema:Claim;
        schema:abstract          "“In point of fact, the hypothesis that solar variability and not human activity is warming the oceans goes a long way to explain the puzzling idea that the Earth’s surface may be warming while the atmosphere is not. The GHG hypothesis does not do this,”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3820/source/18>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-wojick/>;

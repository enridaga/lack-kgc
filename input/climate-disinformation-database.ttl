        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20020704015711/http://cei.org/gencon/027,01526.cfm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Testimony before the Committee on Small Business, Hearing on the Kyoto Protocol</a>,” Competitive Enterprise Institute, June 4, 1998. Archived July 4, 2002. Archive.is URL: <a href=\"https://archive.is/y4bWl\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/y4bWl</a>"^^rdf:HTML .


        rdf:type                 schema:Claim;
        schema:abstract          "In addition to basic event tickets, Levant also said they were selling an “exclusive VIP wine and cheese reception” as well as a “private dinner with Dr. Moore after the speech.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11855/source/56>;

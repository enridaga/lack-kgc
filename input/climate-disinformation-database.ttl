        schema:citation  "<a href=\"http://web.archive.org/web/20170928025940/http://www.nam.org/Issues/Official-Policy-Positions/NAM-Policy-Positions-Approved-Winter-2016.pdf\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">“NAM&nbsp;POLICY&nbsp;POSITIONS” (PDF),</a>&nbsp;<em>National Association of Manufacturers</em>, February&nbsp;2016."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1933>
        rdf:type                 schema:Claim;
        schema:abstract          "“The&nbsp;NAM&nbsp;believes that mitigating the impact of global warming by reducing greenhouse gas emissions is a significant and important goal for all nations. Any initiatives to achieve this goal, however, must not put American manufacturers at a relative competitive disadvantage. If actions are not taken by all significant emitters, there is substantial risk of carbon leakage that could nullify the effects of unilateral domestic action.”";

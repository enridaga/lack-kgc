        rdf:type                 schema:Claim;
        schema:abstract          "“[W]e conclude that future global warming will occur at a pace substantially lower than that upon which US federal and international actions to restrict greenhouse gas emissions are&nbsp;founded.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/652/source/15>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/cato-institute/>;

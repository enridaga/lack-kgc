<http://data.open.ac.uk/climate-sense/claim/3074/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3074>
        rdf:type                 schema:Claim;
        schema:abstract          "Thus, CEI was to be a different organization, bridging the gap between analysis and advocacy – we should seek to integrate mind and muscle, if you will.&nbsp;[…]”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3074/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/council-competitive-economy/>;

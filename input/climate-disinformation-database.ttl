        schema:url               "https://www.desmog.com/jim-lakely/" .

<http://data.open.ac.uk/climate-sense/claim/8000/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8000>
        rdf:type                 schema:Claim;
        schema:abstract          "“If socialists care about people they should be loving nuclear power. […] Why are they so anti-nuclear?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8000/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jim-lakely/>;

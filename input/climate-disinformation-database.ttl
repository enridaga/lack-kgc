<http://data.open.ac.uk/climate-sense/claim/9738/source/47>
        rdf:type         schema:CreativeWork;
        schema:citation  "Hiroko Tabucchi. “<a href=\"http://www.nytimes.com/2017/01/05/business/energy-environment/koch-brothers-fossil-fuels-minorities.html?_r=0\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Sensing Gains Ahead Under Trump, the Kochs Court Minorities</a>,” <em>The New York Times</em>, January 5, 2017. Archived January 9, 2017. Archive.is URL: <a href=\"https://archive.is/abF3O\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/abF3O</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9738>
        rdf:type                 schema:Claim;
        schema:abstract          "“About halfway through the event, the music gave way to a panel discussion on how the holidays were made possible by energy — cheap energy, like oil and gas,” Hiroko Tabuchi writes at the&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9738/source/47>;

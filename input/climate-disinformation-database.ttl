        rdf:type         schema:CreativeWork;
        schema:citation  "(Press Release). “<a href=\"https://lamarsmith.house.gov/media-center/press-releases/smith-statement-on-obama-climate-plan\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Smith Statement on Obama Climate Plan</a>,” Congressman Lamar Smith, September 17, 2014. Archive.is URL: <a href=\"https://archive.is/IDE5L\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/IDE5L</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3877>
        rdf:type                 schema:Claim;
        schema:abstract          "“America cannot afford to drive its economy over a cliff with the hopes that the rest of the world will make the same mistake. The only economy the EPA’s plan will help is that of our competitors.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3877/source/30>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/lamar-smith/>;

<http://data.open.ac.uk/climate-sense/claim/3412/source/17>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160727004703/http://www.washingtontimes.com/news/2016/jul/6/science-groups-blasted-crossing-line-activism-clim/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Science groups blasted for crossing line into activism with climate-change letter to Congress</a>,” <em>The Washington Times</em>, July 6, 2016. Archived July 27, 2016. Archive.is URL: <a href=\"https://archive.is/TPUTd\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/TPUTd</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3412>
        rdf:type                 schema:Claim;
        schema:abstract          "“Obviously folks should be free to deliver their opinions,” said Knappenberger. “That said, since many of these organizations publish some of the most respected scientific journals, it certainly calls into question the degree of objectivity to which new science pertaining to the issues addressed in the letter is treated with. This is a far greater concern.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3412/source/17>;

<http://data.open.ac.uk/climate-sense/claim/8369/source/12>
        rdf:type         schema:CreativeWork;
        schema:citation  "Ben Jervey. “<a href=\"https://www.desmog.com/2017/11/16/climate-depot-marc-morano-cop23-spins-climate-denial-turkish-tv\" target=\"_blank\" rel=\"noreferrer noopener\" data-wpel-link=\"internal\">Climate Depot’s Marc Morano Returns to UN Climate Talks to Mock Activists, Spin Climate Denial,”</a>&nbsp;<em>DeSmog</em>, November 16, 2017."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8369>
        rdf:type                 schema:Claim;
        schema:abstract          "“Carbon pricing harkens back to the idea, you know, that Massachusetts had to deal with, is the witchcraft trials. The idea that witches change the weather. Now they’re claiming SUVs and our coal plants are changing the weather,” Morano&nbsp;said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8369/source/12>;

        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3065>
        rdf:type                 schema:Claim;
        schema:abstract          "“We believed that if we could convince even a modest number of prominent corporate leaders and associations to admit publicly that, whatever their practical constraints, they at least believed in and aspired to such a straight and narrow course, the public perception of economic competition and profits would begin to change and an appropriate standard by which to judge the social behavior of business enterprises would emerge. Public awareness of such a high road could not help but focus attention on those who seek&nbsp;privileges.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3065/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/council-competitive-economy/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/council-competitive-economy/" .


<http://data.open.ac.uk/climate-sense/claim/1243/source/20>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20201009215911/https://stream.org/the-mccarrick-scandal-objectively-disordered-sexual-desires/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The McCarrick Scandal &amp; Objectively Disordered Sexual Desires</a>,” <em>The Stream</em>, October 9, 2020. Archive URL:<a href=\"https://archive.vn/V43Xv\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/V43Xv</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1243>
        rdf:type                 schema:Claim;
        schema:abstract          "“The Church instead needs to return to a proper understanding of the nature of man.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1243/source/20>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/william-briggs/>;

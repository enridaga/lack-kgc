<http://data.open.ac.uk/climate-sense/claim/3451>
        rdf:type                 schema:Claim;
        schema:abstract          "“State legislatures should also oppose the rule by passing legislation to protect consumers, businesses, and low-income Americans, and by restricting state agencies from submitting a state plan until the courts have ruled it legal. Almost 30 states filed negative comments on the proposed rule.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3451/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“Hypothesis 1: Human inﬂuence on cli-mate variability and change is of minimal importance, and natural causes dominate climate variations and changes on all time scales. In coming decades, the human inﬂu-ence will continue to be minimal.’";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1155/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-sr/>;

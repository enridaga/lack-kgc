<http://data.open.ac.uk/climate-sense/claim/3737>
        rdf:type                 schema:Claim;
        schema:abstract          "“Man indeed may be a pygmy before nature and incapable of causing or reversing a global warming or climate change. To err on the side of caution let us presume man may be contributing a minor fraction towards warming of the earth. The planet has a great resilience we must not however forget.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3737/source/8>;

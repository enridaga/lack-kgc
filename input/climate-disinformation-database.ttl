        rdf:type                 schema:Claim;
        schema:abstract          "[…]";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2613/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vijay-jayaraj/>;
        schema:claimInterpreter  <http://desmog.com/>;

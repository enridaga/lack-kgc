        rdf:type                 schema:Claim;
        schema:abstract          "“Britain possesses abundant natural energy resources, a skilled workforce, and a track record of driving innovation. It is crucial that we capitalise on these strengths to deliver the lowest energy costs in Europe, ensure energy security, and achieve our climate goals. To undermine our home-grown oil and gas industry would jeopardise critical industries and jobs across the UK, including manufacturing and vital product supply chains.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7159/source/>;

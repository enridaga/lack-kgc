        rdf:type                 schema:Claim;
        schema:abstract          "“… our Berlin Conference shall point out the fact that the scientific debate is not over. Especially with new regulations on the cards, economic and scientific analysis is more important than ever.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7919/source/43>;

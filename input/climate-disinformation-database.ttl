<http://data.open.ac.uk/climate-sense/claim/12585>
        rdf:type                 schema:Claim;
        schema:abstract          "“The divestment of fossil-fuel stocks is both ineffectual against its corporate targets and hurtful to ordinary people,” Bradley said, describing divestment as “a futile crusade.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12585/source/11>;

        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12863>
        rdf:type                 schema:Claim;
        schema:abstract          "[00:11:52] All of which I think raises a really uncomfortable question in the effort to try to save the climate, are we destroying the environment?&nbsp;[00:11:59][7.3]";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12863/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/michael-shellenberger/>;

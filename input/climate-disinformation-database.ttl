<http://data.open.ac.uk/climate-sense/claim/12805>
        rdf:type                 schema:Claim;
        schema:abstract          "“Writes Glassman, Climate does change. It has changed for thousands of years, according to readings of ice cores and tree rings. The question is whether climate change will continue to be cyclical and out of the control of humans, or whether something utterly new is going on.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12805/source/10>;

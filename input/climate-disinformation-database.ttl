        rdf:type         schema:CreativeWork;
        schema:citation  "Alex Epstein. “<a href=\"https://www.forbes.com/sites/alexepstein/2016/03/22/the-truth-about-sea-levels/#7089ffa721d1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Truth About Sea Levels</a>,” <em>Forbes</em>, March 22,&nbsp;2016."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8309>
        rdf:type                 schema:Claim;
        schema:abstract          "“The impact on sea levels of human-influenced global warming pales in comparison to local factors and to the massive natural sea level rises of the past,” he wrote. “Global average trends can be alarming, however–not because of human beings but because of&nbsp;nature.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8309/source/154>;

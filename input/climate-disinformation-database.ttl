<http://data.open.ac.uk/climate-sense/claim/73/source/15>
        rdf:type         schema:CreativeWork;
        schema:citation  "Norman Rogers. “<a href=\"http://web.archive.org/web/20140721181008/http://www.americanthinker.com/2009/08/global_warming_blues.html\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Global Warming Blues</a>,” <em>American Thinker</em>, August 27, 2009. Archived July 21, 2014. Archive.fo URL:<a href=\"https://archive.fo/BlT33\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.fo/BlT33</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/73>
        rdf:type                 schema:Claim;
        schema:abstract          "“The increase in temperature predicted by the global warming computer models is about 3 degrees Celsius. This isn’t very scary, so the promoters of global warming alarmism come up with additional scare stories. For example, there will be more hurricanes, the ice caps will melt, the polar bears will die, the oceans will become acid and kill the coral, and weather will become more extreme.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/73/source/15>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/norman-rogers/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/norman-rogers/" .

<http://data.open.ac.uk/climate-sense/claim/72/source/14>
        rdf:type         schema:CreativeWork;
        schema:citation  "Norman Rogers. “<a href=\"http://web.archive.org/web/20140721181008/http://www.americanthinker.com/2009/08/global_warming_blues.html\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Global Warming Blues</a>,” <em>American Thinker</em>, August 27, 2009. Archived July 21, 2014. Archive.fo URL:<a href=\"https://archive.fo/BlT33\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.fo/BlT33</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/72>
        rdf:type                 schema:Claim;
        schema:abstract          "“Global warming scare stories are good for global warming science because the scare stories promote research funding. If it weren’t for the scary predictions these scientists would be toiling in a poorly funded and obscure branch of academic science.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/72/source/14>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/norman-rogers/>;

<http://data.open.ac.uk/climate-sense/claim/4383/source/21>
        rdf:type         schema:CreativeWork;
        schema:citation  "Emma Gatten. “<a href=\"https://web.archive.org/web/20221126085322/https://www.telegraph.co.uk/news/2022/11/26/exclusive-town-where-boilers-will-ripped-net-zero-trial/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Exclusive: The town where boilers will be ripped out for net zero trial</a>,” <em>The Telegraph</em>, November 26, 2022. Archived November 26, 2022. Archive URL: <a href=\"https://archive.is/vnUO1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/vnUO1</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4383>
        rdf:type                 schema:Claim;
        schema:abstract          "“As ever, with so much nonsense we’re seeing across the path to net zero, the CO2 balance sheet is often worse than what it is attempting to replace.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4383/source/21>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/craig-mackinlay/>;

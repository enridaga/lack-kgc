<http://data.open.ac.uk/climate-sense/claim/4652/source/7>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.larouchepub.com/other/interviews/2007/3419dr_akasofu.html \" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Arctic Climate Expert: Gore’s Film Is ‘Science Fiction’</a>,” <em>Executive Intelligence Review</em>, Volume 34, Number 19-20, May 11, 2007."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4652>
        rdf:type                 schema:Claim;
        schema:abstract          "“… climate change, or temperature, has been rising. Somehow the IPCC decided that the increase in the last 100 years is due to the greenhouse effect; however, a significant part of that would be just due to natural change. So, even if we spend lots of money on suppressing CO2 release, it wouldn’t do any good, because it’s a natural change.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4652/source/7>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/syun-ichi-akasofu/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/syun-ichi-akasofu/" .

<http://data.open.ac.uk/climate-sense/claim/4651/source/6>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://people.iarc.uaf.edu/~sakasofu/climate.php\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Response to Readers: Notes on Climate Change</a>,” Syun-Ichi Akasofu (Page at the IARC), April 24, 2007."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4651>
        rdf:type                 schema:Claim;
        schema:abstract          "“Although I am not a climatologist, it has been interesting to observe climatology from the point of view of an arctic scientist. In order for the field of climatology and IPCC to be healthy, I want to provide a few criticisms, which I hope are constructive.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4651/source/6>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/syun-ichi-akasofu/>;

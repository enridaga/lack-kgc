        rdf:type         schema:CreativeWork;
        schema:citation  "Michelle Arledge. “<a href=\"https://web.archive.org/web/20210805215026/https://thetexan.news/video-railroad-commissioner-elect-jim-wright-on-his-victory-and-coming-job/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">VIDEO: Railroad Commissioner-Elect Jim Wright on His Victory and Coming Job</a>,” <em>The Texan</em>, December 15, 2020. Archived .mp4 on file at DeSmog. Archived August 5, 2021. Archive URL: <a href=\"https://archive.ph/Uh5HR\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.ph/Uh5HR</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9131>
        rdf:type                 schema:Claim;
        schema:abstract          "“CO2 promotes vegetation growth. It’s just it’s part of what we experience. It’s part of being on the Earth. So, you know, I think that there needs to be a lot more study and a lot more research on what is really causing the fluctuation of CO2 increase. I do know that man has contributed to that, but at what detriment? You know, which has not been proven to me.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9131/source/25>;

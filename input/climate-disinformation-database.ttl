<http://data.open.ac.uk/climate-sense/claim/7654>
        rdf:type                 schema:Claim;
        schema:abstract          "“Since 1980, Gloria Dittus has represented the electrical, oil, and gas industries before the U.S. Congress and the Administration. Her emphasis on legislative affairs, media relations, and grassroots organization has included the development and implementation of comprehensive public affairs programs to support federal, state legislative, and regulatory initiatives.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7654/source/18>;

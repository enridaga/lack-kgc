<http://data.open.ac.uk/climate-sense/claim/9790/source/62>
        rdf:type         schema:CreativeWork;
        schema:citation  "Denise Robbins and Andrew Seifter. “<a href=\"http://mediamatters.org/research/2015/06/26/national-black-chamber-of-commerce-joins-oil-in/204153\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">National Black Chamber Of Commerce Joins Oil Industry’s Op-Ed Campaign Against EPA Climate Plan</a>,” Media Matters, June 26, 2016.&nbsp;<a href=\"http://web.archive.org/web/20160322205908/http://mediamatters.org/research/2015/06/26/national-black-chamber-of-commerce-joins-oil-in/204153\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Archived March 22, 2016</a>. Archive.is URL:&nbsp;<a href=\"https://archive.is/O17Fr\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/O17Fr</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9790>
        rdf:type                 schema:Claim;
        schema:abstract          "“Like Americans for Prosperity, the Beacon Hill Institute, and the State Policy Network before it, the National Black Chamber of Commerce (NBCC) is the latest oil industry front group to run a deceptive op-ed campaign against the EPA’s climate change plan, with NBCC president Harry C. Alford alleging in newspapers across the country that the Clean Power Plan will impose ‘economic hardship’ on blacks and Hispanics,” Denise Robbins and Andrew Seifter write at Media Matters.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9790/source/62>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/harry-c-alford/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/harry-c-alford/" .

<http://data.open.ac.uk/climate-sense/claim/9789/source/60>
        rdf:type         schema:CreativeWork;
        schema:citation  "Ali Meyer. “<a href=\"https://web.archive.org/web/20150731233450/http://www.cnsnews.com/news/article/ali-meyer/black-chamber-commerce-epa-clean-air-plan-will-increase-black-poverty-23\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Black Chamber of Commerce: EPA Clean Air Plan Will Increase Black Poverty 23%, Strip 7,000,000 Black Jobs</a>,”&nbsp;<em>CNSnews.com</em>, June 24, 2015. Archived July 31, 2015. Archive.is URL:&nbsp;<a href=\"https://archive.is/l6bFB\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/l6bFB</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9789>
        rdf:type                 schema:Claim;
        schema:abstract          "“Many states, such as New York and Delaware, have already taken action to reduce the largest emitter of carbon pollution – power plant emissions,” Carper said. “As we will hear today, the economies of these states continue to grow at a faster rate than the states that have yet to put climate regulations in place. However, we need all states to do their fair share to protect the air we breathe and stem the tide of climate change. The EPA’s Clean Power Plan attempts to do just that.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9789/source/60>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/harry-c-alford/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/harry-c-alford/" .

<http://data.open.ac.uk/climate-sense/claim/9788/source/57>
        rdf:type         schema:CreativeWork;
        schema:citation  "(Press Release). “<a href=\"http://web.archive.org/web/20160816202709/http://www.prnewswire.com/news-releases/chambers-of-commerce-epa-ozone-rule-will-be-devastating-to-pennsylvania-economy-300137005.html\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Chambers of Commerce: EPA Ozone Rule Will Be Devastating to Pennsylvania Economy</a>,”&nbsp;<em>PR Newswire</em>, September 2, 2015. Archived August 16, 2016. Archive.is URL:&nbsp;<a href=\"https://archive.is/jhZ5g\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/jhZ5g</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9788>
        rdf:type                 schema:Claim;
        schema:abstract          "“As world markets shuttered amidst instability in China, the President reminded us that the American economy is resilient and the backbone of the global market. Unfortunately, the EPA’s proposed ozone rule threatens that resiliency, found in our urban centers like Pittsburgh, by bringing the economic recovery to a halt,” Harry C. Alford said. “Today’s forum was an opportunity for local business owners and elected officials to discuss the effects of this regulation and how to continue our fight to keep EPA’s assault at bay.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9788/source/57>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/harry-c-alford/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/harry-c-alford/" .


<http://data.open.ac.uk/climate-sense/claim/2813>
        rdf:type                 schema:Claim;
        schema:abstract          "“The message I always give, and again I teach a large climate change class at Carleton University, and the message I always say ‘the only constant about climate is change.’ Climate changes all the time.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2813/source/14>;

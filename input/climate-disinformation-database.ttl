<http://data.open.ac.uk/climate-sense/claim/9971/source/9>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160423001535/http://abc11.com/news/13-year-old-files-suit-against-nc-over-climate-change/1082955/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">13-YEAR-OLD FILES LAWSUIT AGAINST NORTH CAROLINA OVER CLIMATE CHANGE</a>,”abc11 eyewitness news, November 13, 2015. Archived April 22, 2016. Archive.is URL: <a href=\"https://archive.is/cAiiT\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/cAiiT</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9971>
        rdf:type                 schema:Claim;
        schema:abstract          "I think it’s beyond dispute that if North Carolina took steps on its own to address global warming there would be no impact. So suing the state to take these steps is not going to have the result that this obviously committed student wants to have.” — ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9971/source/9>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-locke-foundation/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/john-locke-foundation/" .

<http://data.open.ac.uk/climate-sense/claim/9970/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9970>
        rdf:type                 schema:Claim;
        schema:abstract          "“The idea of North Carolina taking extra steps beyond what the federal government is going to call for to cut carbon emissions, the idea that that would have any impact on global warming, is ludicrous. It would not happen. All you would do is put another obstacle or road block in place in terms of industry in North Carolina for no good reason.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9970/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-locke-foundation/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;

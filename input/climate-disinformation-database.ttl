        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10525>
        rdf:type                 schema:Claim;
        schema:abstract          "Rogan: “I get excited about this one because it seems kind of cultish.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10525/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-rogan/>;

<http://data.open.ac.uk/climate-sense/claim/9844/source/18>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20191127174101/https://canadafreepress.com/article/agendaism-and-fraud-the-sordid-tale-of-climate-science\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Agendaism and Fraud; the Sordid Tale of Climate ‘Science’</a>,” <em>Canada Free Press</em>, January 13, 2010. Archived November 27, 2019. Archive.fo URL: <a href=\"https://archive.ph/naL5S\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/naL5S</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9844>
        rdf:type                 schema:Claim;
        schema:abstract          "“Global warming was never about the science, it was about money and power. There are several different agendas in play; world governance and wealth redistribution, population control, and, of course, money.”";

        rdf:type                 schema:Claim;
        schema:abstract          "“The climate is always changing and the nation may well benefit from moderate global warming. Having said that, temperature records indicate that New Zealand has not warmed significantly in the last fifty years.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2095/source/6>;

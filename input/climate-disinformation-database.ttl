        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6362>
        rdf:type                 schema:Claim;
        schema:abstract          "“About 60 percent of any CO2 that we emit today will remain in the atmosphere 20 years from now, between 30 and 55 percent will still be there after a century, and between 15 and 30 percent will remain after one thousand years.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6362/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-koonin/>;

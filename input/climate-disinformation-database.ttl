<http://data.open.ac.uk/climate-sense/claim/6197/source/5>
        rdf:type         schema:CreativeWork;
        schema:citation  "Vaclav Klaus. “<a href=\"https://www.ft.com/cms/s/2/9deb730a-19ca-11dc-99c5-000b5df10621.html#axzz1tkD74onT\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Freedom, not climate, is at risk</a>,” <em>Financial Times</em>, June 13, 2007."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6197>
        rdf:type                 schema:Claim;
        schema:abstract          "“As someone who lived under communism for most of his life, I feel obliged to say that I see the biggest threat to freedom, democracy, the market economy and prosperity now in ambitious environmentalism, not in communism.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6197/source/5>;

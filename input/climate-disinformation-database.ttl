<http://data.open.ac.uk/climate-sense/claim/12583>
        rdf:type                 schema:Claim;
        schema:abstract          "“The good news is that the Malthusian bad news is wrong. May the Church of Climate find its pews increasingly empty.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12583/source/9>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/robert-l-bradley-jr/>;

        schema:citation  "Robert Bryce and Jonathan Lesser. “<a href=\"http://web.archive.org/web/20150905215406/http://www.ocregister.com/articles/energy-673760-california-state.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Renewable energy mandates same as a tax on the poor</a>,”&nbsp;<em>The Orange County Register</em>&nbsp;(Opinion Section), July 26, 2015. Archived September 5, 2015.&nbsp;Archive.is URL:&nbsp;<a href=\"https://archive.is/pYOB7\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/pYOB7</a>"^^rdf:HTML .


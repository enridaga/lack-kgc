<http://data.open.ac.uk/climate-sense/claim/8592/source/23>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s1\" href=\"http://web.archive.org/web/20090409111128/http://www.nhes.com/\" name=\"s1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">New Hope Environmental Services, Inc. </a>homepage. Archived April 9, 2009. Archive.is URL: <a href=\"https://archive.is/rfZXr\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/rfZXr</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8592>
        rdf:type                 schema:Claim;
        schema:abstract          "“Since 1994, New Hope’s international team of research scientists, data analysts, editors, and web publishers have devised, conducted, prepared, and published important research for both the public good and for private clients.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8592/source/23>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/new-hope-environmental-services/>;

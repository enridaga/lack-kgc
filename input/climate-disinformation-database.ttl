        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7822>
        rdf:type                 schema:Claim;
        schema:abstract          "“I don’t question for a moment that carbon dioxide is a greenhouse gas and that, all things being equal, this will lead to warming of the atmosphere. And that it’s true that scientists differ greatly on how big the effect is, but there is huge agreement that there is some&nbsp;effect.&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7822/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/nigel-lawson/>;

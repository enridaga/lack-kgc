<http://data.open.ac.uk/climate-sense/claim/1497>
        rdf:type                 schema:Claim;
        schema:abstract          "“Global climate change is real, and developing alternative energy sources and reducing global carbon-dioxide emission is essential. But the claim that action to slow climate change is justified by the rising toll of natural disasters–and, by extension, that reducing emissions can help stanch these rising losses–is both scientifically and morally&nbsp;insupportable.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1497/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;

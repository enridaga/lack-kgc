<http://data.open.ac.uk/climate-sense/claim/9774/source/18>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.washingtonpost.com/video/national/health-science/evlondo-cooper-interviews-harry-alford/2015/09/28/88b7d0b6-662c-11e5-bdb6-6861f4521205_video.html\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Evlondo Cooper interviews Harry Alford</a>,”&nbsp;<em>The Washington Post</em>, September 28, 2015."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9774>
        rdf:type                 schema:Claim;
        schema:abstract          "“You are about the dumbest ass I’ve ever met in my life,” Alford said. “You’ve come to Columbus to harass me.”";

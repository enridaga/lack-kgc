<http://data.open.ac.uk/climate-sense/claim/6792>
        rdf:type                 schema:Claim;
        schema:abstract          "Later in his opening statement, Manchin emphasized that climate solutions must not present any “additional economic burdens”:";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6792/source/19>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-manchin/>;

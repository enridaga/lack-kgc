<http://data.open.ac.uk/climate-sense/claim/6990>
        rdf:type                 schema:Claim;
        schema:abstract          "“The climate’s been changing since time immemorial. Do I believe there is global warming? No, I believe it’s all a load of bullshit. But it’s amazing the way the whole fucking eco-warriors and the media have changed. It used to be global warming, but now, when global temperatures haven’t risen in the past 12 years, they say ‘climate change’.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6990/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/michael-o-leary/>;

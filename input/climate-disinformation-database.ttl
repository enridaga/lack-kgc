<http://data.open.ac.uk/climate-sense/claim/8310>
        rdf:type                 schema:Claim;
        schema:abstract          "“If we reframe the debate, making our ideals explicit, we can both win supporters and champions of the right policies, and expose the evil and anti-humanism of the wrong policies,” Epstein writes.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8310/source/>;

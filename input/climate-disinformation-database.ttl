        rdf:type                 schema:Claim;
        schema:abstract          "“High self-esteem in children does not produce good character, and in fact is likely to produce a less moral individual,” Prager wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4513/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/dennis-prager/>;

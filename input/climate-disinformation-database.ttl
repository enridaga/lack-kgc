<http://data.open.ac.uk/climate-sense/claim/12084>
        rdf:type                 schema:Claim;
        schema:abstract          "“We’re not in a crisis. There is no climate emergency. We are living in the best times you could ever live on planet Earth. And we are so fragile and we are so protected and we’re so wealthy that if someone drops a feather, we panic,” Plimer claimed.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12084/source/12>;

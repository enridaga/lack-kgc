        rdf:type         schema:CreativeWork;
        schema:citation  "Larry Bell. “<a href=\"http://www.forbes.com/sites/larrybell/2013/04/30/global-warming-alarm-continued-cooling-may-jeopardize-climate-science-and-green-energy-funding/#6c83c2ad2dd0\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Global Warming Alarm: Continued Cooling May Jeopardize Climate Science And Green Energy Funding!</a>” <em>Forbes</em>, April 30, 2013.&nbsp;<a href=\"https://web.archive.org/web/20240104213344/https://www.forbes.com/sites/larrybell/2013/04/30/global-warming-alarm-continued-cooling-may-jeopardize-climate-science-and-green-energy-funding/?sh=7c7501fac75c\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 4, 2024</a>. Archive <span class=\"caps\">URL</span>:&nbsp;<a href=\"https://archive.is/OIdwD\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/<span class=\"caps\">OI</span>dwD</a>"^^rdf:HTML .


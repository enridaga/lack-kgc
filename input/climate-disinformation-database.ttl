<http://data.open.ac.uk/climate-sense/claim/11151/source/24>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a name=\"s5\"></a><a href=\"http://web.archive.org/web/20100706152458/http://www.marshall.org/pdf/materials/61.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Washington Roundtable on Science and Public Policy Climate Forecasts, Global Warming and the National Assessment” (PDF)</a>. January 23, 2001. Archived .pdf on file at <em>DeSmog</em>."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11151>
        rdf:type                 schema:Claim;
        schema:abstract          "“The IPCC really is a sham because while it gives the impression of being a consensus of scientists, it is simply a political document prepared by advocacy scientists with a large ax to grind.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11151/source/24>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-legates/>;

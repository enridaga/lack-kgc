        rdf:type         schema:CreativeWork;
        schema:citation  "Keith H. Lockitch. <a href=\"https://web.archive.org/web/20140124151318/http://aynrand.org/site/DocServer/ee_climate_vulnerability_keith_lockitch.pdf?docID=2221\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“CLIMATE VULNERABILITY AND THE INDISPENSABLE VALUE OF INDUSTRIAL CAPITALISM,”&nbsp;(PDF)</a>,&nbsp;<em>Energy &amp; Environment</em>, Volume 20, No. 5 (2009). Archived January 24, 2015.&nbsp;Archived .pdf&nbsp;on file at&nbsp;DeSmog.&nbsp;Archive URL: <a href=\"https://archive.ph/0QLKG\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/0QLKG</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9462>
        rdf:type                 schema:Claim;
        schema:abstract          "[…] Fundamentally, this is a debate about how society should be organized. The advocates of statism have made their position clear and are actively working to advance their cause. It is time for those who value freedom to do the same.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9462/source/12>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ayn-rand-institute/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Tammy Bruce. “<a href=\"http://web.archive.org/web/20200205033009/https://iwv.org/detail.php?c=2810667&amp;t=Climate-change-activism%3A-The-left%27s-new-power-play\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">CLIMATE CHANGE ACTIVISM: THE LEFT’S NEW POWER PLAY</a>,” <em>Independent Women’s Voice</em>. Archived February 4, 2020. Tweeted by IWV on <a href=\"https://twitter.com/search?q=climate%20(from%3AIWV)&amp;src=typed_query\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">September 25, 2019</a>. Archive.ph URL: <a href=\"https://archive.ph/wip/paJfg\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/wip/paJfg</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7069>
        rdf:type                 schema:Claim;
        schema:abstract          "“The reason the existential threat can only be climate change is because, as designed by its apostles, it’s our fault and requires political action aimed at controlling your entire life. In the meantime, we must decide to stop allowing Hollywood, misled adolescents and political charlatans from distracting us to death with nonsensical political theater.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7069/source/32>;

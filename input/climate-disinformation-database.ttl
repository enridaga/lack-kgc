        rdf:type         schema:CreativeWork;
        schema:citation  "“H<a href=\"http://web.archive.org/web/20170125020612/http://energyfairness.org/2016/10/harry-alford-epiphany-sweet-home-alabama/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">arry Alford: An Epiphany – Sweet Home Alabama</a>,” PACE, October 25, 2016. Archived January 25, 2017. Archive.is URL:&nbsp;<a href=\"https://archive.is/9rbOB\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/9rbOB</a>"^^rdf:HTML .


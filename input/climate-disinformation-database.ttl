<http://data.open.ac.uk/climate-sense/claim/619/source/66>
        rdf:type         schema:CreativeWork;
        schema:citation  "”<a href=\"http://web.archive.org/web/20160304023920/https://www.nationalcenter.org/bios/cohen.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">BONNER COHEN, PH.D.: SENIOR FELLOW</a>,” National Center for Public Policy Research. Archived March 4, 2016. WebCite URL:<a href=\"http://www.webcitation.org/6fkLLO0gV\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> http://www.webcitation.org/6fkLLO0gV</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/619>
        rdf:type                 schema:Claim;
        schema:abstract          "“Articles by Dr. Cohen have appeared in the Wall Street Journal, Forbes, Investor’s Business Daily, New York Post, Washington Times, National Review, Philadelphia Inquirer, Detroit News, Atlanta Journal-Constitution, Miami Herald, and dozens of other newspapers in the U.S. and Canada. He has been interviewed on Fox News, CNN, Fox Business Channel, BBC, BBC Worldwide Television, NBC, NPR, N 24 (German language news channel), Voice of Russia, and scores of radio stations in the U.S.”";

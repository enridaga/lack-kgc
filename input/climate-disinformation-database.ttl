        rdf:type         schema:CreativeWork;
        schema:citation  "Carol Linnitt. “<a href=\"https://thenarwhal.ca/greenpeace-complaint-against-ethical-oil-brings-corrosive-effect-oil-our-politics-light/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Greenpeace Complaint Against Ethical Oil Brings ‘Corrosive Effect of Oil on Our Politics’ to Light</a>,” <em>The Narwhal</em>, April 9,&nbsp;2014.&nbsp;"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11120>
        rdf:type                 schema:Claim;
        schema:abstract          "“At the broadest level,” Stewart told DeSmog Canada via e-mail, “we are trying to rebalance the playing field between money and people power in Canadian politics. You can never eliminate the influence of money on politics, but you can limit it and make it more transparent.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11120/source/28>;

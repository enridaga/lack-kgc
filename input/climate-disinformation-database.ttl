<http://data.open.ac.uk/climate-sense/claim/9682>
        rdf:type                 schema:Claim;
        schema:abstract          "“No. Healthy societies do not fall apart over slow, widely predicted, relatively small economic adjustments of the sort painted by climate analysis. Societies do fall apart from war, disease or chaos. Climate policy must compete with other long-term threats for always-scarce resources.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9682/source/10>;

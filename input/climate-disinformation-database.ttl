        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/209>
        rdf:type                 schema:Claim;
        schema:abstract          "“In 2011, the State Policy Network and its affiliates reported raising a combined $83.2 million, according to the Center for Media and Democracy. While donors to the groups are not required to be disclosed, a 2010 document opened a window on some of them. They included the Donors Trust and the Donors Capital Fund, both secretive right-wing funding instruments, as well as Altria, AT&amp;T, Comcast, GlaxoSmithKline, Kraft Foods, Microsoft, Reynolds American and Time Warner Cable.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/209/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/nevada-policy-research-institute/>;

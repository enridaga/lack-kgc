        rdf:type         schema:CreativeWork;
        schema:citation  "Dr. Keith E. Idso. “Ecologist’s ‘Declaration on Climate Change’ Lacks Scientific Credibility” <a href=\"http://research.greenpeaceusa.org/?a=download&amp;d=2713\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">(PDF)</a>, Retrieved from Greenpeace Research Documents."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12663>
        rdf:type                 schema:Claim;
        schema:abstract          "“Actually, it is much more likely that the warming of the earth over the past century or so is merely a manifestation of the natural temperature variability that is regularly experienced by the earth on quasimillennial time scales.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12663/source/4>;

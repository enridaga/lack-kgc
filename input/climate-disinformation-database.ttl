        rdf:type         schema:CreativeWork;
        schema:citation  "Steven F. Hayward. “<a href=\"http://www.weeklystandard.com/climate-cultists/article/794401\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Climate Cultists,</a>” <em>The Weekly Standard</em>, June 16, 2014. Archive.is URL: <a href=\"https://archive.is/QOySv\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/QOySv</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1972>
        rdf:type                 schema:Claim;
        schema:abstract          "“The total budgets for all of these efforts would probably not add up to a month’s spending by just the Sierra Club. And yet we are to believe that this comparatively small effort has kept the climate change agenda at bay,” Hayward wrote.";

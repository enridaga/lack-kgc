<http://data.open.ac.uk/climate-sense/claim/11123>
        rdf:type                 schema:Claim;
        schema:abstract          "However, the organization’s Articles of Association name prominent pro-oil sands lawyer Thomas Ross, and Ezra Levant himself, as its two&nbsp;officers.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11123/source/29>;

<http://data.open.ac.uk/climate-sense/claim/11963>
        rdf:type                 schema:Claim;
        schema:abstract          "“We have to reduce the regulatory burden on work. Layer after layer of regulation has been imposed on business, particularly in the resource sector, with the result that projects are delayed, cancelled [sic], or moved elsewhere.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11963/source/>;

<http://data.open.ac.uk/climate-sense/claim/10088>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate science is not ‘settled;’ it is both uncertain and incomplete. The available observations do not support the mathematical models that predict a substantial global warming and form the basis for a control policy on greenhouse (GH ) gas emissions. We need a more targeted program of climate research to settle major scientific problems.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10088/source/2>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/science-and-environmental-policy-project/>;

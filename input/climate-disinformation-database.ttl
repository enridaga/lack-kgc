        rdf:type                 schema:Claim;
        schema:abstract          "“[W]e’re in the midst of an enormous battle. A battle between the entrenched interest of the environmental community and government regulatory agencies in Washington and […] ordinary citizens.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/637/source/23>;

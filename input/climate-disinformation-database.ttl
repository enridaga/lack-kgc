        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/david-legates/" .

<http://data.open.ac.uk/climate-sense/claim/11159/source/47>
        rdf:type         schema:CreativeWork;
        schema:citation  "(Press Release). “<a href=\"https://science.house.gov/news/press-releases/chairwoman-johnson-voices-concern-over-climate-denier-named-as-a-top-advisor-at-noaa\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">CHAIRWOMAN JOHNSON VOICES CONCERN OVER CLIMATE DENIER NAMED AS A TOP ADVISOR AT NOAA</a>,”&nbsp;<em>Committee on Science, Space, and Technology</em>. <a href=\"http://web.archive.org/web/20201007010429/https://science.house.gov/news/press-releases/chairwoman-johnson-voices-concern-over-climate-denier-named-as-a-top-advisor-at-noaa\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived October 6, 2020</a>. Archive URL:&nbsp;<a href=\"https://archive.vn/YxFza\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/YxFza</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11159>
        rdf:type                 schema:Claim;
        schema:abstract          "“I am extremely concerned that the quiet weekend appointment of David Legates is another move by the Trump Administration to place climate deniers in key political positions to silence federal climate scientists, as has occurred at the EPA and Interior Department. At a time when our nation is suffering from compound climate hazards and extreme weather, including devastating wildfires and extreme heat in the West, derechos in the Midwest, and a record-setting hyper-active Atlantic hurricane season, Dr. Legates’ appointment is not only troubling but potentially dangerous.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11159/source/47>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-legates/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/david-legates/" .

<http://data.open.ac.uk/climate-sense/claim/11158/source/46>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.washingtonpost.com/opinions/antarctic-glaciers-are-falling-apart-meanwhile-trump-hires-a-climate-denier/2020/09/21/e5e97c20-f859-11ea-a275-1a2c2d36e1f1_story.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Antarctic glaciers are falling apart. Meanwhile, Trump hires a climate denier</a>,” <em>The Washington Post</em>, September 21, 2020. Archived October 5, 2020. Archive URL: <a href=\"https://archive.vn/FMXnl\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/FMXnl</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11158>
        rdf:type                 schema:Claim;
        schema:abstract          "“Mr. Legates’s appointment, which does not require Senate confirmation, threatens to upend an agency that produces some of the best Earth science research in the world — and that has, so far, managed to keep doing credible work even as experts at the Environmental Protection Agency and the Interior Department have been suppressed,” the&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11158/source/46>;

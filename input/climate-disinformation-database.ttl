        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/western-energy-alliance/" .

<http://data.open.ac.uk/climate-sense/claim/9900/source/23>
        rdf:type         schema:CreativeWork;
        schema:citation  "Emily Holden. “<a href=\"https://www.theguardian.com/us-news/2021/mar/09/republican-study-wyoming-biden-climate-plans\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Republicans’ new favorite study trashes Biden’s climate plans – but who’s behind it?</a>” <em>The Guardian</em>, March 9, 2021. <a href=\"https://web.archive.org/web/20210309214221/https://www.theguardian.com/us-news/2021/mar/09/republican-study-wyoming-biden-climate-plans\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived March 9, 2021</a>. Archive URL: <a href=\"https://archive.vn/QEYFC\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/QEYFC</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9900>
        rdf:type                 schema:Claim;
        schema:abstract          "“Just wanted to let you know that I’m working with the Governor’s office about who will commission and pay for the analysis, so I’m making progress,” Sgamma emailed Considine, according to the records.&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9900/source/23>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/western-energy-alliance/>;

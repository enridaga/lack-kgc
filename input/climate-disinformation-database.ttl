        rdf:type                 schema:Claim;
        schema:abstract          "“The Ukraine war has driven gas prices higher, but, says Andrew Montford of Net Zero Watch, it would be daft to assume that this is a permanent state of affairs and design a policy on the assumption that wind will be cheaper than gas in the future.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/854/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/matt-ridley/>;

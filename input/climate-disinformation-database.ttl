        rdf:type                 schema:Claim;
        schema:abstract          "“Currently, satellite data show that the hiatus has continued over 18 years, even though carbon dioxide has risen significantly,” Shaviv writes. “This implies that Earth’s temperature increases less (from the influence of CO2) than IPCC predictions, because those were based on a high climate sensitivity ascribed to CO2.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2643/source/30>;

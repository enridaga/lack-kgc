        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/mike-johnson/" .

<http://data.open.ac.uk/climate-sense/claim/6872/source/80>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=DrVQTNpSwIk\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Oil, Inflation, and the Way Forward | Congressman Mike Johnson | EP 309</a>,” YouTube video uploaded by user “Jordan B Peterson,” November 28, 2022. Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6872>
        rdf:type                 schema:Claim;
        schema:abstract          "“They regard the climate agenda as part of their religion. I don’t know any other way to explain it. They pursue it with religious zeal, and they care not, apparently, what type of pain these policies inflict upon the people that they are supposed to be serving. Because they’re not serving the people, they’re serving the planet, and they use this terminology now openly, to great amazement and frustration.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6872/source/80>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-johnson/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/mike-johnson/" .

<http://data.open.ac.uk/climate-sense/claim/6871/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6871>
        rdf:type                 schema:Claim;
        schema:abstract          "“And it’s as if […] they have effectively replaced Father God with Mother Earth. Not to oversimplify it. That’s how I see it. And so they believe we owe fealty to Mother Earth, that we’re created by the Earth, they believe, and so we owe everything to the Earth itself, and we have to serve that cause above all else, and it matters not who they hurt.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6871/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-johnson/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/mike-johnson/" .


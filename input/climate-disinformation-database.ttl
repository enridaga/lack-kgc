<http://data.open.ac.uk/climate-sense/claim/1191/source/16>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20181227230410/https://www.spiked-online.com/2017/09/12/beware-greens-scaremongering/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Beware greens’ scaremongering</a>,” <em>Spiked</em>, Sep 12, 2017. Archived December 27, 2018. Archive.fo URL:<a href=\"https://archive.fo/fMdw2\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.fo/fMdw2</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1191>
        rdf:type                 schema:Claim;
        schema:abstract          "“Central to greens’ fetish for hurricanes is the scientific theory that warmer sea-surface temperatures caused by global warming can increase hurricanes’ energy and destructive power. It may well be true. But theory easily becomes dogma, and climate pundits have rushed ahead of their science.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1191/source/16>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ben-pile/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Robert Mercer. <a id=\"s37\" name=\"s37\" href=\"http://web.archive.org/web/20171103192410/https://assets.bwbx.io/documents/users/iqjWHBFdfxIU/rQA6D2fRv.tk/v0\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Dear Colleagues” (PDF)</a>, November 2, 2017. Retrieved from <em>Bloomberg News</em>."^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  "Michael Bastasch. “<a href=\"http://web.archive.org/web/20170324192656/http://dailycaller.com/2015/05/28/study-predicts-decades-of-global-cooling-ahead/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Study Predicts Decades Of Global Cooling Ahead</a>,” <em>The Daily Caller</em>, May 28, 2015. Archived March 24, 2017. Archive.is URL: <a href=\"https://archive.is/9ftpd\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/9ftpd</a>"^^rdf:HTML .


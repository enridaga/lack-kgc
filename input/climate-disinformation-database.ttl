        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"https://web.archive.org/web/20180214000740/https://wattsupwiththat.files.wordpress.com/2018/02/amnh18-feb4-petitionletter-1.pdf\" id=\"s39\" name=\"s39\" rel=\"nofollow noopener external noreferrer\" target=\"_blank\" data-wpel-link=\"external\">mnh18-feb4-petitionletter (PDF – Untitled)</a>. Retrieved from <em>Watts Up With That</em>."^^rdf:HTML .


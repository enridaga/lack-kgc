<http://data.open.ac.uk/climate-sense/claim/737>
        rdf:type                 schema:Claim;
        schema:abstract          "“I am yet to hear scientific evidence to satisfy me that if the very, very small amount of carbon dioxide in the atmosphere (approximately 0.38 per cent) was increased, it could lead to significant global&nbsp;warming.";

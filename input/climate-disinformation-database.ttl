        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=Z5ZID0RuUzo\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate change. Julia clashes with The Green Party co-leader Jonathan Bartley</a>,” YouTube video uploaded by user talkRADIO on September 20, 2019. Archived .mp4 on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10241>
        rdf:type                 schema:Claim;
        schema:abstract          "“Fewer people now die from extreme weather events than they ever did”.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10241/source/32>;

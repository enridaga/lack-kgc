        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6878>
        rdf:type                 schema:Claim;
        schema:abstract          "“Homosexual relationships are inherently unnatural and, the studies clearly show, are ultimately harmful and costly for everyone. Society cannot give its stamp of approval to such a dangerous lifestyle. If we change marriage for this tiny, modern minority, we will have to do it for every deviant group.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6878/source/>;

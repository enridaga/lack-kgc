<http://data.open.ac.uk/climate-sense/claim/4717>
        rdf:type                 schema:Claim;
        schema:abstract          "“When it comes to fracking, they have decided to allow worries about modest traffic disruption and over-blown environmental claims to destroy the opportunity to access much cleaner, cheaper energy and create many thousands of new jobs.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4717/source/>;

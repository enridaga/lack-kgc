        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.industrydocuments.ucsf.edu/tobacco/docs/#id=kkdw0110\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">How to set up a Tobacco Alliance</a>,” <em>Tobacco Alliance</em>, September 20, 1983. Retrieved from UCSF Truth Tobacco Industry Documents Library Bates No. 2501021530-2501021532."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1929>
        rdf:type                 schema:Claim;
        schema:abstract          "“Early on we decided that it would be preferable to keep the Alliance at arms length from TAC and the industry and with its own identity and address, to emphasize to supporters, as far as is practical, that it had a degree of independence. thus while the industry determines policy and provides the funds, the day to day management is the responsibility of our P.R. agents Daniel J. Edelman.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1929/source/38>;

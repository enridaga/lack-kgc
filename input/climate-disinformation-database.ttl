        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/michael-shellenberger/" .

<http://data.open.ac.uk/climate-sense/claim/12902/source/43>
        rdf:type         schema:CreativeWork;
        schema:citation  "Michael Shellenberger. “<a href=\"https://web.archive.org/web/20200701185330/https://www.forbes.com/sites/michaelshellenberger/2019/11/25/why-everything-they-say-about-climate-change-is-wrong/#339a16c67af7\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Why Apocalyptic Claims About Climate Change Are Wrong</a>,” <em>Forbes</em>, November 25, 2019. Archived July 1, 2020. Archive URL: <a href=\"https://archive.vn/GvWp1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/GvWp1</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12902>
        rdf:type                 schema:Claim;
        schema:abstract          "“Part of what bothers me about the apocalyptic rhetoric by climate activists is that it is often accompanied by demands that poor nations be denied the cheap sources of energy they need to develop. I have found that many scientists share my&nbsp;concerns.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12902/source/43>;

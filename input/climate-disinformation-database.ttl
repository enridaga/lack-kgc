<http://data.open.ac.uk/climate-sense/claim/11063>
        rdf:type                 schema:Claim;
        schema:abstract          "“Reducing Canada’s greenhouse gas emissions by replacing coal-fired power with wind and solar would prove extremely costly, and still wouldn’t meet the federal government’s climate targets,” he added.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11063/source/>;

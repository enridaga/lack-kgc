<http://data.open.ac.uk/climate-sense/claim/158>
        rdf:type                 schema:Claim;
        schema:abstract          "Sadly, after 34 years of service, the NCPA is closing its doors. Thanks to all who have supported us and helped us fight for free-markets.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/158/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/national-center-policy-analysis/>;

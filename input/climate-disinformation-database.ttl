<http://data.open.ac.uk/climate-sense/claim/267/source/32>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20150909003011/http://www.wsj.com/articles/SB10001424127887323528404578452483656067190\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">In Defense of Carbon Dioxide</a>,”&nbsp;<em>The Wall Street Journal</em>, May 8, 2013. Archived September 9, 2015.&nbsp;Archive.is URL:&nbsp;<a href=\"https://archive.is/f1qhj\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/f1qhj</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/267>
        rdf:type                 schema:Claim;
        schema:abstract          "“We know that carbon dioxide has been a much larger fraction of the earth’s atmosphere than it is today, and the geological record shows that life flourished on land and in the oceans during those times. The incredible list of supposed horrors that increasing carbon dioxide will bring the world is pure belief disguised as science.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/267/source/32>;

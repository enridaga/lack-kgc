        rdf:type         schema:CreativeWork;
        schema:citation  "Ross Clark. “<a href=\"https://web.archive.org/web/20221031060326/https://www.spectator.co.uk/article/how-did-climate-doomsters-get-the-great-barrier-reef-so-wrong-/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">How did climate doomsters get the Great Barrier Reef so wrong?</a>”, <em>Spectator</em>, August 8, 2022. Archived October 31, 2022. Archive URL: <a href=\"https://archive.ph/HBkPs\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/HBkPs</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12460>
        rdf:type                 schema:Claim;
        schema:abstract          "“We are, of course, in the midst of a ‘climate emergency’ and the ‘sixth mass extinction’ of life on Earth. It is just that one of the iconic victims doesn’t seem to be playing ball just at the moment.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12460/source/38>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ross-clark/>;

<http://data.open.ac.uk/climate-sense/claim/7416/source/26>
        rdf:type         schema:CreativeWork;
        schema:citation  "Martin Grünn. “<a href=\"https://web.archive.org/web/20230301191856/https://c2cjournal.ca/2022/03/a-darker-shade-of-green-whats-behind-the-inexorable-rise-of-environmentalism/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">A Darker Shade of Green: What’s Behind the Inexorable Rise of Environmentalism</a>,”<em> C2C Journal</em>, March 2, 2022. Archived March 1, 2023. Archive URL: <a href=\"https://archive.ph/jfRub\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/jfRub</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7416>
        rdf:type                 schema:Claim;
        schema:abstract          "“When it comes to foreign funding of green activism and opposition to our resource development, however, there’s been little coverage, let alone media sleuthing. Alberta’s investigation into foreign interference was relentlessly criticized and derided and called a waste of money. Yet the recent&nbsp;Allan Report, despite its low-key language and various caveats, confirmed the central charge of foreign meddling on the scale reported by Krause and Lyman, concluding that ‘there are large amounts of foreign funding flowing into Canada’ with the goal of influencing public policy on resource development.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7416/source/26>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/manning-foundation-for-democratic-education/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/manning-foundation-for-democratic-education/" .

<http://data.open.ac.uk/climate-sense/claim/7415/source/30>
        rdf:type         schema:CreativeWork;
        schema:citation  "Hymie Rubenstein. “<a href=\"https://web.archive.org/web/20240708202411/https://c2cjournal.ca/2022/12/what-really-caused-the-james-smith-cree-nation-stabbings/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">What Really Caused the James Smith Cree Nation Stabbings?</a>,” <em>C2C Journal</em>, December 15, 2022. Archived July 8, 2024. Archive URL: <a href=\"https://archive.ph/UfYk0\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/UfYk0</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7415>
        rdf:type                 schema:Claim;
        schema:abstract          "“What caused the killings at James Smith Cree Nation wasn’t centuries-old trauma. It was a criminal justice system that puts Indigenous communities at risk by failing to sentence violent criminals appropriately and then releasing them too soon.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7415/source/30>;

<http://data.open.ac.uk/climate-sense/claim/10698/source/68>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s40\" href=\"http://web.archive.org/web/20170825165734/http://www.lavoisier.com.au/articles/climate-policy/science-and-policy/JSCOT.pdf\" name=\"s40\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Submission to the JSCOT Inquiry into The Kyoto Protocol” (PDF)</a>, The Lavoisier Group, October 2000."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10698>
        rdf:type                 schema:Claim;
        schema:abstract          "“But what is noteworthy is that the role of CO2 as essential plant food and fertiliser is never mentioned by the Kyoto protagonists. And, as every geologist knows, there have been periods in the earth’s history when atmospheric CO2 concentrations have been 20 times greater than at present.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10698/source/68>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/lavoisier-group/>;

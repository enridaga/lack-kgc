        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.industrydocuments.ucsf.edu/docs/#id=gfyh0045\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">THE PERSPECTIVE OF PM INTERNATIONAL ON SMOKING AND HEALTH ISSUES</a>,” March 29, 1985. Retrieved from Industry Documents Librry at UCSF. Bates No. 2023268329-2023268337.<em> </em>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2889>
        rdf:type                 schema:Claim;
        schema:abstract          "“A number of media proprietors that I have spoken to are sympathetic to our position – Rupert Murdoch and Malcolm Forbes are two good examples. The media like the money they make from our advertisements and they are an ally that we can and should exploit.”";

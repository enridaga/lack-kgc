        schema:citation  "“<a href=\"http://web.archive.org/web/20050525102006/www.theinterim.com/2005/apr/14qanda.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Q <span class=\"amp\">&amp;</span> A with: Mark Crutcher</a>,” <em>The Interim</em>, April 2005. Archived May 25, 2005. Archive.is <span class=\"caps\">URL</span>: <a href=\"https://archive.is/eC9mH\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/eC9mH</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7921>
        rdf:type                 schema:Claim;
        schema:abstract          "I developed some of my own strategies for getting information … The revelations about the abortion industry being involved in the marketing of baby parts … We were the organization that brought that information out. We were undercover in an abortion clinic in Oberland, Ks. for 31 months and were able to come out with information and documentation to prove that there was this grisly trade in aborted parts of babies. Our child predator campaign was another investigation with aspects that were undercover.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7921/source/15>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Umair Irfan. “<a href=\"https://www.eenews.net/stories/1060051271\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Meet the man behind the Heritage energy budget proposal</a>,” <em>E&amp;E News</em>, March 10, 2017.<a href=\"http://web.archive.org/web/20180806151503/https://www.eenews.net/stories/1060051271\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> Archived August 6, 2018</a>. Archive.is URL: <a href=\"https://archive.fo/V5Njq\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/V5Njq</a>"^^rdf:HTML .


        rdf:type                 schema:Claim;
        schema:abstract          "“As the atmospheric CO2 increases to six times above that of its current value, this extra food, if you will, induces a growth enhancement in most plants that reaches upwards of 160%. “ ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11246/source/>;

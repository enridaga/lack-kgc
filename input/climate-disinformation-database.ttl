        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20180723222403/http://americafirstenergy.org/about/\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">About</a>,” <em>America First Energy Conference 2018</em>. Archived July 23, 2018. Archive.is URL: <a href=\"https://archive.fo/E4Gnt\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">https://archive.fo/E4Gnt</a>"^^rdf:HTML .


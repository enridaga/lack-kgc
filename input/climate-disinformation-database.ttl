        schema:citation  "<a name=\"s3\" id=\"s3\"></a>R. Timothy Patterson. “<a href=\"http://web.archive.org/web/20070929145805/http://www.canada.com/nationalpost/financialpost/comment/story.html?id=597d0677-2a05-47b4-b34f-b84068db11f4&amp;p=4\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Read the sunspots</a>,” <em>The National Post</em>, June 20, 2007. Archived September 29, 2007. Archive.is URL: <a href=\"https://archive.is/Aw4aA\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/Aw4aA</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2811>
        rdf:type                 schema:Claim;
        schema:abstract          "“[C]hanges in the output of the sun caused the most recent climate change. By comparison, CO2 variations show little correlation with our planet’s climate on long, medium and even short time scales.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2811/source/11>;

<http://data.open.ac.uk/climate-sense/claim/12921>
        rdf:type                 schema:Claim;
        schema:abstract          "“If any and all climate conditions are being attributed to climate change, then how can we design any observation or experiment that would make climate change falsifiable? We can’t if it’s not falsifiable. It’s not&nbsp;science.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12921/source/>;

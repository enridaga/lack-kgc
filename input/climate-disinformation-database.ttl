<http://data.open.ac.uk/climate-sense/claim/10707>
        rdf:type                 schema:Claim;
        schema:abstract          "Jonny Bairstow: “So climate change isn’t anything to do with the industrial revolution at all as a lot of people would say so?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10707/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/henrik-svensmark/>;

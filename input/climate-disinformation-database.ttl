<http://data.open.ac.uk/climate-sense/claim/6422/source/27>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.abc.net.au/insiders/tony-abbott-joins-insiders/4927470\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Tony Abbott joins Insiders</a>,” <em><span class=\"caps\">ABC</span></em>, September 1, 2013.&nbsp;<a href=\"http://web.archive.org/web/20200110151531/https://www.abc.net.au/insiders/tony-abbott-joins-insiders/4927470\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 10, 2019</a>. Archive.fo <span class=\"caps\">URL</span>:&nbsp;<a href=\"http://archive.md/wip/hDMrh\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.md/wip/hDMrh</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6422>
        rdf:type                 schema:Claim;
        schema:abstract          "“The important thing is to take strong and effective action to tackle climate change, action that doesn’t damage our economy. And that is why the incentive-based system that we’ve got, the direct action policies, which are quite similar to those that president Obama has put into practice, is – that’s the smart way to deal with this, a big tax is a dumb way to deal with it.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6422/source/27>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tony-abbott/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/tony-abbott/" .

<http://data.open.ac.uk/climate-sense/claim/6421/source/27>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.abc.net.au/insiders/tony-abbott-joins-insiders/4927470\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Tony Abbott joins Insiders</a>,” <em><span class=\"caps\">ABC</span></em>, September 1, 2013.&nbsp;<a href=\"http://web.archive.org/web/20200110151531/https://www.abc.net.au/insiders/tony-abbott-joins-insiders/4927470\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived January 10, 2019</a>. Archive.fo <span class=\"caps\">URL</span>:&nbsp;<a href=\"http://archive.md/wip/hDMrh\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.md/wip/hDMrh</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6421>
        rdf:type                 schema:Claim;
        schema:abstract          "“I think that climate change is real, humanity makes a contribution. It’s important to take strong and effective action against it, and that is what our direct action policy&nbsp;does.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6421/source/27>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tony-abbott/>;

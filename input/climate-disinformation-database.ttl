<http://data.open.ac.uk/climate-sense/claim/1066/source/83>
        rdf:type         schema:CreativeWork;
        schema:citation  "Marlo Lewis, Jr. <a href=\"http://web.archive.org/web/20021127222632/http://cei.org/gencon/027,03205.cfm\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“PRECAUTIONARY FOOLISHNESS,” </a><em>Competitive Enterprise Institute</em>, July 1, 2000. Archived November 27, 2002. Archive.is URL:<a href=\"https://archive.is/HOr71\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.is/HOr71</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1066>
        rdf:type                 schema:Claim;
        schema:abstract          "“A variety of empirical evidence suggests we have little or nothing to fear,“ Lewis begins. “[M]uch of this century’s modest warming may be due to natural causes such as changes in solar energy output. Second, since the models overestimate the warming of the past 100 years, they likely also overestimate the warming of the next hundred years.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1066/source/83>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/marlo-lewis-jr/>;

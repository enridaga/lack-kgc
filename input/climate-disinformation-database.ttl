<http://data.open.ac.uk/climate-sense/claim/5816/source/141>
        rdf:type         schema:CreativeWork;
        schema:citation  "Ken Blackwell. “<a href=\"http://web.archive.org/web/20160704190256/https://patriotpost.us/opinion/43572\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Green Energy Policies May Haunt Democrats This Fall</a>,” <em>The Patriot Post</em>, July 2, 2016. Archived July 4, 2016. Archive.is URL: <a href=\"https://archive.is/PE2Mk\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/PE2Mk</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5816>
        rdf:type                 schema:Claim;
        schema:abstract          "“Green energy remains an inconsequential source of energy in America despite more than $80 billion in direct federal taxpayer subsidies under Presidents George W. Bush and Barack Obama.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5816/source/141>;

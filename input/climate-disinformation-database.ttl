<http://data.open.ac.uk/climate-sense/claim/7807>
        rdf:type                 schema:Claim;
        schema:abstract          "“Here’s the dirty little secret about the climate religion: it has nothing to do with the climate, and everything to do with making the West and America in particular apologize for its success, which it views as a sin.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7807/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vivek-ramaswamy/>;

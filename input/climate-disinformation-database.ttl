<http://data.open.ac.uk/climate-sense/claim/8746>
        rdf:type                 schema:Claim;
        schema:abstract          "“In just a few weeks, more than 300 eminent scientists and other qualified individuals from around the world have signed the petition below,” Lindzen wrote in the letter.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8746/source/43>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/s-fred-singer/>;

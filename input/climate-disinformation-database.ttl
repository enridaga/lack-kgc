        rdf:type         schema:CreativeWork;
        schema:citation  "Paul C. Knappenberger, “<a href=\"http://web.archive.org/save/_embed/http://scienceandpublicpolicy.org/images/stories/papers/originals/utahs_climate_variability.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Utah’s Climate Variability</a>,” SPPI Original Paper, September 29, 2010. <a href=\"http://www.sourcewatch.org/index.php?title=Science_and_Public_Policy_Institute\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Science and Public Policy Institute</a>. Archived .pdf on file at Desmog."^^rdf:HTML .


        schema:citation  "“<a href=\"https://insideclimatenews.org/news/24022015/willie-soon-too-much-ice-really-bad-polar-bears\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Willie Soon: ‘Too Much Ice Is Really Bad for Polar Bears’</a>,” <em>InsideClimate News</em>, February 24, 2015. <a href=\"http://web.archive.org/web/20160820023142/https://insideclimatenews.org/news/24022015/willie-soon-too-much-ice-really-bad-polar-bears\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived August 20, 2016</a>. Archive.is URL: <a href=\"https://archive.is/KzQ3n\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/KzQ3n</a>"^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s5\"></a>Benjamin Powell.&nbsp;<a href=\"https://web.archive.org/web/20210509044402/http://www.beaconhill.org/BHIStudies/ClimateChange/mpi_mccap_review.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Continuing the Debate: Challenging the Economics of Montana’s Climate Change Action Plan” (PDF)</a>, <em>The Beacon Hill Institute</em>, March, 2008.&nbsp;Archived .pdf&nbsp;on file at&nbsp;DeSmog."^^rdf:HTML .


        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/bjorn-lomborg/" .

<http://data.open.ac.uk/climate-sense/claim/8060/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8060>
        rdf:type                 schema:Claim;
        schema:abstract          "“To realize, yes, climate change is a real problem, but it’s not this catastrophic end of the world. There is nothing in the UN climate panel, the new report that came out from 2021–2022, these 1600 pages. No apocalypse in there.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8060/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/bjorn-lomborg/" .

<http://data.open.ac.uk/climate-sense/claim/8059/source/71>
        rdf:type         schema:CreativeWork;
        schema:citation  "Bjorn Lomborg. “<a href=\"https://twitter.com/BjornLomborg/status/1686296353654104064?ref_src=twsrc%5Etfw%7Ctwcamp%5Etweetembed%7Ctwterm%5E1686296353654104064%7Ctwgr%5E0cbbdbf697073ea84e2209f4a150bd62848f4482%7Ctwcon%5Es1_&amp;ref_url=https%3A%2F%2Fwww.theguardian.com%2Fenvironment%2Fcommentisfree%2F2023%2Faug%2F03%2Fthe-world-likely-just-had-its-hottest-month-on-record-what-a-time-to-be-a-climate-science-denier\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate alarmists scare us of ever more fire. But satellites show the world is burning ever 𝙡𝙚𝙨𝙨. In 2022, the world burned the least ever in the satellite era. Why haven’t you seen this?</a>,” Tweet by user @BjornLomborg, August 1, 2023. Archived .png on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8059>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate alarmists scare us with ever more fire. But satellites show the world is burning ever less. In 2022, the world burned the least ever in the satellite era.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8059/source/71>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/bjorn-lomborg/" .

<http://data.open.ac.uk/climate-sense/claim/8058/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8058>

<http://data.open.ac.uk/climate-sense/claim/10719/source/14>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://apnews.com/0c87e4318bcc4eb9b8e69f9f54c7b889\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Documents show ties between university, conservative donors</a>,” <em>Associated Press</em>, February 13, 2018. <a href=\"http://web.archive.org/web/20180501024837/https://apnews.com/0c87e4318bcc4eb9b8e69f9f54c7b889\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived April 30, 2018</a>. Archive.is URL:<a href=\"https://archive.li/2u0g0\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.li/2u0g0</a>"^^rdf:HTML .


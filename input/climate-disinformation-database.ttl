        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160728035213/http://www.freerepublic.com/focus/f-news/1425936/posts\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Global Warming is More Scare than Science – (absolutely!)</a>,” Chronwatch.com, June 19, 2005. Republished by Freerepublic.com. Archived July 28, 2016. Archive.is URL: <a href=\"https://archive.is/qZwW4\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/qZwW4</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3406>
        rdf:type                 schema:Claim;
        schema:abstract          "“The fact of the matter is that there does exist a growing body of scientific evidence that the climate changes in the coming decades will be modest and proceed at a rate that will lie somewhere near the low end of the IPCC projected temperature range.”";

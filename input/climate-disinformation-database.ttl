<http://data.open.ac.uk/climate-sense/claim/2736>
        rdf:type                 schema:Claim;
        schema:abstract          "We do not take funding from fossil fuel industry and we are explicit that no funding will have any influence on our research. This statement should be on our website – we’ll add this to the new website.";

        rdf:type         schema:CreativeWork;
        schema:citation  "Molly Taft. “<a href=\"https://earther.gizmodo.com/top-climate-scientist-blasts-government-lab-after-denie-1846956716\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Top Climate Scientist Blasts Government Lab After Denier Invited to Speak</a>,” <em>Earther/Gizmodo</em>, May 24, 2021.<a href=\"https://web.archive.org/web/20210526180002/https://earther.gizmodo.com/top-climate-scientist-blasts-government-lab-after-denie-1846956716\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> Archived May 26, 2021</a>. Archive URL: <a href=\"https://archive.ph/Qdm2m\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/Qdm2m</a>"^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20161228183228/http://www.dailymail.co.uk/news/article-3974846/Stunning-new-data-indicates-El-Nino-drove-record-highs-global-temperatures-suggesting-rise-not-man-emissions.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Stunning new data indicates El Nino drove record highs in global temperatures suggesting rise may not be down to man-made emissions</a>,”<em> The Mail on Sunday</em>, November 26, 2016. Archived December 28, 2016. Archive.is URL: <a href=\"https://archive.is/jWiS2\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/jWiS2</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2880>
        rdf:type                 schema:Claim;
        schema:abstract          "“Global average temperatures over land have plummeted by more than 1C since the middle of this year – their biggest and steepest fall on record,” Rose writes. ” The fall, revealed by Nasa satellite measurements of the lower atmosphere, has been caused by the end of El Nino – the warming of surface waters in a vast area of the Pacific west of Central America.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2880/source/22>;

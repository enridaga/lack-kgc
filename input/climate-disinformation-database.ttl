        rdf:type                 schema:Claim;
        schema:abstract          "“I hope people won’t take the high mitigation cost out of context,” she told Lomborg.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8110/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bjorn-lomborg/>;

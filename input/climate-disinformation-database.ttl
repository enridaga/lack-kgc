        rdf:type         schema:CreativeWork;
        schema:citation  "Ben Jervey. “<a href=\"//www.desmog.com/2016/10/12/murray-vs-musk-coal-ceo-calls-tesla-fraud-doesn-t-mention-subsidies-failing-coal\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Murray vs. Musk: Coal CEO Calls Tesla a ‘Fraud,’ Doesn’t Mention Subsidies for Failing Coal</a>,” <em>DeSmog</em>, October 13, 2016."^^rdf:HTML .


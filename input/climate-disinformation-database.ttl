        rdf:type                 schema:Claim;
        schema:abstract          "“We should not be banning drilling in the North Sea. Rather, we should start fracking onshore to improve the wealth of the nation.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11924/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jacob-rees-mogg/>;

        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11925>
        rdf:type                 schema:Claim;
        schema:abstract          "“We need to be thinking about extracting every last cubic inch of gas from the North Sea. We are not going for net zero tomorrow – 2050 is a long way off. We’re going to need fossil fuels in the interim. We should [use] ours that we have got available.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11925/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jacob-rees-mogg/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/jacob-rees-mogg/" .


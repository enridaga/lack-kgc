<http://data.open.ac.uk/climate-sense/claim/10098>
        rdf:type                 schema:Claim;
        schema:abstract          "“We should be thanking God for the amount of fossil fuels we have in this country right here, as opposed to other countries where we’re having brown and blackouts right now,” Hollie said on an";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10098/source/11>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/derrick-hollie/>;

<http://data.open.ac.uk/climate-sense/claim/7271/source/37>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"https://www.uts.edu.au/sites/default/files/Sceptical-Climate-Part-2-Climate-Science-in-Australian-Newspapers.pdf\" id=\"s11\" name=\"s11\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Sceptical Climate Part 2: Climate Science in Australian Newspapers” (PDF)</a>, Austrlian Center for Independent Journalism, October 2013."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7271>
        rdf:type                 schema:Claim;
        schema:abstract          "“Given his influence, a consideration of how Australian media covers climate science needs to include an analysis of the strategies used by Bolt to persuade his readers they should reject the findings of the vast majority of climate scientists. These strategies include personal abuse, cherry picking specific findings to refute the entire body of findings of climate scientists, portrayal of advocates of climate action as ideologically motivated with totalitarian tendencies and criticism of journalists who report on climate science. He presents himself as someone who is fighting a battle to reveal ‘truth’ and ‘secrets’ which ‘warmists’ want hidden to protect their vested interests. Once the ‘facts’ are established a triumphal, mocking tone is adopted.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7271/source/37>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/andrew-bolt/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/andrew-bolt/" .


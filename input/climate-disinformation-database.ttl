<http://data.open.ac.uk/climate-sense/claim/5707>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate and energy policy has fallen into the hands of a worldwide movement that openly declares its extremism. The would-be moderates on this issue have pretended for 20 years they could keep the status quo without having to fight for it. Those days are over.”";

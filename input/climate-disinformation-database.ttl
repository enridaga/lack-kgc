<http://data.open.ac.uk/climate-sense/claim/6882>
        rdf:type                 schema:Claim;
        schema:abstract          "“The climate is changing, but the question is, is climate changing because of natural cycles in the atmosphere over the span of history, or is it changing because we drive SUVs? I don’t believe in the latter. I don’t think that’s the primary driver.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6882/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-johnson/>;

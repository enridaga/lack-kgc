<http://data.open.ac.uk/climate-sense/claim/1937/source/9>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://iamleroyjonesjr.com/2016/09/dh-eb-2016/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Talking with Derrick Hollie about the Energy Business</a>,” iamleroyjonesjr.com, September 20, 2016. <a href=\"http://web.archive.org/web/20170715190059/http://iamleroyjonesjr.com/2016/09/dh-eb-2016/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived July 15, 2017</a>. Archive.is URL: <a href=\"https://archive.is/gZTlT\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/gZTlT</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1937>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate change is real and we contribute to it, but how much can be done, and does the rate of warming justify the actions? […] It’s been mild and it’s been gradual. […] mild and gradual warming does not justify the policies that increase energy poverty and income inequality for minority communities.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1937/source/9>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/reaching-america/>;

<http://data.open.ac.uk/climate-sense/claim/8>
        rdf:type                 schema:Claim;
        schema:abstract          "“If the green lobby genuinely believed in tackling climate change they would be more open minded to the benefits of extracting shale gas in the UK.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/priti-patel/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20200806190755/https://stream.org/climate-surprise-co2-good-earth/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Surprise: Why More CO2 is Good for the Earth</a>,” <em>The Stream</em>, March 31, 2016. Arhived August 6, 2020. Archive URL: <a href=\"https://archive.vn/SenNp\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/SenNp</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1246>
        rdf:type                 schema:Claim;
        schema:abstract          "“In times past, atmospheric CO2 levels were up to 30 times higher — pause and reflect on the number — than they are now; and indeed we are now in a historic, almost dangerously low, period. Yet even though CO2 was then so much higher than mankind could ever hope now to achieve even if we burn every drop of oil that exists, there was no runaway global warming. Why should we expect it now?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1246/source/41>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/william-briggs/>;

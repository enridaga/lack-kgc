        rdf:type         schema:CreativeWork;
        schema:citation  "Norman Rogers. “<a href=\"http://web.archive.org/web/20140801161503/http://www.americanthinker.com/2014/07/bamboozled_billionaires.html\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Bamboozled Billionaires</a>,” <em>American Thinker</em>, July 21, 2014. Archived August 1, 2014. Archive.fo URL: <a href=\"https://archive.fo/9DfDj\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/9DfDj</a>"^^rdf:HTML .


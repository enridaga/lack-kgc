<http://data.open.ac.uk/climate-sense/claim/10721/source/28>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a name=\"s5\" id=\"s5\"></a><a href=\"https://web.archive.org/web/20150822232509/http://mercatus.org/sites/default/files/publication/The_Environmental_Protection_Agencys_Request_for_Comment_on_a_Petition_-_Control_of_Emissions_From_New_and_In-use_Highway_Vehicles_and_Engines.pdf\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">“Public Interest Comment on the Environmental Protection Agency’s Request for Comment on a Petition: Control of Emissions From New and In-use Highway Vehicles and Engines” (PDF)</a>, Mercatus Center Regulatory Studies Program. Archived August 22, 2015. <a href=\"//www.desmog.com/wp-content/uploads/files/The_Environmental_Protection_Agencys_Request_for_Comment_on_a_Petition_-_Control_of_Emissions_From_New_and_In-use_Highway_Vehicles_and_Engines.pdf\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Archived .pdf on file at DeSmog</a>."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10721>
        rdf:type                 schema:Claim;
        schema:abstract          "“The evidence regarding global warming and human contribution to it is mixed, and as forecasts of anthropogenic warming get more refined, they predict less extreme warming.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10721/source/28>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20170127224430/http://rogerpielkejr.blogspot.com/2014/03/john-holdrens-epic-fail.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">John Holdren’s Epic Fail,</a>” <em>Roger Pielke Jr.’s Blog</em>, March 1, 2014. Archived January 26, 2017. Archive.is URL: <a href=\"https://archive.is/sJ8kZ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/sJ8kZ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1486>
        rdf:type                 schema:Claim;
        schema:abstract          "“In a nutshell, Holdren’s response is sloppy and reflects extremely poorly on him. Far from showing that I am outside the scientific mainstream, Holdren’s follow-up casts doubt on whether he has even read my Senate testimony,” Pielke claims. He concludes that Holdren “has gone too far” by supposedly attempting&nbsp;to “delegitimize a&nbsp;colleague.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1486/source/102>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/roger-pielke-jr/>;

<http://data.open.ac.uk/climate-sense/claim/9843/source/17>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://canadafreepress.com/index.php/article/27111\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Elitism or </a><a href=\"http://canadafreepress.com/index.php/article/27111\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Arrogance</a>,” <em>Canada Free Press, </em>August 30, 2010."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9843>
        rdf:type                 schema:Claim;
        schema:abstract          "“When a climate scientist calls me a denier, or a columnist from the New York Times or the Washington Post calls me a racist, I can wear the terms with pride. Not because I am a denier or a racist, but because I know that for those individuals, calling me a name is a sign of how desperate they are.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9843/source/17>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/robert-bob-c-shoup/>;

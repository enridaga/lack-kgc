        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://powerhour.alexepstein.com/2020/09/16/patrick-moore-on-how-green-forest-mismanagement-caused-the-california-wildfire-disaster/?utm_source=feedburner&amp;utm_medium=feed&amp;utm_campaign=Feed%3A+power-hour+%28POWER+HOUR+-+with+Alex+Epstein%29\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Patrick Moore on How ‘Green’&nbsp;Forest Mismanagement Caused the California Wildfire Disaster</a>,”&nbsp;<em>Power Hour with Alex Epstein</em>, September 16, 2020. Archived .mp3&nbsp;on file&nbsp;at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8171>
        rdf:type                 schema:Claim;
        schema:abstract          "“You know, one thing I’ve been saying lately is I think it’s just really important that people associate the California blackouts with green energy and the California wildfires with green forestry,” Epstein said in an ";

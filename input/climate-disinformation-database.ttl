        rdf:type                 schema:Claim;
        schema:abstract          "“Natural resources are not incidental to our exceptional quality of life. They are the foundation. They are the way to ensure a future for Canada where we all thrive, combat climate change, develop high-impact science and technology exports, and make a better world possible.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1321/source/20>;

        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/tim-ball/" .

<http://data.open.ac.uk/climate-sense/claim/2008/source/51>
        rdf:type         schema:CreativeWork;
        schema:citation  "Richard Littlemore. “<a href=\"//www.desmog.com/2018/02/14/climate-denier-tim-ball-trump-approved-not-credible-enough-stand-accountable-libel-0\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Climate Denier Tim Ball: Trump Approved, But Not Credible Enough To Stand Accountable For Libel</a>,” <em>DeSmog</em>, February 14, 2018."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2008>
        rdf:type                 schema:Claim;
        schema:abstract          "“These allegations are directed at Dr. Weaver’s professional competence and are clearly derogatory of him. Indeed, it is quite apparent that this was Dr. Ball’s intent,” the judge wrote, adding, however, that “It is very unlikely that the Article and the opinions expressed therein had an impact on the views of anyone who read it, including their views, if any, of Dr. Weaver as a climate scientist. Rather, the reasonably thoughtful and informed reader would have recognized the Article as simply presenting one side of a highly charged public debate.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2008/source/51>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tim-ball/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“The Australian government recently released an issues paper for the review of the renewable energy target. What everyone engaged in this debate should recognise is that policies such as the carbon tax and the ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8046/source/51>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://nymag.com/news/features/67285/index4.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Billionaire’s Party</a>,” <em>New York</em>, July 25, 2010. <a href=\"http://web.archive.org/web/20171228222208/http://nymag.com/news/features/67285/index4.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived December 28, 2017</a>. Archive.is URL: <a href=\"https://archive.is/sHzng\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/sHzng</a>"^^rdf:HTML .


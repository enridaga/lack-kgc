        rdf:type         schema:CreativeWork;
        schema:citation  "Robert Bradley Jr. “<a href=\"https://www.forbes.com/sites/robertbradley/2016/09/23/climate-exaggeration-is-backfiring/2/#2db387f07255\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Climate Exaggeration is Backfiring</a>,” <em>Forbes</em>, September 23, 2016. Archive.is URL: <a href=\"https://archive.is/PHnnQ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/PHnnQ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12579>
        rdf:type                 schema:Claim;
        schema:abstract          "“There is good news as good science drives out bad. The discrepancy between model-predicted warming and (lower) real-world observations has inspired new respect for natural climate variability relative to greenhouse-gas forcing. […] The real news is good news in contradiction to doom-and-gloom. It is time for energy and climate planners to lay down their government arms. Let consumers and taxpayers be.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12579/source/7>;

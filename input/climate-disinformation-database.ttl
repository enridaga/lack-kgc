        rdf:type         schema:CreativeWork;
        schema:citation  "Samuele Furfari. “<a href=\"http://web.archive.org/web/20191024234319/https://www.project-syndicate.org/commentary/europe-nuclear-energy-debate-facts-not-fear-by-samuele-furfari-2019-10\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Europe Needs a Serious Nuclear-Energy Debate</a>,” <em>Project Syndicate</em>, October 11, 2019. Archived October 24, 2019. Archive.fo URL: <a href=\"https://archive.fo/6CE86\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/6CE86</a>"^^rdf:HTML .


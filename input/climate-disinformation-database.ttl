<http://data.open.ac.uk/climate-sense/claim/4799/source/33>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180329192345/https://www.usatoday.com/story/news/politics/2015/04/23/charles-koch-interview-republican-president-primaries/25936305/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Charles Koch: We’re not in politics to boost our bottom line</a>,” <em>USA Today</em>, April 23, 2015. Archived March 29, 2018. Archive.is URL: <a href=\"https://archive.li/i4NGL\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.li/i4NGL</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4799>
        rdf:type                 schema:Claim;
        schema:abstract          "“You can plausibly say that CO2 has contributed” to the planet’s warming, but he sees ‘no evidence’ to support ‘this theory that it’s going to be catastrophic.’”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4799/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/charles-koch/>;

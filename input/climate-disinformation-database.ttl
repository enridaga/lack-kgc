        rdf:type         schema:CreativeWork;
        schema:citation  "Joe Bast. “<a href=\"https://www.industrydocumentslibrary.ucsf.edu/docs/#id=kkww0055\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Dear Editor</a>,” <em>Americans for Tax Reform</em> (forwarded email). Retrieved from UCSF Industry Documents Library. Bates number 2085235040."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7444>
        rdf:type                 schema:Claim;
        schema:abstract          "“Besides thousands of frivolous civil suits pursued by lawyers who long ago forgot the meaning of justice, the U .S . Justice Department itself wants $50 million in taxpayer dollars to pursue a legal case against the tobacco industry initiated by the Clinton administration. When will it end?” Bast asked.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7444/source/23>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joseph-bast/>;

<http://data.open.ac.uk/climate-sense/claim/6196>
        rdf:type                 schema:Claim;
        schema:abstract          "“’With respect to the discussion on global warming, I say there are no simple answers to such an extremely complex issue,’ said England. “No matter how many models they wave in the air and no matter how dire their predictions about our impending doom, they don’t know’.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6196/source/10>;

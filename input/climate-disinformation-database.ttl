        rdf:type         schema:CreativeWork;
        schema:citation  "Vivian Krause, “<a href=\"http://web.archive.org/web/20171110031421/http://www.huffingtonpost.ca/vivian-krause/vision-vancouver-election-us-oil_b_6151792.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">A Vote For Vision Vancouver Is A Vote For U.S. Interests</a>,” <em>HuffPost</em>, November 13, 2014. Archived November 10, 2017. Archive.is URL: <a href=\"https://archive.is/lsn15\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/lsn15</a>"^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8118>
        rdf:type                 schema:Claim;
        schema:abstract          "“This article has shown that these claims are misleading and often incorrectly describe the issue and its future. While climate change is real, human caused, and will have a mostly negative impact, it is important to remember that climate policies will likewise have a mostly negative impact. Thus, we must account for the effects of both to find the policies that will achieve the highest welfare gains.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8118/source/>;

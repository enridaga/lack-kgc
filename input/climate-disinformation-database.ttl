        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4713>
        rdf:type                 schema:Claim;
        schema:abstract          "“They seem to think that developing countries can, in order to develop and industrialise and improve their standards of living, somehow leapfrog the phase of using fossil fuels that we in the West benefited from for our development and industrialisation. And that countries like Kenya should build wind farms and solar farms to progress. But quite frankly, that’s not going to work. It’s just&nbsp;not.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4713/source/>;

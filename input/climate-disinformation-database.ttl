        rdf:type         schema:CreativeWork;
        schema:citation  "Timothy Cama. “<a href=\"https://thehill.com/policy/energy-environment/305631-mcconnell-asked-trump-to-approve-keystone-pipeline\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">McConnell asks Trump to approve Keystone pipeline</a>,” <em>The Hill</em>, November 11, 2016. <a href=\"http://web.archive.org/web/20190605135600/https://thehill.com/policy/energy-environment/305631-mcconnell-asked-trump-to-approve-keystone-pipeline\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived June 5, 2019</a>. Archive.fo URL: <a href=\"http://archive.fo/Jssih\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/Jssih</a>"^^rdf:HTML .


<http://data.open.ac.uk/climate-sense/claim/9037/source/63>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180320222304/https://instituteforenergyresearch.org/analysis/electric-vehicles-beware-customers-prefer-suvs-pick-ups/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Electric Vehicles Beware: Customers Prefer SUVs and Pick-Ups</a>,” <em>Institute for Energy Research</em>, March 19, 2018. Archived March 20, 2018. Archive.is URL: <a href=\"https://archive.is/2sart\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">https://archive.is/2sart</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9037>
        rdf:type                 schema:Claim;
        schema:abstract          "“SUVs and pick-up trucks are increasing in demand–not just in the United States, but around the world—as car buyers are looking to more roomy and powerful vehicles. The demand for these vehicles is making governments worry about meeting their reductions targets for greenhouse gas emissions.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9037/source/63>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/institute-energy-research/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“The Committee’s requests violate basic First Amendment protections, fall outside the proper jurisdiction of the Committee, and are impermissibly vague, overbroad, and burdensome. For these reasons, Greenpeace and 350.org respectfully refuse to comply with the Committee’s requests.”";

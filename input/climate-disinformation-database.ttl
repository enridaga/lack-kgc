        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://abcnews.go.com/Technology/story?id=2612021&amp;page=1#.UXCtM7VKiSo\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Senators to Exxon: Stop the Denial</a>,” <em>ABC News</em>, October 27, 2006. <a href=\"http://web.archive.org/web/20170501232751/http://abcnews.go.com/Technology/story?id=2612021&amp;page=1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 1, 2017</a>. Archive.is URL: <a href=\"https://archive.is/SWLZH\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/SWLZH</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12806>
        rdf:type                 schema:Claim;
        schema:abstract          "“We are convinced that ExxonMobil’s long-standing support of a small cadre of global climate change skeptics, and those skeptics’ access to and influence on government policymakers, have made it increasingly difficult for the United States to demonstrate the moral clarity it needs across all facets of its diplomacy,” they said.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12806/source/13>;

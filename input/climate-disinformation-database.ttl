<http://data.open.ac.uk/climate-sense/claim/7405>
        rdf:type                 schema:Claim;
        schema:abstract          "“[R]adical genocide scholars, influenced by both&nbsp;anti-scientific post-modernism&nbsp;and person-centred victimology studies, have so expanded the notion of genocide as to include any real or alleged action that its presumed targets claim qualify as such.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7405/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/manning-foundation-for-democratic-education/>;
        schema:claimInterpreter  <http://desmog.com/>;

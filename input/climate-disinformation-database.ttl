<http://data.open.ac.uk/climate-sense/claim/12990>
        rdf:type                 schema:Claim;
        schema:abstract          "“We are skeptical of claims for the ability of random mutation and natural selection to account for the complexity of life. Careful examination of the evidence for Darwinian theory should be encouraged.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12990/source/28>;

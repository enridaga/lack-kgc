<http://data.open.ac.uk/climate-sense/claim/13485/source/25>
        rdf:type         schema:CreativeWork;
        schema:citation  "Phil Kerpen. “<a href=\"http://web.archive.org/web/20190704184021/https://www.americancommitment.org/content/trump-should-let-senate-kill-climate-treaty\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">TRUMP SHOULD LET THE SENATE KILL OBAMA’S CLIMATE TREATY</a>,” <em>American Commitment</em>, November 17, 2016. Archived July 4, 2019. Archive.fo URL: <a href=\"https://archive.fo/tTHSW\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/tTHSW</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13485>
        rdf:type                 schema:Claim;
        schema:abstract          "He added: “The Paris treaty is a magnificent example of the bad deals made for America that ultimately paved Donald Trump’s path to the White House.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13485/source/25>;

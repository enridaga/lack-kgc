<http://data.open.ac.uk/climate-sense/claim/8104>
        rdf:type                 schema:Claim;
        schema:abstract          "“At the moment, 60 per cent of the EU’s total renewable energy comes from burning wood pellets. But while wood energy is in principle renewable, cutting down more and more forest can have huge biodiversity impacts. Moreover, wood emits more CO₂ than coal when burned, and it is often imported and transported on diesel ships from the U.S.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8104/source/>;

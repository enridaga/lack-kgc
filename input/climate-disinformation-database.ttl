<http://data.open.ac.uk/climate-sense/claim/6371>
        rdf:type                 schema:Claim;
        schema:abstract          "“While modelers base their assumptions upon both fundamental physical laws and observations of the climate, there is still considerable judgment involved. And since different modelers will make different assumptions, results vary widely among different models.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6371/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/steve-koonin/>;

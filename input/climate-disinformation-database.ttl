        rdf:type         schema:CreativeWork;
        schema:citation  "Vijay Jayaraj. “<a href=\"http://web.archive.org/web/20210329150925/https://www.thegwpf.com/vijay-jayaraj-india-speeds-up-fossil-fuelled-economy-despite-net-zero-noises/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Vijay Jayaraj: India speeds up fossil-fuelled economy, despite Net Zero noises</a>,” <em>The Global Warming Policy Forum, </em>March 26, 2021. Archived March 26, 2021. Archive.vn URL: <a href=\"https://archive.ph/oZmJH\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/oZmJH</a>"^^rdf:HTML .


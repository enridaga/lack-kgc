<http://data.open.ac.uk/climate-sense/claim/8585/source/50>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.ineos.com/businesses/ineos-shale/news/ineos-shale-commission-former-mp-natascha-engel/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">INEOS Shale commission former MP Natascha Engel</a>,” <em>INEOS Shale</em>, December 1, 2017. <a href=\"https://web.archive.org/web/20190711130053/https://www.gov.uk/government/news/natascha-engel-appointed-as-commissioner-for-shale-gas\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived July 11, 2019</a>. Archive.fo URL: <a href=\"http://archive.fo/mDOsZ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/mDOsZ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8585>
        rdf:type                 schema:Claim;
        schema:abstract          "“I saw first-hand what the impacts are on small communities when they hear about a shale gas application near them – even when it’s only for exploratory drilling. What people want is information. They want to know how it will affect them and they want reassurance that it is safe. I hope that this booklet will provide some of those certainties.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8585/source/50>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/natascha-engel/>;

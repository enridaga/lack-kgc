        rdf:type                 schema:Claim;
        schema:abstract          "“Professor Ridd has on numerous occasions and in numerous ways seriously and repeatedly breached the Code of Conduct – his employment has been terminated on this basis. To suggest otherwise is simply wrong,” the statement reads.";

<http://data.open.ac.uk/climate-sense/claim/3078/source/57>
        rdf:type         schema:CreativeWork;
        schema:citation  "Benjamin Kentish. “<a href=\"http://www.independent.co.uk/news/world/americas/donald-trump-cia-director-mike-pompeo-climate-change-findings-nasa-scientists-global-warming-senate-a7524926.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Donald Trump’s pick for CIA director refuses to accept Nasa findings on climate change</a>,” <em>The Independent</em>, January 12, 2017. <a href=\"http://web.archive.org/web/20180314205248/http://www.independent.co.uk/news/world/americas/donald-trump-cia-director-mike-pompeo-climate-change-findings-nasa-scientists-global-warming-senate-a7524926.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived March 14, 2018</a>. Archive.is URL: <a href=\"https://archive.is/i2Hf4\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/i2Hf4</a>"^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  "Jennifer Bendery. “<a href=\"http://www.huffingtonpost.com/entry/pope-congress-climate-change-immigration_us_56042de8e4b08820d91bf69d\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Conservatives Dismiss Pope On Climate Change, Warn Of Immigrant ‘Anarchy’</a>,” <em>HuffPost, </em>September 24, 2015. <a href=\"https://web.archive.org/web/20170704033804/http://www.huffingtonpost.com/entry/pope-congress-climate-change-immigration_us_56042de8e4b08820d91bf69d\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Archived July 3, 2017</a>. Archive.is URL: <a href=\"https://archive.is/W1exd\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/ W1exd</a>"^^rdf:HTML .


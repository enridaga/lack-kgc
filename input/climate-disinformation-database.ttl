<http://data.open.ac.uk/climate-sense/claim/736>
        rdf:type                 schema:Claim;
        schema:abstract          "“There will always be changes that affect our climate, even if we close down all thermal-fired power stations, steel mills and other manufacturing operations, putting employees out of work and drastically changing our way of life. Furthermore, there will always be geothermal activity that spew out heat and ash and this activity does affect the&nbsp;climate.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/736/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/gina-rinehart/>;

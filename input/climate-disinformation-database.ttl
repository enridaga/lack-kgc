        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/117>
        rdf:type                 schema:Claim;
        schema:abstract          "“The breadth of the groups with financial ties to Peabody is extraordinary. Thinktanks, litigation groups, climate scientists, political organisations, dozens of organisations blocking action on climate all receiving funding from the coal industry,” said Nick Surgey, director of research for the Center for Media and&nbsp;Democracy.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/117/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/dci-group/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/dci-group/" .

<http://data.open.ac.uk/climate-sense/claim/116/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/116>
        rdf:type                 schema:Claim;
        schema:abstract          "Among Peabody’s beneficiaries, the Center for the Study of Carbon Dioxide and Global Change has insisted – wrongly – that carbon emissions are not a threat but “the elixir of life” while the American Legislative Exchange Council is trying to overturn Environmental Protection Agency rules cutting emissions from power plants. Meanwhile, Americans for Prosperity campaigns against carbon pricing. The Oklahoma chapter was on the list.&nbsp;[…]";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/116/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/dci-group/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/dci-group/" .

<http://data.open.ac.uk/climate-sense/claim/115/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/115>
        rdf:type                 schema:Claim;
        schema:abstract          "The company’s filings reveal funding for a range of organisations which have fought Barack Obama’s plans to cut greenhouse gas emissions, and denied the very existence of climate change.&nbsp;[…]";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/115/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/dci-group/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/dci-group/" .

<http://data.open.ac.uk/climate-sense/claim/114/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/114>
        rdf:type                 schema:Claim;
        schema:abstract          "“These groups collectively are the heart and soul of climate denial,” said Kert Davies, founder of the Climate Investigation Center, who has spent 20 years tracking funding for climate denial. “It’s the broadest list I have seen of one company funding so many nodes in the denial&nbsp;machine.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/114/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/dci-group/>;

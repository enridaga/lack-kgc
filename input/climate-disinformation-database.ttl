        rdf:type         schema:CreativeWork;
        schema:citation  "Mike Haseler. “<a href=\"http://web.archive.org/web/20190307140058/https:/www.brugesgroup.com/images/issues/climate_change/climate_what_we_know_and_what_we_do_no_bruges_climate_paper_pdf.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Climate Change: What we know and what we don’t</a>,” <em>Bruges Group</em>, August 11, 2014. Archived March 7, 2019. Archive.fo URL: <a href=\"http://archive.fo/3lcSh\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/3lcSh</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3169>
        rdf:type                 schema:Claim;
        schema:abstract          "“Through the ‘moral’ imperative of ‘saving the planet’ from the dire consequences of burning of fossil fuels, the EU hoped it could hobble the burgeoning industries of Brazil, Russia, India, China (BRICs). Making the world’s energy extremely expensive by requiring the use of renewables and by insisting on heavy carbon taxes, you are a long way towards crushing the competition of the BRICs.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3169/source/27>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/philip-foster/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/philip-foster/" .


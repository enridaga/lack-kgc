        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://youtu.be/wU1qg8HceGI\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">The Connection between Cosmic Rays, Clouds and Climate</a>,” YouTube video uploaded by user “GWPF,” March 16, 2018. Archived .mp4 on file at DeSmog."^^rdf:HTML .


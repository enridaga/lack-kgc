<http://data.open.ac.uk/climate-sense/claim/8629/source/108>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.nytimes.com/2018/05/08/climate/pruitt-epa-red-blue-team-debate-emails.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Pruitt’s Plan for Climate Change Debates: Ask Conservative Think Tanks</a>,”<em> The New York Times</em>, May 8, 2018. Archived May 14, 2018. Archive.is URL:<a href=\"https://archive.li/onsj5\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.li/onsj5</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8629>
        rdf:type                 schema:Claim;
        schema:abstract          "“The documents show the extent to which the E.P.A., which is the main federal agency charged with protecting human health and the environment, worked with groups like the Heartland Institute, which holds positions on climate change that are far outside the mainstream of scientific opinion, as opposed to the agency’s own chief scientists,”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8629/source/108>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/scott-pruitt/>;
        schema:claimInterpreter  <http://desmog.com/>;

        rdf:type                 schema:Claim;
        schema:abstract          "They all just assume we are all mad and we are in the pockets of the big polluters and it really is impossible to deal with these people on any rational basis at all.&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11458/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/nick-minchin/>;

<http://data.open.ac.uk/climate-sense/claim/9479/source/53>
        rdf:type         schema:CreativeWork;
        schema:citation  "<br>\n“<a href=\"https://web.archive.org/web/20240506104847/http://www.thegwpf.org/publications/the-state-of-the-climate-2023/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">State of the Climate 2023</a>,” Global Warming Policy Foundation, March 28, 2024. Archived May 6, 2024. Archive URL: <a href=\"https://archive.is/jqtui\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/jqtui</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9479>
        rdf:type                 schema:Claim;
        schema:abstract          "“Believing that one minor constituent of the atmosphere (CO2) controls nearly all aspects of climate is naïve and entirely unrealistic. The global climate has remained in a quasi-stable condition within certain limits for millions of years, although with important variations playing out over periods ranging from years to centuries, or more, but the global climate has never been in a fully stable state without change. Modern observations show that this normal behaviour is also characterising recent years, including 2023, and there is no observational evidence for any global climate crisis”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9479/source/53>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/global-warming-policy-foundation/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;

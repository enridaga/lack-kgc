        rdf:type                 schema:Claim;
        schema:abstract          "Either from the climate or from a virus, it’s the same thing. I would go after these ‘solutions’ and then I would just keep an open debate.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8413/source/>;

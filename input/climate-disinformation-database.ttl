<http://data.open.ac.uk/climate-sense/claim/5721>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate change does pose some risks; yet those risks do not imply that massive social engineering for GHG control is either possible or desirable. Only when an awareness of this reality sinks in among public intellectuals is a more serious policy discourse likely to emerge.” — Lee Lane, Hudson Institute Scholar ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5721/source/13>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/hudson-institute/>;

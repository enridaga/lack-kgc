<http://data.open.ac.uk/climate-sense/claim/3746>
        rdf:type                 schema:Claim;
        schema:abstract          "All this unutterable climate crap has convinced me we should pull all public funding for science. Private sector science only please, serving genuine consumer needs.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3746/source/>;

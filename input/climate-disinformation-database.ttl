<http://data.open.ac.uk/climate-sense/claim/3260>
        rdf:type                 schema:Claim;
        schema:abstract          "“No. And you don’t have to take our word for it. No fewer than two dozen scientific studies have concluded that fracking does not pose a major threat to groundwater. “";

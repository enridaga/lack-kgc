        rdf:type                 schema:Claim;
        schema:abstract          "Join Reaching America in our modern-day movement to address social issues impacting the African American community at ReachingAmerica.org.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10101/source/13>;

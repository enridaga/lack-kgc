        schema:url               "https://www.desmog.com/thomas-jefferson-institute-public-policy/" .

<http://data.open.ac.uk/climate-sense/claim/2056/source/29>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20150925204223/http://www.world-nuclear-news.org/NP-Virginia-can-lead-nuclear-renaissance-report-says-1506157.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Virginia can lead nuclear renaissance, report says</a>,” <em>World Nuclear News</em>, June 15, 2015. Archived September 25, 2015. WebCite URL: <a href=\"http://www.webcitation.org/6boaPk0AO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://www.webcitation.org/6boaPk0AO</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2056>
        rdf:type                 schema:Claim;
        schema:abstract          "“Due to the amazing number of nuclear related facilities and Virginia’s critical infrastructure related to national security, it makes perfect sense that Virginia should lead the way in nuclear technology and new and innovative ideas to provide safe and secure power that is also, if necessary, off grid,” the report says.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2056/source/29>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/thomas-jefferson-institute-public-policy/>;

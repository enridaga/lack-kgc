<http://data.open.ac.uk/climate-sense/claim/9793/source/68>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160816185150/http://www.nationalbcc.org/news/testimonials/1165-senate-testimony-july-16-2009\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Senate Testimony, July 16, 2009</a>,” National Black Chamber of Commerce. Archived August 16, 2016. Archive.is URL:&nbsp;<a href=\"https://archive.is/Or3H9\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/Or3H9</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9793>
        rdf:type                 schema:Claim;
        schema:abstract          "”[…] I’m not a climate change expert, but I have to believe that there are better options than the one currently on the table.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9793/source/68>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/harry-c-alford/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/harry-c-alford/" .

<http://data.open.ac.uk/climate-sense/claim/9792/source/69>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160816185150/http://www.nationalbcc.org/news/testimonials/1165-senate-testimony-july-16-2009\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Senate Testimony, July 16, 2009</a>,” National Black Chamber of Commerce. Archived August 16, 2016. Archive.is URL:&nbsp;<a href=\"https://archive.is/Or3H9\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/Or3H9</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9792>
        rdf:type                 schema:Claim;
        schema:abstract          "“The bottom line is this: any climate legislation that fails to meaningfully reduce the human impact on the climate or does so in an economically unsustainable manner, can’t be effective,” Alford said. “Under the House bill, American consumers and businesses would take on a heavy burden. This burden would fall at exactly the wrong time.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9792/source/69>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/harry-c-alford/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/harry-c-alford/" .

<http://data.open.ac.uk/climate-sense/claim/9791/source/64>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160816180649/https://oversight.house.gov/wp-content/uploads/2012/02/Testimony_-_Alford_2011_0210.pdf\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Testimony of Harry C. Alford on Behalf of the National Black Chamber of Commerce (NBCC) Before the House Committee on Oversight and Government Reform” (PDF)</a>, National Black Chamber of Commerce, February 10, 2011. Archived .pdf on file at Desmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9791>
        rdf:type                 schema:Claim;
        schema:abstract          "“Now is the time to dust ourselves off and get back to work,” Alford’s testimony reads. “We must learn from this incident and not be afraid to move forward with domestic energy production.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9791/source/64>;

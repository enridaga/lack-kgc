        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/john-coleman/" .

<http://data.open.ac.uk/climate-sense/claim/4220/source/18>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"http://web.archive.org/web/20160218200230/http://ftpcontent.worldnow.com/kusi/Comments+on+Global+Warming02.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Global Warming Comments by John Coleman” (PDF)</a>, <em>KUSI News</em>. Archived February 18, 2016. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/4220>
        rdf:type                 schema:Claim;
        schema:abstract          "“Environmental extremist, notable politicians among them then teamed up with movie, media and other liberal, environmentalist journalists to create this wild ‘scientific’ scenario of the civilization threatening environmental consequences from Global Warming unless we adhere to their radical agenda.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4220/source/18>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/john-coleman/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160304193425/http://prfamerica.org/speeches/10th/EnvironmentalismConsequences.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Environmentalism and Its Consequences</a>,” Property Rights Foundation of America, October 14, 2006. Archived March 4, 2016. WebCite URL: <a href=\"http://www.webcitation.org/6flPmpkmx\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://www.webcitation.org/6flPmpkmx</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/635>
        rdf:type                 schema:Claim;
        schema:abstract          "“[T]he banning of DDT and the similar regulations were something which were not based on available scientific evidence, so too is the environmental vision being imposed on rural America itself, contrary to how nature really works. ”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/635/source/25>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/bonner-cohen/>;

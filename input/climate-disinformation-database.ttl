<http://data.open.ac.uk/climate-sense/claim/3465/source/56>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20170226020825/http://fuelingfreedomproject.com/tppf-statement-on-removal-of-energy-subsidies-from-faa-reauthorization-bill/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">TPPF STATEMENT ON REMOVAL OF ENERGY SUBSIDIES FROM FAA REAUTHORIZATION BILL</a>,”<em> Fueling Freedom</em>. April 19, 2016. Archived February 26, 2017. Archive.is URL: <a href=\"https://archive.is/E01Hi\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/E01Hi</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3465>
        rdf:type                 schema:Claim;
        schema:abstract          "“We are pleased that leadership in the U.S. Senate removed the troublesome tax incentives and credits attached to the FAA Reauthorization bill,” said Doug Domenech. “Energy production in America should be based on the free market, not artificially propped up in ways that mask the real cost to the consumer and the taxpayer.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3465/source/56>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;
        schema:claimInterpreter  <http://desmog.com/>;

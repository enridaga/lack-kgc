        rdf:type         schema:CreativeWork;
        schema:citation  "Gayathri Vaidyanathan. “<a href=\"http://web.archive.org/web/20161111000552/http://www.eenews.net/stories/1060041292\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">How to get a skeptic to believe in climate change? Scientists are studying that</a>,” <em>E&amp;E News</em>, August 8, 2016. Archived November 10, 2016. Arhive.is URL:&nbsp;<a href=\"https://archive.is/GXmE6\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/GXmE6</a>"^^rdf:HTML .


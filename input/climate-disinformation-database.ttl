<http://data.open.ac.uk/climate-sense/claim/8305/source/159>
        rdf:type         schema:CreativeWork;
        schema:citation  "Alex Epstein. “<a href=\"http://www.forbes.com/sites/alexepstein/2015/09/17/jerry-brownout/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Jerry Burnout</a>,”&nbsp;<em>Forbes</em>, September 17, 2015. Archive.is URL:&nbsp;<a href=\"https://archive.is/zoiXL\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/zoiXL</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/8305>
        rdf:type                 schema:Claim;
        schema:abstract          "“Energy abundance is essential to climate livability—since the natural climate is inherently variable, volatile, and vicious. And oil and other fossil fuels do infinitely more to make it safer than make it more dangerous. This has been proven and documented—there has been a 98% decline in the rate of climate-related deaths since significant global ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8305/source/159>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/alex-epstein/>;

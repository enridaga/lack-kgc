<http://data.open.ac.uk/climate-sense/claim/3512/source/24>
        rdf:type         schema:CreativeWork;
        schema:citation  "Peter Lilley. “<a href=\"https://www.wsj.com/articles/SB10001424052748704238104574601762696721506\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Global Warming as Groupthink</a>,” <em>Wall Street Journal</em>, December 17, 2009. Archive.fo URL: <a href=\"https://archive.fo/aiCuj#selection-4093.0-4093.242\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/aiCuj</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3512>
        rdf:type                 schema:Claim;
        schema:abstract          "“The tendency of those committed to the theory of catastrophic man-made global warming to unquestioningly adopt the assumptions, at every stage, that maximize the expectation of calamity should alert us that groupthink is driving the&nbsp;movement.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3512/source/24>;

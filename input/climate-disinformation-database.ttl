        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s1\" href=\"http://www.exxonsecrets.org/html/orgfactsheet.php?id=65\" target=\"_blank\" rel=\"noopener external noreferrer\" name=\"s1\" data-wpel-link=\"external\">ExxonSecrets Factsheet: Science and Environmental Policy Project, SEPP </a>."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10089>
        rdf:type                 schema:Claim;
        schema:abstract          "“Global agriculture will likely benefit from climate warming and increased precipitation; increased CO2 leads to more rapid plant growth; increased nocturnal and winter warming leads to a longer growing season. Farmers can and will adjust to climate changes.”";

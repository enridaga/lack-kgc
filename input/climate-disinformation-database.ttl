<http://data.open.ac.uk/climate-sense/claim/3462/source/65>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20170226032542/http://dailycaller.com/2016/06/08/did-you-burn-any-fossil-fuels-today/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Did You Burn Any Fossil Fuels Today?</a>” <em>Daily Caller</em>, June 8, 2016. Archived February 26, 2017. Archive.is URL: <a href=\"https://archive.is/aJnOn\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/aJnOn</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3462>
        rdf:type                 schema:Claim;
        schema:abstract          "“The policies of the United States should not doom third world countries to a lifetime of poverty. Allowing everyone to unleash the potential prosperity and health generated by fossil fuels is how we transform society. Everyone deserves to have the same benefits we enjoy.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3462/source/65>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/doug-domenech/>;

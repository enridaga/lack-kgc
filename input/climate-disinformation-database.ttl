        rdf:type         schema:CreativeWork;
        schema:citation  "Helena Horton. “<a href=\"https://www.theguardian.com/environment/2022/jul/19/kemi-badenoch-moves-away-from-net-zero-by-2050-in-double-climate-u-turn\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Kemi Badenoch moves away from net zero by 2050, in double climate U-turn</a>,” <em>The Guardian</em>, July 19, 2022. <a href=\"https://web.archive.org/web/20241001072350/https://www.theguardian.com/environment/2022/jul/19/kemi-badenoch-moves-away-from-net-zero-by-2050-in-double-climate-u-turn\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived October 1, 2024.</a> Archive URL: <a href=\"https://archive.is/p6HvM\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/p6HvM</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9926>
        rdf:type                 schema:Claim;
        schema:abstract          "“Practically none of us will still be here for us to be held accountable for it […] what would happen if we moved it to 2060 or 2070? We’re not going to be here. Let’s be realistic.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9926/source/14>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kemi-badenoch/>;

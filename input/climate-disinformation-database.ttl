        rdf:type                 schema:Claim;
        schema:abstract          "“More and more people are realising that green taxes have nothing to do with being green. They’re just an excuse to tax us more.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8514/source/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Joe Pounder. “<a href=\"http://www.definersdc.com/#!Welcome-To-Definers/xg28x/577be6af0cf2a27045ee82a8\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Welcome To Definers</a>,” <em>Definers Public Affairs</em>, July 5, 2016. Archived .pdf on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12685>
        rdf:type                 schema:Claim;
        schema:abstract          "As we built America Rising into a 60-person operation with employees across the country, we were actually turning away corporate clients so we could focus exclusively on our political mission. In 2015, we changed that and formed&nbsp;Definers.&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12685/source/20>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/america-rising-llc-pac-america-rising-squared-definers-public-affairs/>;

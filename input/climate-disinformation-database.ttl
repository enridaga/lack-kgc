<http://data.open.ac.uk/climate-sense/claim/6106/source/42>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180417011839/https://steyerville.com/what-is-steyerville/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">What Is Steyerville?</a>” <em>Steyerville</em>. Archived April 16, 2018. Archive.is URL: <a href=\"https://archive.li/dVEY9\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.li/dVEY9</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6106>
        rdf:type                 schema:Claim;
        schema:abstract          "“And we named it Steyerville to make it clear: he destroyed this community. Tom Steyer and the billionaire funders like him: Mike Bloomberg, George Soros, and countless Hollywood elites, who paid activists and phony protesters to pressure political leaders to enact their agenda. The activists left, the protesters are gone, and destroyed communities Tom Steyer cannot find on a map nor would Mike Bloomberg deign to land his private jet near suffer the consequences of their activism. He built this, and so we named it after him, to hold him accountable, to shame him for his actions, and to hopefully stop him from doing it again,” the website&nbsp;announced.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6106/source/42>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/power-future/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/power-future/" .

<http://data.open.ac.uk/climate-sense/claim/6105/source/42>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180417011839/https://steyerville.com/what-is-steyerville/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">What Is Steyerville?</a>” <em>Steyerville</em>. Archived April 16, 2018. Archive.is URL: <a href=\"https://archive.li/dVEY9\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.li/dVEY9</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6105>
        rdf:type                 schema:Claim;
        schema:abstract          "“We made Steyerville to put these communities- literally and figuratively- on the map. The site is well researched and documented, and will continue to grow to highlight the damage Tom Steyer is doing to rural&nbsp;America";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6105/source/42>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/power-future/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/power-future/" .

<http://data.open.ac.uk/climate-sense/claim/6104/source/42>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180417011839/https://steyerville.com/what-is-steyerville/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">What Is Steyerville?</a>” <em>Steyerville</em>. Archived April 16, 2018. Archive.is URL: <a href=\"https://archive.li/dVEY9\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.li/dVEY9</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6104>
        rdf:type                 schema:Claim;
        schema:abstract          "“Steyerville is a real place in the American heartland: a rural community where multiple generations of men and women worked in the same industry: energy. Coal miners in Appalachia or Navajo Natives in New Mexico. Oil workers in the Louisiana Bayou or the central valley of California. These close-knit communities produce the energy that fuels our entire way of life. But their livelihood was&nbsp;taken.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6104/source/42>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/power-future/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/power-future/" .


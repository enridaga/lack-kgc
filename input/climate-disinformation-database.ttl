        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20210427235803/https://mikerowe.com/2016/10/the-worst-place-in-the-universe/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">The Worst Place in the Universe</a>,” <em>Mike Rowe</em>, October 31, 2016. Archived April 27, 2021. Archive URL: <a href=\"https://archive.ph/IL3pO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/IL3pO</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10032>
        rdf:type                 schema:Claim;
        schema:abstract          "“’Because Global Warming is real, and man is causing it. And our planet is in terrible trouble.’";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10032/source/28>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/mike-rowe/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“Ocean acidification was just it was a made up terminology used to scare people. And the people that did it have admitted to&nbsp;that.”&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4311/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/gregory-wrightstone/>;

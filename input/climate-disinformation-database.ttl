        rdf:type                 schema:Claim;
        schema:abstract          "“Four hundred years ago, people were burnt at the stake for believing the wrong things about religion. Today, they get fired for questioning the climate-change catechism.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4244/source/>;

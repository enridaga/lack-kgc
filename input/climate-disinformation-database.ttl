        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20120505074350/http://www.pacificresearch.org/press/inconvenient-truth-or-convenient-fiction-sorting-out-sense-from-nonsense-on-global-warming\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Inconvenient Truth or Convenient Fiction: Sorting out Sense from Nonsense on Global Warming</a>,” Pacific Research Institute, August 24, 2007. Archived May 5, 2012. Archive.is URL: <a href=\"https://archive.is/zGPMD\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/zGPMD</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1971>
        rdf:type                 schema:Claim;
        schema:abstract          "“The planet is warming. Human beings are playing a substantial role in that warming. How large that warming is going to be and how we ought to respond to it is still an open question.”";

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20191011173311/https://www.ipaa.org/fracking/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">HYDRAULIC FRACTURING</a>,” <em>IPAA</em>. Archived October 11, 2019. Archive URL: <a href=\"https://archive.fo/ZG9vI\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/ZG9vI</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3258>
        rdf:type                 schema:Claim;
        schema:abstract          "“Fracking is a uniquely American success story that has provided immense benefits around the nation. By safely unlocking America’s abundant natural resources, fracking has created millions of American jobs, reduced energy prices, brought cleaner air by significantly reducing U.S. greenhouse gas emissions to 25-year-lows, strengthened our national security, and transformed the United States into a global energy superpower,” IPAA claims on its website.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3258/source/13>;

<http://data.open.ac.uk/climate-sense/claim/12845/source/92>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20200701040534/http://www.ecomodernism.org/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">AN&nbsp;ECOMODERNIST MANIFESTO</a>,” Ecomodernism.org. Archived June 30, 2020. Archive URL: <a href=\"https://archive.vn/uZIuC\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/uZIuC</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12845>
        rdf:type                 schema:Claim;
        schema:abstract          "“We offer this statement in the belief that both human prosperity and an ecologically vibrant planet are not only possible, but also inseparable. By committing to the real processes, already underway, that have begun to decouple human well-being from environmental destruction, we believe that such a future might be achieved. As such, we embrace an optimistic view toward human capacities and the future.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12845/source/92>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/michael-shellenberger/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/michael-shellenberger/" .

<http://data.open.ac.uk/climate-sense/claim/12844/source/93>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20200701040534/http://www.ecomodernism.org/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">AN&nbsp;ECOMODERNIST MANIFESTO</a>,” Ecomodernism.org. Archived June 30, 2020. Archive URL: <a href=\"https://archive.vn/uZIuC\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/uZIuC</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12844>
        rdf:type                 schema:Claim;
        schema:abstract          "Meaningful climate mitigation is fundamentally a technological challenge. By this we mean that even dramatic limits to per capita global consumption would be insufficient to achieve significant climate mitigation. Absent profound technological change there is no credible path to meaningful climate mitigation. While advocates differ in the particular mix of technologies they favor, we are&nbsp;aware of no quantified climate mitigation scenario in which technological change is not responsible for the vast majority of emissions cuts.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12844/source/93>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/michael-shellenberger/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/michael-shellenberger/" .

<http://data.open.ac.uk/climate-sense/claim/12843/source/93>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20200701040534/http://www.ecomodernism.org/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">AN&nbsp;ECOMODERNIST MANIFESTO</a>,” Ecomodernism.org. Archived June 30, 2020. Archive URL: <a href=\"https://archive.vn/uZIuC\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/uZIuC</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12843>
        rdf:type                 schema:Claim;
        schema:abstract          "“Climate change and other global ecological challenges are not the most important immediate concerns for the majority of the world’s people. Nor should they be. A new coal-fired power station in Bangladesh may bring air pollution and rising carbon dioxide emissions but will also save lives. For millions living without light and forced to burn dung to cook their food, electricity and modern fuels, no matter the source, offer a pathway to a better life, even as they also bring new environmental&nbsp;challenges.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12843/source/93>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/michael-shellenberger/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/michael-shellenberger/" .


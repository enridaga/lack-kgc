        rdf:type                 schema:Claim;
        schema:abstract          "“So what strikes me most about the Heartland Conference is that I am with people that are in love with weather, climate, and their country, and many of them have loved these longer and stronger than I have.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6488/source/>;

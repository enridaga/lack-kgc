        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20210908035434/https://www.discovery.org/m/securepdfs/2021/07/Scientific-Dissent-from-Darwinism-List-07152021.pdf\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">A Scientific Dissent from Darwinism</a>” (PDF), <em>Discovery Institute</em>, May 2021."^^rdf:HTML .


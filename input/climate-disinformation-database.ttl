<http://data.open.ac.uk/climate-sense/claim/7570>
        rdf:type                 schema:Claim;
        schema:abstract          "“In the 1980s a small group of individuals became concerned about the Earth’s temperature and what it might do in the future. I hesitate to call them scientists because they have abandoned their scientific principals by which their guess about temperature increases and the cause could achieve scientific acceptance or rejection.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7570/source/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20160510174711/http://www.tertiumquids.org/freedom-and-prosperity-radio.html\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Freedom &amp; Prosperity Radio,</a>” Tertium Quids. Archived May 10, 2016. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7910>
        rdf:type                 schema:Claim;
        schema:abstract          "“Dr. Charles Battig discusses: the positive effects of carbon dioxide without which plants would die closely followed by the human race; and how according to the satellite data, there has been no global warming for the last 18 years. Dr. Battig also asks if the environmentalists are so certain of their positions, why do they: refuse to debate, make personal attacks on opponents, refuse to release their data, and try to limit the freedom of speech of those who disagree with them. Aren’t these actions more typical of the side that realizes it holds a losing hand? Of what are they afraid other than losing their federal research bribes, er, grants?” reads the event program.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7910/source/26>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/charles-battig/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/charles-battig/" .


        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s10\" href=\"https://www.iea.org/publications/insights/insightpublications/global_value_of_coal.pdf\" name=\"s10\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“The Global Value of Coal” (PDF)</a>,<em> International Energy Agency</em>, 2012. <a href=\"//www.desmog.com/wp-content/uploads/files/global_value_of_coal.pdf\" target=\"_blank\" rel=\"noopener external noreferrer\" data-wpel-link=\"external\">Archived .pdf </a>on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13446>
        rdf:type                 schema:Claim;
        schema:abstract          "“The purpose of this paper is to highlight for policy makers the value of coal to world economic and social development and so encourage development of a policy environment that will allow the coal and electricity industries to make the necessary investments in production capacity and CO2 emissions reduction technologies.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13446/source/41>;

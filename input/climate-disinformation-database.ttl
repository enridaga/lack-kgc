<http://data.open.ac.uk/climate-sense/claim/10194>
        rdf:type                 schema:Claim;
        schema:abstract          "“In dealing with important issues in the past, we’ve been most effective when we’ve kept a clear focus on our common interest. The coalition we formed to defeat with Btu tax is an excellent example.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10194/source/49>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20200529210208/https://junkscience.com/2020/05/monckton-naomi-seibt-the-anti-greta-needs-your-financial-support-now/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Monckton: Naomi Seibt, the anti-Greta, needs your financial support now</a>,” <em>JunkScience.com</em>, May 18, 2020. Archived May 29, 2020. Archive URL: <a href=\"https://archive.vn/O7YA3\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.vn/O7YA3</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5298>
        rdf:type                 schema:Claim;
        schema:abstract          "As a result of this arbitrary and capricious prosecution and conviction without trial, Naomi has had her earnings cut off. Please donate securely and directly to her Patreon account at https://www.patreon.com/naomiseibtmy. May I suggest at least $10 per month? That would be a real life-saver, and would enable Naomi to continue her valuable work.”";

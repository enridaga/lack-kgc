        schema:url               "https://www.desmog.com/tech-central-station/" .

<http://data.open.ac.uk/climate-sense/claim/12803/source/6>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20000815065009/http://www.techcentralstation.com:80/About.asp\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">About Tech Central Station</a>,” <em>Tech Central Station</em>. Archived August 15, 2000. Archive.is URL: <a href=\"https://archive.is/CDhd7\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/CDhd7</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12803>
        rdf:type                 schema:Claim;
        schema:abstract          "“For too long, silicontrepreneurs have contemplated a false choice: ignore Washington or else descend into Gucci Gulch and behave just like old-fashioned special interests. Either stick to the business of making great products or else join the old game of pleading for special favors and urging restrictions on the competition. But there is another option – to promote an optimistic high-tech agenda of freedom and opportunity, with no apologies.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12803/source/6>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/tech-central-station/>;

        rdf:type                 schema:Claim;
        schema:abstract          "“There is a way for Nevada to fight back. Every business owner and electricity consumer in Nevada should encourage both Gov. Brian Sandoval and Attorney General Adam Laxalt to join 27 other states and fight the Clean Power Plan in federal court.” — Michael Schaus, ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12816/source/28>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/franklin-centre-government-and-public-integrity/>;

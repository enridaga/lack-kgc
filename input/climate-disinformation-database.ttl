        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://www.epw.senate.gov/public/index.cfm/hearings?ID=E8D6A0C3-982E-2AFA-F53D-131EA566818B\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">UPDATED&nbsp;TIME: Subcommittee on Oversight hearing entitled, ‘</a><a href=\"https://www.epw.senate.gov/public/index.cfm/hearings?ID=E8D6A0C3-982E-2AFA-F53D-131EA566818B\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Natural Resource Adaptation: Protecting Ecosystems and Economies’,</a>“&nbsp;<em>U.S.&nbsp;Senate Committee on Environment and Public Works</em>, February 24, 2014. Archived March 13, 2019. Archived .mp4 on file at Desmog. Archive&nbsp;URL:&nbsp;&nbsp;<a href=\"https://archive.fo/88fMS\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/88fMS</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11861>
        rdf:type                 schema:Claim;
        schema:abstract          "“Today, we live in an unusually cold period in the history of life on Earth and there is no reason to believe that a warmer climate would be anything but beneficial for humans and the majority of other species…It is “extremely likely” that a warmer temperature than today’s would be far better than a cooler one.”";

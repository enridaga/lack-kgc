<http://data.open.ac.uk/climate-sense/claim/7412/source/33>
        rdf:type         schema:CreativeWork;
        schema:citation  "Hymie Rubenstein. “<a href=\"https://web.archive.org/web/20171111041847/https://c2cjournal.ca/2017/11/the-myth-of-indigenous-utopia/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The myth of indigenous utopia</a>,” <em>C2C Journal</em>, November 8, 2017. Archived November 11, 2017. Archive URL: <a href=\"https://archive.ph/tAe4M\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/tAe4M</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7412>
        rdf:type                 schema:Claim;
        schema:abstract          "“Warts and all, no country has ever done more for its indigenous people. And Professor [Niigaan] Sinclair’s haughty claims to aboriginal moral superiority over European savagery have no foundation in Canadian history.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7412/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/manning-foundation-for-democratic-education/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/manning-foundation-for-democratic-education/" .

<http://data.open.ac.uk/climate-sense/claim/7411/source/34>
        rdf:type         schema:CreativeWork;
        schema:citation  "Gwyn Morgan. “<a href=\"https://web.archive.org/web/20200616224826/https://c2cjournal.ca/2020/02/wheres-the-veto-for-common-sense/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Where’s the Veto for Common Sense?</a>,” <em>C2C Journal</em>, February 4, 2020. Archived June 16, 2020. Archive URL: <a href=\"https://archive.ph/77D6e\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/77D6e</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7411>
        rdf:type                 schema:Claim;
        schema:abstract          "“The melodrama of endless litigation must not be allowed to continue. But what is the Trudeau government doing to improve the process of gaining Aboriginal consent? Absolutely nothing. In fact, it has compounded the problem by adopting the United Nations Declaration on the Rights of Indigenous People (UNDRIP). UNDRIP requires ‘free, prior and informed consent’ regarding ‘legislative or administrative measures that may affect Indigenous peoples, including approval of any project affecting their lands or territories and other resources.’";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7411/source/34>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/manning-foundation-for-democratic-education/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/manning-foundation-for-democratic-education/" .

<http://data.open.ac.uk/climate-sense/claim/7410/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7410>
        rdf:type                 schema:Claim;
        schema:abstract          "“If followed, this amounts to an aboriginal veto over nearly any development, and an at-times-tiny minority-within-a-minority would be able to nix projects that other Indigenous groups favoured.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7410/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/manning-foundation-for-democratic-education/>;

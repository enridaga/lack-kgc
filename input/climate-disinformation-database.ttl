<http://data.open.ac.uk/climate-sense/claim/10040>
        rdf:type                 schema:Claim;
        schema:abstract          "“The theory that we caused the global warming with our emissions of carbon dioxide is based on two assumptions (guesses), made in the early 1980s when there was insufficient data. One assumption has since been disproved, and the second is looking dubious.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10040/source/24>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/david-evans/>;

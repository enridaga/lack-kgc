        rdf:type         schema:CreativeWork;
        schema:citation  "(Press Release). “<a href=\"https://web.archive.org/web/20210920202253/https://aapsonline.org/attack-on-coal-will-not-save-lives-states-aaps/\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Attack on Coal Will Not Save Lives, States AAPS</a>,” <em>Association of American Physicians and Surgeons</em>, September 20, 2014. Archived September 20, 2021. Archive URL: <a href=\"https://archive.ph/iYlEN\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.ph/iYlEN</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12988>
        rdf:type                 schema:Claim;
        schema:abstract          "“The adverse health effects of Obama’s promised skyrocketing of the costs of electricity, not to mention unemployment, are simply being ignored.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12988/source/27>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/jane-m-orient/>;

<http://data.open.ac.uk/climate-sense/claim/12562/source/84>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20161222233521/http://www.heritage.org/events/2016/12/at-the-crossroads-iii\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">At the Crossroads III: Energy and Climate Policy Summit,</a>” Heritage Foundation, December 8, 2016. Archived December 22, 2016. Archive.is URL: <a href=\"https://archive.is/AKaKq\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/AKaKq</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12562>
        rdf:type                 schema:Claim;
        schema:abstract          "Speaking of his 2003 paper: “Actually, I didn’t really want to write this paper. But as a professional scientist, the phenomenon that happened in between, let’s say, 2001 to 2003 is highly strange. When you tried to publish a paper at those times, if you don’t cite those famous papers like the famous hockey stick paper properly, and you will actually be taken to task, rather seriously actually, or else your paper will be rejected. This is the kind of coercion that should not be allowed in open science. But unfortunately they prevailed, so I decided I had to do something about it and so I wrote a paper.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12562/source/84>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/willie-soon/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/willie-soon/" .

<http://data.open.ac.uk/climate-sense/claim/12561/source/84>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20161222233521/http://www.heritage.org/events/2016/12/at-the-crossroads-iii\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">At the Crossroads III: Energy and Climate Policy Summit,</a>” Heritage Foundation, December 8, 2016. Archived December 22, 2016. Archive.is URL: <a href=\"https://archive.is/AKaKq\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/AKaKq</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12561>
        rdf:type                 schema:Claim;
        schema:abstract          "“I have never said this in public, so I’ll say it for the first time: that ultimately, that version that published in Climate Research was a hoax. […] It is really as if I give a damn about having another paper in publication.” ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12561/source/84>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/willie-soon/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/willie-soon/" .

<http://data.open.ac.uk/climate-sense/claim/12560/source/84>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20161222233521/http://www.heritage.org/events/2016/12/at-the-crossroads-iii\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">At the Crossroads III: Energy and Climate Policy Summit,</a>” Heritage Foundation, December 8, 2016. Archived December 22, 2016. Archive.is URL: <a href=\"https://archive.is/AKaKq\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/AKaKq</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12560>
        rdf:type                 schema:Claim;
        schema:abstract          "“I’m sick and tired of this system of collusion and coercions.” ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12560/source/84>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/willie-soon/>;

<http://data.open.ac.uk/climate-sense/claim/8726>
        rdf:type                 schema:Claim;
        schema:abstract          "“[…] So, has global warming really stopped? We will know for sure in just a few years.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/8726/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/s-fred-singer/>;

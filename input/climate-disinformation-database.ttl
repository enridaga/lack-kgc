<http://data.open.ac.uk/climate-sense/claim/6107>
        rdf:type                 schema:Claim;
        schema:abstract          "“There’s a tremendous arrogance in these activists… Just a few months ago they all flew to Paris to demand we cut back on using energy. Either none of them have Skype or they think good intentions fuel their&nbsp;planes.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6107/source/46>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/power-future/>;
        schema:claimInterpreter  <http://desmog.com/>;

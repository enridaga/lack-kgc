<http://data.open.ac.uk/climate-sense/claim/12078/source/33>
        rdf:type         schema:CreativeWork;
        schema:citation  "Jeff Kucharski. “<a href=\"https://financialpost.com/opinion/resource-exports-bring-leverage-as-well-as-jobs-and-income\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Resource exports bring leverage as well as jobs and income</a>,” <em>Financial Post</em>, March 17, 2020. Archive URL: <a href=\"https://archive.ph/q3yxb\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/q3yxb</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12078>
        rdf:type                 schema:Claim;
        schema:abstract          "“There is also a humanitarian case to be made for exporting our resources. As economies develop, they need energy resources like oil, natural gas, uranium, and rare earth elements. These are strategic resources: they are relatively scarce, are located only in certain regions, and are vital for economies to grow and thrive.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12078/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/macdonald-laurier-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/macdonald-laurier-institute/" .

<http://data.open.ac.uk/climate-sense/claim/12077/source/33>
        rdf:type         schema:CreativeWork;
        schema:citation  "Jeff Kucharski. “<a href=\"https://financialpost.com/opinion/resource-exports-bring-leverage-as-well-as-jobs-and-income\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Resource exports bring leverage as well as jobs and income</a>,” <em>Financial Post</em>, March 17, 2020. Archive URL: <a href=\"https://archive.ph/q3yxb\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/q3yxb</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12077>
        rdf:type                 schema:Claim;
        schema:abstract          "“Canadian strategic energy resources can help: address energy poverty; reduce the global impact of climate change (by replacing supplies from authoritarian regimes with much lower ethical and environmental standards); lower GHG emissions by replacing coal with cleaner natural gas; and provide a stable source of the rare earth elements that are essential to producing cutting-edge clean energy technologies.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12077/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/macdonald-laurier-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/macdonald-laurier-institute/" .

<http://data.open.ac.uk/climate-sense/claim/12076/source/33>
        rdf:type         schema:CreativeWork;
        schema:citation  "Jeff Kucharski. “<a href=\"https://financialpost.com/opinion/resource-exports-bring-leverage-as-well-as-jobs-and-income\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Resource exports bring leverage as well as jobs and income</a>,” <em>Financial Post</em>, March 17, 2020. Archive URL: <a href=\"https://archive.ph/q3yxb\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/q3yxb</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12076>
        rdf:type                 schema:Claim;
        schema:abstract          "“For these reasons, in addition to the obvious and more often mentioned economic case for Canadian energy exports, our governments, both federal and provincial, need to focus more intensively on how to make our resource exports available to an area of the world whose recent growth has been so impressive and whose growth potential remains substantial.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12076/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/macdonald-laurier-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/macdonald-laurier-institute/" .

<http://data.open.ac.uk/climate-sense/claim/12075/source/42>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://web.archive.org/web/20220530230053/https://macdonaldlaurier.ca/cm-expert/jp-gladu/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">JP Gladu</a>,” <em>MLI</em>. Archived May 30, 2022. Archive URL: <a href=\"https://archive.ph/FBYQp\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/FBYQp</a>"^^rdf:HTML .


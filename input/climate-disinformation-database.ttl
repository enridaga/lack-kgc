        schema:url               "https://www.desmog.com/roy-spencer/" .

<http://data.open.ac.uk/climate-sense/claim/10861/source/22>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a name=\"s12\"></a>Wendy Reeves. “<a href=\"http://web.archive.org/web/20070422025557/http://www.al.com/news/huntsvilletimes/index.ssf?/base/news/1176974192195090.xml&amp;coll=1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Scientist: Warming not caused by humans</a>,” <em>The Huntsville Times</em>, April 19, 2007. Archived April 22, 2007. Archive.is URL: <a href=\"https://archive.is/tFEZC\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/tFEZC</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10861>
        rdf:type                 schema:Claim;
        schema:abstract          "“We see something change in our climate and we blame ourselves . . . I don’t think we understand what happens. We can watch it happen on the (climate) models, we know it happens, but we don’t know for sure how it happens.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10861/source/22>;

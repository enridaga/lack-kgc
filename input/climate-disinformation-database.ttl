        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/gina-rinehart/" .

<http://data.open.ac.uk/climate-sense/claim/732/source/23>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.youtube.com/watch?v=h-hfaN-xNnM\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Gina Rinehart – The Power of One – Four Corners</a>,” YouTube video uploaded by user “liberalcynic,” june 25, 2012. Archived .mp4 on file at&nbsp;DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/732>
        rdf:type                 schema:Claim;
        schema:abstract          "“To lessen the fear the media have caused over these issues, Mrs Rinehart suggests that the media should also permit to be published that climate change has been occurring naturally since the earth began, not just the views of the climate extremists. It is a fact that there have been ice ages, then periods of global warming to end the ice ages,&nbsp;for thousands of years, and these have occurred naturally, including due to the earth’s orbit, and not due to mankind at all.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/732/source/23>;

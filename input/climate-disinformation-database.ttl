        rdf:type         schema:CreativeWork;
        schema:citation  "Ezra Levant. “<a href=\"http://web.archive.org/web/20170823184606/https:/www.therebel.media/ezra_levant_august_22_2017\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">SPECIAL: The future of The Rebel — Will you stand with us?</a>” <em>The Rebel</em>, August 23, 2017. Archived August 23, 2017. Archive.is URL: <a href=\"https://archive.is/PAWKC\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/PAWKC</a>"^^rdf:HTML .


        rdf:type         schema:CreativeWork;
        schema:citation  "Molly Christian. “US Senate energy panel brainstorms climate action strategies,” <em>ClimateWire, </em>March 13, 2019."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6777>
        rdf:type                 schema:Claim;
        schema:abstract          "At the hearing, Manchin “repeated figures from the federal government’s fourth&nbsp;national climate assessment&nbsp;showing that the U.S. has experienced 44 climate and weather-related disasters since 2015 at a total cost of over $400 billion. But the coal-state lawmaker said any solutions to the problem ‘must be grounded in reality, which requires a recognition that fossil fuels aren’t going anywhere anytime soon.'” ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6777/source/33>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-manchin/>;

        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/fred-palmer/" .

<http://data.open.ac.uk/climate-sense/claim/9205/source/112>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s26\" href=\"https://www.scribd.com/document/235382157/EPA-Hearing-Testimony-FDP-072914\" name=\"s26\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“Submitted Testimony by Fredrick D. Palmer Peabody Energy Senior Vice President of Government Relations U.S. Environmental Protection Agency Clean Power Plan Proposed Rule Washington, D.C” (PDF)</a>, <em>Peabody Energy</em>, July 29, 2014. Retrieved from Scribd. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9205>
        rdf:type                 schema:Claim;
        schema:abstract          "“Peabody has a profound disagreement with EPA’s approach on carbon under the Clean Air Act. We are opposed to any proposal that would punish electricity consumers, have no material benefit under climate theory and act outside the bounds of the law,” Palmer wrote in his testimony. “This proposal must be withdrawn.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9205/source/112>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/fred-palmer/>;

<http://data.open.ac.uk/climate-sense/claim/5099/source/20>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.huffpost.com/entry/i-was-manhandled-by-a-koc_b_7949114\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">I Was Manhandled by a Koch Capo</a>,” <em>HuffPost</em>, August 6, 2015. <a href=\"http://web.archive.org/web/20190522211718/https://www.huffpost.com/entry/i-was-manhandled-by-a-koc_b_7949114\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 22, 2019</a>. Archive.fo URL: <a href=\"https://archive.fo/VhoqB\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/VhoqB</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5099>
        rdf:type                 schema:Claim;
        schema:abstract          "“Kevin Gentry walked over, positioning himself in such a way as to block my ability to approach the private dining room door. He faux-congenially asked my name, and then pretended not to be Kevin Gentry, although I identified him immediately. As I saw Charles Koch exit into the bar area surrounded by a phalanx of security, I walked towards him, and Gentry grabbed my arm, forcibly detaining me,” Lauren Windsor wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5099/source/20>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kevin-gentry/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/kevin-gentry/" .

<http://data.open.ac.uk/climate-sense/claim/5098/source/21>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"https://www.huffpost.com/entry/i-was-manhandled-by-a-koc_b_7949114\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">I Was Manhandled by a Koch Capo</a>,” <em>HuffPost</em>, August 6, 2015. <a href=\"http://web.archive.org/web/20190522211718/https://www.huffpost.com/entry/i-was-manhandled-by-a-koc_b_7949114\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived May 22, 2019</a>. Archive.fo URL: <a href=\"https://archive.fo/VhoqB\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/VhoqB</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5098>
        rdf:type                 schema:Claim;
        schema:abstract          "“They had been shaking hands, when this whole scene went into motion. He crushed her hand and twisted her wrist, also forcibly detaining her. Tara’s hand and wrist were hurt and incredibly sore. Gentry and Davis laughed off her injury.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/5098/source/21>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/kevin-gentry/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "Bonner R. Cohen. “<a href=\"https://web.archive.org/web/20190925203136/https://www.heartland.org/news-opinion/news/declining-government-support-for-electric-vehicles-could-boost-global-oil-demand-report-states\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Declining Government Support for Electric Vehicles Could Boost Global Oil Demand, Report States</a>,” <em>The Heartland Institute</em>, September 19, 2019. Archived September 25, 2019. Archive.is URL: <a href=\"https://archive.is/4lUkR\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/4lUkR</a>"^^rdf:HTML .


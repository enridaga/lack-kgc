        rdf:type                 schema:Claim;
        schema:abstract          "“Pursuing net zero is not a growth strategy; it is, to borrow from Michael Porter, a choice not to prioritise economic growth. The structural adjustments required of net zero are colossal and will involve pain, particularly for people on low incomes and those losing their jobs in the transition”.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/4243/source/>;

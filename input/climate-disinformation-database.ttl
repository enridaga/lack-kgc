        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7407>
        rdf:type                 schema:Claim;
        schema:abstract          "“As immeasurably tragic as every single murder is, the numbers in question are orders of magnitude smaller than any genocide ever documented.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7407/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/manning-foundation-for-democratic-education/>;

<http://data.open.ac.uk/climate-sense/claim/7408/source/36>
        rdf:type         schema:CreativeWork;
        schema:citation  "Brian Giesbrecht. “<a href=\"https://web.archive.org/web/20230303225521/https://c2cjournal.ca/2019/07/the-battle-for-the-bruce/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The Battle for the Bruce</a>,” <em>C2C Journal</em>, July 13, 2019. Archived March 3, 2023. Archive URL: <a href=\"https://archive.ph/L3kfL\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/L3kfL</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7408>
        rdf:type                 schema:Claim;
        schema:abstract          "“As difficult as it may be to conceive, however, the prospect of handing over a massive swath of popular public lands along with a fabulous sum of money to a local Indigenous population of approximately 1,500 is not the greatest threat this case poses to Canada. At the risk of running out of superlatives, this particular land claim threatens far greater damage by striking at the very foundation of the Canadian system of private property ownership.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7408/source/36>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/manning-foundation-for-democratic-education/>;
        schema:claimInterpreter  <http://desmog.com/>;

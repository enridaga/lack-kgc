        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/david-legates/" .

<http://data.open.ac.uk/climate-sense/claim/11157/source/43>
        rdf:type         schema:CreativeWork;
        schema:citation  "Rebecca Hersher. “<a href=\"http://web.archive.org/web/20200915181549/https://www.npr.org/2020/09/12/912301325/longtime-climate-science-denier-hired-at-noaa\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Longtime Climate Science Denier Hired At NOAA</a>,” <em>NPR</em>, September 12, 2020. Archived September 15, 2020. Archive URL:<a href=\"https://archive.vn/IfxrA\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.vn/IfxrA</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11157>
        rdf:type                 schema:Claim;
        schema:abstract          "“He’s not just in left field — he’s not even near the ballpark,” said Jane Lubchenco, a professor of marine biology at Oregon State University and head of NOAA under President Barack Obama.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11157/source/43>;

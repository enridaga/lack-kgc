        schema:citation  "Matthew Brown. “<a href=\"https://www.apnews.com/abaee2a70c394ab5afc449a1489a2fd6\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">US to ease oil drilling controls protecting imperiled bird</a>,” <em>AP</em>, December 6, 2018. <a href=\"http://web.archive.org/web/20181217233628/https://www.apnews.com/abaee2a70c394ab5afc449a1489a2fd6\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">Archived December 17, 2018</a>. Archive.fo URL: <a href=\"https://archive.fo/gBBP1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/gBBP1</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/233>
        rdf:type                 schema:Claim;
        schema:abstract          "“I completely believe that these plans are leaning forward on the conservation of sage grouse,” Bernhardt told The Associated Press. “Do they do it in exactly the same way? No. We made some change in the plans and got rid of some things that are simply not necessary.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/233/source/42>;

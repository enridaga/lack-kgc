        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3551>
        rdf:type                 schema:Claim;
        schema:abstract          "“Canada needs its Conservatives to go all in against environmental alarmism, including climate alarmism, and here I would point out that when governments start hauling out the issue of extreme weather, there is nothing mainstream about that kind of science. The mainstream science including the IPCC does not draw a connection between greenhouse gas emissions and extreme weather events.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3551/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/canada-strong-and-free-network/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/canada-strong-and-free-network/" .

<http://data.open.ac.uk/climate-sense/claim/3550/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3550>
        rdf:type                 schema:Claim;
        schema:abstract          "“We have a problem of overkill in some areas including, for instance, the coal phase-out in Ontario. That was a huge overkill in response to the air emissions issue. […] They didn’t need to phase out those coal-fired power plants, but its the alarmism that made it impossible to have that debate at the time.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3550/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/canada-strong-and-free-network/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/canada-strong-and-free-network/" .


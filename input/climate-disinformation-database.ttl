<http://data.open.ac.uk/climate-sense/claim/3056>
        rdf:type                 schema:Claim;
        schema:abstract          "“I started as an anthropogenic global warming believer, then I read the [UN’s IPCC] Summary for Policymakers and the research of prominent skeptics.” “After that, I changed my mind”";

<http://data.open.ac.uk/climate-sense/claim/1928>
        rdf:type                 schema:Claim;
        schema:abstract          "“You’ve been told about global warming, right? You know, take the One Tonne Challenge, turn down your heat and cool the planet. But have you been told the truth? Are you really causing global warming? Find out: watch our video at friendsofscience.org.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1928/source/>;

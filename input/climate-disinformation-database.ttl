        rdf:type                 schema:Claim;
        schema:abstract          "“(When asked about Mr. Faissal’s account, Mr. Velshi called it ‘totally untrue,’ but also acknowledged having met Mr. Faissal and telling ‘anyone who would listen’ that Ontario Proud was the best thing to happen to the Tories.)";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11591/source/>;

<http://data.open.ac.uk/climate-sense/claim/3003/source/64>
        rdf:type         schema:CreativeWork;
        schema:citation  "Christian Giggenbach. “<a href=\"http://www.register-herald.com/news/local_news/giuliani-touts-importance-of-coal/article_abba7f4f-9c55-5a78-a2b2-acbddff0ef5f.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Giuliani touts importance of coal</a>,”<em> The Register-Herald</em>, August 3, 2007. Archive.is URL: <a href=\"https://archive.is/hNDTO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/hNDTO</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3003>
        rdf:type                 schema:Claim;
        schema:abstract          "“One of my 12 commitments to the American people is to make our country energy independent and coal plays a big role in that.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3003/source/64>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/rudy-giuliani/>;

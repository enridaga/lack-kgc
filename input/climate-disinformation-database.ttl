        rdf:type                 schema:Claim;
        schema:abstract          "“The real way we measure our impact is through public opinion surveys,” Bast said, referring to Heartland’s surveys on public global warming&nbsp;attitudes.&nbsp;";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2425/source/230>;

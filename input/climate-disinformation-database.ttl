<http://data.open.ac.uk/climate-sense/claim/11571/source/37>
        rdf:type         schema:CreativeWork;
        schema:citation  "Sarah Lacy. “<a href=\"http://web.archive.org/web/20240906165409/https://techcrunch.com/2011/04/10/peter-thiel-were-in-a-bubble-and-its-not-the-internet-its-higher-education/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Peter Thiel: We’re in a Bubble and It’s Not the Internet. It’s Higher Education</a>,” <em>TechCrunch</em>, April 10, 2011. Archived September 6, 2024. Archive URL: <a href=\"https://archive.ph/JHKox\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/JHKox</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/11571>
        rdf:type                 schema:Claim;
        schema:abstract          "“A true bubble is when something is overvalued and intensely believed,” Thiel said in an ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11571/source/37>;

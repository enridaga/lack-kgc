        rdf:type         schema:CreativeWork;
        schema:citation  "Alexis Levinson. “<a href=\"http://web.archive.org/web/20190518045641/https://dailycaller.com/2014/04/07/new-ads-attack-braley-udall-on-obamacare/\" rel=\"nofollow external noopener noreferrer\" data-wpel-link=\"external\" target=\"_blank\">NEW ADS ATTACK BRALEY, UDALL ON OBAMACARE</a>,” <em>The Daily Caller</em>, April 7, 2014. Archived May 18. 2019. Archive.fo URL: <a href=\"https://archive.fo/RUpJf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.fo/RUpJf</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/12637>
        rdf:type                 schema:Claim;
        schema:abstract          "“Congressman Bruce Braley voted for Obamacare,” says a female narrator in the Iowa ad, as brooding piano music plays in the background. “The government spent millions of taxpayer dollars to promote it. Now, health insurance companies stand to make billions, and Bruce Braley, he takes tens of thousands from his friends in the health insurance industries. For Iowans, it’s cancelled policies and higher costs. That’s not right.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12637/source/45>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/freedom-partners/>;

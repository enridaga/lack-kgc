<http://data.open.ac.uk/climate-sense/claim/12833>
        rdf:type                 schema:Claim;
        schema:abstract          "“While the amounts of hexavalent chromium detected in municipal water supplies in North Carolina are worrisome and show we do need state and federal drinking water standards to catch up to the latest science, some of the levels found in wells near Duke’s coal ash sites have been much higher,” said Katie Hicks, Associate Director for Clean Water for North Carolina.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12833/source/73>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/franklin-centre-government-and-public-integrity/>;

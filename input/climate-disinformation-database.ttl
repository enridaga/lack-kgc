        rdf:type                 schema:Claim;
        schema:abstract          "“You may also know us from our work exposing the shoddy science and missing economics behind the global warming delusion. Our videos, books, studies, and international conferences changed the debate and led to the defeat of ‘cap and trade.'”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2353/source/25>;

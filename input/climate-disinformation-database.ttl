<http://data.open.ac.uk/climate-sense/claim/9771/source/14>
        rdf:type         schema:CreativeWork;
        schema:citation  "Harry C. Alford. “<a href=\"http://www.phillytrib.com/commentary/global-warming-proponents-cling-to-costly-farce/article_823387dc-177d-5892-ade6-881d50d8cbe8.html\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">Global warming proponents cling to costly farce</a>,”&nbsp;<em>The Philadelphia Tribune</em>, November 4, 2015. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9771>
        rdf:type                 schema:Claim;
        schema:abstract          "“Believe me, I have personally experienced these nuts, and the National Black Chamber of Commerce has been slandered for its energy positions. It appears that we are right and they are wrong. Let the whole world know about it.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9771/source/14>;

<http://data.open.ac.uk/climate-sense/claim/7445>
        rdf:type                 schema:Claim;
        schema:abstract          "“Thank you for inviting me to request renewed general operating support for The Heartland Institute for 1999. I note that Philip Morris contributed $5,000 last August (for a Gold Table at our annual benefit) and $25,000 in October (general operating support). It also has allowed you to serve on our Board of Directors, which has produced many positive results for the entire organization.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7445/source/24>;

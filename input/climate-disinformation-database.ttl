<http://data.open.ac.uk/climate-sense/claim/7719>
        rdf:type                 schema:Claim;
        schema:abstract          "“With assistance from the Institute of Public Affairs, I have been pushing back against the charges and the gag order – leading the university to search my official emails for examples of where I had mentioned the case to other scientists, old friends, past students and my wife,” Ridd wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7719/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ridd/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/peter-ridd/" .

<http://data.open.ac.uk/climate-sense/claim/7718/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/7718>
        rdf:type                 schema:Claim;
        schema:abstract          "“We filed in court in November. At that point the university backed away from firing me. But university officials issued a ‘Final Censure’ in my employment file and told me to be silent about the allegations, and not to repeat my comments about the unreliability of institutional research. […] I would rather be fired than accept these conditions. We are still pursuing the matter in court,” Ridd wrote.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7718/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/peter-ridd/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/peter-ridd/" .


        schema:citation  "Colin Craig. “<a href=\"https://financialpost.com/opinion/colin-craig-things-to-do-with-co2\" target=\"_blank\" rel=\"noreferrer noopener nofollow external\" data-wpel-link=\"external\">Colin Craig: Things to do with CO2</a>,” <em>Financial Post</em>, December 3, 2021. Archived March 16, 2022. Archive URL: <a href=\"https://archive.ph/kGZpO\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.ph/kGZpO</a>"^^rdf:HTML .


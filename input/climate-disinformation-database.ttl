<http://data.open.ac.uk/climate-sense/claim/7929>
        rdf:type                 schema:Claim;
        schema:abstract          "“While one may not doubt the fact that the climate, by and large, does appear to be getting warmer; what, however, does tax the mind is the attempted linkage of the glacier retreat in the Himalayas to the global warming.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/7929/source/2>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/vijay-kumar-raina/>;

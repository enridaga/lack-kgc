<http://data.open.ac.uk/climate-sense/claim/3740>
        rdf:type                 schema:Claim;
        schema:abstract          "‘Climate Chaos’ is a baseless, absurd ruse to hike taxes and extend State power. That so many ‘scientists’ play ball just demonstrates what a bunch of shameless, grubby, tax-munching charlatans they are.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3740/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/martin-durkin/>;

<http://data.open.ac.uk/climate-sense/claim/11094>
        rdf:type                 schema:Claim;
        schema:abstract          "“Studies confirm that the Kyoto Protocol will have a minimal effect on total greenhouse gas emissions over the next decades and will have no real influence on the evolution of the earth’s climate change. We are also told that the Kyoto Protocol is the first in a long line of necessary steps to control global warming. Do you intend to continue this process by signing or supporting the signing of other international agreements to control climate change?”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/11094/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/montreal-economic-institute/>;

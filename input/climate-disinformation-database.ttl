        rdf:type                 schema:Claim;
        schema:abstract          "“Children will be taught, for example, the ‘impact of diet choices for land usage and environmental impact’ […] That isn’t educating children to think for themselves; it is trying to train them to be the next generation of environmental activists.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12463/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/ross-clark/>;

        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10509>
        rdf:type                 schema:Claim;
        schema:abstract          "Rogan: “Right. But it doesn’t deny that human beings have an impact on this either.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10509/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-rogan/>;

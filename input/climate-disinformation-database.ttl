<http://data.open.ac.uk/climate-sense/claim/5784/source/178>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20070824223727/http://www.dallasnews.com/sharedcontent/dws/dn/opinion/editorials/stories/DN-white_23edi.ART.State.Edition1.42a54fe.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Clean Air Awaits: Gov. Perry should seize this chance to reshape TCEQ</a>,” <em>The Dallas Morning News</em>, July 23, 2007. Archived August 27, 2007. Archived .pdf on file at DeSmog. Archive.is URL: <a href=\"https://archive.is/LinZJ\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/LinZJ</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/5784>
        rdf:type                 schema:Claim;
        schema:abstract          "“She [Hartnett White] has been an apologist for polluters, consistently siding with business interests instead of protecting public health. Ms. White worked to set a low bar as she lobbied for lax ozone standards and pushed through an inadequate anti-pollution plan. She also voted to approve TXU’s pollution-intensive Oak Grove coal units, ignoring evidence that emissions from the lignite plant could thwart North Texas’ efforts to meet air quality standards,” the editorial reads.";

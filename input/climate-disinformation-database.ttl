        rdf:type         schema:CreativeWork;
        schema:citation  "Lisa Friedman. “<a href=\"https://www.nytimes.com/2018/02/22/climate/george-david-banks.html\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Former Trump Aide Calls Paris Climate Accord ‘a Good Republican Agreement’</a>,” <em>The New York Times</em>, February 22, 2018. Archive.is URL:<a href=\"https://archive.li/tM8I4\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\"> https://archive.li/tM8I4</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2911>
        rdf:type                 schema:Claim;
        schema:abstract          "“I’m going to say something controversial,” Banks, said in an interview after leaving his position in the Trump Administration. “The Paris agreement is a good Republican agreement. It’s everything the Bush administration wanted.”";

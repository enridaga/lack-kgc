        rdf:type                 schema:Claim;
        schema:abstract          "“People remain the problem to the congregation of the Church of Climate, as much as they want to say that forced energy transformation is compatible with economic coordination and prosperity.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12581/source/>;

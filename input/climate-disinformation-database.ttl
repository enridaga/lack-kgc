<http://data.open.ac.uk/climate-sense/claim/9295>
        rdf:type                 schema:Claim;
        schema:abstract          "“More and more, I am becoming convinced that atmospheric heating is primarily by thermal conduction from the surface, whose temperature is determined primarily by solar absorption. I get a lot of email from laymen seeking simple answers. My simple reply goes like this:";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9295/source/10>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/james-peden/>;

        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20191021171240/http://www.ipaa.org/wp-content/uploads/2016/12/2007-02-Climate-Concerns-Impacts.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Global Climate Change: Concerns and Impacts” (PDF)</a>, February 2007. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/3257>
        rdf:type                 schema:Claim;
        schema:abstract          "“[N]o climate change policy action should discard the question of science. Too often, recent arguments for action discard the uncertainties of today’s understanding of global climate science. Global climate science is an emerging field, one that changes as the tools to model it improve. There needs to be a continuing commitment to improve the capabilities of this science and to use it in developing policy.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/3257/source/10>;

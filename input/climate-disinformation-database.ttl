        rdf:type                 schema:Claim;
        schema:abstract          "“At this point there is little doubt that the IPCC position is seriously flawed in its central position that humanity is responsible for most of the observed warming of the last third of the 20th century, and in its projections for effects in the 21st century.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9710/source/10>;

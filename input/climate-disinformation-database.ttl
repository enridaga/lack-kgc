        schema:citation  "<a href=\"https://web.archive.org/web/20180214000740/https://wattsupwiththat.files.wordpress.com/2018/02/amnh18-feb4-petitionletter-1.pdf\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">mnh18-feb4-petitionletter (PDF – Untitled)</a>. Retrieved from&nbsp;<em>Watts Up With That</em>."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/13043>
        rdf:type                 schema:Claim;
        schema:abstract          "“Make no mistake, the agitators are not defending science from quackery — quite the contrary!”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/13043/source/13>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/james-wanliss/>;

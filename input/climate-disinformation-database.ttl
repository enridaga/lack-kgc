        rdf:type                 schema:Claim;
        schema:abstract          "Rogan: “Randall Carlson said, he goes, climate change where it gets warmer. It’s not necessarily good, but climate change where it gets colder is ";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10530/source/>;

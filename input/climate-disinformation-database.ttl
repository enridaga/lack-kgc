        rdf:type         schema:CreativeWork;
        schema:citation  "Roger Harrabin. “<a href=\"https://www.bbc.co.uk/news/science-environment-48081314\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Fracking tsar resigns after six months over ‘ridiculous’ rules</a>,” <em>BBC News</em>, April 28, 2019. <a href=\"https://web.archive.org/web/20190711134521/https://www.bbc.co.uk/news/science-environment-48081314\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Archived July 11, 2019</a>. Archive.fo URL: <a href=\"http://archive.fo/cYTLu\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.fo/cYTLu</a>"^^rdf:HTML .


<http://data.open.ac.uk/climate-sense/claim/6193/source/6>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20111119180124/www.associatedcontent.com/article/298630/no_one_really_knows_on_global_warming.html?cat=15\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">No One Really Knows on Global Warming, Oklahoma Weather Forecaster Says</a>.” <em>Associated Content</em>, July 1, 2007."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/6193>
        rdf:type                 schema:Claim;
        schema:abstract          "“… .As someone said recently, ‘It’s the Sun stupid!’ Recent research suggests that the activity of our Sun combined with cosmic radiation from far outside our galaxy interact with our atmosphere to produce effects never dreamed of a few years ago. Is anything or everything in this paragraph correct? No body really knows.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6193/source/6>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/gary-england/>;

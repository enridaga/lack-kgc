<http://data.open.ac.uk/climate-sense/claim/651/source/14>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20180119232157/https://www.cato.org/research/global-warming\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Global Warming</a>,”&nbsp;<em>Cato Institute</em>. Archived January 19, 2018. Archive.is URL:<a href=\"https://archive.is/WrWU1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">&nbsp;https://archive.is/WrWU1</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/651>
        rdf:type                 schema:Claim;
        schema:abstract          "“Global warming is indeed real, and human activity has been a contributor since 1975. But global warming is also a very complicated and difficult issue that can provoke very unwise policy in response to political pressure. Although there are many different legislative proposals for substantial reductions in carbon dioxide emissions, there is no operational or tested suite of technologies that can accomplish the goals of such legislation. Fortunately, and contrary to much of the rhetoric surrounding climate change, there is ample time to develop such technologies, which will require substantial capital investment by individuals.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/651/source/14>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/cato-institute/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/cato-institute/" .


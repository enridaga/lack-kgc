<http://data.open.ac.uk/climate-sense/claim/6370>
        rdf:type                 schema:Claim;
        schema:abstract          "“Let’s just take one simple, but significant assumption modelers must make: the impact of clouds on the climate.";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/6370/source/>;

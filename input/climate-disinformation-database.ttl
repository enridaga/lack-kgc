<http://data.open.ac.uk/climate-sense/claim/12682>
        rdf:type                 schema:Claim;
        schema:abstract          "A separate wing of the group will incorporate as a limited liability company (LLC), which can coordinate directly with campaigns and political committees by sharing video and resources. [To avoid making illegal in-kind corporate contributions, the LLC needs to charge for access to the videos and&nbsp;resources.]";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12682/source/>;

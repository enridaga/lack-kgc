<http://data.open.ac.uk/climate-sense/claim/3307/source/87>
        rdf:type         schema:CreativeWork;
        schema:citation  "E. Calvin Beisner. “<a href=\"https://web.archive.org/web/20150620190951/http://www.washingtontimes.com/news/2015/jun/17/e-calvin-beisner-ironies-pope-franciss-climate-cha/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">The ironies of Pope Francis’s climate-change cure</a>,”&nbsp;<em>The Washington Times</em>, June 17, 2015. Archived June 20, 2015. Archive.is&nbsp;URL:&nbsp;<a href=\"https://archive.is/7YBcV\" target=\"_blank\" rel=\"noreferrer noopener external\" data-wpel-link=\"external\">https://archive.is/7YBcV</a>"^^rdf:HTML .


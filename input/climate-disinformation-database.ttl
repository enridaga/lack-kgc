        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/lavoisier-group/" .

<http://data.open.ac.uk/climate-sense/claim/10685/source/43>
        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20170825161903/http://www.lavoisier.com.au/articles/greenhouse-science/climate-change/satanicgas2008.pdf\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Satanic Gas: The Politics of Carbon Dioxide</a>,” <em>Quadrant</em>, September 2008. Retrieved from Lavoisier.com."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/10685>
        rdf:type                 schema:Claim;
        schema:abstract          "“[A]bove all, the belief that carbon is a demonic element, and that carbon dioxide is a satanic gas, is a retreat into fantasy of the most primitive and dangerous kind.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10685/source/43>;

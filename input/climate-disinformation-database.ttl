        rdf:type         schema:CreativeWork;
        schema:citation  "<a href=\"http://web.archive.org/web/20171014035447/http://21sci-tech.com/Articles%202008/Patterson_Interview.pdf\" id=\"s29\" name=\"s29\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">“There’s No Correlation Between CO2 and Climate Change” (PDF)</a>, <em>21st Centry Science and Technology</em>, Winter 2007 – 2008."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/2810>
        rdf:type                 schema:Claim;
        schema:abstract          "“And this is again due very heavily to Jan Veizer at the University of Ottawa […] And this is where the work he did with Shaviv came in, and they found that there was no statistical correlation between CO2 and climate. And in my research, I didn’t really see any CO2 impact at all; there was nothing changing in more recent times that didn’t correlate well with the sunspot cycle. So, that’s how I got where I am.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/2810/source/10>;

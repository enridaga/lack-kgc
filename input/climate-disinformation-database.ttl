        rdf:type         schema:CreativeWork;
        schema:citation  "“<a href=\"http://web.archive.org/web/20171014040853/http://www.ourcommons.ca/DocumentViewer/en/38-1/ENVI/meeting-18/evidence\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">38TH PARLIAMENT, 1ST SESSION STANDING COMMITTEE ON ENVIRONMENT AND SUSTAINABLE DEVELOPMENT</a>,” <em>House of Commons</em>, February 10, 2005. Archived October 14, 2017. Archive.is URL: <a href=\"https://archive.is/7R7vP\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">https://archive.is/7R7vP</a>"^^rdf:HTML .


        rdf:type                 schema:Claim;
        schema:abstract          "“[Anthony] Fauci knew very well that gain-of-function research was not only occurring at the Wuhan lab, but that it was being funded by the US government. . .";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/10489/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/joe-rogan/>;

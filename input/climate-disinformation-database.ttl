<http://data.open.ac.uk/climate-sense/claim/12530>
        rdf:type                 schema:Claim;
        schema:abstract          "Carbon dioxide is absolutely essential for plant growth – and for all life on Earth. Volumes of research clearly demonstrate that crop, garden, forest, grassland and ocean plants want more CO2, not less. The increased greening of our Earth over the past 30 years testifies to the desperate need of plants for this most fundamental fertilizer. The more CO2 they get, the better and faster they grow.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/12530/source/29>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/willie-soon/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;

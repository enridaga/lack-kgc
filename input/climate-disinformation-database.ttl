<http://data.open.ac.uk/climate-sense/claim/1172/source/27>
        rdf:type         schema:CreativeWork;
        schema:citation  "<a id=\"s40\" href=\"https://files.texaspolicy.com/uploads/2020/03/23175236/Coronavirus-Stimulus-Letter.pdf\" name=\"s40\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">Coronavirus Stimulus Letter, Life:Powered</a>, March 23, 2020. Archived .pdf on file at DeSmog."^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1172>
        rdf:type                 schema:Claim;
        schema:abstract          "“This is no time for political games. Climate change is not an immediate threat to humanity. Climate-related deaths have declined 98.9% in the last century, and humanity is growing more and more resilient thanks to the availability of affordable, reliable energy. On behalf of all Americans, we urge you to oppose any stimulus proposals that carve out special treatment for or bail out any energy companies and focus instead on stopping COVID-19.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1172/source/27>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/isaac-orr/>;
        schema:claimInterpreter  <http://desmog.com/>;
        schema:inLanguage        "English"^^schema:Text;
        schema:publisher         <http://desmog.com/>;
        schema:url               "https://www.desmog.com/isaac-orr/" .

<http://data.open.ac.uk/climate-sense/claim/1171/source/>
        rdf:type         schema:CreativeWork;
        schema:citation  ""^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/1171>
        rdf:type                 schema:Claim;
        schema:abstract          "“This will have no impact on climate change,” Orr Claimed in his testimony. “When you look at the the proposed rule, the governor’s administration was saying it’s a little over 2 million tons of CO2 every single year … you’re looking at a temperature reduction of 0.000052 degrees by 2100. And you’re not going to be able to measure that.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/1171/source/>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/isaac-orr/>;
        schema:claimInterpreter  <http://desmog.com/>;

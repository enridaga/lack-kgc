<http://data.open.ac.uk/climate-sense/claim/9035/source/55>
        rdf:type         schema:CreativeWork;
        schema:citation  "Robert L. Bradley Jr. “<a href=\"https://web.archive.org/web/20190212202004/https://www.instituteforenergyresearch.org/the-grid/what-was-the-energy-new-deal-anyway/\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">What Was the Energy New Deal Anyway?</a>,” <em>Institute for Energy Research</em>, February 1, 2019. Archived February 12, 2019. Archive.is URL: <a href=\"http://archive.is/lNpk1\" data-wpel-link=\"external\" target=\"_blank\" rel=\"external noopener noreferrer\">http://archive.is/lNpk1</a>"^^rdf:HTML .

<http://data.open.ac.uk/climate-sense/claim/9035>
        rdf:type                 schema:Claim;
        schema:abstract          "“[…] the proposed Green New Deal would be a giant leap on the road to serfdom. It would create the distortions and conflicts that would engender more of the same. Its slow-motion attack on wealth creation to subsidize the inefficient and a growing class of cronies would spiral the United States toward a present-day Venezuela.”";
        schema:archivedAt        <http://data.open.ac.uk/climate-sense/claim/9035/source/55>;
        schema:author            <http://data.open.ac.uk/climate-sense/entity/institute-energy-research/>;

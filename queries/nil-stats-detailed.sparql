PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX lack: <https://purl.net/climatesense/lack/ns#>

SELECT
  (COUNT(DISTINCT ?e_desmog_only)   AS ?nil_desmog_only)
  (COUNT(DISTINCT ?e_lobbymap_only) AS ?nil_lobbymap_only)
  (COUNT(DISTINCT ?e_both)          AS ?nil_both)
WHERE {
  { ?e a lack:Person } UNION { ?e a lack:Collective }

  # NIL: no Wikidata or DBpedia link
  FILTER NOT EXISTS {
    ?e owl:sameAs ?link .
    FILTER(
      STRSTARTS(STR(?link), "https://www.wikidata.org/entity/") ||
      STRSTARTS(STR(?link), "http://dbpedia.org/resource/")
    )
  }

  # Source flags
  BIND(EXISTS {
    ?e rdfs:seeAlso ?s .
    FILTER(isLiteral(?s))
    FILTER(STRSTARTS(STR(?s), "https://www.desmog.com"))
  } AS ?inDesmog)

  BIND(EXISTS {
    ?e rdfs:seeAlso ?s2 .
    FILTER(isLiteral(?s2))
    FILTER(
      STRSTARTS(STR(?s2), "https://lobbymap.org") ||
      STRSTARTS(STR(?s2), "https://influencemap.org")
    )
  } AS ?inLobbymap)

  BIND(IF(?inDesmog && !?inLobbymap, ?e, ?x) AS ?e_desmog_only)
  BIND(IF(?inLobbymap && !?inDesmog, ?e, ?x) AS ?e_lobbymap_only)
  BIND(IF(?inDesmog && ?inLobbymap,  ?e, ?x) AS ?e_both)
}